[Unit]
Description=Kiwi Network: Pi-hole records for the Mullvad SOCKS5 proxies ({{ hostname }})
Documentation=https://github.com/derlocke-ng/kiwi-server https://github.com/derlocke-ng/mullvad-socks5
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# curl gives up after its retries; this bounds anything else
TimeoutStartSec=15min
ExecStart=/usr/bin/bash {{ docker_dir }}/kiwi/mullvad-socks.sh
# root, fetching from the Internet: it may write one directory and nothing else
ProtectSystem=strict
ReadWritePaths=-{{ docker_dir }}/{{ container_prefix }}-pihole
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# no [Install]: {{ container_prefix }}-mullvad-socks.timer starts it (and the apply, once)
