# accounts — Kanidm: the network's people, passwords and passkeys
services:
  {{ container_prefix }}-accounts:
    image: {{ image }}
    container_name: {{ container_prefix }}-accounts
    restart: unless-stopped
    command: ["/sbin/kanidmd", "server", "-c", "/config/server.toml"]
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-accounts/data:/data:z
      - {{ docker_dir }}/{{ container_prefix }}-accounts/server.toml:/config/server.toml:ro,z
      - {{ docker_dir }}/{{ container_prefix }}-nginx/fullchain.pem:/certs/fullchain.pem:ro,z
      - {{ docker_dir }}/{{ container_prefix }}-nginx/privkey.pem:/certs/privkey.pem:ro,z
    logging:
      driver: json-file
      options:
        max-size: 10m
{% if signup %}

  # the sign-up page: invite codes and requests (kiwi-server signup), at https://{{ id_host }}/join
  {{ container_prefix }}-signup:
    image: {{ signup_image }}
    container_name: {{ container_prefix }}-signup
    restart: unless-stopped
    command: ["signup", "serve", "--state", "/state", "--kanidm", "https://{{ container_prefix }}-accounts:8443",
              "--kanidm-cert", "/certs/kanidm.pem",
              "--token-file", "/state/token", "--id-host", "{{ id_host }}", "--id-onion", "{{ (onion or {}).values() | first | default('') }}",
              "--brand", "{{ brand or domain }}",
              "--terms-file", "/state/terms.txt", "--listen", "0.0.0.0:8080"]
{% if proxy_ip %}
    environment:
      # the reverse proxy in front: the only one whose X-Real-IP the sign-up believes (its limits are per address)
      - KIWI_PROXY={{ proxy_ip }}
{% endif %}
    networks:
      {{ network_name }}: {}
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-accounts/signup:/state:z
      # the certificate Kanidm shows: the only one the sign-up trusts when it talks to Kanidm
      - {{ docker_dir }}/{{ container_prefix }}-nginx/fullchain.pem:/certs/kanidm.pem:ro,z
    logging:
      driver: json-file
      options:
        max-size: 10m
{% endif %}
