# control
services:
  {{ container_prefix }}-control:
    image: {{ image }}
    container_name: {{ container_prefix }}-control
    command: ["serve", "/fleet/fleet.yaml", "--listen", "0.0.0.0:8740", "--status-minutes", "{{ status_minutes }}", "--wait"]
    environment:
      # an apply of this machine restarts this container: the role then runs detached from it
      - KIWI_CONTROL_HOST={{ hostname.split('.')[0] }}
{% if proxy_ip %}
      # the reverse proxy in front: the only one whose X-Real-IP the page believes
      - KIWI_PROXY={{ proxy_ip }}
{% endif %}
      # the opened store, job logs and renders: in RAM, gone with the container
      - XDG_RUNTIME_DIR=/run/kiwi
      # the network's name, colour, words and contact on the pages for everyone
      # quoted: a sentence with ": " in it is no YAML map
      - {{ ("KIWI_BRAND=" ~ brand_name) | tojson }}
      - {{ ("KIWI_ACCENT=" ~ brand_accent) | tojson }}
      - {{ ("KIWI_ABOUT=" ~ (about | replace('\n', ' '))) | tojson }}
      - {{ ("KIWI_CONTACT=" ~ contact) | tojson }}
{% if play_page %}
      # the game page: its name (only /play/ answers there), who may, and what more it lists
      - KIWI_PLAY_HOST={{ play_hostname or 'play.' ~ hostname }}
      - KIWI_PLAY_GROUP={{ play_group }}
      - {{ ("KIWI_PLAY_EXTRA=" ~ (play_extra | join(' '))) | tojson }}
{% endif %}
    tmpfs:
      - /run/kiwi:size={{ ram_mb }}m,mode=0700
    volumes:
      # fleet.yaml and the encrypted store (secrets.age): no secret is on this disk in the clear
      - {{ docker_dir }}/{{ container_prefix }}-control:/fleet:Z
    restart: unless-stopped
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    logging:
      driver: json-file
      options:
        max-size: 10m
