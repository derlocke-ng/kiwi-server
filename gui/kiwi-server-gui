    def copy_button(self, text, what):
        b = Gtk.Button(icon_name="edit-copy-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Copy the %s" % what,
                       css_classes=["flat"])
        b.update_property([Gtk.AccessibleProperty.LABEL], ["Copy the %s" % what])
        b.connect("clicked", lambda *_: (Gdk.Display.get_default().get_clipboard().set(text),
                                         self.toasts.add_toast(Adw.Toast(title="Copied the %s" % what, timeout=2))))
        return b

    def value_row(self, title, value, what):
        row = Adw.ActionRow(use_markup=False, title=title, subtitle=value, subtitle_selectable=True,
                            css_classes=["property"])
        row.add_suffix(self.copy_button(value, what))
        return row

    def password_row(self, password):
        row = Adw.ActionRow(use_markup=False, title="Password", subtitle=self.DOTS, css_classes=["property"])
        eye = Gtk.ToggleButton(icon_name="view-reveal-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Show the password",
                               css_classes=["flat"])
        eye.update_property([Gtk.AccessibleProperty.LABEL], ["Show the password"])

        def toggled(b):
            on = b.get_active()
            row.set_subtitle(password if on else self.DOTS)
            row.set_subtitle_selectable(on)
            b.set_icon_name("view-conceal-symbolic" if on else "view-reveal-symbolic")
            b.set_tooltip_text("Hide the password" if on else "Show the password")
        eye.connect("toggled", toggled)
        row.add_suffix(eye)
        row.add_suffix(self.copy_button(password, "password"))
        return row

    def show_list(self, found, err):
        if not found:
            self.status.set_title("No answer" if found is None else "Nothing to sign in to")
            self.status.set_description((err.replace("error: ", "").splitlines() or [""])[-1] if found is None
                                        else "No service on %s has a login." % self.host)
            self.status.set_child(None)
            return False
        for x in found:
            g = Adw.PreferencesGroup(title=esc(x["label"]), description=esc(x["note"]))
            address = x["address"]
            if address:
                row = self.value_row("Address", address, "address")
                if address.startswith(("https://", "http://")):
                    row.set_activatable(True)
                    row.add_suffix(Gtk.Image(icon_name="adw-external-link-symbolic"))
                    row.connect("activated", lambda _r, a=address: Gtk.UriLauncher.new(a).launch(self.win, None, None))
                g.add(row)
            if x["user"]:
                g.add(self.value_row("User name", x["user"], "user name"))
            if x["password"]:
                g.add(self.password_row(x["password"]))
            self.page.add(g)
        self.stack.set_visible_child_name("list")
        return False


class FederationDialog(Adw.Dialog):
    """The partner networks in federation.yaml and what each may reach here."""

    def __init__(self, win):
        super().__init__(title="Linked networks", content_width=620, content_height=600)
        self.win = win
        self.path = os.path.join(os.path.dirname(win.doc.path), "federation.yaml")
        try:
            with open(self.path) as fh:
                self.data = yaml.safe_load(fh) or {}
        except OSError:
            self.data = {}
        page = Adw.PreferencesPage()
        intro = Adw.PreferencesGroup(description="Networks linked to this one. Each sees only what is shared here.")
        intro.set_header_suffix(help_button("A partner reaches the names listed under Shared here (a node, node:port "
                                            "or service.node, e.g. cloud.papaya) from the addresses under From "
                                            "(empty: its whole network). One network can also leave to the Internet "
                                            "through the other, over the same link: switch it on here, and the "
                                            "matching switch in the other network. Apply the master and the nodes "
                                            "after a change.",
                                            DOCS + "docs/design/federation.md"))
        link = Adw.ButtonRow(title="Link another network…", start_icon_name="list-add-symbolic")
        link.connect("activated", lambda *_: self.link())
        intro.add(link)
        # a network of another operator, whose fleet file is not here: cards, as on the page (federate --invite/--accept)
        card = Adw.ButtonRow(title="This network's card…", start_icon_name="document-save-symbolic")
        card.connect("activated", lambda *_: self.write_card())
        intro.add(card)
        take = Adw.ButtonRow(title="Take another network's card…", start_icon_name="document-open-symbolic")
        take.connect("activated", lambda *_: self.take_card())
        intro.add(take)
        page.add(intro)
        self.rows = {}
        for name, p in self.data.items():
            p = p or {}
            g = Adw.PreferencesGroup(title=name)
            g.set_header_suffix(info_button("%s at %s, %s, its names .%s" % (
                name, p.get("endpoint", "?"), p.get("mesh", "?"), p.get("domain", "?"))))
            share = Adw.EntryRow(title="Shared here (ticked under “Access rules…”)", text=" ".join(p.get("share") or []))
            frm = Adw.EntryRow(title="From", text=" ".join(p.get("from") or []))
            g.add(share)
            g.add(frm)
            # the way to the internet over the link: this network through the partner, or the partner through this one
            out = Adw.SwitchRow(title="Leave to the Internet through it", active=bool(p.get("exit")),
                                subtitle="Your devices come out at %s's master. It has to allow that on its side." % name)
            let = Adw.SwitchRow(title="It may leave to the Internet through this network", active=bool(p.get("internet")),
                                subtitle="%s's devices come out at your master. To the Internet only." % name)
            g.add(out)
            g.add(let)
            # its CA, for this network's devices: only one that signs its own names only (kiwi-server federate --ca)
            ca = Adw.ActionRow(title="Its certificates", subtitle="Save its CA and import it on your devices, to open "
                               "%s's pages without a warning. Offered only when it can sign nothing of yours." % name)
            get = Gtk.Button(label="Save…", valign=Gtk.Align.CENTER)
            get.connect("clicked", lambda _b, n=name: self.save_ca(n))
            ca.add_suffix(get)
            g.add(ca)
            self.rows[name] = (share, frm, out, let)
            page.add(g)
        save = Gtk.Button(label="Save", css_classes=["suggested-action"], sensitive=bool(self.rows))
        save.connect("clicked", lambda *_: self.save())
        head = Adw.HeaderBar()
        head.pack_end(save)
        tb = Adw.ToolbarView(content=page)
        tb.add_top_bar(head)
        self.set_child(tb)

    def save(self):
        leaving = [n for n, r in self.rows.items() if r[2].get_active()]
        both = [n for n, r in self.rows.items() if r[2].get_active() and r[3].get_active()]
        if len(leaving) > 1 or both:
            self.win.toast("Two networks cannot leave through each other" if both else
                           "Only one partner can be the way to the Internet")
            return
        for name, (share, frm, out, let) in self.rows.items():
            entry = dict(self.data.get(name) or {}, share=share.get_text().split(), **{"from": frm.get_text().split()})
            for key, row in (("exit", out), ("internet", let)):
                if row.get_active():
                    entry[key] = True
                else:
                    entry.pop(key, None)
            self.data[name] = entry
        class Dumper(yaml.SafeDumper):      # a partner's CA certificate stays a block, as kiwi-server writes it
            pass
        Dumper.add_representer(str, lambda d, v: d.represent_scalar("tag:yaml.org,2002:str", v,
                                                                   style="|" if "\n" in v else None))
        text = ("# federation.yaml — the partner networks and what each may reach here.\n"
                + yaml.dump(self.data, Dumper=Dumper, sort_keys=False, default_flow_style=None, allow_unicode=True))
        with open(self.path, "w") as fh:
            fh.write(text)
        self.close()
        self.win.toast("Saved — apply the master and the nodes")

    def save_ca(self, name):
        path = self.win.doc.path

        def work():
            rc, out, err = run_cli(self.win.cli, ["federate", path, "--ca", name])

            def done():
                if rc != 0 or "BEGIN CERTIFICATE" not in out:
                    self.win.alert("Not offered", ((err or out).strip().replace("error: ", "").splitlines() or ["?"])[-1])
                    return False
                dlg = Gtk.FileDialog(title="Save %s's CA" % name, initial_name="kiwiCA-%s.pem" % name)

                def chosen(d, res):
                    try:
                        dest = d.save_finish(res).get_path()
                    except GLib.Error:
                        return
                    with open(dest, "w") as fh:
                        fh.write(out)
                    self.win.toast("Saved. Import it on your devices as a certificate authority.")
                dlg.save(self.win, None, chosen)
                return False
            GLib.idle_add(done)
        threading.Thread(target=work, daemon=True).start()

    def write_card(self):
        """This network's card for another operator (federate --invite): its name, mesh, DNS and key."""
        name = os.path.basename(os.path.dirname(os.path.abspath(self.win.doc.path)))
        dlg = Gtk.FileDialog(title="Save this network's card", initial_name="%s.card.yaml" % name)

        def done(d, res):
            try:
                dest = d.save_finish(res).get_path()
            except GLib.Error:
                return
            self.win.spawn(["federate", self.win.doc.path, "--invite", dest],
                           "Writing the card… give it to the other network's operator")
        dlg.save(self.win, None, done)

    def take_card(self):
        """Another operator's card (federate --accept): that network becomes a partner, and this network's
        card is written beside it for them when there is none yet."""
        dlg = Gtk.FileDialog(title="The other network's card")

        def done(d, res):
            try:
                card = d.open_finish(res).get_path()
            except GLib.Error:
                return
            self.close()
            self.win.spawn(["federate", self.win.doc.path, "--accept", card], "Taking the card…")
        dlg.open(self.win, None, done)

    def link(self):
        dlg = Gtk.FileDialog(title="The other network's fleet file")

        def done(d, res):
            try:
                other = d.open_finish(res).get_path()
            except GLib.Error:
                return
            self.close()
            self.win.spawn(["federate", self.win.doc.path, other], "Linking the networks…")
        dlg.open(self.win, None, done)


class AccessDialog(Adw.Dialog):
    """Who may reach what: the VPN's groups and the linked networks, ticked per machine and
    service. Reads and writes through `kiwi-server access`, as the control page does."""

    def __init__(self, win):
        super().__init__(title="Access rules", content_width=660, content_height=700)
        self.win = win
        # the rules are read beside the window, which stays usable meanwhile
        self.set_child(Adw.StatusPage(title="Reading the rules…", child=Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER)))
        path = win.doc.path

        def work():
            rc, out, err = run_cli(win.cli, ["access", path, "--porcelain"])
            orc, oout, _oerr = run_cli(win.cli, ["onion", path, "--porcelain"])
            GLib.idle_add(lambda: self.build(rc, out, err, (orc, oout)) and False)
        threading.Thread(target=work, daemon=True).start()

    def build(self, rc, out, err, onion):
        try:
            data = json.loads(out) if rc == 0 else {}
        except ValueError:
            data = {}
        self.who, self.machines = data.get("who") or [], [m for m in data.get("machines") or [] if not m["master"]]
        page = Adw.PreferencesPage()
        intro = Adw.PreferencesGroup(description=(
            "A device on the VPN belongs to a group: you choose it when you add the device. A linked network is another "
            "Kiwi network. Switch on what each may open. A machine: all of it. A service: only that page.")
            if data else "The rules could not be read: %s" % ((err.strip().splitlines() or ["no answer"])[-1]))
        intro.set_header_suffix(help_button("The master lets through what is given here and drops the rest; a machine that "
                                            "is reached for single services refuses the others itself. The master is always "
                                            "reachable: it answers the names. Apply the machines after a change.",
                                            DOCS + "docs/network.md"))
        page.add(intro)
        self.rows = {}
        for w in self.who:
            group = w["kind"] in ("group", "lan")       # a group of the home network is given things as a VPN group
            g = Adw.PreferencesGroup(title=w["name"], description="%s · %s%s. Now: %s." % (
                {"group": "group", "lan": "group of the home network"}.get(w["kind"], "linked network"), w["range"],
                (" · " + ", ".join(w["devices"])) if w["devices"] else "", w["says"]))
            r = {"all": None, "machines": {}, "flags": {}}
            r["apps"] = None
            if group:
                r["all"] = Adw.SwitchRow(title="Everything on the VPN", active=w["open"]["all"])
                g.add(r["all"])
                r["apps"] = Adw.SwitchRow(title="Every app", active=w["open"].get("apps", False),
                                          subtitle="The pages of every machine: no admin pages, nothing else of the machines")
                g.add(r["apps"])
            for m in self.machines:
                o = w["open"]["machines"].get(m["name"]) or {"whole": False, "services": [], "ports": []}
                exp = Adw.ExpanderRow(title=m["name"], subtitle="all of it" if o["whole"] else
                                      (", ".join(o["services"] + [":" + x for x in o["ports"]]) or "nothing"))
                whole = Adw.SwitchRow(title="All of it", active=o["whole"])
                exp.add_row(whole)
                svc = {}
                for name in m["services"]:
                    svc[name] = Adw.SwitchRow(title=name, active=name in o["services"], subtitle=(
                        "an admin page: only with this, or with “The admin pages”" if name in m.get("admin", [])
                        else "only this page"))
                    exp.add_row(svc[name])
                r["machines"][m["name"]] = (whole, svc)
                g.add(exp)
            extra = ["%s:%s" % (n, x) for n, o in w["open"]["machines"].items() for x in o["ports"]] + w["open"]["other"]
            r["extra"] = Adw.EntryRow(title="Single ports, like lychee:22" + (", or a linked network by its name" if group else ""),
                                      text=" ".join(extra))
            g.add(r["extra"])
            if group:
                for key, title in (("peers", "Other devices on the VPN"), ("internet", "The Internet through the VPN"),
                                   ("admin", "The admin pages (control page, Portainer, Pi-hole, backups)")):
                    if w["kind"] == "lan" and key != "admin":       # the home's router decides those
                        continue
                    r["flags"][key] = Adw.SwitchRow(title=title, active=bool(w[key]))
                    g.add(r["flags"][key])
            self.rows[w["name"]] = r
            page.add(g)
        # hidden services: a site for anyone with Tor Browser, or for named people (kiwi-server onion)
        rc, out = onion
        try:
            self.hidden = {"%s.%s" % (x["service"], x["host"]): x for x in json.loads(out)["services"]} if rc == 0 else {}
        except (ValueError, KeyError):
            self.hidden = {}
        self.onion = {}
        tor = Adw.PreferencesGroup(title="Hidden services", description=(
            "An address that anyone opens with Tor Browser, without your VPN: for people you do not know. No names: "
            "anyone with the address gets in. With names, only who holds a key finds it: Show key gives what a person types "
            "into Tor Browser. Tor never leaves through a home connection: it leaves at the master."))
        for m in [x for x in (data.get("machines") or []) if x["services"]]:
            exp = Adw.ExpanderRow(title=m["name"], subtitle=", ".join(
                sv for sv in m["services"] if "%s.%s" % (sv, m["name"]) in self.hidden) or "none")
            # the sites their modules mark as usable over Tor, and what is a hidden service already
            usable = set(m.get("tor") if m.get("tor") is not None else m["services"])
            usable |= {k[:-len(m["name"]) - 1] for k in self.hidden if k.endswith("." + m["name"])}
            for sv in sorted(usable):
                what = "%s.%s" % (sv, m["name"])
                has = self.hidden.get(what)
                on = Adw.SwitchRow(title=sv, subtitle=("http://" + has["address"]) if has else "not a hidden service",
                                   active=bool(has))
                who = Adw.EntryRow(title="%s: only these people (empty: anyone)" % sv, text=" ".join(has["clients"]) if has else "")
                if has:         # its next address: the old one stops with the machine's next apply
                    renew = Gtk.Button(label="New address", valign=Gtk.Align.CENTER, css_classes=["flat"])
                    renew.connect("clicked", lambda _b, w=what, row=on: self.new_address(w, row))
                    on.add_suffix(renew)
                exp.add_row(on)
                exp.add_row(who)
                for person in (has or {}).get("clients") or []:
                    kr = Adw.ActionRow(use_markup=False, title=person, subtitle="%s: may open it with a key" % sv)
                    show = Gtk.Button(label="Show key", valign=Gtk.Align.CENTER, css_classes=["flat"])
                    show.connect("clicked", lambda _b, w=what, p=person: self.show_key(w, p))
                    kr.add_suffix(show)
                    exp.add_row(kr)
                self.onion[what] = (on, who)
            tor.add(exp)
        if data and self.onion:
            page.add(tor)
        more = Adw.PreferencesGroup(title="A new group", description="It starts with nothing. A device joins it under "
                                                                      "“Add a phone or laptop…”.")
        self.new = Adw.EntryRow(title="Its name, like family")
        more.add(self.new)
        self.new_lan = Adw.EntryRow(title="At home: its subnet, like 192.168.20.0/24 (empty: a group of the VPN)")
        more.add(self.new_lan)
        if data:
            page.add(more)
        save = Gtk.Button(label="Save", css_classes=["suggested-action"], sensitive=bool(data))
        save.connect("clicked", lambda *_: self.save())
        head = Adw.HeaderBar()
        head.pack_end(save)
        tb = Adw.ToolbarView(content=page)
        tb.add_top_bar(head)
        self.set_child(tb)

    def wanted(self, w):
        """(reach, {flag: bool}) as the switches of one group or linked network stand."""
        r = self.rows[w["name"]]
        if r["all"] is not None and r["all"].get_active():
            reach = ["all"]
        else:
            reach = ["apps"] if r["apps"] is not None and r["apps"].get_active() else []
            for m in self.machines:
                whole, svc = r["machines"][m["name"]]
                if whole.get_active():
                    reach.append(m["name"])
                else:
                    reach += ["%s.%s" % (s, m["name"]) for s, row in svc.items() if row.get_active()]
            reach += [e for e in r["extra"].get_text().split() if e not in reach]
        return reach, {k: row.get_active() for k, row in r["flags"].items()}

    def show_key(self, what, person):
        """What one person types into Tor Browser for a hidden service (`onion … --show NAME`)."""
        path = self.win.doc.path

        def work():
            rc, out, err = run_cli(self.win.cli, ["onion", path, what, "--show", person])
            lines = [x.strip() for x in out.strip().splitlines() if x.strip()]

            def done():
                if rc != 0 or not lines:
                    self.win.alert("No key", ((err or out).strip().replace("error: ", "").splitlines() or ["?"])[-1])
                    return False
                key = lines[-1]
                dlg = Adw.AlertDialog(heading="%s's key for %s" % (person, what),
                                      body="Tor Browser asks for it when %s opens the address. Give it to %s only." % (person, person))
                dlg.set_extra_child(Gtk.Label(label=key, selectable=True, wrap=True, wrap_mode=Pango.WrapMode.CHAR,
                                              css_classes=["monospace"]))
                dlg.add_response("close", "Close")
                dlg.add_response("copy", "Copy")
                dlg.connect("response", lambda _d, r: r == "copy" and self.get_clipboard().set(key))
                dlg.present(self)
                return False
            GLib.idle_add(done)
        threading.Thread(target=work, daemon=True).start()

    def new_address(self, what, row):
        dlg = Adw.AlertDialog(heading="A new address for %s?" % what,
                              body="The old address stops answering with the machine's next apply, and whoever had it "
                                   "needs the new one. Its people and their keys stay.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("new", "New address")
        dlg.set_response_appearance("new", Adw.ResponseAppearance.DESTRUCTIVE)
        path = self.win.doc.path

        def answer(_d, r):
            if r != "new":
                return

            def work():
                rc, out, err = run_cli(self.win.cli, ["onion", path, what, "--new-address"])
                found = re.search(r"new address: (http://\S+?\.onion)", out + err)

                def done():
                    if rc != 0 or not found:
                        self.win.alert("No new address", ((err or out).strip().replace("error: ", "").splitlines() or ["?"])[-1])
                    else:
                        row.set_subtitle(found.group(1))
                        self.win.toast("%s: new address; apply %s for it to take effect" % (what, what.partition(".")[2]))
                    return False
                GLib.idle_add(done)
            threading.Thread(target=work, daemon=True).start()
        dlg.connect("response", answer)
        dlg.present(self)

    def save(self):
        calls = []
        new = self.new.get_text().strip().lower()
        lan = self.new_lan.get_text().strip()
        if new:
            calls.append([new, "--new"] + (["--lan", lan] if lan else []))
        for w in self.who:
            reach, flags = self.wanted(w)
            args = []
            if sorted(reach) != sorted(w["reach"]):
                args = [w["name"]] + (reach or ["nothing"])
            diff = [x for k, v in flags.items() if v != bool(w[k]) for x in ("--" + k, "yes" if v else "no")]
            if diff:
                args = (args or [w["name"], "--add"]) + diff
            if args:
                calls.append(args)
        tor = []                    # the same for the hidden services: `kiwi-server onion`
        for what, (on, who) in self.onion.items():
            has, names = self.hidden.get(what), who.get_text().lower().split()
            if not on.get_active():
                if has:
                    tor.append([what, "--remove"])
                continue
            if not has:
                tor.append([what])
            tor += [[what, "--client", n] for n in names if not has or n not in has["clients"]]
            tor += [[what, "--remove", "--client", n] for n in (has["clients"] if has else []) if n not in names]
        if not calls and not tor:
            self.close()
            return
        path, cli, steps = self.win.doc.path, self.win.cli, [("access", a) for a in calls] + [("onion", a) for a in tor]
        self.win.toast("Saving…")

        def work():
            for cmd, args in steps:
                rc, out, err = run_cli(cli, [cmd, path] + args)
                if rc != 0:
                    why = "%s: %s" % (args[0], (err.strip().splitlines() or ["not saved"])[-1].replace("error: ", ""))
                    GLib.idle_add(lambda: (self.win.toast(why), False)[1])
                    return
            GLib.idle_add(saved)

        def saved():
            self.close()
            self.win.open_path(path, sync=False)        # the fleet file changed under the app
            self.win.toast("Saved — apply the master, and the machines whose services are named")
            return False
        threading.Thread(target=work, daemon=True).start()


class SourcesDialog(Adw.Dialog):
    """Module sources (`kiwi-server sources`): modules besides the built-in ones, from a git repository,
    each held at one version. List, add by link, update, remove, as on the control page."""

    def __init__(self, win):
        super().__init__(title="Module sources", content_width=620, content_height=680)
        self.win = win
        self.load()

    def load(self, check=False, said="", bad=False):
        self.set_child(Adw.StatusPage(title="Looking at the module sources…", child=Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER)))
        path = self.win.doc.path

        def work():
            rc, out, err = run_cli(self.win.cli, ["sources", path, "list", "--porcelain"] + (["--check"] if check else []), timeout=180)
            try:
                got = json.loads(out)["sources"] if rc == 0 else None
            except (ValueError, KeyError):
                got = None
            GLib.idle_add(self.show, got, (err.strip().replace("error: ", "").splitlines() or ["no answer"])[-1], check, said, bad)
        threading.Thread(target=work, daemon=True).start()

    def run(self, args, what):
        """add, update, remove: the command, then the fleet file opened again and sent to the other computers."""
        if self.win.doc.dirty:
            self.win.toast("Save your changes first")
            return
        path = self.win.doc.path
        self.set_child(Adw.StatusPage(title=what, child=Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER)))

        def work():
            rc, out, err = run_cli(self.win.cli, ["sources", path] + args, timeout=600)
            text = "\n".join(line[3:] if line.startswith(":: ") else line.replace("error: ", "", 1)
                              for line in (out + err).strip().splitlines())

            def done():
                if rc == 0:
                    self.win.open_path(path, sync=False)
                    self.win.sync(False, True)
                    if args[0] != "remove" and " already" not in text:
                        text_ = text + "\nThe machines that use its modules take the change with their next apply."
                    else:
                        text_ = text
                    self.load(said=text_)
                else:
                    self.load(said=text, bad=True)
                return False
            GLib.idle_add(done)
        threading.Thread(target=work, daemon=True).start()

    def show(self, got, why, checked, said, bad):
        tb = Adw.ToolbarView()
        hb = Adw.HeaderBar()
        tb.add_top_bar(hb)
        page = Adw.PreferencesPage()
        if said:
            g = Adw.PreferencesGroup()
            g.add(Gtk.Label(label=said, wrap=True, xalign=0, css_classes=["error" if bad else "success"]))
            page.add(g)
        if got is None:
            tb.set_content(Adw.StatusPage(title="The module sources could not be read", description=why,
                                          icon_name="dialog-information-symbolic"))
            self.set_child(tb)
            return False
        g = Adw.PreferencesGroup(title="Module sources", description="Modules besides the built-in ones, from a git repository "
                                 "of your own or a community one. Each is held at one version: nothing of it changes until you update it.")
        if got:
            look = Gtk.Button(label="Look for new versions", css_classes=["flat"], valign=Gtk.Align.CENTER)
            look.connect("clicked", lambda *_: self.load(check=True))
            g.set_header_suffix(look)
        for x in got:
            version = x.get("tag") or ("commit " + x["commit"][:12] if x.get("commit") else "a folder on this computer")
            sub = "%s · %s" % (version, ("its modules: " + ", ".join(x["modules"])) if x.get("modules") else (x.get("error") or "no modules"))
            row = Adw.ActionRow(title=GLib.markup_escape_text(x["name"]), subtitle=GLib.markup_escape_text(sub))
            new = x.get("newest") or {}
            if new.get("error"):
                row.add_suffix(Gtk.Label(label="could not ask", css_classes=["dim-label"], tooltip_text=new["error"]))
            elif new.get("tag") and new.get("commit") != x.get("commit"):
                row.add_suffix(Gtk.Label(label="%s is out" % new["tag"], css_classes=["warning"]))
            elif checked and x.get("url"):
                row.add_suffix(Gtk.Label(label="the newest", css_classes=["dim-label"]))
            if x.get("url"):
                up = Gtk.Button(label="Update to %s" % new["tag"] if new.get("tag") and new.get("commit") != x.get("commit") else "Update",
                                valign=Gtk.Align.CENTER)
                if new.get("tag") and new.get("commit") != x.get("commit"):
                    up.add_css_class("suggested-action")
                up.connect("clicked", lambda _b, n=x["name"]: self.run(["update", n], "Updating %s…" % n))
                row.add_suffix(up)
            rm = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Remove", css_classes=["flat"])
            rm.connect("clicked", lambda _b, n=x["name"]: self.confirm_remove(n))
            row.add_suffix(rm)
            g.add(row)
        if not got:
            g.add(plain_row("None yet: only the built-in modules."))
        page.add(g)
        g = Adw.PreferencesGroup(title="Add a module source", description="Its modules' templates and scripts run as root on the "
                                 "machines that use them: add only sources you trust. Then a machine takes its modules in its "
                                 "settings, like the built-in ones.")
        url = Adw.EntryRow(title="Its link (https://…)")
        name = Adw.EntryRow(title="Its name here (empty: from the link)")
        ref = Adw.EntryRow(title="Version (empty: its newest version tag)")
        for r in (url, name, ref):
            g.add(r)
        add = Gtk.Button(label="Add it", css_classes=["suggested-action", "pill"], halign=Gtk.Align.START, margin_top=10)

        def go(*_):
            link, n, v = url.get_text().strip().rstrip("/"), name.get_text().strip(), ref.get_text().strip()
            if not link.startswith("https://") or link.startswith("-") or n.startswith("-") or v.startswith("-"):
                self.win.toast("The link is the https address of a git repository")
                return
            self.run(["add", link] + (["--name", n] if n else []) + (["--ref", v] if v else []), "Adding %s…" % link)
        add.connect("clicked", go)
        g.add(add)
        page.add(g)
        tb.set_content(page)
        self.set_child(tb)
        return False

    def confirm_remove(self, name):
        d = Adw.AlertDialog(heading="Remove %s?" % name, body="Its modules can then no longer be used. A machine that uses "
                            "them needs them taken off first.")
        d.add_response("cancel", "Cancel")
        d.add_response("remove", "Remove")
        d.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        d.connect("response", lambda _d, r: r == "remove" and self.run(["remove", name], "Removing %s…" % name))
        d.present(self)


