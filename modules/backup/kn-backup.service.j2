[Unit]
{% set targets = (([server] if server else []) + (servers or [])) | unique | list %}
Description=Backup of {{ hostname }} to {{ targets | join(', ') }}
Documentation=https://github.com/derlocke-ng/kiwi-server
{% if runtime == 'docker' %}
After=docker.service kiwi-stack.service network-online.target
Requires=docker.service
{% else %}
After=kiwi-stack.service network-online.target
{% endif %}
Wants=network-online.target
# No start limit: every apply restarts this unit, and a limit counted those too and kept the
# night's run from starting. Retries back off instead (RestartSteps, RestartMaxDelaySec).
StartLimitIntervalSec=0

[Service]
Type=oneshot
# for a server that is rebooting, say: an hour, then longer, at most every eight hours
Restart=on-failure
RestartSec=1h
RestartSteps=3
RestartMaxDelaySec=8h
ExecCondition=/usr/bin/bash {{ docker_dir }}/kiwi/backup.sh due
ExecStart=/usr/bin/bash {{ docker_dir }}/kiwi/backup.sh backup
ExecStopPost=/usr/bin/bash {{ docker_dir }}/kiwi/backup.sh thaw
Nice=10
IOSchedulingClass=idle
