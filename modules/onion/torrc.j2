# torrc for the hidden services of {{ hostname }} — generated by kiwi-server.
# No SOCKS port: this Tor only serves. Its keys are written by start.sh, from the fleet's seed.
{% set proxy = container_ips.get(module_config.get('reverse-proxy', {}).get('network_mode') or 'reverse-proxy') %}
SocksPort 0
DataDirectory /var/lib/tor
{% for name, k in keys.items() %}

# {{ name }}.{{ hostname }}{{ ': only ' ~ (k.clients | join(', ')) if k.clients else ': anyone with the address' }}
HiddenServiceDir /var/lib/tor/onion/{{ name }}
HiddenServicePort 80 {{ proxy }}:8043
{% if tls %}
HiddenServicePort 443 {{ proxy }}:8044
{% endif %}
{# Jabber's own port beside its page: apps connect to <address>.onion, port 5222. The service in
   the network of the machine's door to the VPN is the site jabber; a separate public instance is the site xmpp #}
{% set jabber = module_config.get('xmpp') %}
{% if jabber is not none and name == 'jabber' %}
HiddenServicePort 5222 {{ container_ips.get('vpn-server' if node_type == 'master' else 'vpn-client') }}:5222
{% elif jabber is not none and name == 'xmpp' and jabber.get('separate') %}
HiddenServicePort 5222 {{ container_ips.get('xmpp') }}:5222
{% endif %}
{% endfor %}
