; PrivateBin for {{ paste_host }}: generated by kiwi-server; the fleet file is the place to change it

[main]
name = "{{ title | replace('"', '') }}"
discussion = false
opendiscussion = false
password = true
fileupload = {{ 'true' if file_upload else 'false' }}
burnafterreadingselected = false
defaultformatter = "plaintext"
sizelimit = {{ size_mb * 1048576 }}
languageselection = false

[expire]
default = "{{ default_expire }}"

[expire_options]
5min = 300
10min = 600
1hour = 3600
1day = 86400
1week = 604800
1month = 2592000
1year = 31536000
never = 0

[formatter_options]
plaintext = "Plain Text"
syntaxhighlighting = "Source Code"
markdown = "Markdown"

[traffic]
; one paste in ten seconds from one address. The address is the visitor's, which the reverse
; proxy passes on, not the proxy's own
limit = 10
header = "X_FORWARDED_FOR"

[purge]
limit = 300
batchsize = 10

[model]
class = Filesystem

[model_options]
dir = PATH "data"
