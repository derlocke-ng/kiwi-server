# torrc for the hidden services of {{ hostname }} — generated by kiwi-server.
# No SOCKS port: this Tor only serves. Its keys are written by start.sh, from the fleet's seed.
{% set proxy = container_ips.get(module_config.get('reverse-proxy', {}).get('network_mode') or 'reverse-proxy') %}
SocksPort 0
DataDirectory /var/lib/tor
{% for name, k in keys.items() %}

# {{ name }}.{{ hostname }}{{ ': only ' ~ (k.clients | join(', ')) if k.clients else ': anyone with the address' }}
HiddenServiceDir /var/lib/tor/onion/{{ name }}
HiddenServicePort 80 {{ proxy }}:8043
{% endfor %}
