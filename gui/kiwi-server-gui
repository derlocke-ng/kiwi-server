        eb = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        b1 = Gtk.Button(label="Open…")
        b1.connect("clicked", lambda *_: self.open_dialog())
        b2 = Gtk.Button(label="New fleet…")
        b2.add_css_class("suggested-action")
        b2.connect("clicked", lambda *_: self.new_dialog())
        eb.append(b1)
        eb.append(b2)
        self.empty.set_child(eb)
        self.editor_holder.append(self.empty)
        content_tb = Adw.ToolbarView(content=self.content_box)
        self.content_hb = Adw.HeaderBar(show_title=True)
        self.content_title = Adw.WindowTitle(title="")
        self.content_hb.set_title_widget(self.content_title)
        self.b_host_render = Gtk.Button(label="Render host")
        self.b_host_render.connect("clicked", lambda *_: self.render(self.current_scope))
        self.b_host_build = Gtk.Button(label="Build ISO")
        self.b_host_build.add_css_class("suggested-action")
        self.b_host_build.connect("clicked", lambda *_: self.confirm_build(self.current_scope))
        self.b_host_script = Gtk.Button(icon_name="text-x-script-symbolic", tooltip_text="Show the role script")
        self.b_host_script.connect("clicked", lambda *_: self.show_script())
        self.b_host_folder = Gtk.Button(icon_name="folder-symbolic", tooltip_text="Open the output folder")
