# paste (PrivateBin): one container, its pastes in a volume it owns
services:
  {{ container_prefix }}-paste:
    image: {{ image }}
    container_name: {{ container_prefix }}-paste
    environment:
      - TZ={{ timezone }}
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    restart: unless-stopped
    # its page answers
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - privatebin_data:/srv/data
      - {{ docker_dir }}/{{ container_prefix }}-paste/conf.php:/srv/cfg/conf.php:ro,z
