# onion — this machine's hidden services. Tor shares the VPN client's network: what it sends
# leaves at the master, or at a commercial VPN on a machine off the mesh, never through this
# machine's own connection.
services:
  {{ container_prefix }}-onion:
    image: {{ image }}
    container_name: {{ container_prefix }}-onion
{% if has_vpn_client %}
    network_mode: "service:{{ container_prefix }}-vpn-client"
    depends_on:
      - {{ container_prefix }}-vpn-client
{% elif (node_type == 'master' and not at_home) or without_vpn %}
    # a master at a hoster without a VPN exit: from its address there; a machine whose owner chose
    # Tor without a VPN (without_vpn): from its own connection, which its provider can see. A master
    # at home without either gets no network, as a node does: that connection is the home line
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
{% else %}
    # no VPN client on this machine: Tor gets no network at all rather than the home connection
    network_mode: none
{% endif %}
    restart: unless-stopped
    entrypoint: /bin/sh
    command: ["/etc/tor/start.sh"]
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-onion/etc:/etc/tor:z
      - {{ docker_dir }}/{{ container_prefix }}-onion/var:/var/lib/tor:z
