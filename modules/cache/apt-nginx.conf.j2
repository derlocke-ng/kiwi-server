# The package proxy of {{ hostname }} — generated by kiwi-server. apt on the LAN's Debian
# machines sends its plain-HTTP requests here (Acquire::http::Proxy-Auto-Detect); packages
# are signed, so what is kept needs no TLS. Only Debian's own servers are proxied.
worker_processes 1;
events { worker_connections 256; }
http {
    resolver 9.9.9.9 149.112.112.112 valid=300s ipv6=off;
    proxy_cache_path /var/cache/nginx/apt levels=1:2 keys_zone=apt:20m max_size={{ apt_size }} inactive=180d use_temp_path=off;
    map $host $apt_known {
        default 0;
        deb.debian.org 1;
        security.debian.org 1;
        ftp.debian.org 1;
        "~^ftp\.[a-z]{2}\.debian\.org$" 1;
        archive.debian.org 1;
    }
    access_log /dev/stdout;
    server {
        listen 3142;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_cache apt;
        proxy_cache_key $host$uri;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating;
        add_header X-Cache $upstream_cache_status;
        # what changes with every release of the archive: asked again after a few minutes
        location ~ /(InRelease|Release|Release\.gpg)$ {
            if ($apt_known = 0) { return 403; }
            proxy_cache_valid 200 5m;
            proxy_pass http://$host$uri$is_args$args;
        }
        # packages and index files by hash never change
        location / {
            if ($apt_known = 0) { return 403; }
            proxy_cache_valid 200 206 180d;
            proxy_cache_valid 404 1m;
            proxy_pass http://$host$uri$is_args$args;
        }
    }
}
