# dns (Pi-hole) — resolver for the mesh (master) or the LAN (gateway node)
{#
  Upstreams, in strict order: a node asks the master's Pi-hole first, so the whole
  network shares one blocklist and leaves through the master's exit; the master asks
  the VPN client's DNS-over-TLS resolver. The fallback is reached directly and only
  answers while the master is unreachable (the tunnel is down in the same moment).
  Names under the fleet's domain go to the master and never leave it.
#}
{% set chain = [] %}
{% if upstream_dns %}
{% set _ = chain.append(upstream_dns) %}
{% else %}
{% if node_type != 'master' and master_ip %}
{% set _ = chain.append(master_ip) %}
{% elif vpn_client_ip %}
{% set _ = chain.append(vpn_client_ip) %}
{% endif %}
{% if fallback_dns %}
{% set _ = chain.append(fallback_dns) %}
{% endif %}
{% endif %}
{% if not chain %}
{% set _ = chain.append('9.9.9.9;149.112.112.112') %}
{% endif %}
{% set upstreams = chain | join(';') %}
{% set lines = ['strict-order'] %}
{% if domain %}
{% if node_type != 'master' and master_ip %}
{% set _ = lines.append('server=/' ~ domain ~ '/' ~ master_ip) %}
{% else %}
{% set _ = lines.append('local=/' ~ domain ~ '/') %}
{% endif %}
{% endif %}
{% if mullvad_socks %}
{# the Mullvad SOCKS5 records, refreshed by the host timer; reloaded on every change #}
{% set _ = lines.append('hostsdir=/etc/mullvad-socks') %}
{% endif %}
{% set hosts = [] %}
{% if fleet_records %}{% for ip, name in dns_records %}{% set _ = hosts.append(ip ~ ' ' ~ name) %}{% endfor %}{% endif %}
{% for name, ip in extra_records.items() %}{% set _ = hosts.append(ip ~ ' ' ~ name) %}{% endfor %}
services:
  {{ container_prefix }}-pihole:
    image: {{ image }}
    container_name: {{ container_prefix }}-pihole
{% if not network_mode %}
    hostname: pihole
{% endif %}
    environment:
      - TZ={{ timezone }}
      - FTLCONF_webserver_api_password={{ pihole_password }}
      - FTLCONF_dns_upstreams={{ upstreams }}
      - FTLCONF_misc_dnsmasq_lines={{ lines | join(';') }}
      - FTLCONF_dns_listeningMode=all
      - FTLCONF_webserver_domain={{ pihole_hostname or 'pihole.' ~ hostname }}
{% if hosts %}
      # the fleet's names at their mesh addresses (pihole.toml dns.hosts)
      - FTLCONF_dns_hosts={{ hosts | join(';') }}
{% endif %}
{% if dhcp_enabled %}
      # Pi-hole is the LAN's DHCP server; the dhcp-relay module carries the broadcasts here
      - FTLCONF_dhcp_active=true
      - FTLCONF_dhcp_start={{ dhcp_start }}
      - FTLCONF_dhcp_end={{ dhcp_end }}
      - FTLCONF_dhcp_router={{ dhcp_router }}
      - FTLCONF_dhcp_leaseTime={{ dhcp_lease_time }}
{% endif %}
{% if legacy_env %}
      - WEBPASSWORD={{ pihole_password }}
      - PIHOLE_DNS_={{ upstreams }}
      - DNSMASQ_LISTENING=all
{% endif %}
{% for k, v in extra_env.items() %}
      - {{ k }}={{ v }}
{% endfor %}
{% if network_mode %}
    network_mode: "service:{{ container_prefix }}-{{ network_mode }}"
{% else %}
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    ports:
      - "53:53/tcp"
      - "53:53/udp"
{% if expose_web_ui %}
      - "{{ web_ui_bind ~ ':' if web_ui_bind else '' }}{{ web_ui_port }}:80/tcp"
{% endif %}
{% endif %}
    cap_add:
      - NET_ADMIN
      - SYS_TIME
      - SYS_NICE
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-pihole/etc-pihole:/etc/pihole:z
      - {{ docker_dir }}/{{ container_prefix }}-pihole/etc-dnsmasq.d:/etc/dnsmasq.d:z
{% if mullvad_socks %}
      # root's, written by the host timer: read-only in here
      - {{ docker_dir }}/{{ container_prefix }}-pihole/mullvad-socks:/etc/mullvad-socks:ro,z
{% endif %}
