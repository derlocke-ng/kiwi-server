#!/bin/sh
# The network's accounts on {{ hostname }} (Kanidm), for kiwi-server and its sign-up page:
#   accounts.sh create NAME [DISPLAY NAME]   a new account; prints the link that sets its password
#   accounts.sh reset NAME                   a new link for an account (a lost password)
#   accounts.sh list                         the accounts, one JSON object a line
#   accounts.sh delete NAME
#   accounts.sh jabber NAME on|off           whether Jabber takes this account (LDAP)
#   accounts.sh member GROUP NAME on|off     whether the account is in a group (made when missing), e.g. games;
#                                            admins: an admin in Forgejo, Nextcloud and Immich at the next sign-in
#   accounts.sh members GROUP                who is in it, as JSON
#   accounts.sh oauth CLIENT NAME ORIGIN CALLBACK [CALLBACK…] [--pkce] [--group GROUP]
#                                            a service that signs people in here (OpenID Connect); prints its secret.
#                                            --pkce: the service sends a PKCE challenge (else Kanidm wants none)
#                                            --group: only the group's members may sign in there (else everyone)
#   accounts.sh setup                        the rules for everyone, and the sign-up page's token (every apply)
# Each call takes the admin over afresh (its password is never kept: a new one each time) and
# runs Kanidm's own command line in a container that is gone afterwards.
set -eu
rt={{ runtime }}
url=https://{{ container_ip }}:8443
link=https://{{ id_host }}/ui/reset?token=
tools={{ tools_image }}
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT; chmod 700 "$work"
pw=$($rt exec {{ container_prefix }}-accounts kanidmd recover-account idm_admin -c /config/server.toml 2>&1 |
     grep -o 'new_password[^,}]*' | sed 's/new_password[": ]*//; s/"//g' | tr -d ' \n')
[ -n "$pw" ] || { echo "accounts: Kanidm did not give its admin over (is it running?)" >&2; exit 1; }
k() { $rt run --rm --network host -e KANIDM_URL=$url -e KANIDM_SKIP_HOSTNAME_VERIFICATION=true -e KANIDM_ACCEPT_INVALID_CERTS=true \
          -e KANIDM_NAME=idm_admin -e RUST_LOG=error ${KANIDM_PASSWORD:+-e KANIDM_PASSWORD} -v "$work:/root:z" "$tools" kanidm "$@" </dev/null; }
# the network's admins (the group `admins`) are told to each service in its own words: kiwi_roles
# [admin] (Forgejo's admin group, Nextcloud's group admin), immich_role admin (Immich's role). Only
# the group's members get the claims; everyone else gets none of them
admins_claims() {
    k group get admins 2>&1 | grep -q "name: admins" || k group create admins >/dev/null 2>&1
    k system oauth2 update-claim-map "$1" kiwi_roles admins admin >/dev/null 2>&1 || true
    k system oauth2 update-claim-map-join "$1" kiwi_roles array >/dev/null 2>&1 || true
    k system oauth2 update-claim-map "$1" immich_role admins admin >/dev/null 2>&1 || true
    k system oauth2 update-claim-map-join "$1" immich_role ssv >/dev/null 2>&1 || true
}
KANIDM_PASSWORD=$pw; export KANIDM_PASSWORD
k login >/dev/null 2>&1 || { echo "accounts: the admin could not log in to Kanidm" >&2; exit 1; }
unset KANIDM_PASSWORD
# the rules for everyone, set again when the settings change: what a person needs to sign in,
# how long a password is at least, and (Jabber) that LDAP takes the same password as the pages
policy="{{ 'mfa' if second_factor else 'any' }} {{ password_min_length }} {{ 'jabber' if ldap else '' }} look2 admins1 {{ brand or 'Kiwi' }}"
mark={{ docker_dir }}/{{ container_prefix }}-accounts/data/.kiwi-policy
if [ "$policy" != "$(cat "$mark" 2>/dev/null)" ]; then
    k group account-policy enable idm_all_persons >/dev/null 2>&1 || true
    k group account-policy credential-type-minimum idm_all_persons {{ 'mfa' if second_factor else 'any' }} >/dev/null 2>&1
    k group account-policy password-minimum-length idm_all_persons {{ password_min_length }} >/dev/null 2>&1
{% if ldap %}
    if ! k group get jabber 2>&1 | grep -q "name: jabber"; then
        k group create jabber >/dev/null 2>&1; k group posix set jabber >/dev/null 2>&1
    fi
    k group account-policy enable jabber >/dev/null 2>&1 || true
    k group account-policy allow-primary-cred-fallback jabber true >/dev/null 2>&1
{% endif %}
    # the clients made before the network had admins: their claims too
    for c in $(k system oauth2 list 2>/dev/null | sed -n 's/^name: *//p'); do admins_claims "$c"; done
    # Kanidm's own pages look like the network's: its name, and the kiwi as their logo. The domain
    # is Kanidm's `admin`'s to change, not idm_admin's: taken over the same way, for these two only
    apw=$($rt exec {{ container_prefix }}-accounts kanidmd recover-account admin -c /config/server.toml 2>&1 |
          grep -o 'new_password[^,}]*' | sed 's/new_password[": ]*//; s/"//g' | tr -d ' \n')
    ka() { $rt run --rm --network host -e KANIDM_URL=$url -e KANIDM_SKIP_HOSTNAME_VERIFICATION=true -e KANIDM_ACCEPT_INVALID_CERTS=true \
               -e KANIDM_NAME=admin -e RUST_LOG=error ${KANIDM_PASSWORD:+-e KANIDM_PASSWORD} -v "$work:/root:z" "$tools" kanidm "$@" </dev/null; }
    if [ -n "$apw" ]; then KANIDM_PASSWORD=$apw; export KANIDM_PASSWORD; ka login >/dev/null 2>&1 || true; unset KANIDM_PASSWORD; fi
    ka system domain set-displayname "{{ brand or 'Kiwi' }}" >/dev/null 2>&1 || true
    cat > "$work/kiwi.svg" <<'SVG'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" fill="#7b5a3c"/><circle cx="12" cy="12" r="9.3" fill="#8dc63f"/><circle cx="12" cy="12" r="3.3" fill="#f4f1d6"/><circle cx="17.7" cy="12.0" r=".75" fill="#1f2a1a"/><circle cx="16.6" cy="15.4" r=".75" fill="#1f2a1a"/><circle cx="13.8" cy="17.4" r=".75" fill="#1f2a1a"/><circle cx="10.2" cy="17.4" r=".75" fill="#1f2a1a"/><circle cx="7.4" cy="15.4" r=".75" fill="#1f2a1a"/><circle cx="6.3" cy="12.0" r=".75" fill="#1f2a1a"/><circle cx="7.4" cy="8.6" r=".75" fill="#1f2a1a"/><circle cx="10.2" cy="6.6" r=".75" fill="#1f2a1a"/><circle cx="13.8" cy="6.6" r=".75" fill="#1f2a1a"/><circle cx="16.6" cy="8.6" r=".75" fill="#1f2a1a"/></svg>
SVG
    ka system domain set-image /root/kiwi.svg svg >/dev/null 2>&1 || true
    printf '%s' "$policy" > "$mark"
fi
token() {   # the link's token, out of what Kanidm prints
    k person credential create-reset-token "$1" --ttl "${2:-86400}" 2>/dev/null | grep -o 'token=[A-Za-z0-9_-]*' | head -1 | cut -d= -f2
}
name_ok() { echo "$1" | grep -Eq '^[a-z][a-z0-9_-]{1,31}$' || { echo "accounts: a name is 2-32 lowercase letters, digits, - and _" >&2; exit 2; }; }
case "${1:-}" in
    create)
        name_ok "$2"
        k person create "$2" "${3:-$2}" >/dev/null 2>&1 || { echo "accounts: $2 exists already" >&2; exit 3; }
        # an address nobody reads: apps like Forgejo want one, and the network sends no mail
        k person update "$2" --mail "$2@{{ id_host }}" >/dev/null 2>&1 || true
        t=$(token "$2"); printf '{"name": "%s", "link": "%s%s"}\n' "$2" "$link" "$t" ;;
    reset)
        name_ok "$2"; t=$(token "$2")
        [ -n "$t" ] || { echo "accounts: no account $2" >&2; exit 3; }
        printf '{"name": "%s", "link": "%s%s"}\n' "$2" "$link" "$t" ;;
    list)       # a JSON list of the accounts as Kanidm says them
        k person list -o json 2>/dev/null | grep '^\[' || echo "[]" ;;
    delete)
        name_ok "$2"
        k person delete "$2" 2>&1 | grep -q "deleted" || { echo "accounts: no account $2" >&2; exit 3; }
        printf '{"name": "%s", "deleted": true}\n' "$2" ;;
    jabber)
        name_ok "$2"
        if ! k group get jabber 2>&1 | grep -q "^name: jabber\|name: jabber"; then
            k group create jabber >/dev/null 2>&1; k group posix set jabber >/dev/null 2>&1
        fi
        if [ "${3:-on}" = on ]; then k person posix set "$2" >/dev/null 2>&1; k group add-members jabber "$2" >/dev/null 2>&1
        else k group remove-members jabber "$2" >/dev/null 2>&1; fi
        k group get jabber 2>/dev/null | grep -q "member: $2@" && on=on || on=off
        printf '{"name": "%s", "jabber": "%s"}\n' "$2" "$on" ;;
    member)
        name_ok "$2"; name_ok "$3"
        k group get "$2" 2>&1 | grep -q "name: $2" || k group create "$2" >/dev/null 2>&1
        if [ "${4:-on}" = on ]; then k group add-members "$2" "$3" >/dev/null 2>&1
        else k group remove-members "$2" "$3" >/dev/null 2>&1; fi
        k group get "$2" 2>/dev/null | grep -q "member: $3@" && on=on || on=off
        printf '{"name": "%s", "group": "%s", "member": "%s"}\n' "$3" "$2" "$on" ;;
    members)
        name_ok "$2"
        printf '{"group": "%s", "members": [%s]}\n' "$2" "$(k group list-members "$2" 2>/dev/null |
            sed -n 's/^\([a-z][a-z0-9_-]*\)@.*/"\1"/p' | paste -sd, -)" ;;
    oauth)
        name_ok "$2"
        c=$2; shift 2                           # now: DISPLAY ORIGIN CALLBACK…
        if ! k system oauth2 get "$c" 2>&1 | grep -q "^name: $c"; then
            k system oauth2 create "$c" "$1" "$2" >"$work/out" 2>&1 ||
                { echo "accounts: Kanidm did not make the client $c: $(tail -1 "$work/out")" >&2; exit 1; }
        fi
        shift 2
        pkce=off group=""
        for cb in "$@"; do                      # (not $url: that is Kanidm's own address)
            if [ "$cb" = --pkce ]; then pkce=on
            elif [ "$cb" = --group ]; then group=next
            elif [ "$group" = next ]; then name_ok "$cb"; group=$cb
            else k system oauth2 add-redirect-url "$c" "$cb" >/dev/null 2>&1 || true; fi
        done
        if [ -n "$group" ]; then
            # only the group's members: Kanidm turns everyone else away at its own page
            k group get "$group" 2>&1 | grep -q "name: $group" || k group create "$group" >/dev/null 2>&1
            k system oauth2 delete-scope-map "$c" idm_all_persons >/dev/null 2>&1 || true
            k system oauth2 update-scope-map "$c" "$group" openid email profile groups >/dev/null 2>&1
        else
            k system oauth2 update-scope-map "$c" idm_all_persons openid email profile groups >/dev/null 2>&1
        fi
        k system oauth2 prefer-short-username "$c" >/dev/null 2>&1 || true
        admins_claims "$c"
        # Forgejo, Paperless and Vaultwarden send no PKCE challenge; they sign in with their secret (a
        # confidential client), which is enough. A service that sends one (Immich) keeps Kanidm's check.
        [ "$pkce" = on ] || k system oauth2 warning-insecure-client-disable-pkce "$c" >/dev/null 2>&1 || true
        s=$(k system oauth2 show-basic-secret "$c" 2>/dev/null | grep -v '^\s*$' | tail -1 | tr -d ' \n')
        [ -n "$s" ] || { echo "accounts: Kanidm gave no secret for $c" >&2; exit 1; }
        printf '{"client": "%s", "secret": "%s", "issuer": "https://{{ id_host }}/oauth2/openid/%s"}\n' "$c" "$s" "$c" ;;
    setup)
        # the sign-up page's own service account: it may make people and their links, nothing else
        tok={{ docker_dir }}/{{ container_prefix }}-accounts/signup/token
        if [ ! -s "$tok" ]; then
            k service-account get kiwi-signup 2>&1 | grep -q "name: kiwi-signup" ||
                k service-account create kiwi-signup "Sign-up page" idm_admins >/dev/null 2>&1
            k group add-members idm_people_admins kiwi-signup >/dev/null 2>&1
            new=$(k service-account api-token generate kiwi-signup "sign-up page" --readwrite 2>/dev/null | grep -o 'ey[A-Za-z0-9._-]*' | head -1)
            [ -n "$new" ] || { echo "accounts: Kanidm gave the sign-up page no token" >&2; exit 1; }
            mkdir -p "${tok%/*}"; umask 077; printf '%s' "$new" > "$tok"
            $rt restart {{ container_prefix }}-signup >/dev/null 2>&1 || true
        fi
        echo '{"setup": "done"}' ;;
    *)
        sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
