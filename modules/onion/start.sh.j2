#!/bin/sh
# The hidden services of {{ hostname }} — generated by kiwi-server. Writes each service's key
# (the same from every render: it derives from the fleet's seed) and who may find it, then
# starts Tor as its own user.
set -eu
umask 077
D=/var/lib/tor/onion
mkdir -p "$D"
# a service that is no longer one leaves with its key
for old in "$D"/*; do
    [ -d "$old" ] || continue
    case " {% for name in keys %}{{ name }} {% endfor %}" in *" $(basename "$old") "*) ;; *) rm -rf "$old" ;; esac
done
{% for name, k in keys.items() %}
mkdir -p "$D/{{ name }}/authorized_clients"
printf '%s' '{{ k.secret }}' | base64 -d > "$D/{{ name }}/hs_ed25519_secret_key"
printf '%s' '{{ k.public }}' | base64 -d > "$D/{{ name }}/hs_ed25519_public_key"
printf '%s\n' '{{ k.address }}' > "$D/{{ name }}/hostname"
rm -f "$D/{{ name }}"/authorized_clients/*.auth
{% for client, key in (k.clients or {}).items() %}
printf '%s\n' 'descriptor:x25519:{{ key }}' > "$D/{{ name }}/authorized_clients/{{ client }}.auth"
{% endfor %}
{% endfor %}
chown -R tor:tor /var/lib/tor
su-exec tor tor -f /etc/tor/torrc &
tor=$!
trap 'kill "$tor" 2>/dev/null; wait "$tor"; exit 0' TERM INT
# The self-check: Tor can stop being found at its addresses while it runs on (17 Nov 2026: two
# of three hidden services answered nothing for hours, after the tunnel under it had changed; a
# start anew brought them back). Every ten minutes each address open to anyone is asked through
# Tor itself (the first two minutes after a start); three rounds in a row with one that answers
# nothing, and Tor ends: the container starts anew.
# What it found is written down for the status pages (kiwi-check: name, address, answer, when).
ADDRESSES="{% for name, k in keys.items() if not k.clients %}{{ name }}={{ k.address }} {% endfor %}"
CHECK=/var/lib/tor/kiwi-check
(
    [ -n "${ADDRESSES% }" ] || exit 0
    sleep 120           # the first look soon after a start: a new address takes a minute to be found
    misses=0
    while kill -0 "$tor" 2>/dev/null; do
        gone=""
        : > "$CHECK.new"
        for na in $ADDRESSES; do
            a=${na#*=}
            code=$(su-exec tor curl -s -o /dev/null -m 120 -w '%{http_code}' \
                   -x "socks5h://localhost/var/lib/tor/self-check.sock" "http://$a/" 2>/dev/null)
            [ "${code:-000}" = 000 ] && gone="$gone $a"
            printf '%s %s %s %s\n' "${na%%=*}" "$a" "${code:-000}" "$(date +%s)" >> "$CHECK.new"
        done
        mv -f "$CHECK.new" "$CHECK"
        if [ -n "$gone" ]; then misses=$((misses + 1)); else misses=0; fi
        if [ "$misses" -ge 3 ]; then
            echo "kiwi: not found through Tor three times in a row:$gone; Tor starts anew"
            kill "$tor"
            exit 0
        fi
        sleep 600
    done
) &
wait "$tor"
exit 1          # Tor ended by itself or by the self-check: the container starts anew
