#!/usr/bin/bash
# {{ hostname }}'s data to {{ server }} with restic, which runs in a container. What is kept is
# what each module declares in the backup: block of its module.yaml.
#   kiwi-stack backup [--new]       one run now (kn-backup.timer does it at {{ at }}); --new: a
#                                   rebuilt machine starts a history of its own instead of restoring
#   kiwi-stack snapshots            what is stored
#   kiwi-stack restore MODULE...    put the newest back; those modules stop around it
set -uo pipefail

DIR={{ docker_dir }}/kiwi/backup
HOST={{ hostname }}
IMAGE={{ image }}

MODULES=({{ backup_sources | map(attribute='name') | join(' ') }})
declare -A FREEZE FROZEN BULK EXCLUDE SERVICES NO_RESTORE
{% for s in backup_sources %}
FREEZE[{{ s.name }}]="{{ s.freeze | join(' ') }}"
FROZEN[{{ s.name }}]="{{ s.frozen | join(' ') }}"
BULK[{{ s.name }}]="{{ s.bulk | join(' ') }}"
EXCLUDE[{{ s.name }}]="{{ s.exclude | join(' ') }}"
SERVICES[{{ s.name }}]="{{ s.services | join(' ') }}"
NO_RESTORE[{{ s.name }}]="{{ s.no_restore }}"
{% endfor %}

# A server that hangs instead of refusing keeps restic waiting for as long as it hangs. LIMIT
# bounds that: a database frozen meanwhile is down, and a run that never ends blocks the next.
# A first upload that needs longer than BULK_LIMIT goes on from where it was at the next run.
FREEZE_LIMIT=10m
ASK_LIMIT=3m
BULK_LIMIT=20h

restic() { # MOUNT... -- ARGUMENT...
    local mounts=()
    while [[ $1 != -- ]]; do mounts+=(-v "$1"); shift; done
    shift
    ${LIMIT:+timeout -k 60 "$LIMIT"} {{ runtime }} run --rm --network host --security-opt label=disable --env-file "$DIR/restic.env" \
        -v {{ docker_dir }}/kiwi/ca:/kiwi-ca:ro -v kiwi_restic_cache:/cache "${mounts[@]}" \
        "$IMAGE" --cacert /kiwi-ca/kiwiCA.crt --cache-dir /cache "$@"
}

excludes() { # MODULE: sets the array EXCLUDES
    local list e
    EXCLUDES=()
    read -ra list <<<"${EXCLUDE[$1]}"
    for e in "${list[@]}"; do EXCLUDES+=(--exclude "$e"); done
}

store() { # MODULE KIND MOUNTS
    local module=$1 kind=$2 m list mounts=() paths=()
    read -ra list <<<"$3"
    for m in "${list[@]}"; do
        if [[ ${m:0:1} == / && ! -e ${m%%:*} ]]; then
            echo "backup: ${m%%:*} is missing, left out" >&2
            continue
        fi
        mounts+=("$m:ro")
        paths+=("${m##*:}")
    done
    [[ -n ${paths[*]:-} ]] || return 0
    excludes "$module"
    restic "${mounts[@]}" -- backup --host "$HOST" --tag "$module,$kind" "${EXCLUDES[@]}" "${paths[@]}"
    local rc=$?
    # 3: stored, without a file or two that went away while the machine was running
    (( rc == 3 )) || return "$rc"
    echo "backup: $module: some files could not be read, the rest is stored" >&2
}

# A database must not change while restic reads it. Frozen, its files are what a power cut
# would leave, which is what it recovers from at its next start. It stays frozen for its own
# files only; the big ones are read with everything running.
FROZEN_NOW=()
thaw() {
    local c
    for c in "${FROZEN_NOW[@]}"; do
        {{ runtime }} unpause "$c" >/dev/null || echo "backup: $c could not be unpaused" >&2
    done
    FROZEN_NOW=()
}
trap thaw EXIT
trap 'exit 143' TERM INT

# A run killed outright thaws nothing, and a paused container looks like a running one:
# kn-backup.service does this after every run.
thaw_left() {
    local m c list
    for m in "${MODULES[@]}"; do
        read -ra list <<<"${FREEZE[$m]}"
        for c in "${list[@]}"; do
            [[ $({{ runtime }} inspect --format '{% raw %}{{.State.Status}}{% endraw %}' "$c" 2>/dev/null) == paused ]] || continue
            echo "backup: $c was left frozen" >&2
            {{ runtime }} unpause "$c" >/dev/null || echo "backup: $c could not be unpaused" >&2
        done
    done
}

backup() {
    local m c list ok frozen_failed=0 failed=()
    LIMIT=$ASK_LIMIT restic -- --no-lock cat config >/dev/null 2>&1 || LIMIT=$ASK_LIMIT restic -- init || return 1
    # a restic killed half way leaves its lock, and one from a prune stops every backup after
    # it. This removes only those: a lock in use is refreshed and is never old enough.
    LIMIT=$ASK_LIMIT restic -- unlock >/dev/null 2>&1 || true
    for m in "${MODULES[@]}"; do
        # the server gone, each module would sit frozen through restic's retries in its turn
        if [[ -n ${failed[*]:-} ]] && ! LIMIT=$ASK_LIMIT restic -- --no-lock cat config >/dev/null 2>&1; then
            echo "backup: {{ server }} no longer answers, stopping here" >&2
            failed+=("$m and those after it")
            break
        fi
        ok=1
        read -ra list <<<"${FREEZE[$m]}"
        for c in "${list[@]}"; do
            # not running: its files are not changing either
            if {{ runtime }} pause "$c" >/dev/null 2>&1; then FROZEN_NOW+=("$c"); fi
        done
        LIMIT=$FREEZE_LIMIT store "$m" frozen "${FROZEN[$m]}" || { ok=0; frozen_failed=1; }
        thaw
        LIMIT=$BULK_LIMIT store "$m" bulk "${BULK[$m]}" || ok=0
        (( ok )) || failed+=("$m")
        # A repository that could not take this database (a full disk still answers) will not
        # take the next one either, and each would sit frozen until its limit in its turn.
        if (( frozen_failed )); then
            echo "backup: {{ server }} took nothing from a frozen $m, stopping here" >&2
            failed+=("those after it")
            break
        fi
    done
    if [[ -n ${failed[*]:-} ]]; then
        echo "backup: failed: ${failed[*]}" >&2
        return 1
    fi
    date -u +%FT%TZ > "$DIR/last-success"
    echo "backup: ${MODULES[*]} stored at {{ server }}"
}

put_back() { # MODULE KIND MOUNTS
    local module=$1 kind=$2 m list mounts=()
    read -ra list <<<"$3"
    [[ -n ${list[*]:-} ]] || return 0
    for m in "${list[@]}"; do
        [[ ${m:0:1} != / ]] || mkdir -p "${m%%:*}"
        mounts+=("${m%%:*}:/restore${m##*:}")
    done
    excludes "$module"
    # --delete empties the target of what the snapshot does not hold: it must hold nothing but these
    restic "${mounts[@]}" -- restore latest --host "$HOST" --tag "$module,$kind" --target /restore --delete "${EXCLUDES[@]}"
}

service() { # stop|start SERVICE...
    local verb=$1 s
    shift
    for s; do
{% if runtime == 'podman' %}
        systemctl "$verb" "$s.service"
{% else %}
        docker "$verb" "$s" >/dev/null
{% endif %}
    done
}

restore() { # MODULE...
    local m list rc=0
    (( $# )) || { echo "usage: kiwi-stack restore MODULE...   (${MODULES[*]})" >&2; return 1; }
    for m; do
        [[ -v "BULK[$m]" ]] || { echo "backup: no module $m here (${MODULES[*]})" >&2; return 1; }
        [[ -z ${NO_RESTORE[$m]} ]] || { echo "backup: $m is not restored from here: ${NO_RESTORE[$m]}" >&2; return 1; }
    done
    for m; do
        read -ra list <<<"${SERVICES[$m]}"
        service stop "${list[@]}"
        put_back "$m" frozen "${FROZEN[$m]}" || { echo "backup: $m: its frozen part did not come back" >&2; rc=1; }
        put_back "$m" bulk "${BULK[$m]}" || { echo "backup: $m: its files did not come back" >&2; rc=1; }
        service start "${list[@]}"
    done
    # a container in another's network namespace stops with it and nothing else brings it back
    /usr/local/bin/kiwi-stack start >/dev/null 2>&1 || rc=1
    if (( rc == 0 )); then
        rm -f "$DIR/held"
        touch "$DIR/restored"       # what it backs up from now on continues what was restored
    fi
    return "$rc"
}

# a re-apply and a stack start restart host units: this keeps that from being a backup
# A rebuilt machine finds snapshots of itself that it never made. Backed up now, its fresh and
# empty state would be the newest snapshot, the one `restore` takes, and the next prune keeps
# only that one of the day. So it waits: for a restore, or for `kiwi-stack backup --new`.
held() { # true while this machine must not back up; says why on stderr
    [[ -f $DIR/last-success || -f $DIR/restored || -f $DIR/new-history ]] && return 1
    if [[ -f $DIR/held ]]; then cat "$DIR/held" >&2; return 0; fi
    # no repository yet, or no server: a new machine, or a run that fails on its own anyway
    LIMIT=$ASK_LIMIT restic -- --no-lock cat config >/dev/null 2>&1 || return 1
    local list
    if ! list=$(LIMIT=$ASK_LIMIT restic -- --no-lock snapshots --host "$HOST" --json 2>/dev/null); then
        echo "backup: {{ server }} did not say what it holds of $HOST: trying again at the next run" >&2
        return 0
    fi
    [[ $list == *'"short_id"'* ]] || return 1
    echo "backup: {{ server }} holds snapshots of $HOST and this machine made none of them: rebuilt? Restore first (kiwi-stack restore MODULE...), or start a new history (kiwi-stack backup --new)" | tee "$DIR/held" >&2
    return 0
}

due() {
    if [[ -f $DIR/last-success ]] && (( $(date +%s) - $(stat -c %Y "$DIR/last-success") <= 20 * 3600 )); then
        return 1
    fi
    ! held
}

exec 9>"$DIR/lock"
case "${1:-}" in
    due)        due ;;
    thaw)       flock -w 120 9 || exit 0; thaw_left ;;
    backup)     flock -n 9 || { echo "backup: one is running already" >&2; exit 1; }
                if [[ ${2:-} == --new ]]; then rm -f "$DIR/held"; touch "$DIR/new-history"; fi
                held && exit 1
                backup ;;
    snapshots)  restic -- snapshots --host "$HOST" ;;
    restore)    shift; flock -n 9 || { echo "backup: one is running already" >&2; exit 1; }; restore "$@" ;;
    *)          echo "usage: kiwi-stack backup|snapshots|restore MODULE..." >&2; exit 1 ;;
esac
