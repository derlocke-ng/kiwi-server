# Shared network definition — rendered once per host and merged into the compose file.
networks:
  {{ network_name }}:
    name: {{ network_name }}
    driver: bridge
    driver_opts:
      com.docker.network.enable_ipv6: "false"
      com.docker.network.bridge.name: {{ network_name }}
      com.docker.network.driver.mtu: "{{ mtu }}"
    ipam:
      driver: default
      config:
        - subnet: {{ docker_subnet }}
          gateway: {{ docker_gateway }}
{% if has_cloud %}
  # Nextcloud AIO attaches its containers to this network; the reverse proxy
  # joins it to reach nextcloud-aio-apache. Declared here (not external) so
  # the first `compose up` can create it.
  nextcloud-aio:
    name: nextcloud-aio
{% endif %}
