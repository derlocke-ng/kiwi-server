    def hidden_services(self):
        """The network's hidden services, "service.machine" -> address and who may open it
        (`kiwi-server onion --porcelain`). Asked once per network, beside the window: the page
        that wanted them is drawn again when they are there."""
        path = self.doc.path
        if path and getattr(self, "hidden_for", None) != path:
            self.hidden_for, self.hidden = path, {}

            def work():
                rc, out, _err = run_cli(self.cli, ["onion", path, "--porcelain"])
                try:
                    found = {"%s.%s" % (x["service"], x["host"]): x for x in json.loads(out)["services"]} if rc == 0 else {}
                except (ValueError, KeyError, TypeError):
                    found = {}
                GLib.idle_add(got, found)

            def got(found):
                if self.doc.path == path and found:
                    self.hidden = found
                    self.render_current()
                return False
            threading.Thread(target=work, daemon=True).start()
        return getattr(self, "hidden", {})

