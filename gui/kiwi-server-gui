    def rotate_dialog(self):
        """What a lost computer knew is replaced: the keys that open the machines, here; the
        control page's password, there."""
        if not self.doc.path:
            return
        control = self.control_host()
        dlg = Adw.AlertDialog(heading="A computer was lost or stolen")
        body = ("A computer that managed this network knows its keys. Replace them, one after the other.\n\n"
                "The keys: every machine gets a new key to open it, and the old one stops working when the last "
                "machine has changed. Nothing restarts.\n\n"
                "The secrets: the passwords your services use among themselves change, and each machine is updated. "
                "Some services restart for a moment. Database and admin passwords stay as they are for now.\n\n"
                "A machine that is off waits until you do this again.")
        if control:
            name = (self.status.get(control) or {}).get("hostname") or control
            body += ("\n\nFirst remove that computer on the control page (Computers), and change the page's "
                     "password there.")
            dlg.add_response("page", "Open the control page")
        pending = self.rotation_pending()
        rings = self.rings_named()
        if rings:
            body += ("\n\nThe keys that open the disks at boot (%s): each ring makes new ones, every disk it opens is "
                     "bound to them again, and the old keys go when the last machine has changed." % ", ".join(rings))
        for kind, label in (("ssh", "keys"), ("seed", "secrets"), ("ring", "disk keys")):
            if pending[kind]:
                body += "\n\nUnder way: %s still on the old %s. Switch them on, then press again; or leave out one " \
                        "that is gone or will be installed anew." % (", ".join(pending[kind]), label)
                for n in pending[kind]:
                    dlg.add_response("waive:%s:%s" % (kind, n), "Leave %s out of the %s" % (n, label))
        dlg.set_body(body)
        dlg.add_response("close", "Not now")
        dlg.add_response("seed", "Replace the secrets")
        if rings:
            dlg.add_response("ring", "Replace the disk keys")
        dlg.add_response("go", "Replace the keys")
        dlg.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)

        def answer(_d, r):
            if r == "page":
                Gtk.UriLauncher.new("https://control.%s/controllers" % name).launch(self, None, None)
            elif r.startswith("waive:"):
                _w, kind, host = r.split(":", 2)
                self.confirm_waive(kind, host)
            elif r in ("go", "seed"):
                self._after_spawn = lambda: self.sync(False, True)      # the other computers get the result
                self.spawn(["rotate", self.doc.path, "ssh" if r == "go" else "seed"],
                           "Replacing the keys…" if r == "go" else "Replacing the secrets…")
            elif r == "ring":
                self._after_spawn = lambda: self.sync(False, True)
                self.spawn(["rotate", self.doc.path, "ring", "all"], "Replacing the disk keys…")
        dlg.connect("response", answer)
        dlg.present(self)

    def rotation_pending(self):
        """The machines still on the old keys (ssh) or the old secrets (seed), as the control page
        shows them: from secrets/rotation.json."""
        try:
            with open(os.path.join(self.doc.dir, "secrets", "rotation.json")) as fh:
                state = json.load(fh)
        except (OSError, ValueError):
            return {"ssh": [], "seed": [], "ring": []}
        out = {k: [] if (state.get(k) or {}).get("done") is None else
               [n for n in self.doc.hosts() if n not in state[k]["done"]] for k in ("ssh", "seed")}
        out["ring"] = sorted({n for x in (state.get("rings") or {}).values() if x for n in x.get("pending") or []})
        return out

    def rings_named(self):
        """The unlock rings the machines name (unlock.rings)."""
        return sorted({str(r) for n in self.doc.hosts() for r in (self.doc.get(n, ("unlock", "rings")) or [])} - {"operator"})

    def confirm_waive(self, kind, host):
        """A machine left out of a replacement under way: gone for good, or about to be installed anew."""
        body = {"ssh": "Its old key stops working when the others are done. Only for a machine that is gone or will be "
                       "installed anew.",
                "ring": "It opens with the old disk keys until they go, then only with its key at the console."}.get(
                    kind, "It takes the new secrets at its next update.")
        dlg = Adw.AlertDialog(heading="Leave %s out?" % host, body=body)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("leave", "Leave it out")
        dlg.set_response_appearance("leave", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")

        def answer(_d, r):
            if r == "leave":
                self._after_spawn = lambda: self.sync(False, True)
                self.spawn(["rotate", self.doc.path, kind] + (["all"] if kind == "ring" else []) + ["--waive", host],
                           "Leaving %s out…" % host)
        dlg.connect("response", answer)
        dlg.present(self)

    def joined(self):
        """Does this fleet belong to a control node (it joined one, or pushed to one)?"""
        d = os.path.join(os.path.dirname(self.doc.path or ""), "control")
        return bool(self.doc.path) and (os.path.isfile(os.path.join(d, "remote")) or os.path.isfile(os.path.join(d, "folder")))

    def sync(self, say=False, after_save=False, pull_only=False, then=None):
        """Keep in step with the control node, in the background: fetch what is newer there
        (on opening), send what was saved here. Changes on both sides become one copy by
        themselves; only when both changed the same thing a person is asked which counts.
        `then`: called when it is done, whatever came of it."""
        if not self.joined():
            if say:
                self.toast("This network is not shared yet: Use another computer… in the menu")
            if then:
                then()
            return
        path, generation, dirty = self.doc.path, self.generation, self.doc.dirty

        def stamp():
            try:
                return os.stat(path).st_mtime_ns
            except OSError:
                return 0

        def work():
            steps = ["push"] if after_save else (["pull"] if dirty or pull_only else ["pull", "push"])
            rc, text, was = 0, "", stamp()
            for step in steps:
                rc, out, err = run_cli(self.cli, ["control", step, path], timeout=180)
                text = (err or out).strip().replace("error: ", "").replace(":: ", "")
                if rc != 0:
                    break
            if rc == 0 and stamp() != was:      # the file is another now: a pull, or a push that merged
                GLib.idle_add(came)
            GLib.idle_add(done, rc, text)
            # a computer asking to join is shown also when the sync failed: it may be what is needed
            if os.path.isfile(os.path.join(os.path.dirname(path), "control", "folder")):
                rc2, out2, _e = run_cli(self.cli, ["control", "requests", path, "--porcelain"], timeout=60)
                try:
                    asking = json.loads(out2)["requests"] if rc2 == 0 else []
                except (ValueError, KeyError):
                    asking = []
                for r in asking:
                    GLib.idle_add(self.join_request, path, r)

        def came():
            if generation == self.generation and not self.doc.dirty:
                self.open_path(path, sync=False)      # what came is what is shown
            return False

        def done(rc, text):
            if generation != self.generation and rc == 0:
                return False
            if rc != 0 and "changed on both sides" in text:
                self.both_changed(path, text)
            elif rc != 0:
                self.toast("Not in step with the other computers: %s" % (text.splitlines() or ["?"])[-1][:140], "warn",
                           "Your changes stay on this computer and go to the others with the next sync (menu: Sync now). "
                           "Menu, Compare with the other copy… shows what differs and who changed it.")
            elif say:
                self.toast("In step")
            if then:
                then()
            return False
        threading.Thread(target=work, daemon=True).start()

    def follow_there(self):
        """The control node says something changed (a look, a job, an apply there): fetch what it
        holds and what it remembers (cheap when the fleet is the same), then ask again. Without
        the fetch, a machine the control node had just applied stayed "Changes not applied yet"
        here until the next sync (21 Nov 2026)."""
        if self.doc.dirty or self.busy or self.following:
            self.poll_soon()
            return False
        self.following = True

        def then():
            self.following = False
            self.poll_soon()
        self.sync(pull_only=True, then=then)
        return False

    def both_changed(self, path, text):
        """This computer and another changed the same thing: a person says which counts."""
        what = text.split("last sync:", 1)[-1].split(". Which", 1)[0].strip()
        what = what.replace("fleet.yaml", "the settings").replace("secrets/", "")
        dlg = Adw.AlertDialog(heading="Changed in two places",
                              body="This computer and another one both changed %s since they last agreed. "
                                   "Which side counts for that? Everything else of both sides is kept." % what)
        dlg.add_response("later", "Decide later")
        dlg.add_response("show", "Show the differences")
        dlg.add_response("theirs", "The other one's")
        dlg.add_response("mine", "This computer's")
        dlg.set_default_response("show")

        def answer(_d, r):
            if r == "show":
                DiffDialog(self, both=True).present(self)
                return
            if r not in ("mine", "theirs"):
                return
            self.toast("Making one copy of the two…")

            def done(rc, out, err):
                if rc != 0:
                    self.toast("Not in step: %s" % ((err or out).strip().splitlines() or ["?"])[-1][:160])
                else:
                    self.open_path(path, sync=False)
                    self.toast("In step: one copy of the two", "ok")
            run_cli_then(self.cli, ["control", "push", path, "--keep", "here" if r == "mine" else "there"], done, timeout=180)
        dlg.connect("response", answer)
        dlg.present(self)

    def join_request(self, path, r):
        """A computer asks, through the synced folder, to manage this network: the owner answers."""
        if path != self.doc.path or r["name"] in getattr(self, "_asked", set()):
            return False
        self._asked = getattr(self, "_asked", set()) | {r["name"]}
        dlg = Adw.AlertDialog(
            heading="%s wants to join" % r["name"],
            body="The computer “%s” asks to manage this network, through your synced folder. Accept only if you "
                 "set that computer up yourself just now: it will be able to open every key of the network."
                 % r["host"])
        dlg.add_response("deny", "Deny")
        dlg.add_response("later", "Not now")
        dlg.add_response("accept", "Accept")
        dlg.set_response_appearance("accept", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_response_appearance("deny", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("later")

        def answer(_d, what):
            self._asked.discard(r["name"])
            if what not in ("accept", "deny"):
                return

            def work():
                rc, out, err = run_cli(self.cli, ["control", what, path, r["name"]], timeout=180)
                text = (err or out).replace("error: ", "").replace(":: ", "").strip().splitlines()
                GLib.idle_add(self.toast, (text or ["Done"])[-1][:160])
            threading.Thread(target=work, daemon=True).start()
        dlg.connect("response", answer)
        dlg.present(self)
        return False

    def open_path(self, path, sync=True):
        try:
            self.doc = FleetDoc(path)
        except Exception as e:  # noqa: BLE001
            self.alert("Cannot open %s" % os.path.basename(path), str(e))
            return
        path = os.path.abspath(path)
        self.generation += 1
        self.polling = False
        self.status, self.fleet_info, self.live, self.last_seen, self.store = {}, {}, {}, {}, {}
        self.checked = None
        self.current_scope = None
        recent = [path] + [p for p in load_recent() if p != path]
        save_recent(recent)
        self.rebuild_recent(recent)
        self.title.set_subtitle(tilde(path))
        self.rebuild_sidebar(FLEET)
        self.mark_dirty()
        self.set_actions_sensitive()
        if (self.doc.data or {}).get("module_sources"):     # their modules belong in the settings too
            self.load_schema()
        self.poll()
        if sync:
            self.sync()

    def new_dialog(self):
        """A new network: straight to the questions. It goes into ~/kiwi (or ~/kiwi-2, … when
        that holds one already); nobody is asked for a file name before they know what it is."""
        if not self.confirm_discard(self.new_dialog):
            return
        folder, n = os.path.expanduser("~/kiwi"), 2
        while os.path.exists(folder) and os.listdir(folder):
            folder, n = os.path.expanduser("~/kiwi-%d" % n), n + 1
        rc, out, err = run_cli(self.cli, ["init", "--questions"])
        if rc != 0:
            self.alert("The questions could not be loaded", err or out)
            return
        os.makedirs(folder, mode=0o700, exist_ok=True)
        SetupWizard(self, os.path.join(folder, "fleet.yaml"), json.loads(out)).present(self)

    def ask_domain(self, then):
        dlg = Adw.AlertDialog(
            heading="The fleet's domain",
            body="Hosts are named <name>.<domain>, services <service>.<name>.<domain>: sh3.home, cloud.sh3.home.\n\n"
                 ".home can never become a public top-level domain; .internal, .corp and .mail are the other "
                 "safe choices. Not .local (that is mDNS) and not a public one like .dev or .kiwi, which anyone "
                 "can register names under.")
        entry = Gtk.Entry(text="home", placeholder_text="home")
        dlg.set_extra_child(entry)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("create", "Create")
        dlg.set_response_appearance("create", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("create")
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "create" and then(entry.get_text().strip() or "home"))
        dlg.present(self)

    def create_fleet(self, path, domain):
        if os.path.exists(path):
            os.unlink(path)
        rc, out, err = run_cli(self.cli, ["init", path, "--domain", domain])
        if rc != 0:
            self.alert("Could not create the fleet", err or out)
            return
        if err.strip():
            self.append_log(err)
        self.open_path(path)
        self.toast("Example fleet written — edit the hosts and their secrets")

    def save(self):
        if not self.doc.path:
            return False
        try:
            self.doc.save()
        except OSError as e:
            self.alert("Save failed", str(e))
            return False
        self.mark_dirty()
        self.poll()
        self.toast("Saved %s" % os.path.basename(self.doc.path))
        self.keep_passwords()
        self.sync(after_save=True)
        return True

    def keep_passwords(self):
        """A password typed into a module's settings goes into the secret store, not the fleet file
        on this disk (`secrets keep`, the same value); the settings then show it as kept there."""
        path = self.doc.path
        try:
            with open(path, encoding="utf-8") as fh:
                text = fh.read()
        except OSError:
            return
        if not re.search(r"(?m)^\s+\w*(password|secret|token|_key)\w*:\s*\S", text):
            return

        def work():
            rc, out, _err = run_cli(self.cli, ["secrets", "keep", path])
            moved = [x.split(":")[0] + ": " + x.split(": ", 1)[1].split(" is in", 1)[0]
                     for x in out.splitlines() if " is in the secret store now" in x]

            def done():
                if rc != 0 or not moved or self.doc.path != path or self.doc.dirty:
                    return False
                self.doc = FleetDoc(path)
                if self.current_scope is not None:
                    self.show_scope(self.current_scope)
                self.toast("In the secret store now, out of the fleet file: %s" % ", ".join(moved))
                return False
            GLib.idle_add(done)
        threading.Thread(target=work, daemon=True).start()

    def mark_dirty(self):
        self.title.set_title("Kiwi Server" + (" •" if self.doc.dirty else ""))
        self.b_save.set_visible(bool(self.doc.path) and self.doc.dirty)
        self.update_rows()

    def confirm_discard(self, then):
        if not self.doc.dirty:
            return True
        dlg = Adw.AlertDialog(heading="Unsaved changes", body="Save the fleet file first?")
        dlg.add_response("discard", "Discard")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("save", "Save")
        dlg.set_response_appearance("discard", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("save")
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r == "save" and not self.save():
                return
            if r in ("save", "discard"):
                self.doc.dirty = False
                then()
        dlg.connect("response", resp)
        dlg.present(self)
        return False

    def on_close(self, *_):
        if self.busy:
            self.toast("A build is running — wait for it to finish")
            return True
        if self.doc.dirty:
            self.confirm_discard(lambda: (self.stop_watch(), self.destroy()))
            return True
        self.stop_watch()
        return False

    # ---- what is known about a host ----
    def value_of(self, name, key, default):
        return self.doc.get(name, (key,)) or self.doc.get("defaults", (key,)) or default

    def group_of(self, name):
        role = self.value_of(name, "role", "bare")
        return dict(ROLE_GROUPS).get(role, role.capitalize())

    def locked(self):
        return bool(self.store.get("store")) and not self.store.get("open")

    def phase_of(self, name):
        st = self.status.get(name) or {}
        return st.get("phase") or ("invalid" if st.get("errors") else "")

    def is_new(self, name):
        """Not installed yet: never applied from this fleet folder and not answering. What
        comes next is a step, not a problem."""
        live = self.live.get(name)
        st = self.status.get(name) or {}
        never = not (live and live["ok"]) and not self.last_seen.get(name) and not st.get("applied")
        # a machine that never ran and whose settings are incomplete is a step too, not an alarm
        return never and self.phase_of(name) in NEW_PHASES + ("invalid",)

    def state_of(self, name):
        if self.is_new(name):
            return "new"
        if self.phase_of(name) == "invalid":
            return "bad"
        live = self.live.get(name)
        return live["state"] if live else "unknown"

    def problems_of(self, name):
        st = self.status.get(name) or {}
        if self.is_new(name):
            return []           # what it needs is in Getting started
        found = [("bad", e) for e in st.get("errors") or []] if self.phase_of(name) == "invalid" else []
        live = self.live.get(name)
        if not live:
            return found
        return found + [(p["level"], p["text"]) for p in live["problems"]]

    def next_of(self, name):
        return (self.status.get(name) or {}).get("next") or ""

    def machine_line(self, name):
        if self.locked():
            return "secret store locked"
        live = self.live.get(name)
        if self.is_new(name):
            return "not installed yet"
        if not live:
            return "checking…" if self.polling else "no answer yet"
        if not live["ok"] and live.get("state") == "asleep":     # in its sleep window (asleep): as it should
            return (live.get("notes") or ["asleep"])[0]
        if not live["ok"]:
            seen = self.last_seen.get(name)
            return "unreachable" + (", seen %s ago" % duration(time.time() - seen) if seen else "")
        f = live["facts"]
        bits = ["up %s" % duration(f["uptime"])]
        if f["expected"]:
            bits.append("%d/%d running" % (f["running"], f["expected"]))
        return " · ".join(bits)

    def numbers(self):
        hosts = [h for h in self.doc.hosts() if not self.is_new(h)]
        answers = [self.live[h] for h in hosts if h in self.live]
        good = [a for a in answers if a["ok"]]
        return {"hosts": len(hosts), "answers": len(answers), "online": len(good),
                "running": sum(a["facts"]["running"] for a in good),
                "expected": sum(a["facts"]["expected"] for a in good),
                "attention": [(h, level, text) for h in hosts for level, text in self.problems_of(h)],
                "backup": self.oldest_backup(hosts)}

    def oldest_backup(self, hosts):
        """(words, what they say, colour) for the tile: the machine whose last backup is oldest. None: nothing saves."""
        saved = [(a["facts"]["backup"].get("age"), h) for h in hosts
                 for a in [self.live.get(h)] if a and a["ok"] and a["facts"].get("backup")]
        if not saved:
            return None
        never = [h for age, h in saved if age is None]
        if never:
            return ("never", "%s was not saved yet" % never[0], "bad")
        age, who = max(saved)
        return (" ".join(duration(age).split(" ")[:2]), "oldest backup: %s" % who,
                "bad" if age > 3 * 86400 else "warn" if age > 36 * 3600 else None)

    def picture(self):
        """The picture of the network, or None while there is no master with a machine beside it."""
        rows = []
        for h in self.doc.hosts():
            role = self.value_of(h, "role", "bare")
            if role == "bare":
                continue
            mods = (self.status.get(h) or {}).get("modules") or []
            rows.append((h, self.state_of(h), bool((self.live.get(h) or {}).get("ok")), ", ".join(tags(mods)[:2]) or role, role))
        standby_of = {h: (self.status.get(h) or {}).get("standby_of") or "" for h, *_r in rows}
        masters = [r for r in rows if r[4] == "master" and not standby_of[r[0]]]
        rest = [r for r in rows if r[4] != "master"]
        if not masters or not rest or kiwi_picture is None:
            return None
        folder = os.path.join(self.doc.dir, "secrets", "devices")
        n = len([f for f in os.listdir(folder) if f.endswith(".conf")]) if os.path.isdir(folder) and not self.locked() else 0
        cap = "master" + (" · %d %s on its VPN" % (n, "device" if n == 1 else "devices") if n else "")
        master = masters[0]
        machine = lambda r: {"name": r[0], "state": r[1], "up": r[2], "cap": r[3],                          # noqa: E731
                             "site": (self.status.get(r[0]) or {}).get("site") or "home"}
        # a standby is no host of its own in the fleet file (its master's standby: block): `list` names it
        standbys = [{"name": h, "state": self.state_of(h), "cap": "standby: takes over when %s is gone" % master[0]}
                    for h, st in sorted(self.status.items()) if st.get("standby_of") == master[0]]
        said = ((self.live.get(master[0]) or {}).get("facts") or {}).get("opened") or {}    # what each opens to us
        masters_of = ((self.live.get(master[0]) or {}).get("facts") or {}).get("partner_masters") or {}
        linked = [{"name": x["name"], "state": "", "reach": list(x.get("reach") or []), "theirs": said.get(x["name"]),
                   "cap": "linked network · %s%s%s" % (masters_of.get(x["name"]) or x.get("mesh") or "",
                                                       " · its way out" if x.get("exit") else "",
                                                       " · opens nothing to you" if said.get(x["name"]) == [] else "")}
                  for x in (self.fleet_info or {}).get("linked") or []]
        return NetworkPicture(self, {"name": master[0], "state": master[1], "cap": cap},
                              [machine(r) for r in masters[1:] + rest], standbys, linked)

    def fleet_line(self):
        n = self.numbers()
        if not n["hosts"]:
            fresh = [h for h in self.doc.hosts() if self.is_new(h)]
            return "%d to install" % len(fresh) if fresh else "no hosts yet"
        if self.locked():
            return "secret store locked"
        if not n["answers"]:
            return "checking…" if self.polling else "%d hosts" % n["hosts"]
        line = "%d of %d online" % (n["online"], n["hosts"])
        return line + (" · %d to look at" % len(n["attention"]) if n["attention"] else " · all good")

    # ---- sidebar ----
    def section_header(self, row, before):
        title = getattr(row, "group", None)
        if title and title != getattr(before, "group", None):
            row.set_header(Gtk.Label(label=title, xalign=0, css_classes=["ks-section"]))
        else:
            row.set_header(None)

    def rebuild_sidebar(self, select=None):
        want = select or self.current_scope
        while True:
            row = self.listbox.get_row_at_index(0)
            if row is None:
                break
            self.listbox.remove(row)
        order = {title: i for i, (_r, title) in enumerate(ROLE_GROUPS)}
        self.listbox.append(OverviewRow(self))
        for name in sorted(self.doc.hosts(), key=lambda h: order.get(self.group_of(h), len(order))):
            self.listbox.append(HostRow(self, name))
        self.listbox.append(DefaultsRow())
        self.select_scope(want)

    def rows(self):
        i = 0
        while True:
            row = self.listbox.get_row_at_index(i)
            if row is None:
                return
            yield row
            i += 1

    def select_scope(self, scope):
        for row in self.rows():
            if row.scope == scope:
                self.listbox.select_row(row)
                return
        self.listbox.select_row(self.listbox.get_row_at_index(0))

    def update_rows(self):
        """New facts into the rows as they stand; a host that changed role moves."""
        for row in self.rows():
            if isinstance(row, HostRow) and row.group != self.group_of(row.scope):
                self.rebuild_sidebar()
                return
            row.update()

    def on_select(self, _lb, row):
        if row is None:
            return
        if row.scope != self.current_scope:
            self.show_scope(row.scope)
        if self.split.get_collapsed():
            self.split.set_show_content(True)

    # ---- pages ----
    def show_scope(self, scope):
        self.current_scope = scope
        self.form_scope = None
        if scope is None or not self.doc.path:
            self.pages.set_visible_child_name("empty")
        elif scope == FLEET:
            self.render_fleet()
            self.pages.set_visible_child_name("fleet")
        elif scope == "defaults":
            self.defaults_bin.set_child(Form(self, self.doc, scope, self.roles, self.targets).page)
            self.pages.set_visible_child_name("defaults")
        else:
            self.pages.set_visible_child_name("host")
            self.on_host_tab()
        self.update_header()
        self.set_actions_sensitive()

    def is_host(self):
        return self.current_scope not in (None, FLEET, "defaults")

    def on_host_tab(self):
        if not self.is_host():
            return
        if self.host_stack.get_visible_child_name() == "settings":
            if self.form_scope != self.current_scope:     # built once per visit: a refresh must not eat what is being typed
                self.form_scope = self.current_scope
                self.form = Form(self, self.doc, self.current_scope, self.roles, self.targets)
                self.settings_bin.set_child(self.form.page)
            self.update_banner()
        else:
            self.render_host(self.current_scope)

    def update_banner(self):
        st = self.status.get(self.current_scope) or {}
        text = (st.get("errors") or st.get("warnings") or [None])[0]
        if text:
            self.banner.set_title(text)
        self.banner.set_revealed(bool(text))

    def set_compact(self, compact):
        self.compact = compact
        self.update_header()

    def update_header(self):
        scope, is_host = self.current_scope, self.is_host()
        self.b_apply.set_visible(is_host)
        self.b_more.set_visible(is_host)
        self.b_refresh.set_visible(bool(self.doc.path))
        self.switcher_bar.set_reveal(is_host and self.compact)
        self.content_hb.set_title_widget(self.switcher if is_host and not self.compact else self.content_title)
        if scope == FLEET:
            self.content_title.set_title("Overview")
            self.content_title.set_subtitle(self.checked_line())
        elif scope == "defaults":
            self.content_title.set_title("Defaults")
            self.content_title.set_subtitle("inherited by every host")
        elif is_host:
            self.content_title.set_title(scope)
            self.content_title.set_subtitle((self.status.get(scope) or {}).get("hostname") or "")
        else:
            self.content_title.set_title("")
            self.content_title.set_subtitle("")
        self.content_page.set_title(scope if is_host else "Overview")

    def checked_line(self):
        if self.polling and not self.checked:
            return "asking the machines…"
        return "checked %s" % time.strftime("%H:%M:%S", time.localtime(self.checked)) if self.checked else ""

    def render_current(self):
        self.update_header()
        if self.current_scope == FLEET:
            self.render_fleet()
        elif self.is_host():
            if self.host_stack.get_visible_child_name() == "settings":
                self.update_banner()
            else:
                self.render_host(self.current_scope)

    def guide_step(self, h):
        """(what to do, in a sentence; the button; what it does) for a machine that is not set up yet."""
        phase = self.phase_of(h)
        if phase == "enroll":
            return ("It needs its place on your VPN first. The master has to be running for that.", "Connect it",
                    lambda: self.spawn(["enroll", self.doc.path, h], "Connecting %s to the VPN…" % h))
        if phase == "build":
            return ("Make its install media: one file. From a USB stick with it, the machine installs itself.",
                    "Make install media", lambda: self.confirm_build(h))
        if phase == "install":
            on_done = self.doc.get(h, ("install", "on_done")) or self.doc.get("defaults", ("install", "on_done")) or "poweroff"
            how = ("wait until it has restarted by itself" if on_done == "reboot" else
                   "wait until it turns itself off. Take the install media out and switch it on again")
            return ("Start the machine from the install media and %s. Then press the button." % how,
                    "Set it up", lambda: self.confirm_apply(h))
        if phase == "bare":
            return ("It has no job yet. Choose what it should be in its settings.", "Open its settings",
                    lambda: self.select_scope(h))
        errors = (self.status.get(h) or {}).get("errors") or []
        why = errors[0].split(": ", 1)[-1] if errors else "something is missing or wrong"
        return ("Its settings are not complete yet: %s." % why.rstrip("."), "Open its settings",
                lambda: self.select_scope(h))

    def guide_group(self, fresh):
        """Getting started: one machine after the other, the master first; one sentence and one
        button each, the first one marked."""
        g = Adw.PreferencesGroup(title="Getting started",
                                 description="One machine after the other, the master first. Do the marked step; the "
                                             "list moves on by itself.")
        order = {title: i for i, (_r, title) in enumerate(ROLE_GROUPS)}
        for i, h in enumerate(sorted(fresh, key=lambda x: order.get(self.group_of(x), len(order)))):
            text, label, action = self.guide_step(h)
            row = Adw.ActionRow(use_markup=False, title="%d. %s" % (i + 1, h), subtitle=text, subtitle_lines=4)
            b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
            if i == 0:
                b.add_css_class("suggested-action")
            b.connect("clicked", lambda _b, a=action: a())
            row.add_suffix(b)
            g.add(row)
        return g

    def control_host(self):
