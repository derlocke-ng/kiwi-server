def meter(fraction, **kw):
    bar = Gtk.LevelBar(min_value=0, max_value=1, value=min(max(fraction, 0), 1), valign=Gtk.Align.CENTER, **kw)
    for name in ("low", "high", "full"):
        bar.remove_offset_value(name)
    bar.add_offset_value("ks-ok", .85)
    bar.add_offset_value("ks-warn", .95)
    bar.add_offset_value("ks-bad", 1)
    return bar


SHORT = 90       # longer text is cut in its row and whole behind an (i)


def shorten(text, n=SHORT):
    """The text up to its first sentence's end, or cut at a word, when it is longer than n."""
    if len(text) <= n:
        return text
    for end in (". ", "; ", ": "):
        i = text.find(end)
        if 20 < i < n:
            return text[:i + 1] + " …"
    return text[:n].rsplit(" ", 1)[0] + " …"


def plain_row(title, subtitle="", **kw):
    """A row for text from elsewhere (an error, a path): `<` and `&` are just characters. Text
    too long for a row is cut, the whole of it behind an (i)."""
    row = Adw.ActionRow(use_markup=False, **kw)
    row.set_title(shorten(title))
    row.set_subtitle(shorten(subtitle))
    if len(title) > SHORT or len(subtitle) > SHORT:
        row.add_suffix(info_button("\n\n".join(t for t in (title, subtitle) if t)))
    return row


def info_row(title, value, copy=False):
