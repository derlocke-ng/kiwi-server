class SetupWizard(Adw.Dialog):
    """A new fleet, step by step. The questions are `kiwi-server init --questions` and the
    answers go back to `kiwi-server init --answers`: the terminal and the app ask the same."""

    def __init__(self, win, path, data):
        super().__init__(title="A new network", content_width=660, content_height=700)
        self.win, self.path = win, path
        self.suggest = data.get("suggestions") or {}
        self.get, self.rows, self.machines = {}, {}, []
        self.steps = []
        for st in data["steps"]:            # a question with one possible answer is not a question
            asked = []
            for q in st["questions"]:
                opts = q.get("options") or []
                if q.get("type") == "choice" and len(opts) == 1:
                    self.get[q["id"]] = lambda v=opts[0]["value"]: v
                else:
                    asked.append(q)
            if asked:
                self.steps.append(dict(st, questions=asked))
        self.nav = Adw.NavigationView()
        self.pages = [self.step_page(i, st) for i, st in enumerate(self.steps)]
        self.nav.add(self.pages[0])
        self.set_child(self.nav)
        self.update_when()

    # ---- the pages ----
    def step_page(self, i, step):
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(title=step["step"], description=step.get("intro", ""))
        page.add(g)
        for q in step["questions"]:
            if q.get("type") == "machines":
                page.add(self.machines_group(q))
            else:
                g.add(self.row_for(q))
        last = i == len(self.steps) - 1
        go = Gtk.Button(label="Create my network" if last else "Next", css_classes=["suggested-action", "pill"],
                        halign=Gtk.Align.CENTER, margin_top=6, margin_bottom=12)
        go.connect("clicked", lambda *_: self.create() if last else self.nav.push(self.pages[i + 1]))
        tv = Adw.ToolbarView(content=page)
        tv.add_top_bar(Adw.HeaderBar())
        tv.add_bottom_bar(go)
        return Adw.NavigationPage(title="%d of %d · %s" % (i + 1, len(self.steps), step["step"]), child=tv)

    def row_for(self, q, into=None):
        """A row for one question; its value is read through self.get (or into, for a machine)."""
        kind, get = q.get("type", "string"), None
        if kind == "choice":
            opts = q["options"]
            # (the subtitle shows the choice only when the row is told how to read an item's text)
            row = Adw.ComboRow(title=q["label"], model=Gtk.StringList.new([o["label"] for o in opts]), use_subtitle=True,
                               expression=Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
            row.set_selected(next((n for n, o in enumerate(opts) if o["value"] == q.get("default")), 0))
            row.connect("notify::selected", lambda *_: self.update_when())
            get = lambda r=row, o=opts: o[r.get_selected()]["value"]
        elif kind == "bool":
            row = Adw.SwitchRow(title=q["label"], active=bool(q.get("default")))
            get = row.get_active
        else:
            row = (Adw.PasswordEntryRow if q.get("secret") else Adw.EntryRow)(title=q["label"])
            row.set_text(str(q.get("default") or ""))
            get = lambda r=row: r.get_text().strip()
        if q.get("help"):
            row.add_suffix(help_button(q["help"], DOCS + "README.md"))
        (into if into is not None else self.get)[q["id"]] = get
        if into is None:
            self.rows[q["id"]] = (row, q.get("when"))
        return row

    def machines_group(self, q):
        self.machine_q = q
        g = Adw.PreferencesGroup(title=q["label"], description="Add one with +, or none: they can come later.")
        add = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="Add a machine", css_classes=["flat"],
                         valign=Gtk.Align.CENTER)
        add.connect("clicked", lambda *_: self.add_machine(g))
        head = Gtk.Box(spacing=4, valign=Gtk.Align.CENTER)
        if q.get("help"):
            head.append(help_button(q["help"], DOCS + "README.md"))
        head.append(add)
        g.set_header_suffix(head)
        self.machine_group = g
        return g

    def add_machine(self, g):
        n = len(self.machines)
        taken = {m["name"]() for m in self.machines} | ({self.get["master_name"]()} if "master_name" in self.get else set())
        name = next((x for x in self.suggest.get("nodes", []) if x not in taken), "node%d" % (n + 1))
        addrs = self.suggest.get("addresses") or []
        exp = Adw.ExpanderRow(title=name, subtitle="a machine at home", expanded=True)
        fields = {}
        for f in self.machine_q.get("fields") or []:
            f = dict(f)
            if f.get("default_from") == "fruits":
                f["default"] = name
            elif f.get("default_from") == "suggest":
                f["default"] = addrs[n] if n < len(addrs) else ""
            row = self.row_for(f, into=fields)
            exp.add_row(row)
            fields["_row_" + f["id"]] = (row, f.get("when"))
        rm = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Remove it", css_classes=["flat"],
                        valign=Gtk.Align.CENTER)
        exp.add_suffix(rm)
        entry = {"exp": exp, "fields": fields, "name": fields["name"]}
        name_row = fields["_row_name"][0]
        name_row.connect("changed", lambda r: exp.set_title(r.get_text().strip() or "a machine"))
        rm.connect("clicked", lambda *_: (g.remove(exp), self.machines.remove(entry)))
        self.machines.append(entry)
        g.add(exp)
        self.update_when()

    def update_when(self):
        """Show a question only while its `when` holds (key == 'value')."""
        def holds(cond, values):
            if not cond:
                return True
            key, _sep, val = cond.partition(" == ")
            return key in values and str(values[key]()) == val.strip("'")
        for row, cond in self.rows.values():
            row.set_visible(holds(cond, self.get))
        for m in self.machines:
            for k, v in m["fields"].items():
                if k.startswith("_row_"):
                    v[0].set_visible(holds(v[1], {x: g for x, g in m["fields"].items() if not x.startswith("_row_")}))

    # ---- the end ----
    def answers(self):
        # (a question that was not asked, having one answer, has no row)
        a = {k: g() for k, g in self.get.items() if k not in self.rows or self.rows[k][0].get_visible()}
        a["nodes"] = [{k: g() for k, g in m["fields"].items() if not k.startswith("_row_") and m["fields"]["_row_" + k][0].get_visible()}
                      for m in self.machines]
        return a

    def create(self):
        a = self.answers()
        if not a.get("master_address"):
            self.win.alert("The hub's address is missing", "Go back to the step \"The hub\" and fill in its address on "
                           "the Internet: the one your hoster shows for the server, like 203.0.113.7.")
            return
        # the answers may hold a Mullvad key: they pass through memory, not the disk
        tmp = os.path.join(GLib.get_user_runtime_dir(), "kiwi-init-%d.json" % os.getpid())
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(a, f)
        spinner = Adw.StatusPage(title="Making your network", description="its keys and its settings")
        self.nav.push(Adw.NavigationPage(title="Making your network", child=spinner, can_pop=False))

        def work():
            try:
                rc, out, err = run_cli(self.win.cli, ["init", self.path, "--answers", tmp], timeout=300)
            finally:
                os.remove(tmp)
            GLib.idle_add(self.done, rc, out, err)
        threading.Thread(target=work, daemon=True).start()

    def done(self, rc, out, err):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        ok = rc == 0
        box.append(Gtk.Label(label="Your network is ready" if ok else "It was not made", xalign=0,
                             css_classes=["title-2"]))
        key = re.search(r"AGE-SECRET-KEY-1[0-9A-Z]+", out) if ok else None
        if key:
            box.append(Gtk.Label(label="Write this recovery key down now, on paper or in a password manager. It is "
                                       "shown only once. If this computer is lost, it is the only way back to your "
                                       "network's keys.", wrap=True, xalign=0, css_classes=["warning"]))
            shown = Gtk.Label(label=key.group(0), selectable=True, wrap=True, wrap_mode=2, xalign=0,
                              css_classes=["monospace", "card"], margin_top=4, margin_bottom=4)
            shown.set_margin_start(2)
            box.append(shown)
            copy = Gtk.Button(label="Copy the key", halign=Gtk.Align.START)
            copy.connect("clicked", lambda b: (Gdk.Display.get_default().get_clipboard().set(key.group(0)),
                                               b.set_label("Copied")))
            box.append(copy)
        if ok:
            box.append(Gtk.Label(label="Next, the app lists your machines, the hub first, with one step and one "
                                       "button each.", wrap=True, xalign=0))
        tv = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR, vexpand=True)
        text = (out + ("\n" + err if err.strip() else "")).strip()
        tv.get_buffer().set_text(text.replace(key.group(0), "(the key above)") if key else text)
        details = Gtk.Expander(label="Details" if ok else "What went wrong", expanded=not ok)
        details.set_child(Gtk.ScrolledWindow(child=tv, vexpand=True, min_content_height=220))
        box.append(details)
        b = Gtk.Button(label="Go to the first step" if ok else "Back", css_classes=["suggested-action", "pill"],
                       halign=Gtk.Align.CENTER)
        b.connect("clicked", lambda *_: (self.close(), ok and self.win.open_path(self.path)))
        box.append(b)
        self.nav.push(Adw.NavigationPage(title="Done" if ok else "Not made", child=box, can_pop=not ok))
        return False


def with_passphrase(cli, args, passphrase, timeout=600):
    """Run a command that takes --passphrase-file: the passphrase goes through a file in RAM
    that is gone afterwards. Returns (rc, output)."""
    tmp = os.path.join(GLib.get_user_runtime_dir(), "kiwi-pass-%d-%d" % (os.getpid(), threading.get_ident()))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(passphrase + "\n")
    try:
        rc, out, err = run_cli(cli, list(args) + ["--passphrase-file", tmp], timeout=timeout)
    finally:
        os.remove(tmp)
    return rc, (out + err)


class CopyDialog(Adw.Dialog):
    """Save a copy of the network (its settings and keys) as one encrypted file, or bring one back."""

    def __init__(self, win, restore=False):
        super().__init__(title="Restore a network from a copy" if restore else "Save a copy of the network",
                         content_width=520)
        self.win, self.restore, self.file = win, restore, None
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        box.append(Gtk.Label(label=(
            "Choose the copy (a file named fleet-….tar.enc) and type the passphrase it was saved with."
            if restore else
            "One encrypted file with the network's settings and keys: for a USB stick in a drawer, or to move to "
            "another computer. It is not a backup of your files and photos; the machines save those themselves."),
            wrap=True, xalign=0))
        g = Adw.PreferencesGroup()
        self.where = Adw.ActionRow(title="The copy" if restore else "Folder", subtitle="Choose…", activatable=True)
        self.where.add_suffix(Gtk.Image(icon_name="folder-open-symbolic"))
        self.where.connect("activated", lambda *_: self.choose())
        g.add(self.where)
        self.pw1 = Adw.PasswordEntryRow(title="Passphrase")
        self.pw1.connect("changed", lambda *_: self.check())
        g.add(self.pw1)
        self.pw2 = None
        if not restore:
            self.pw2 = Adw.PasswordEntryRow(title="The passphrase again")
            self.pw2.connect("changed", lambda *_: self.check())
            g.add(self.pw2)
        box.append(g)
        if not restore:
            box.append(Gtk.Label(label="Without the passphrase the copy cannot be opened by anyone, you included.",
                                 wrap=True, xalign=0, css_classes=["dim-label", "caption"]))
        self.note = Gtk.Label(wrap=True, xalign=0, visible=False, selectable=True)
        box.append(self.note)
        self.go = Gtk.Button(label="Restore it" if restore else "Save the copy", css_classes=["suggested-action", "pill"],
                             halign=Gtk.Align.CENTER, sensitive=False)
        self.go.connect("clicked", lambda *_: self.run())
        box.append(self.go)
        self.set_child(box)

    def choose(self):
        dlg = Gtk.FileDialog(title="The copy" if self.restore else "Where to save the copy")

        def chosen(d, res):
            try:
                f = d.open_finish(res) if self.restore else d.select_folder_finish(res)
            except GLib.Error:
                return
            self.file = f.get_path()
            self.where.set_subtitle(tilde(self.file))
            self.check()
        if self.restore:
            dlg.open(self.win, None, chosen)
        else:
            dlg.select_folder(self.win, None, chosen)

    def check(self):
        a = self.pw1.get_text()
        same = self.pw2 is None or a == self.pw2.get_text()
        self.go.set_sensitive(bool(self.file) and len(a) >= (1 if self.restore else 8) and same)

    def run(self):
        if getattr(self, "finished", False):
            self.close()
            return
        self.go.set_sensitive(False)
        self.go.set_label("Working…")
        pw, win = self.pw1.get_text(), self.win
        if self.restore:
            into, n = os.path.expanduser("~/kiwi"), 2
            while os.path.exists(into) and os.listdir(into):
                into, n = os.path.expanduser("~/kiwi-%d" % n), n + 1
            args = ["restore", self.file, "--into", into]
        else:
            into, args = self.file, ["backup", win.doc.path, "--local", self.file]

        def work():
            rc, out = with_passphrase(win.cli, args, pw)
            GLib.idle_add(self.done, rc, out, into)
        threading.Thread(target=work, daemon=True).start()

    def done(self, rc, out, into):
        lines = [ln.replace(":: ", "").replace("error: ", "") for ln in out.strip().splitlines() if ln.strip()]
        if rc != 0:
            self.note.set_label((lines or ["It did not work."])[-1])
            self.note.set_css_classes(["error"])
            self.note.set_visible(True)
            self.go.set_label("Restore it" if self.restore else "Save the copy")
            self.go.set_sensitive(True)
            return False
        if self.restore:
            self.close()
            self.win.open_path(os.path.join(into, "fleet.yaml"))
            self.win.toast("Restored into %s" % tilde(into))
            return False
        self.note.set_label("Saved in %s. Keep the file and the passphrase in different places." % tilde(into))
        self.note.set_css_classes([])
        self.note.set_visible(True)
        self.finished = True                 # the button closes now
        self.go.set_label("Done")
        self.go.set_sensitive(True)
        return False


class ControlSetupDialog(Adw.Dialog):
    """A home server that looks after the network when this computer is off: pick it, choose
    the password of its page, and every step runs by itself (what docs/control.md does by hand)."""

    def __init__(self, win):
        super().__init__(title="A home server that looks after the network", content_width=560)
        self.win = win
        self.nav = Adw.NavigationView()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        box.append(Gtk.Label(label="One home server checks every machine day and night, and gets a page for your phone: "
                                   "see how everything is, bring a machine up to date, add a device. This computer "
                                   "can then be off.", wrap=True, xalign=0))
        self.hosts = [h for h in win.doc.hosts() if win.group_of(h) != "Masters" and not win.is_new(h)]
        g = Adw.PreferencesGroup()
        self.host = Adw.ComboRow(title="Which home server?", subtitle="One that is always on",
                                 model=Gtk.StringList.new(self.hosts or ["(none is set up yet)"]))
        g.add(self.host)
        # rings other machines serve: one of them can open this node's keys by itself after a restart
        self.rings = []
        for h in win.doc.hosts():
            served = win.doc.get(h, (win.value_of(h, "role", "node"), "tang", "rings")) or {}
            self.rings += [(str(r), h) for r in served]
        self.ring = None
        if self.rings:
            self.ring = Adw.ComboRow(title="After a power cut", subtitle="Who unlocks its keys again",
                                     model=Gtk.StringList.new(["I log in on its page"] + [
                                         "By itself, with the help of %s" % h for _r, h in self.rings]))
            g.add(self.ring)
        self.pw1 = Adw.PasswordEntryRow(title="Password for its page (12 characters or more)")
        self.pw2 = Adw.PasswordEntryRow(title="The password again")
        for row in (self.pw1, self.pw2):
            row.connect("changed", lambda *_: self.check())
            g.add(row)
        box.append(g)
        box.append(Gtk.Label(label="The password unlocks the network's keys on that server after a restart. It cannot "
                                   "be read back anywhere: keep it in your password manager.", wrap=True, xalign=0,
                             css_classes=["dim-label", "caption"]))
        self.note = Gtk.Label(wrap=True, xalign=0, visible=False, css_classes=["error"])
        box.append(self.note)
        self.go = Gtk.Button(label="Set it up", css_classes=["suggested-action", "pill"], halign=Gtk.Align.CENTER,
                             sensitive=False)
        self.go.connect("clicked", lambda *_: self.start())
        box.append(self.go)
        self.nav.add(Adw.NavigationPage(title="A home server that looks after the network", child=box))
        self.set_child(self.nav)

    def check(self):
        a, b = self.pw1.get_text(), self.pw2.get_text()
        problem = ("" if not a else "The password needs 12 characters or more." if len(a.strip()) < 12
                   else "The two passwords differ." if b and a != b else "")
        self.note.set_label(problem)
        self.note.set_visible(bool(problem))
        self.go.set_sensitive(bool(self.hosts) and len(a.strip()) >= 12 and a == b)

    def start(self):
        win, host, password = self.win, self.hosts[self.host.get_selected()], self.pw1.get_text().strip()
        if win.doc.dirty and not win.save():
            return
        path = win.doc.path
        steps = []
        if not (win.store or {}).get("store"):
            steps.append(("Protecting the network's keys", ["secrets", "init", path], None, 120))
        steps += [("Setting the password", ["serve", path, "--set-password"], password + "\n", 120),
                  ("Setting up %s (this takes a few minutes)" % host, ["apply", path, host], None, 3600),
                  ("Sending the network to %s, encrypted" % host, ["control", "push", path], None, 300)]
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        labels = []
        for title, *_rest in [("Adding the control part to %s" % host,)] + steps:
            lbl = Gtk.Label(label="○  " + title, xalign=0)
            labels.append((lbl, title))
            box.append(lbl)
        self.out = Gtk.Label(wrap=True, xalign=0, selectable=True, visible=False)
        box.append(self.out)
        self.close_b = Gtk.Button(label="Close", halign=Gtk.Align.CENTER, visible=False)
        self.close_b.connect("clicked", lambda *_: self.close())
        box.append(self.close_b)
        self.nav.push(Adw.NavigationPage(title="Setting it up", child=box, can_pop=False))
        self.set_can_close(False)

        def mark(i, sign):
            labels[i][0].set_label("%s  %s" % (sign, labels[i][1]))
            return False

        # step 1 is ours: the part goes into the machine's settings
        role = win.value_of(host, "role", "node")
        parts = list((win.status.get(host) or {}).get("modules") or [])
        for part in ("reverse-proxy", "control"):
            if part not in parts:
                parts.append(part)
        win.doc.set(host, (role, "modules"), parts)
        if self.ring is not None and self.ring.get_selected() > 0:
            ring, server = self.rings[self.ring.get_selected() - 1]
            if server != host:              # a machine cannot open itself
                win.doc.set(host, ("unlock", "control"), ring)
        if not win.save():
            return self.finish(False, "The settings could not be saved.", host, "")
        mark(0, "✓")

        def work():
            recovery = ""
            for i, (title, args, stdin, timeout) in enumerate(steps, start=1):
                GLib.idle_add(mark, i, "…")
                try:
                    r = subprocess.run([win.cli] + args, input=stdin, capture_output=True, text=True, timeout=timeout)
                    rc, out = r.returncode, (r.stdout + r.stderr)
                except (OSError, subprocess.TimeoutExpired) as e:
                    rc, out = 1, str(e)
                if rc != 0:
                    GLib.idle_add(mark, i, "✗")
                    why = [ln for ln in out.replace("error: ", "").strip().splitlines() if ln.strip()]
                    GLib.idle_add(self.finish, False, (why or ["It did not work."])[-1], host, recovery)
                    return
                if args[:2] == ["secrets", "init"]:
                    recovery = next((w for w in out.split() if w.startswith("AGE-SECRET-KEY-")), "")
                GLib.idle_add(mark, i, "✓")
            GLib.idle_add(self.finish, True, "", host, recovery)
        threading.Thread(target=work, daemon=True).start()

    def finish(self, ok, why, host, recovery):
        self.set_can_close(True)
        name = (self.win.status.get(host) or {}).get("hostname") or host
        text = ("Done. From a device on your VPN, open https://control.%s and log in with the password.\n"
                "After a restart of %s it unlocks by itself if you chose that; otherwise log in there once." % host) if ok else (
            "It stopped here: %s\nNothing is broken; fix that and start again from the menu." % why)
        if recovery:
            text += ("\n\nWrite this recovery key down now, on paper or in a password manager. It is shown only "
                     "once, and it opens the network's keys if this computer is lost:\n%s" % recovery)
        self.out.set_label(text)
        self.out.set_visible(True)
        self.close_b.set_visible(True)
        self.win.poll()
        return False


class DeviceDialog(Adw.Dialog):
    """A phone or laptop onto the VPN: a name, then a QR code to scan or a file to import."""

