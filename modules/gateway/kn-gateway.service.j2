[Unit]
Description=Kiwi Network LAN gateway routing ({{ hostname }})
Documentation=https://github.com/derlocke-ng/kiwi-server
{% if runtime == 'docker' %}
After=docker.service kiwi-stack.service network-online.target
Requires=docker.service
{% else %}
# podman: the containers are systemd units themselves; kiwi-stack.service starts their target
After=kiwi-stack.service network-online.target
{% endif %}
Wants=kiwi-stack.service

[Service]
# sets the routing up, then watches it: a network manager may drop the rule and the routes
ExecStartPre=/usr/bin/bash {{ docker_dir }}/kiwi/gw.sh start
ExecStart=/usr/bin/bash {{ docker_dir }}/kiwi/gw.sh watch
ExecStopPost=/usr/bin/bash {{ docker_dir }}/kiwi/gw.sh stop
Restart=on-failure
RestartSec=10
# the start waits for the VPN client, which may take minutes after a boot
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
