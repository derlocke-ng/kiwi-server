# shellcheck shell=bash
# bash completion for kiwi-server — sourced, never executed
_kiwi_server() {
    local cur prev cmds opts
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cmds="init add names backups sshca plan check federate validate list show render build script ca openwrt apply adopt serve control status enroll secrets mtu vps backup restore prune unlock roles modules targets toolchain doctor version help"
    opts="--output-dir --cache --toolchain --image --porcelain --quiet --verbose -o -v --help --version --wireguard --full --via --name --domain --no-backup --offline --local --ssh --passphrase-file --dry-run --keep-daily --keep-weekly --keep-monthly --from --list --into --no-run --group --address --split --existing --master --qr --example --questions --answers --preset --target --now --new --restore --at --days --user --known-hosts"

    if [[ $cur == -* ]]; then
        mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
        return
    fi
    case "$prev" in
        --output-dir|--cache|-o)
            mapfile -t COMPREPLY < <(compgen -d -- "$cur"); return ;;
        --toolchain)
            mapfile -t COMPREPLY < <(compgen -W "auto native container" -- "$cur"); return ;;
        --wireguard|--passphrase-file|--answers)
            mapfile -t COMPREPLY < <(compgen -f -- "$cur"); return ;;
        --local|--into)
            mapfile -t COMPREPLY < <(compgen -d -- "$cur"); return ;;
        --domain)
            mapfile -t COMPREPLY < <(compgen -W "home internal corp mail" -- "$cur"); return ;;
        --preset)
            mapfile -t COMPREPLY < <(compgen -W "minimal gateway cloud" -- "$cur"); return ;;
        toolchain)
            mapfile -t COMPREPLY < <(compgen -W "status build" -- "$cur"); return ;;
    esac

    local i verb="" fleet=""
    for (( i = 1; i < COMP_CWORD; i++ )); do
        case "${COMP_WORDS[i]}" in
            -*) ;;
            *) if [[ -z $verb ]]; then verb="${COMP_WORDS[i]}"
               elif [[ -z $fleet ]]; then fleet="${COMP_WORDS[i]}"; fi ;;
        esac
    done
    case "$verb" in
        "")  mapfile -t COMPREPLY < <(compgen -W "$cmds" -- "$cur") ;;
        validate|list|show|plan|check|federate|render|build|script|ca|openwrt|backup|backups|prune|unlock|apply|adopt|status|enroll)
            if [[ -z $fleet ]]; then
                mapfile -t COMPREPLY < <(compgen -f -X '!*.y*ml' -- "$cur")
            elif [[ -f $fleet ]]; then
                mapfile -t COMPREPLY < <(compgen -W \
                    "$(kiwi-server list "$fleet" --porcelain 2>/dev/null |
                       sed -n 's/^ *"name": "\([^"]*\)".*/\1/p')" -- "$cur")
            fi ;;
        init|restore|names) mapfile -t COMPREPLY < <(compgen -f -- "$cur") ;;
        sshca)
            if [[ -z $fleet ]]; then
                mapfile -t COMPREPLY < <(compgen -f -X '!*.y*ml' -- "$cur")
            elif [[ $prev == "$fleet" ]]; then
                mapfile -t COMPREPLY < <(compgen -W "init sign trust" -- "$cur")
            else
                mapfile -t COMPREPLY < <(compgen -f -X '!*.pub' -- "$cur")
            fi ;;
        add)
            if [[ -z $fleet ]]; then
                mapfile -t COMPREPLY < <(compgen -f -X '!*.y*ml' -- "$cur")
            elif [[ $prev == "$fleet" ]]; then
                mapfile -t COMPREPLY < <(compgen -W "node master bare" -- "$cur")
            fi ;;
    esac
}
complete -F _kiwi_server kiwi-server
