    # ---- the secret store ----
    def store_detail(self):
        at = self.store.get("locks_at")
        return "locks itself in %s" % duration(max(at - time.time(), 0)) if at else ""

    def update_store(self):
        s = self.store
        known = bool(self.doc.path and s)
        self.store_banner.set_revealed(known and self.locked())
        self.store_icon.set_visible(known)
        self.store_button.set_visible(known and bool(s.get("store")))
        if not known:
            self.store_label.set_label("")
        elif not s.get("store"):
            self.store_icon.set_from_icon_name("dialog-warning-symbolic")
            self.store_label.set_label("Secrets are plain files")
            self.store_label.set_tooltip_text("kiwi-server secrets init %s" % self.doc.path)
        elif self.locked():
            self.store_icon.set_from_icon_name("changes-prevent-symbolic")
            self.store_label.set_label("Secrets locked")
            self.store_button.set_label("Unlock")
        else:
            self.store_icon.set_from_icon_name("changes-allow-symbolic")
            detail = self.store_detail()
            self.store_label.set_label("Secrets open")
            self.store_label.set_tooltip_text("%sOpens with: %s" % (detail.capitalize() + ". " if detail else "",
                                                                    ", ".join(s.get("opens_with") or [])))
            self.store_button.set_label("Lock")
        self.store_button.set_sensitive(not self.busy)

    def toggle_store(self):
        action = "unlock" if self.locked() else "lock"
        path, gen = self.doc.path, self.generation

        def worker():
            rc, out, err = run_cli(self.cli, ["secrets", action, path])
            GLib.idle_add(done, rc, err or out)

        def done(rc, text):
            if gen != self.generation:
                return False
            if rc != 0:
                self.alert("The store did not %s" % action,
                           "%s\n\nIn a terminal it can ask for the recovery key:\n  kiwi-server secrets unlock %s" % (text.strip(), path))
            self.poll()
            return False
        threading.Thread(target=worker, daemon=True).start()

    # ---- what the CLI says ----
    def tick(self):
        if self.is_active():
            self.poll()
        return True

    def on_focus(self):
        if self.is_active() and self.doc.path and (not self.checked or time.time() - self.checked > POLL_SECONDS):
            self.poll()

    def poll(self):
        """Ask again: the store, the fleet (quick), then the machines. Reads only."""
        if not self.doc.path or self.polling or self.busy:
            return
        self.polling = True
        self.b_refresh.set_sensitive(False)
        self.update_rows()
        path, gen = self.doc.path, self.generation

        def ask(args, timeout=120):
            rc, out, err = run_cli(self.cli, args, timeout)
            if rc != 0:
                return None, (err or out).strip()
            try:
                return json.loads(out), ""
            except ValueError:
                return None, "%s: no answer the app can read" % args[0]

        def worker():
            store, _err = ask(["secrets", "status", path, "--porcelain"])
            store = store or {}
            if store.get("store") and not store.get("open"):
                GLib.idle_add(self.answer_fleet, gen, store, None, "")
                GLib.idle_add(self.answer_machines, gen, None)
                return
            listing, err = ask(["list", path, "--porcelain"])
            GLib.idle_add(self.answer_fleet, gen, store, listing, err)
            live, _err = ask(["status", path, "--porcelain"], 90)
            GLib.idle_add(self.answer_machines, gen, live)
        threading.Thread(target=worker, daemon=True).start()

    def answer_fleet(self, gen, store, listing, err):
        if gen != self.generation:
            return False
        self.store = store
        if listing:
            self.status = {h["name"]: h for h in listing["hosts"]}
            self.fleet_info = {k: listing.get(k) or "" for k in ("domain", "mesh", "master_ip")}
            self.fleet_info["groups"] = listing.get("groups") or {}      # where a new device may go
        if err:
            self.append_log(err + "\n")
            self.toast(err.splitlines()[-1])
        self.update_store()
        self.set_actions_sensitive()
        self.update_rows()
        self.render_current()
        return False

    def answer_machines(self, gen, live):
        if gen != self.generation:
            return False
        self.polling = False
        self.b_refresh.set_sensitive(True)
        if self.locked():
            self.live = {}
        elif live:
            now = time.time()
            self.live = {h["host"]: h for h in live["hosts"]}
            self.last_seen.update({h: now for h, a in self.live.items() if a["ok"]})
            self.checked = now
        self.update_rows()
        self.render_current()
        return False

    # ---- hosts ----
    def add_host_dialog(self):
        if not self.doc.path:
            self.toast("Open or create a fleet first")
            return
        dlg = Adw.AlertDialog(heading="Add a host", body="Masters are named after fruit dishes, everything else after "
                              "fruits; any short name works: letters, digits, dashes. It becomes <name>.<domain>.")
        rc, out, _err = run_cli(self.cli, ["names"])
        pools = json.loads(out) if rc == 0 else {}
        taken = set(self.doc.hosts())               # with hosts added here and not saved yet
        names = {k: next((x for x in pools.get(k + "s", []) if x not in taken), "") for k in ("master", "node")}
        roles = [("node", "A node: a machine at home"), ("master", "A master: the machine everything connects to"),
                 ("bare", "Bare: only the system, a role later")]
        role = Gtk.DropDown.new_from_strings([label for _r, label in roles])
        entry = Gtk.Entry(text=names.get("node", ""), placeholder_text=names.get("node", "papaya"))
        suggested = [entry.get_text()]

        def role_changed(*_):
            key = "master" if roles[role.get_selected()][0] == "master" else "node"
            if entry.get_text() in suggested:          # not typed over: follow the role
                entry.set_text(names.get(key, ""))
                suggested.append(entry.get_text())
        role.connect("notify::selected", role_changed)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.append(role)
        box.append(entry)
        dlg.set_extra_child(box)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("add", "Add")
        dlg.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("add")
        dlg.set_close_response("cancel")

        def resp(_d, r):
            name = entry.get_text().strip()
            if r != "add" or not name:
                return
            if not re.match(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$", name, re.I):
                self.toast("A host name is a DNS label: letters, digits and dashes, 63 at most")
                return
            if name in self.doc.hosts() or name == "defaults":
                self.toast("There is already a host called %s" % name)
                return
            self.doc.add_host(name)
            kind = roles[role.get_selected()][0]
            self.doc.set(name, ("role",), kind)
            if kind == "master":            # what `kiwi-server add` writes; wg_host is the user's to fill in
                self.doc.set(name, ("target",), "debian")
                self.doc.set(name, ("master", "modules"), ["vpn-server", "dns", "tor", "reverse-proxy"])
            elif kind == "node":
                domain = self.doc.get("defaults", ("domain",)) or "home"
                self.doc.set(name, ("node", "preset"), "minimal")
                self.doc.set(name, ("node", "vpn-client", "wireguard_config"), "secrets/%s.%s.conf" % (name, domain))
            self.mark_dirty()
            self.rebuild_sidebar(name)
            self.host_stack.set_visible_child_name("settings")
        dlg.connect("response", resp)
        dlg.present(self)

    def remove_host_dialog(self):
        name = self.current_scope
        dlg = Adw.AlertDialog(heading="Remove %s?" % name,
                              body="Only from the fleet file. Generated files in the output directory stay.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("remove", "Remove")
        dlg.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r == "remove":
                self.doc.remove_host(name)
                self.mark_dirty()
                self.rebuild_sidebar(FLEET)
        dlg.connect("response", resp)
        dlg.present(self)

    # ---- actions ----
    def set_actions_sensitive(self):
        ok = bool(self.doc.path) and not self.busy and not self.locked()
        host = self.is_host()
        for name in ("render-all", "build-all"):
            self.lookup_action(name).set_enabled(ok)
        for name in ("render-host", "build-host", "status-host", "script-host", "stack-host", "folder-host"):
            self.lookup_action(name).set_enabled(ok and host)
        self.lookup_action("remove-host").set_enabled(host and not self.busy)
        self.lookup_action("refresh").set_enabled(bool(self.doc.path))
        self.b_apply.set_sensitive(ok and host)

    def ensure_saved(self):
        if not self.doc.path:
            self.toast("Open or create a fleet first")
            return False
        if self.doc.dirty and not self.save():
            return False
        return True

    def render(self, host):
        if not self.ensure_saved():
            return
        args = ["render", self.doc.path] + ([host] if host else [])
        self.spawn(args, "Rendering %s…" % (host or "every host"))

    def confirm_build(self, host):
        if not self.ensure_saved():
            return
        names = [host] if host else self.doc.hosts()
        lines = []
        for n in names:
            disk = self.doc.get(n, ("disk",)) or self.doc.get("defaults", ("disk",))
            lines.append("%s  →  %s" % (n, disk or "(no disk set — the build will refuse)"))
        dlg = Adw.AlertDialog(
            heading="Build unattended ISO%s?" % ("" if len(names) == 1 else "s"),
            body="Each ISO installs WITHOUT ASKING and wipes the disk it is told to:\n\n%s\n\n"
                 "Base images are downloaded once into the cache. The ISO carries the base "
                 "system only; Apply brings the host's role and its secrets afterwards." % "\n".join(lines))
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("build", "Build")
        dlg.set_response_appearance("build", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "build" and
                    self.spawn(["build", self.doc.path] + ([host] if host else []),
                               "Building %s…" % (host or "every host")))
        dlg.present(self)

    def confirm_apply(self, host):
        if not self.ensure_saved():
            return
        where = (self.live.get(host) or {}).get("target") or "%s@%s" % (
            self.admin_user(host), (self.status.get(host) or {}).get("hostname") or host)
        dlg = Adw.AlertDialog(
            heading="Apply %s?" % host,
            body="The role script is re-rendered, sent to %s over SSH (your key or agent must open the "
                 "connection; nothing asks for a password) and run as root with --force: the stack is rewritten "
                 "and restarted. Secrets and modules that changed take effect; the disk is not touched." % where)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("apply", "Apply")
        dlg.set_response_appearance("apply", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "apply" and
                    self.spawn(["apply", self.doc.path, host], "Applying %s…" % host))
        dlg.present(self)

    def show_status(self):
        if not self.ensure_saved():
            return
        scope = self.current_scope
        self.set_busy(True, "Asking %s…" % scope)

        def worker():
            rc, out, err = run_cli(self.cli, ["status", self.doc.path, scope])
            GLib.idle_add(done, rc, out, err)

        def done(rc, out, err):
            self.set_busy(False, "")
            if rc != 0 and not out.strip():
                self.alert("Cannot reach %s" % scope, err or out)
            else:
                TextDialog("%s — status" % scope, out + (("\n" + err) if err.strip() else "")).present(self)
            return False
        threading.Thread(target=worker, daemon=True).start()

    def show_script(self):
        if not self.ensure_saved():
            return
        scope = self.current_scope
        self.set_busy(True, "Rendering the role script…")

        def worker():
            rc, out, err = run_cli(self.cli, ["script", self.doc.path, scope, "--offline"])
            GLib.idle_add(done, rc, out, err)

        def done(rc, out, err):
            self.set_busy(False, "")
            if rc != 0:
                self.alert("Cannot render the script", err or out)
            else:
                TextDialog("%s — role script" % scope, out).present(self)
            return False
        threading.Thread(target=worker, daemon=True).start()

    def show_stack(self):
        st = self.status.get(self.current_scope) or {}
        p = os.path.join(st.get("dir") or "", "%s.stack" % self.current_scope, "docker-compose.yml")
        if not st.get("dir") or not os.path.isfile(p):
            self.toast("Render this host first — the stack is written next to its script")
            return
        with open(p, encoding="utf-8") as f:
            TextDialog("%s — docker-compose.yml" % self.current_scope, f.read()).present(self)

    def open_folder(self):
        st = self.status.get(self.current_scope) or {}
        d = st.get("dir")
        if not d or not os.path.isdir(d):
            self.toast("Nothing rendered for this host yet")
            return
        Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(d).get_uri(), None)

    def spawn(self, args, msg):
        if self.busy:
            return
        self.set_busy(True, msg)
        self.b_log.set_active(True)
        cmd = [self.cli] + list(args)

        def worker():
            GLib.idle_add(self.append_log, "\n$ %s\n" % " ".join(shlex.quote(c) for c in cmd))
            rc = 1
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                        text=True, stdin=subprocess.DEVNULL)
                for line in proc.stdout:
                    GLib.idle_add(self.append_log, line)
                rc = proc.wait()
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self.append_log, "%s\n" % e)
            GLib.idle_add(self.after_spawn, rc)
        threading.Thread(target=worker, daemon=True).start()

    def after_spawn(self, rc):
        self.set_busy(False, "")
        self.toast("Done" if rc == 0 else "Failed — see the output")
        self.poll()
        return False

    def set_busy(self, busy, msg):
        self.busy = busy
        self.progress.set_visible(busy)
        if busy and self._pulse is None:
            self._pulse = GLib.timeout_add(120, self._do_pulse)
        elif not busy and self._pulse is not None:
            GLib.source_remove(self._pulse)
            self._pulse = None
        self.set_actions_sensitive()
        self.store_button.set_sensitive(not busy)
        self.title.set_subtitle(msg if msg else (tilde(self.doc.path) if self.doc.path else "no fleet open"))

    def _do_pulse(self):
        self.progress.pulse()
        if not self.busy:
            self._pulse = None
            return False
        return True

    def append_log(self, text):
        self.logbuf.insert(self.logbuf.get_end_iter(), text)
        mark = self.logbuf.create_mark(None, self.logbuf.get_end_iter(), False)
        self.logview.scroll_mark_onscreen(mark)
        self.logbuf.delete_mark(mark)
        return False

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast.new(text))

    def alert(self, heading, body):
        dlg = Adw.AlertDialog(heading=heading, body=body)
        dlg.add_response("close", "Close")
        dlg.present(self)


class Application(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.path = None
        for name, cb in (("about", self.show_about), ("doctor", self.show_doctor)):
            act = Gio.SimpleAction(name=name)
            act.connect("activate", lambda _a, _p, cb=cb: cb())
            self.add_action(act)

    def show_doctor(self):
        win = self.get_active_window()
        if win:
            DoctorDialog(win).present(win)

    def show_about(self):
        win = self.get_active_window()
        cli = getattr(win, "cli", None) or find_cli()
        version = "?"
        if cli:
            rc, out, _err = run_cli(cli, ["version"])
            if rc == 0 and out.split():
                version = out.split()[-1]
        kw = dict(application_name="Kiwi Server", application_icon=APP_ID, developer_name="derlocke-ng",
                  version=version, website="https://github.com/derlocke-ng/kiwi-server",
                  issue_url="https://github.com/derlocke-ng/kiwi-server/issues",
                  license_type=Gtk.License.GPL_3_0,
                  comments="Create and manage a kiwi-network: unattended install ISOs and first-boot scripts "
                           "for kiwi-master and kiwi-node machines, applied and enrolled over SSH. "
                           "Part of the Kiwi Network.")
        dlg = Adw.AboutDialog(**kw) if hasattr(Adw, "AboutDialog") else Adw.AboutWindow(transient_for=win, **kw)
        dlg.add_credit_section("Icon", ["kiwi-icons https://github.com/derlocke-ng/kiwi-icons"])
        dlg.add_link("Kiwi Network", "https://github.com/derlocke-ng/kiwi-network")
        if hasattr(Adw, "AboutDialog"):
            dlg.present(win)
        else:
            dlg.present()

    def do_startup(self):
        Adw.Application.do_startup(self)
        # run from a checkout, before install.sh put the icon into hicolor: the
        # data/icons directory next to this script holds it under the app id
        icons = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "data", "icons")
        if os.path.isfile(os.path.join(icons, APP_ID + ".svg")):
            Gtk.IconTheme.get_for_display(Gdk.Display.get_default()).add_search_path(os.path.realpath(icons))
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_open(self, files, _n, _hint):
        self.path = files[0].get_path()
        self.do_activate()

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            cli = find_cli()
            if not cli:
                dlg = Adw.AlertDialog(heading="kiwi-server not found",
                                      body="The CLI must be installed next to this GUI:\n  kiwi install kiwi-server")
                dlg.add_response("close", "Close")
                tmp = Adw.ApplicationWindow(application=self, title="Kiwi Server", icon_name=APP_ID,
                                            default_width=420, default_height=200)
                tmp.present()
                dlg.connect("response", lambda *_: self.quit())
                dlg.present(tmp)
                return
            win = Window(self, cli)
            recent = load_recent()
            if self.path or recent:
                win.open_path(self.path or recent[0])
        win.present()


if __name__ == "__main__":
    import signal
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    sys.exit(Application().run(sys.argv))
