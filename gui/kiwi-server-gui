            if part in (modules or [])]


class NetworkPicture(Gtk.DrawingArea):
    """The network as it is: the master out on the Internet, the machines at home, and the tunnel
    each one holds to the master: green while the machine answers, grey and broken when it does
    not. A click on a machine opens it. `master` and each of `rest` are (name, state, answers,
    caption)."""
    BW, BH, GAP, PAD, MW, MH, ZONE = 172, 54, 18, 28, 260, 58, 34
    COLOURS = {"ok": (.18, .76, .49), "warn": (.90, .65, .04), "bad": (.88, .11, .14), "down": (.88, .11, .14)}

    def __init__(self, win, master, rest):
        super().__init__(hexpand=True)
        self.win, self.master, self.rest = win, master, rest
        self.boxes, self.links, self.zone, self.laid = [], [], None, None
        self.set_draw_func(self.draw)
        self.connect("resize", lambda _a, width, _h: self.lay_out(width))
        self.lay_out(720)
        click = Gtk.GestureClick()
        click.connect("released", lambda _g, _n, x, y: self.at(x, y) and self.win.select_scope(self.at(x, y)["name"]))
        self.add_controller(click)
        move = Gtk.EventControllerMotion()
        move.connect("motion", self.moved)
        self.add_controller(move)
        self.update_property([Gtk.AccessibleProperty.LABEL],
                             ["Your network: the master %s and %d machines linked to it" % (master[0], len(rest))])

    def lay_out(self, width):
        """Where the master, the home with its machines, and every tunnel go for this width."""
        bw, bh, gap, pad, mw, mh, zp = self.BW, self.BH, self.GAP, self.PAD, self.MW, self.MH, self.ZONE
        fits = lambda w: max(1, min(6, (width - 2 * pad - 2 * zp + gap) // (w + gap)))       # noqa: E731
        per_row = fits(bw)
        if len(self.rest) > 2 * per_row - 1 and fits(140) > per_row:      # two rows hold them when narrower
            bw, per_row = 140, fits(140)
        if self.laid == (width, per_row, bw):
            return
        self.laid, self.boxes, self.links, self.trunk = (width, per_row, bw), [], [], None
        if len(self.rest) > 2 * per_row - 1 and per_row < 6:
            return self.lay_out_list(width)
        mx = (width - mw) // 2
        self.boxes.append({"name": self.master[0], "state": self.master[1], "cap": self.master[3],
                           "x": mx, "y": 8, "w": mw, "h": mh, "master": True})
        # the rows after the first hold one machine less and stand between the ones above, so that a
        # tunnel to them passes through a gap and not across a machine
        rows, left = [], list(self.rest)
        while left:
            take = per_row if not rows or per_row == 1 else per_row - 1
            rows.append(left[:take])
            left = left[take:]
        rows = rows or [[]]
        zw = min(width - 2 * pad, per_row * bw + (per_row - 1) * gap + 2 * zp)
        zx, zy = (width - zw) // 2, 8 + mh + 58
        y = zy + 30
        for row in rows:
            rw = len(row) * bw + (len(row) - 1) * gap
            x = (width - rw) // 2
            for m in row:
                self.boxes.append({"name": m[0], "state": m[1], "cap": m[3], "x": x, "y": y, "w": bw, "h": bh,
                                   "master": False, "up": m[2]})
                x += bw + gap
            y += bh + gap
        zh = y - gap + 22 - zy
        self.zone = (zx, zy, zw, zh)
        # every tunnel leaves the master at its own place along its lower edge, left to right as the machines
        # stand, so that no two cross; it comes down into the home and then straight down to its machine
        machines = sorted(self.boxes[1:], key=lambda b: (b["x"], b["y"]))
        n = len(machines)
        for i, b in enumerate(machines):
            sx = mx + 24 + (mw - 48) * (i + 0.5) / max(n, 1)
            self.links.append((sx, 8 + mh, b["x"] + bw / 2, zy + 12, b["y"], b.get("up")))
        self.set_content_height(zy + zh + 8)
        self.queue_draw()

    def lay_out_list(self, width):
        """Too many for two rows at this width: the machines one under the other, each tunnel a
        branch off one line that comes down from the master."""
        mw, mh, bh, pad = self.MW, self.MH, self.BH, self.PAD
        w = min(width - 2 * pad, 520)
        x0 = (width - w) // 2
        mw = min(mw, w)
        self.boxes.append({"name": self.master[0], "state": self.master[1], "cap": self.master[3],
                           "x": x0, "y": 8, "w": mw, "h": mh, "master": True})
        zx, zy, zw = x0 - 14, 8 + mh + 30, w + 28
        tx, y = x0 + 22, zy + 30
        for m in self.rest:
            self.boxes.append({"name": m[0], "state": m[1], "cap": m[3], "x": x0 + 48, "y": y, "w": w - 48, "h": bh,
                               "master": False, "up": m[2]})
            self.links.append(("branch", tx, y + bh / 2, x0 + 48, m[2]))
            y += bh + 10
        self.trunk = (tx, 8 + mh, y - 10 - bh / 2)
        self.zone = (zx, zy, zw, y - 10 + 18 - zy)
        self.set_content_height(y - 10 + 18 + 8)
        self.queue_draw()

    def at(self, x, y):
        return next((b for b in self.boxes if b["x"] <= x <= b["x"] + b["w"] and b["y"] <= y <= b["y"] + b["h"]), None)

    def moved(self, _c, x, y):
        b = self.at(x, y)
        self.set_cursor(Gdk.Cursor.new_from_name("pointer") if b else None)
        self.set_tooltip_text("%s: %s" % (b["name"], WORDS.get(b["state"], b["state"])) if b else None)

    @staticmethod
    def _rounded(cr, x, y, w, h, r):
        cr.new_sub_path()
        for cx, cy, a in ((x + w - r, y + r, -.5), (x + w - r, y + h - r, 0), (x + r, y + h - r, .5), (x + r, y + r, 1)):
            cr.arc(cx, cy, r, a * 3.14159265, (a + .5) * 3.14159265)
        cr.close_path()

    def draw(self, _area, cr, _width, _height):
        fg = self.get_color()
        ink = lambda a: cr.set_source_rgba(fg.red, fg.green, fg.blue, a)                       # noqa: E731
        try:
            accent = Adw.StyleManager.get_default().get_accent_color_rgba()
            accent = (accent.red, accent.green, accent.blue)
        except AttributeError:                  # an older libadwaita: its blue
            accent = (.21, .52, .89)
        # the home: where every machine but the master stands
        if self.zone and len(self.boxes) > 1:
            zx, zy, zw, zh = self.zone
            self._rounded(cr, zx + .5, zy + .5, zw, zh, 14)
            ink(.035)
            cr.fill_preserve()
            cr.set_dash([2, 4])
            cr.set_line_width(1)
            ink(.25)
            cr.stroke()
            cr.set_dash([])
            text = self.create_pango_layout("")
            text.set_markup("<small>%s</small>" % esc("At home"))
            ink(.55)
            cr.move_to(zx + 14, zy + 7)
            PangoCairo.show_layout(cr, text)
        # the tunnels: a curve from the master down to each machine
        cr.set_line_cap(1)
        if self.trunk:              # the list: one line down from the master, a branch to each machine
            tx, ty1, ty2 = self.trunk
            ink(.22)
            cr.set_line_width(1.6)
            cr.move_to(tx, ty1)
            cr.line_to(tx, ty2)
            cr.stroke()
        for link in self.links:
            if link[0] == "branch":
                _k, sx, sy, ex, up = link
                cr.move_to(sx, sy - 10)
                cr.curve_to(sx, sy, sx, sy, sx + 10, sy)
                cr.line_to(ex, sy)
            else:
                sx, sy, ex, ez, ey, up = link
                mid = (sy + ez) / 2
                cr.move_to(sx, sy)
                cr.curve_to(sx, mid, ex, mid, ex, ez)
                cr.line_to(ex, ey)
            if up:
                cr.set_source_rgba(*self.COLOURS["ok"], .75)
                cr.set_dash([])
                cr.set_line_width(1.8)
            else:
                ink(.35)
                cr.set_dash([4, 5])
                cr.set_line_width(1.6)
            cr.stroke()
        cr.set_dash([])
        # the machines: on a ground of their own, so that a tunnel behind one does not show through
        dark = Adw.StyleManager.get_default().get_dark()
        ground = (.19, .19, .21) if dark else (1, 1, 1)
        for b in self.boxes:
            x, y, w, h = b["x"] + .5, b["y"] + .5, b["w"], b["h"]
            self._rounded(cr, x, y, w, h, 12)
            cr.set_source_rgb(*ground)
            cr.fill_preserve()
            cr.set_source_rgba(*(accent if b["master"] else (fg.red, fg.green, fg.blue)), .10 if b["master"] else .045)
            cr.fill_preserve()
            cr.set_line_width(1.5 if b["master"] else 1)
            if b["master"]:
                cr.set_source_rgba(*accent, .9)
            else:
                ink(.18)
            cr.stroke()
            # the state: a dot with a soft ring
            colour = self.COLOURS.get(b["state"])
            cx, cy = x + 20, y + h / 2
            if colour:
                cr.set_source_rgba(*colour, .22)
                cr.arc(cx, cy, 9, 0, 6.2831853)
                cr.fill()
                cr.set_source_rgb(*colour)
            else:
                ink(.3)
            cr.arc(cx, cy, 5, 0, 6.2831853)
            cr.fill()
            for markup, dy, alpha in (("<b>%s</b>" % esc(b["name"]), -18, 1), ("<small>%s</small>" % esc(b["cap"]), 1, .6)):
                text = self.create_pango_layout("")
                text.set_markup(markup)
                text.set_width(int((w - 46) * Pango.SCALE))
                text.set_ellipsize(Pango.EllipsizeMode.END)
                ink(alpha)
                cr.move_to(x + 36, y + h / 2 + dy)
                PangoCairo.show_layout(cr, text)

