# kiwi-server stack — generated; the fleet file is the place to change it
[Unit]
Description=kiwi stack: km-vpn-client
StartLimitIntervalSec=0

[Container]
Image=docker.io/qmcgaw/gluetun:v3
ContainerName=km-vpn-client
Network=knet-master.network
IP=172.64.0.2
AutoUpdate=registry
AddCapability=NET_ADMIN
Sysctl=net.ipv4.tcp_mtu_probing=1
Sysctl=net.ipv4.tcp_base_mss=1024
AddDevice=/dev/net/tun:/dev/net/tun
Environment=VPN_SERVICE_PROVIDER=mullvad
Environment=VPN_TYPE=wireguard
Environment=WIREGUARD_ADDRESSES=10.66.1.2/32
Environment=SERVER_COUNTRIES=Germany
Environment=TZ=Europe/Berlin
Environment=WIREGUARD_MTU=1412
Environment=WIREGUARD_PERSISTENT_KEEPALIVE_INTERVAL=25s
Environment=DOT_PROVIDERS=quad9
Environment=BLOCK_MALICIOUS=off
Environment=UPDATER_PERIOD=24h
EnvironmentFile=/home/user/docker/kiwi/env/km-vpn-client.env
AddHost=gate.home:172.64.0.5
AddHost=wg.gate.home:172.64.0.5
AddHost=pihole.gate.home:172.64.0.5
Volume=/home/user/docker/km-vpn-client/post-rules.txt:/iptables/post-rules.txt:z
LogDriver=journald

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900

[Install]
WantedBy=kiwi-stack.target
