class FleetDoc:
    """fleet.yaml as a dict, with get/set by path for either scope."""

    def __init__(self, path=None):
        self.path = path
        self.data = {"defaults": {}, "hosts": {}}
        self.dirty = False
        if path:
            with open(path, encoding="utf-8") as f:
                data = yaml.safe_load(f) or {}
            if not isinstance(data, dict):
                raise ValueError("not a mapping")
            data.setdefault("defaults", {})
            data.setdefault("hosts", {})
            if data["defaults"] is None:
                data["defaults"] = {}
            if data["hosts"] is None:
                data["hosts"] = {}
            self.data = data

    @property
    def dir(self):
        return os.path.dirname(os.path.abspath(self.path)) if self.path else os.getcwd()

    def hosts(self):
        return list(self.data["hosts"])

    def block(self, scope):
        if scope == "defaults":
            return self.data["defaults"]
        h = self.data["hosts"].get(scope)
        if h is None:
            h = self.data["hosts"][scope] = {}
        return h

    def get(self, scope, path):
        d = self.block(scope)
        for p in path:
            if not isinstance(d, dict) or p not in d:
                return None
            d = d[p]
        return d

    def set(self, scope, path, value):
        d = self.block(scope)
        for p in path[:-1]:
            if not isinstance(d.get(p), dict):
                d[p] = {}
            d = d[p]
        if value is None:
            if path[-1] in d:
                del d[path[-1]]
        else:
            d[path[-1]] = value
        self._prune(self.block(scope))
        self.dirty = True

    def _prune(self, d):
        for k in list(d):
            if isinstance(d[k], dict):
                self._prune(d[k])
                if not d[k] and k not in ("hosts",):
                    del d[k]

    def add_host(self, name):
        self.data["hosts"][name] = {}
        self.dirty = True

    def remove_host(self, name):
        self.data["hosts"].pop(name, None)
        self.dirty = True

    def save(self, path=None):
        self.path = path or self.path
        text = ("# fleet.yaml — written by kiwi-server-gui. Comments are not kept here;\n"
                "# `kiwi-server init` writes a commented example to read along.\n"
                + yaml.safe_dump(self.data, sort_keys=False, allow_unicode=True, default_flow_style=False))
        try:
            mode = os.stat(self.path).st_mode & 0o777
        except OSError:
            mode = 0o600   # new file: it holds secrets
        tmp = self.path + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, self.path)
        self.dirty = False


