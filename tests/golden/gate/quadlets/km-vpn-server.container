# kiwi-server stack — generated; the fleet file is the place to change it
[Unit]
Description=kiwi stack: km-vpn-server
StartLimitIntervalSec=0

[Container]
Image=docker.io/weejewel/wg-easy:7
ContainerName=km-vpn-server
Network=knet-master.network
IP=172.64.0.3
AutoUpdate=registry
AddCapability=NET_ADMIN
AddCapability=SYS_MODULE
Sysctl=net.ipv4.ip_forward=1
Sysctl=net.ipv4.conf.all.src_valid_mark=1
Environment=WG_HOST=vpn.example.org
Environment=WG_PORT=51820
Environment="WG_POST_UP=bash /etc/wireguard/start.sh"
Environment=WG_PERSISTENT_KEEPALIVE=25
Environment=UI_TRAFFIC_STATS=true
Environment=WG_DEFAULT_DNS=10.8.0.1
Environment=WG_DEFAULT_ADDRESS=10.8.0.x
Environment=WG_MTU=1412
EnvironmentFile=/home/user/docker/kiwi/env/km-vpn-server.env
AddHost=gate.home:172.64.0.5
AddHost=wg.gate.home:172.64.0.5
AddHost=pihole.gate.home:172.64.0.5
DNS=172.64.0.3
DNS=9.9.9.9
Volume=/home/user/docker/km-vpn-server:/etc/wireguard:z
PublishPort=51820:51820/udp
PublishPort=127.0.0.1:51821:51821/tcp
PublishPort=127.0.0.1:8080:8081/tcp
LogDriver=journald

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900

[Install]
WantedBy=kiwi-stack.target
