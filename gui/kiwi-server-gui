def find_cli():
    here = os.path.dirname(os.path.realpath(__file__))
    for c in (os.environ.get("KIWI_SERVER_CLI"), os.path.join(here, "..", "bin", "kiwi-server"),
              os.path.expanduser("~/.local/bin/kiwi-server"), "/usr/local/bin/kiwi-server"):
        if c and os.path.exists(c):
            return os.path.realpath(c)
    import shutil
    return shutil.which("kiwi-server")


# the commands that only read, which the resident kiwi-server (`kiwi-server agent`) answers without
# starting a new one; its socket is only this user's
AGENT_READS = {("list",), ("logins",), ("version",), ("names",), ("validate",), ("secrets", "status"), ("sources", "list")}


def agent_socket():
    return os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "kiwi-server-agent.sock")


def agent_reads(args):
    if not args:
        return False
    two = tuple(args[:1]) + tuple(a for a in args[2:3] if not a.startswith("-"))
    return (args[0],) in AGENT_READS or (len(args) >= 3 and two in AGENT_READS)


def agent_ask(message, timeout):
    """One question to the agent: its answer as a dict, or None when none runs."""
    import socket as _socket
    try:
        c = _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM)
        c.settimeout(timeout)
        c.connect(agent_socket())
        with c:
            c.sendall((json.dumps(message) + "\n").encode())
            return json.loads(c.makefile("r").readline())
    except (OSError, ValueError):
        return None


def start_agent(cli):
    """The resident kiwi-server, for as long as the app runs (an older one without `agent` just ends)."""
    if not cli or agent_ask({"argv": ["version"]}, 2):
        return
    try:
        subprocess.Popen([cli, "agent", "--parent", str(os.getpid())], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def run_cli(cli, args, timeout=120, input=None):
    if input is None and agent_reads(list(args)):
        got = agent_ask({"argv": [str(a) for a in args]}, timeout)
        if got and "rc" in got:
            return got["rc"], got.get("out", ""), got.get("err", "")
    else:
        agent_ask({"forget": True}, 2)          # a command that may change what the agent keeps
    try:
        r = subprocess.run([cli] + list(args), capture_output=True, text=True, timeout=timeout,
                           **({"input": input} if input is not None else {"stdin": subprocess.DEVNULL}))
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def run_cli_then(cli, args, done, timeout=120):
    """run_cli in a thread, `done(rc, out, err)` back on the window's thread: the window stays alive
    while kiwi-server works (a sync with the control node can take half a minute)."""
    def work():
        rc, out, err = run_cli(cli, args, timeout)
        GLib.idle_add(lambda: (done(rc, out, err), False)[1])
    threading.Thread(target=work, daemon=True).start()


def machine_chips(phase, modules, facts, applied=None, now=None):
    """One look at a machine, part by part, as the chips on its page on the control node (web.py,
    machine_chips; a test holds the two to the same rules): set up or not, its last apply that
    worked, its backup, its fullest disk. [(text, kind)]."""
    now = now or time.time()
    out = []
    if phase and phase != "applied":
        out.append(("not set up yet", "warn"))
    if applied:
        out.append(("last apply: done %s ago" % duration(max(0, now - applied)), "ok"))
    b = (facts or {}).get("backup")
    if "backup" in (modules or []):
        if b and b.get("last") and b.get("age") is not None:
            out.append(("backup %s ago" % duration(b["age"]), "ok" if b["age"] < 129600 else "bad"))
        else:
            out.append(("no backup seen yet", "warn"))
    disks = [d for d in (facts or {}).get("disks") or [] if d.get("size")]
    if disks:
        pct = max(0, min(100, int(round(100 * max(d["used"] / d["size"] for d in disks)))))
        out.append(("disk %d %%" % pct, "bad" if pct >= 92 else "warn" if pct >= 80 else "ok"))
    return out


