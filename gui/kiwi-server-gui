class MoveDialog(Adw.Dialog):
    """A part of a machine to another machine (`kiwi-server move`): which part, where to, what
    would happen (the plan, and what stands in its way), then the move."""

    def __init__(self, win, host):
        super().__init__(title="Move a part of %s" % host, content_width=620, content_height=560)
        self.win, self.host = win, host
        mine = win.status.get(host) or {}
        self.parts = [p for p in mine.get("modules") or []]
        self.targets = [n for n, h in sorted(win.status.items())
                        if n != host and h.get("role") == mine.get("role") and not h.get("standby_of")]
        tb = Adw.ToolbarView()
        tb.add_top_bar(Adw.HeaderBar())
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup()
        self.part = Adw.ComboRow(title="Part", model=Gtk.StringList.new(self.parts))
        self.to = Adw.ComboRow(title="To the machine", model=Gtk.StringList.new(self.targets))
        g.add(self.part)
        g.add(self.to)
        see = Adw.ButtonRow(title="See what would happen")
        see.connect("activated", lambda *_: self.plan())
        g.add(see)
        page.add(g)
        self.out = Gtk.Label(xalign=0, wrap=True, selectable=True, margin_top=6, margin_bottom=6, margin_start=12, margin_end=12)
        g2 = Adw.PreferencesGroup()
        g2.add(self.out)
        self.go = Adw.ButtonRow(title="Move it", sensitive=False, css_classes=["suggested-action"])
        self.go.connect("activated", lambda *_: self.move())
        g2.add(self.go)
        page.add(g2)
        tb.set_content(page)
        self.set_child(tb)
        if not self.targets:
            self.out.set_label("There is no other machine of this kind to move a part to.")

    def chosen(self):
        if not self.parts or not self.targets:
            return None, None
        return self.parts[self.part.get_selected()], self.targets[self.to.get_selected()]

    def plan(self):
        part, to = self.chosen()
        if not part:
            return
        self.go.set_sensitive(False)
        self.out.set_label("Looking at both machines…")

        def work():
            rc, out, err = run_cli(self.win.cli, ["move", self.win.doc.path, part, self.host, to], timeout=180)
            text = (out or err or "no answer").strip()
            GLib.idle_add(lambda: (self.out.set_label(text.replace("Nothing was changed. With --yes it is done: ", "Nothing was changed yet.\n")
                                                      .split("kiwi-server move ")[0].strip()),
                                   self.go.set_sensitive(rc == 0)) and False)
        threading.Thread(target=work, daemon=True).start()

    def move(self):
        part, to = self.chosen()
        if not part:
            return
        self.close()
        self.win.spawn(["move", self.win.doc.path, part, self.host, to, "--yes"], "Moving %s from %s to %s…" % (part, self.host, to))


