# dns (Pi-hole) — resolver for the mesh (master) or the LAN (gateway node)
{#
  Upstreams, in strict order: a node asks the master's Pi-hole first, so the whole
  network shares one blocklist and leaves through the master's exit; the master asks
  the VPN client's DNS-over-TLS resolver. The fallback is reached directly and only
  answers while the master is unreachable (the tunnel is down in the same moment).
  Names under the fleet's domain go to the master and never leave it.
#}
{% set chain = [] %}
{% if upstream_dns %}
{% set _ = chain.append(upstream_dns) %}
{% else %}
{% if node_type != 'master' and master_ip %}
{% set _ = chain.append(master_ip) %}
{% elif vpn_client_ip %}
{% set _ = chain.append(vpn_client_ip) %}
{% endif %}
{% if fallback_dns %}
{% set _ = chain.append(fallback_dns) %}
{% endif %}
{% endif %}
{% if not chain %}
{% set _ = chain.append('1.1.1.1;1.0.0.1') %}
{% endif %}
{% set upstreams = chain | join(';') %}
{% if dns_up %}
{# a node: the resolver in front (Corefile.j2) chooses between the master and the fallbacks #}
{% set upstreams = '127.0.0.1#5335' %}
{% endif %}
{# no-hosts: podman copies the host's /etc/hosts into the container, where the node's
   own names point at 127.0.0.1 — dnsmasq would serve that to every client #}
{% set lines = ['strict-order', 'no-hosts'] %}
{% if domain %}
{% if node_type != 'master' and master_ip %}
{% set _ = lines.append('server=/' ~ domain ~ '/' ~ master_ip) %}
{# a linked network's names: from the master, which asks the partner; the wildcard gets past
   Pi-hole 6's own local=/internal/ and local=/home.arpa/ #}
{% for d in partner_domains or [] if d and d != domain %}
{% set _ = lines.append('server=/' ~ d ~ '/' ~ master_ip) %}
{% set _ = lines.append('server=/*.' ~ d ~ '/' ~ master_ip) %}
{% endfor %}
{% else %}
{% set _ = lines.append('local=/' ~ domain ~ '/') %}
{% endif %}
{% endif %}
{# federation: a partner network's names from its own DNS, over the link #}
{% for pname, p in ((module_config.get('vpn-server') or {}).get('federation') or {}).items() if node_type == 'master' and p.domain and p.dns %}
{# a partner seen here under another domain or mesh: the link's DNS (fed-dns) translates #}
{% set fd = (p.seen_as or {}).get('domain') or p.domain %}
{% set up = '127.0.0.1#5353' if p.seen_as else p.dns %}
{% set _ = lines.append('server=/' ~ fd ~ '/' ~ up) %}
{# and every name under it: Pi-hole 6 keeps .internal and .home.arpa to itself (local=), which wins
   over the line above; a wildcard is more specific, and the partner's names get through #}
{% set _ = lines.append('server=/*.' ~ fd ~ '/' ~ up) %}
{% endfor %}
{# and what this network opens to each of them, for their picture: a TXT record under this
   network's domain, named after the partner's mesh, that the partner's master asks for #}
{% for pname, p in ((module_config.get('vpn-server') or {}).get('federation') or {}).items() if node_type == 'master' and p.mesh and domain %}
{% set _ = lines.append('txt-record=' ~ (p.mesh | string | replace('.', '-') | replace('/', '-')) ~ '._kiwi-share.' ~ domain ~ ',' ~ ((p.share or []) | join(',') or '-')) %}
{% endfor %}
{# and which machine is this network's master, for their picture too #}
{% if node_type == 'master' and domain and (module_config.get('vpn-server') or {}).get('federation') %}
{% set _ = lines.append('txt-record=_kiwi-master.' ~ domain ~ ',' ~ hostname) %}
{% endif %}
{% if dhcp_enabled and ntp %}
{# the devices that get their address here get the time here too (option 42; 0.0.0.0 is this server) #}
{% set _ = lines.append('dhcp-option=option:ntp-server,0.0.0.0') %}
{% endif %}
{% if mullvad_socks %}
{# the Mullvad SOCKS5 records, refreshed by the host timer; reloaded on every change #}
{% set _ = lines.append('hostsdir=/etc/mullvad-socks') %}
{% endif %}
{% if moving %}
{# the names of parts that can move to another machine: a switch rewrites that file, dnsmasq reloads it #}
{% set _ = lines.append('hostsdir=/etc/kiwi-moving') %}
{% endif %}
{# an operator's own FTLCONF_misc_dnsmasq_lines: one variable can only be set once #}
{% for k, v in extra_env.items() if k | upper == 'FTLCONF_MISC_DNSMASQ_LINES' %}
{% for l in (v | string).split(';') if l.strip() %}{% set _ = lines.append(l.strip()) %}{% endfor %}
{% endfor %}
{% set hosts = [] %}
{# on a LAN, a node on that same LAN answers with its LAN address: its traffic stays on the switch #}
{% if fleet_records %}{% for ip, name in dns_records if name not in moving_names %}{% set _ = hosts.append((ip if name in mesh_only else lan_addresses.get(ip, ip)) ~ ' ' ~ name) %}{% endfor %}{% endif %}
{% for name, ip in extra_records.items() %}{% set _ = hosts.append(ip ~ ' ' ~ name) %}{% endfor %}
services:
  {{ container_prefix }}-pihole:
    image: {{ image }}
    container_name: {{ container_prefix }}-pihole
{% if not network_mode %}
    hostname: pihole
{% endif %}
    environment:
      - TZ={{ timezone }}
      - FTLCONF_webserver_api_password={{ pihole_password }}
      - FTLCONF_dns_upstreams={{ upstreams }}
      - FTLCONF_misc_dnsmasq_lines={{ lines | join(';') }}
      - FTLCONF_dns_listeningMode=all
      # the clock is the machine's own time service's to set: Pi-hole setting it too (every hour, from
      # pool.ntp.org) made two setters of one clock (20 Nov 2026). It only serves the time, when asked to
      - FTLCONF_ntp_sync_active=false
{% if not ntp %}
      - FTLCONF_ntp_ipv4_active=false
      - FTLCONF_ntp_ipv6_active=false
{% endif %}
      - FTLCONF_webserver_domain={{ pihole_hostname or 'pihole.' ~ hostname }}
{% if web_port_effective != '80' %}
      # no 'o' (optional) suffix: a port that cannot be bound is an error, not silence
      - FTLCONF_webserver_port={{ web_port_effective }}
{% endif %}
{% if hosts %}
      # the fleet's names at their mesh addresses (pihole.toml dns.hosts)
      - FTLCONF_dns_hosts={{ hosts | join(';') }}
{% endif %}
{% if dhcp_enabled %}
      # Pi-hole is the LAN's DHCP server; the dhcp-relay module carries the broadcasts here
      - FTLCONF_dhcp_active=true
      - FTLCONF_dhcp_start={{ dhcp_start }}
      - FTLCONF_dhcp_end={{ dhcp_end }}
      - FTLCONF_dhcp_router={{ dhcp_router }}
      - FTLCONF_dhcp_leaseTime={{ dhcp_lease_time }}
{% endif %}
{% if legacy_env %}
      - WEBPASSWORD={{ pihole_password }}
      - PIHOLE_DNS_={{ upstreams }}
      - DNSMASQ_LISTENING=all
{% endif %}
{% for k, v in extra_env.items() if k | upper != 'FTLCONF_MISC_DNSMASQ_LINES' %}
      - {{ k }}={{ v }}
{% endfor %}
{% if network_mode %}
    network_mode: "service:{{ container_prefix }}-{{ network_mode }}"
{% else %}
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    ports:
      - "53:53/tcp"
      - "53:53/udp"
{% if ntp %}
      - "123:123/udp"
{% endif %}
{% if expose_web_ui %}
      - "{{ web_ui_bind ~ ':' if web_ui_bind else '' }}{{ web_ui_port }}:{{ web_port_effective }}/tcp"
{% endif %}
{% endif %}
    cap_add:
      - NET_ADMIN
      - SYS_NICE
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-pihole/etc-pihole:/etc/pihole:z
      - {{ docker_dir }}/{{ container_prefix }}-pihole/etc-dnsmasq.d:/etc/dnsmasq.d:z
{% if mullvad_socks %}
      # root's, written by the host timer: read-only in here
      - {{ docker_dir }}/{{ container_prefix }}-pihole/mullvad-socks:/etc/mullvad-socks:ro,z
{% endif %}
{% if moving %}
      # root's, written by an apply or a switch: read-only in here
      - {{ docker_dir }}/{{ container_prefix }}-pihole/moving:/etc/kiwi-moving:ro,z
{% endif %}
{% if dns_up %}
  # in front of Pi-hole, in its network: the master's Pi-hole while it answers, the fallbacks while it does not
  {{ container_prefix }}-dns-up:
    image: {{ up_image }}
    container_name: {{ container_prefix }}-dns-up
    network_mode: "service:{{ container_prefix }}-{{ network_mode or 'pihole' }}"
    depends_on:
      - {{ container_prefix }}-{{ network_mode or 'pihole' }}
    command: ["-conf", "/Corefile"]
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 1m
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-pihole/Corefile:/Corefile:ro,z
{% endif %}
