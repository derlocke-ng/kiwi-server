    # ---- the secret store ----
    def store_detail(self):
        at = self.store.get("locks_at")
        return "locks itself in %s" % duration(max(at - time.time(), 0)) if at else ""

    def update_store(self):
        s = self.store
        known = bool(self.doc.path and s)
        self.store_banner.set_revealed(known and self.locked())
        self.store_icon.set_visible(known)
        self.store_button.set_visible(known)
        if not known:
            self.store_label.set_label("")
        elif not s.get("store"):
            self.store_icon.set_from_icon_name("dialog-warning-symbolic")
            self.store_label.set_label("Keys are not protected")
            self.store_label.set_tooltip_text("The network's keys lie on this computer as plain files. Protect "
                                              "encrypts them; this computer then opens them by itself when you log in.")
            self.store_button.set_label("Protect")
        elif self.locked():
            self.store_icon.set_from_icon_name("changes-prevent-symbolic")
            self.store_label.set_label("Secrets locked")
            self.store_button.set_label("Unlock")
        else:
            self.store_icon.set_from_icon_name("changes-allow-symbolic")
            detail = self.store_detail()
            self.store_label.set_label("Secrets open")
            self.store_label.set_tooltip_text("%sOpens with: %s" % (detail.capitalize() + ". " if detail else "",
                                                                    ", ".join(s.get("opens_with") or [])))
            self.store_button.set_label("Lock")
        self.store_button.set_sensitive(not self.busy)

    def protect(self, then=None):
        """The network's keys into the encrypted store, and the recovery key shown once."""
        path = self.doc.path

        def worker():
            rc, out, err = run_cli(self.cli, ["secrets", "init", path])
            GLib.idle_add(done, rc, out, err)

        def done(rc, out, err):
            # whatever was opened or reloaded meanwhile: the key exists only in this output
            key = re.search(r"AGE-SECRET-KEY-1[0-9A-Z]+", out) if rc == 0 else None
            if rc != 0 or not key:
                self.alert("The keys were not protected", ((err or out).strip().replace("error: ", "").splitlines() or ["?"])[-1])
            else:
                RecoveryKeyDialog(key.group(0)).present(self)
            self.poll()
            if then:
                then()
            return False
        threading.Thread(target=worker, daemon=True).start()

    def toggle_store(self):
        if not (self.store or {}).get("store"):
            return self.protect()
        action = "unlock" if self.locked() else "lock"
        path, gen = self.doc.path, self.generation

        def worker(password=None):
            args = ["secrets", action, path] + (["--password-stdin"] if password is not None else [])
            rc, out, err = run_cli(self.cli, args, input=(password + "\n") if password is not None else None)
            GLib.idle_add(done, rc, err or out)

        def done(rc, text):
            if gen != self.generation:
                return False
            if rc != 0 and action == "unlock" and ("has a password" in text or "does not open this computer" in text):
                ask_password("does not open" in text)       # this computer's key wants its password too
                return False
            if rc != 0:
                self.alert("The store did not %s" % action,
                           "%s\n\nIn a terminal it can ask for the recovery key:\n  kiwi-server secrets unlock %s" % (text.strip(), path))
            self.poll()
            return False

        def ask_password(wrong):
            dlg = Adw.AlertDialog(heading="This computer's password",
                                  body=("That was not it. " if wrong else "") +
                                  "This computer's key for the network opens only together with its password.")
            entry = Gtk.PasswordEntry(show_peek_icon=True, activates_default=True)
            dlg.set_extra_child(entry)
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("unlock", "Unlock")
            dlg.set_response_appearance("unlock", Adw.ResponseAppearance.SUGGESTED)
            dlg.set_default_response("unlock")

            def answer(_d, r):
                if r == "unlock" and entry.get_text():
                    pw = entry.get_text()
                    entry.set_text("")
                    threading.Thread(target=worker, args=(pw,), daemon=True).start()
            dlg.connect("response", answer)
            dlg.present(self)
        threading.Thread(target=worker, daemon=True).start()

    # ---- what the CLI says ----
    def tick(self):
        if self.is_active():
            self.poll()
        return True

    def on_focus(self):
        if self.is_active() and self.doc.path and (not self.checked or time.time() - self.checked > POLL_SECONDS):
            self.poll()

    def watch_control(self):
        """A computer joined to a control node follows its changes (kiwi-server control watch): a look,
        a job or an apply there is asked for at once, not at the next minute. Opened again a minute after
        its stream ended; given up with the fleet."""
        path, gen = self.doc.path, self.generation
        if not path or self.watching == gen or not os.path.isfile(os.path.join(os.path.dirname(path), "control", "remote")):
            return
        self.stop_watch()
        self.watching = gen

        def worker():
            while self.watching == gen:
                try:
                    p = subprocess.Popen([self.cli, "control", "watch", path], stdin=subprocess.DEVNULL,
                                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
                except OSError:
                    return
                self.watcher, first = p, True
                for _line in p.stdout:
                    if self.watching != gen:
                        break
                    if first:               # the mark as it is: nothing new yet
                        first = False
                        continue
                    GLib.idle_add(self.follow_there)
                p.kill()
                p.wait()
                for _ in range(60):
                    if self.watching != gen:
                        return
                    time.sleep(1)
        threading.Thread(target=worker, daemon=True).start()

    def stop_watch(self):
        self.watching = None
        p, self.watcher = self.watcher, None
        if p and p.poll() is None:
            p.kill()

    WATCH_GAP = 10      # seconds: changes that come close together are asked for once

    def poll_soon(self):
        if self.watch_due:
            return False
        wait = max(0, self.WATCH_GAP - (time.time() - (self.last_poll or 0)))
        self.watch_due = True

        def go():
            self.watch_due = False
            if self.polling:            # a look is on its way: one more after it
                GLib.timeout_add_seconds(self.WATCH_GAP, lambda: (self.poll_soon(), False)[1])
            else:
                self.poll()
            return False
        GLib.timeout_add(int(wait * 1000) + 1, go)
        return False

    def poll(self):
        """Ask again: the store, the fleet (quick), then the machines. Reads only."""
        if not self.doc.path or self.polling or self.busy:
            return
        self.last_poll = time.time()
        self.watch_control()
        self.polling = True
        self.b_refresh.set_sensitive(False)
        self.update_rows()
        path, gen = self.doc.path, self.generation

        def ask(args, timeout=120):
            rc, out, err = run_cli(self.cli, args, timeout)
            if rc != 0:
                return None, (err or out).strip()
            try:
                return json.loads(out), ""
            except ValueError:
                return None, "%s: no answer the app can read" % args[0]

        def worker():
            store, _err = ask(["secrets", "status", path, "--porcelain"])
            store = store or {}
            if store.get("store") and not store.get("open"):
                GLib.idle_add(self.answer_fleet, gen, store, None, "")
                GLib.idle_add(self.answer_machines, gen, None)
                return
            listing, err = ask(["list", path, "--porcelain"])
            # the services open by name, and only from a device on the network: is this computer one?
            # (a name that resolves is not enough: some resolvers answer every name with something)
            # (only the network's own names: a public one, a relay's, opens from anywhere)
            ending = "." + str((listing or {}).get("domain") or "")
            sites = [s for h in (listing or {}).get("hosts") or [] if h.get("phase") == "applied"
                     for s in h.get("sites") or [] if s.endswith(ending)]
            if sites:
                def opens(n):
                    try:
                        socket.create_connection((n, 443), timeout=3).close()
                        return True
                    except OSError:
                        return False
                self.on_network = any(opens(n) for n in sites[:3])
            GLib.idle_add(self.answer_fleet, gen, store, listing, err)
            live, _err = ask(["status", path, "--porcelain"], 90)
            GLib.idle_add(self.answer_machines, gen, live)
        threading.Thread(target=worker, daemon=True).start()

    def answer_fleet(self, gen, store, listing, err):
        if gen != self.generation:
            return False
        self.store = store
        if listing:
            self.status = {h["name"]: h for h in listing["hosts"]}
            self.fleet_info = {k: listing.get(k) or "" for k in ("domain", "mesh", "master_ip")}
            self.fleet_info["play"] = listing.get("play") or {}      # the game page, if the network has one
            self.fleet_info["groups"] = listing.get("groups") or {}      # where a new device may go
            self.fleet_info["changed"] = listing.get("changed") or []    # changes not applied yet
            self.fleet_info["linked"] = listing.get("linked") or []      # networks linked to this one: in the picture
        if err:
            self.append_log(err + "\n")
            self.toast(err.splitlines()[-1])
        self.update_store()
        self.set_actions_sensitive()
        self.update_rows()
        self.render_current()
        return False

    def answer_machines(self, gen, live):
        if gen != self.generation:
            return False
        self.polling = False
        self.b_refresh.set_sensitive(True)
        if self.locked():
            self.live = {}
        elif live:
            now = time.time()
            before = {(h, p["text"]) for h, a in self.live.items() for p in a.get("problems") or []}
            self.live = {h["host"]: h for h in live["hosts"]}
            self.emergencies = live.get("emergencies") or []       # from the control node's look (Control.emergencies)
            if self.checked:        # not at the first look: then everything would be new
                for h, a in self.live.items():
                    for p in a.get("problems") or []:
                        if (h, p["text"]) not in before:
                            self.remember("%s: %s" % (h, in_plain_words(p["text"])), p.get("level") or "warn", p.get("hint") or "")
                now_seen = {(h, p["text"]) for h, a in self.live.items() for p in a.get("problems") or []}
                for h, text in sorted(before - now_seen):
                    if h in self.live:
                        self.remember("%s: fine again: %s" % (h, in_plain_words(text)), "ok")
            self.last_seen.update({h: now for h, a in self.live.items() if a["ok"]})
            self.checked = now
        self.update_rows()
        self.render_current()
        return False

