    def whats_next_group(self):
        """Every machine runs: what makes the network useful and safe, each with a button.
        A step that is done is not listed."""
        rows = []
        devices = os.path.join(self.doc.dir, "secrets", "devices")
        if not (os.path.isdir(devices) and any(f.endswith(".conf") for f in os.listdir(devices))) and not self.locked():
            rows.append(("Put your phone on the VPN", "Then your files, photos and passwords open from anywhere.",
