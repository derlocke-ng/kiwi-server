def size_kib(kib):
    for unit in ("KiB", "MiB", "GiB", "TiB"):
        if kib < 1024 or unit == "TiB":
            return "%.0f %s" % (kib, unit) if unit == "KiB" else "%.1f %s" % (kib, unit)
        kib /= 1024


def local_time(iso):
    """restic's time (nanoseconds, an offset) as local 'Tue 10 Nov 19:01'."""
    try:
        import datetime
        t = datetime.datetime.fromisoformat(re.sub(r"(\.\d+)", "", iso).replace("Z", "+00:00"))
        return t.astimezone().strftime("%a %d %b %H:%M")
    except ValueError:
        return iso[:16]


def duration(seconds):
    s = int(seconds)
    if s < 90:
        return "%d s" % s
    if s < 3600:
        return "%d min" % (s / 60)
    if s < 86400:
        return "%d h %d min" % (s / 3600, s % 3600 / 60)
    return "%d d %d h" % (s / 86400, s % 86400 / 3600)


def size(kib):
    gib = kib / 1048576
    if gib >= 1024:
        return "%.1f TiB" % (gib / 1024)
    return "%.1f GiB" % gib if gib >= 1 else "%d MiB" % (kib / 1024)


def when(iso):
    """2026-11-09T06:32:25Z as `09 Nov 07:32, 1 h 3 min ago`."""
    dt = GLib.DateTime.new_from_iso8601(iso, None) if iso else None
    if dt is None:
        return iso or "never"
    ago = GLib.DateTime.new_now_utc().difference(dt) / 1000000
    return "%s, %s ago" % (dt.to_local().format("%d %b %H:%M"), duration(max(ago, 0)))


def load_recent():
    try:
        with open(RECENT, encoding="utf-8") as f:
            return [p for p in json.load(f).get("recent", []) if os.path.isfile(p)]
    except (OSError, ValueError, AttributeError):
        return []


def save_recent(paths):
    try:
        os.makedirs(os.path.dirname(RECENT), exist_ok=True)
        with open(RECENT, "w", encoding="utf-8") as f:
            json.dump({"recent": paths[:8]}, f)
    except OSError:
        pass


def tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path.startswith(home + "/") else path


def caption(text=""):
    return Gtk.Label(label=text, xalign=0, ellipsize=3, css_classes=["dim-label", "caption"])


def dot(state="unknown"):
    return Gtk.Box(css_classes=["ks-dot", state], halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)


def meter(fraction, **kw):
    bar = Gtk.LevelBar(min_value=0, max_value=1, value=min(max(fraction, 0), 1), valign=Gtk.Align.CENTER, **kw)
    for name in ("low", "high", "full"):
        bar.remove_offset_value(name)
    bar.add_offset_value("ks-ok", .85)
    bar.add_offset_value("ks-warn", .95)
    bar.add_offset_value("ks-bad", 1)
    return bar


SHORT = 90       # longer text is cut in its row and whole behind an (i)


def shorten(text, n=SHORT):
    """The text up to its first sentence's end, or cut at a word, when it is longer than n."""
    if len(text) <= n:
        return text
    for end in (". ", "; ", ": "):
        i = text.find(end)
        if 20 < i < n:
            return text[:i + 1] + " …"
    return text[:n].rsplit(" ", 1)[0] + " …"


def plain_row(title, subtitle="", **kw):
    """A row for text from elsewhere (an error, a path): `<` and `&` are just characters. Text
    too long for a row is cut, the whole of it behind an (i)."""
    row = Adw.ActionRow(use_markup=False, **kw)
    row.set_title(shorten(title))
    row.set_subtitle(shorten(subtitle))
    if len(title) > SHORT or len(subtitle) > SHORT:
        row.add_suffix(info_button("\n\n".join(t for t in (title, subtitle) if t)))
    return row


def info_row(title, value, copy=False):
    row = plain_row(title)
    row.add_suffix(Gtk.Label(label=value, xalign=1, wrap=True, natural_wrap_mode=Gtk.NaturalWrapMode.NONE, max_width_chars=60,
                             justify=Gtk.Justification.RIGHT, selectable=copy, css_classes=["dim-label"]))
    return row


def meter_row(title, fraction, text):
    row = plain_row(title, text)
    bar = meter(fraction)
    bar.set_size_request(170, -1)
    row.add_suffix(bar)
    return row


def tile(value, label, kind=None):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, css_classes=["card", "ks-tile"])
    box.append(Gtk.Label(label=value, xalign=0, css_classes=["ks-tile-value"] + ([kind] if kind else [])))
    box.append(caption(label))
