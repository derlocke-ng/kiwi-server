# kiwi-server stack — generated; the fleet file is the place to change it
[Unit]
Description=kiwi stack: km-pihole
Requires=km-vpn-server.service
After=km-vpn-server.service
StartLimitIntervalSec=0

[Container]
Image=docker.io/pihole/pihole:latest
ContainerName=km-pihole
Network=container:km-vpn-server
AutoUpdate=registry
AddCapability=NET_ADMIN
AddCapability=SYS_TIME
AddCapability=SYS_NICE
Environment=TZ=Europe/Berlin
Environment=FTLCONF_dns_upstreams=172.64.0.2;9.9.9.9;149.112.112.112
Environment=FTLCONF_misc_dnsmasq_lines=strict-order;no-hosts;local=/home/;hostsdir=/etc/mullvad-socks
Environment=FTLCONF_dns_listeningMode=all
Environment=FTLCONF_webserver_domain=pihole.gate.home
Environment=FTLCONF_webserver_port=8081
Environment="FTLCONF_dns_hosts=10.8.0.1 gate.home;10.8.0.1 wg.gate.home;10.8.0.1 pihole.gate.home;10.8.0.6 m1.home;10.8.0.6 pihole.m1.home;10.8.0.6 dl.m1.home;10.8.0.6 jd.m1.home;10.8.0.6 portainer.m1.home;10.8.0.25 sh3.home;10.8.0.25 cloud.sh3.home;10.8.0.25 vault.sh3.home;10.8.0.25 portainer.sh3.home;10.8.0.9 min.home"
EnvironmentFile=/home/user/docker/kiwi/env/km-pihole.env
Volume=/home/user/docker/km-pihole/etc-pihole:/etc/pihole:z
Volume=/home/user/docker/km-pihole/etc-dnsmasq.d:/etc/dnsmasq.d:z
Volume=/home/user/docker/km-pihole/mullvad-socks:/etc/mullvad-socks:ro,z
LogDriver=journald

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900

[Install]
WantedBy=kiwi-stack.target
