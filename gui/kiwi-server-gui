    def power_ask(self, name, act, label):
        def work():
            rc, out, err = run_cli(self.cli, ["power", self.doc.path, name, act, "--porcelain"])
            try:
                words = json.loads(out)["what"] if rc == 0 else None
            except (ValueError, KeyError):
                words = None
            GLib.idle_add(ask, words, err)

        def ask(words, err):
            if words is None:
                self.alert("Not possible", (err or "no answer").strip().replace("error: ", ""))
                return False
            dlg = Adw.AlertDialog(heading="%s %s?" % (label, name), body=" ".join(words))
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("go", label)
            dlg.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_close_response("cancel")
            dlg.connect("response", lambda _d, r: r == "go" and self.spawn(
                ["power", self.doc.path, name, act, "--yes"], "%s %s…" % ("Restarting" if act == "restart" else "Switching off", name)))
            dlg.present(self)
            return False
        threading.Thread(target=work, daemon=True).start()

