#!/usr/bin/env bash
# kiwi-stack — run the stack kiwi-server put on this machine.
#   kiwi-stack start|stop|restart|update|status|verify|logs [service]|vpn-restart
#   kiwi-stack backup|snapshots|restore MODULE...   this machine's data (the backup module)
#   kiwi-stack apply DIR          a rendered stack bundle, without a role script
#   kiwi-stack address [ADDRESS/PREFIX GATEWAY [DNS...]]   this machine's fixed address at home
# runtime podman: the containers are systemd units (quadlets in /etc/containers/systemd)
# runtime docker: docker compose with the rendered docker-compose.yml
set -euo pipefail
if [[ ${1:-} == apply ]]; then
    # a bundle directory rendered by kiwi-server or kiwi-modules, applied without a role script
    [[ -n ${2:-} ]] || { echo "usage: kiwi-stack apply DIR   (DIR holds stack.sh, the files, host-units/, quadlets/)" >&2; exit 1; }
    lib=${KIWI_STACK_LIB:-/usr/local/lib/kiwi-stack/lib.sh}
    [[ -f $lib ]] || { echo "kiwi-stack: $lib is missing — reinstall kiwi-stack" >&2; exit 1; }
    # shellcheck disable=SC1090
    . "$lib"
    # read by the library: it installs these two files over themselves
    # shellcheck disable=SC2034
    KS_STACK_SELF=$(readlink -f "$0")
    # shellcheck disable=SC2034
    KS_STACK_LIB_SELF=$(readlink -f "$lib")
    ks_stack_standalone "$2"
    exit 0
fi
if [[ ${1:-} == address ]]; then
    # A machine installed from media gets its address from the installer. A board starts
    # from an image and asks the router (DHCP), and an address changed in the fleet file has
    # to arrive somehow: this sets it where systemd-networkd runs the network (Armbian), and
    # puts back what was there when the new address does not work, so a wrong one never
    # leaves a machine nobody can reach. kiwi-server runs it detached, after the role.
    shift
    file=/etc/systemd/network/05-kiwi-lan.network      # sorts before netplan's files in /run: it wins for its card
    ifc=$(ip -o -4 route show default | awk '{print $5; exit}')
    [[ -n $ifc ]] || { echo "kiwi-stack: this machine has no default route, so no card to give the address to" >&2; exit 3; }
    state=$(networkctl status "$ifc" 2>/dev/null || true)      # not piped into grep -q: pipefail would count its early exit
    if ! systemctl is-active --quiet systemd-networkd || [[ $state != *"(configured)"* ]]; then
        echo "kiwi-stack: the network here is not run by systemd-networkd: this machine's address is set where it was installed" >&2
        exit 3
    fi
    if [[ $# -eq 0 ]]; then
        echo "$ifc $(ip -o -4 addr show dev "$ifc" scope global | awk '{print $4}' | tr '\n' ' ')$([[ -f $file ]] && echo fixed || echo dhcp)"
        exit 0
    fi
    want=$1 gw=${2:-}
    shift; [[ $# -gt 0 ]] && shift
    if [[ ! $want =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$ || ! $gw =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "usage: kiwi-stack address ADDRESS/PREFIX GATEWAY [DNS...]   e.g. kiwi-stack address 192.168.1.30/24 192.168.1.1 1.1.1.1" >&2
        exit 1
    fi
    ip=${want%%/*}
    mine() { ip -o -4 addr show dev "$ifc" | grep -q " $ip/"; }
    if ! mine && ping -c 1 -W 1 "$ip" >/dev/null 2>&1; then
        echo "kiwi-stack: $ip is in use by another device: nothing changed" >&2
        exit 4
    fi
    old=$(cat "$file" 2>/dev/null || true)
    {
        echo "# kiwi-server: this machine's fixed address at home (network.address in the fleet file)"
        printf '[Match]\nName=%s\n\n[Network]\nDHCP=no\nIPv6AcceptRA=yes\nAddress=%s\nGateway=%s\n' "$ifc" "$want" "$gw"
        for d in "$@"; do printf 'DNS=%s\n' "$d"; done
    } > "$file.new"
    chmod 0644 "$file.new"
    ks_replace "$file.new" "$file"
    networkctl reload
    networkctl reconfigure "$ifc"
    # it works when the card has the address and the router is there (seen on the wire: some do not answer pings)
    for _ in $(seq 1 20); do
        if mine; then
            ping -c 1 -W 1 "$gw" >/dev/null 2>&1 || true
            if ip neigh show "$gw" dev "$ifc" 2>/dev/null | grep -q lladdr; then
                echo "kiwi-stack: $ifc has $want now"
                exit 0
            fi
        fi
        sleep 2
    done
    if [[ -n $old ]]; then printf '%s\n' "$old" > "$file"; else rm -f "$file"; fi
    networkctl reload
    networkctl reconfigure "$ifc"
    echo "kiwi-stack: $want did not work on $ifc (the router $gw was not there): what it had before is back" >&2
    exit 4
fi
[[ -f /etc/kiwi-server/stack.env ]] || { echo "kiwi-stack: no stack on this machine yet (/etc/kiwi-server/stack.env) — kiwi-stack apply DIR" >&2; exit 1; }
# shellcheck disable=SC1091
. /etc/kiwi-server/stack.env
cd "$STACK_DIR"
case "${1:-}" in
    backup|snapshots|restore)
        [[ -x $STACK_DIR/kiwi/backup.sh ]] || { echo "kiwi-stack: this machine has no backup module" >&2; exit 1; }
        exec "$STACK_DIR/kiwi/backup.sh" "$@" ;;
esac
compose() { docker compose --file "$STACK_DIR/docker-compose.yml" "$@"; }
units() { local s; for s in $STACK_SERVICES; do printf '%s.service\n' "$s"; done; }
# The proxy as it is once the parts kept ready run here (kiwi-modules writes it as nginx-ready.conf):
# put in place and reloaded, so their names answer here at once. The apply that follows writes the
# proxy's own config again; a config nginx refuses is put back as it was.
proxy_now() {
    local d=$STACK_DIR/${STACK_PREFIX}-nginx keep rt=docker
    [[ -f $d/nginx-ready.conf && -f $d/nginx.conf ]] || return 0
    [[ $STACK_RUNTIME == podman ]] && rt=podman
    keep=$(mktemp) && cp "$d/nginx.conf" "$keep" || return 0
    cat "$d/nginx-ready.conf" > "$d/nginx.conf"       # in place: the container mounts this very file
    if "$rt" exec "${STACK_PREFIX}-nginx" nginx -t >/dev/null 2>&1 && "$rt" exec "${STACK_PREFIX}-nginx" nginx -s reload >/dev/null 2>&1; then
        echo "the proxy answers for them now"
    else
        cat "$keep" > "$d/nginx.conf"
        echo "the proxy did not take their sites: they answer after the apply" >&2
    fi
    rm -f "$keep"
}
# The parts kept ready for another machine (a standby): made, not started. A switch starts them
# here in seconds (kiwi-server switch); the apply that follows makes them the machine's own.
ready() {     # VERB [CONTAINER...]: those of the ready ones, or all of them
    local verb=${1:-list} s want=" ${*:2} " all=()
    # shellcheck disable=SC2086
    for s in ${STACK_READY:-}; do
        [[ $want == "  " || $want == *" $s "* ]] && all+=("$s")
    done
    set -- "${all[@]}"
    if [[ $verb == list ]]; then
        for s in "$@"; do
            if [[ $STACK_RUNTIME == podman ]]; then printf '%s %s\n' "$s" "$(systemctl is-active "$s.service" 2>/dev/null)"
            else printf '%s %s\n' "$s" "$(docker inspect -f '{{.State.Status}}' "$s" 2>/dev/null || echo missing)"; fi
        done
        return 0
    fi
    (( $# )) || { echo "kiwi-stack: this machine keeps no part ready for another one" >&2; return 1; }
    case $verb in
        start) if [[ $STACK_RUNTIME == podman ]]; then
                   systemctl daemon-reload
                   for s in "$@"; do systemctl start "$s.service" || return 1; done
               else
                   compose --profile kiwi-ready up --detach "$@" || return 1
               fi
               echo "started: $*"
               proxy_now ;;
        stop)  if [[ $STACK_RUNTIME == podman ]]; then
                   for s in "$@"; do systemctl stop "$s.service" || true; done
               else
                   compose --profile kiwi-ready stop "$@" || true
               fi ;;
        *)     echo "usage: kiwi-stack ready [list|start|stop] [CONTAINER...]" >&2; return 1 ;;
    esac
}
if [[ ${1:-} == ready ]]; then
    ready "${2:-list}" "${@:3}"
    exit $?
fi
# The parts of this machine that have a standby: they run only while the machine holds a permission
# for them (kiwi-server's kiwi-lease, which calls this). Not started by `up` or a boot.
lease() {     # VERB [CONTAINER...]: those of the leased ones, or all of them
    local verb=${1:-list} s want=" ${*:2} " all=()
    # shellcheck disable=SC2086
    for s in ${STACK_LEASED:-}; do
        [[ $want == "  " || $want == *" $s "* ]] && all+=("$s")
    done
    set -- "${all[@]}"
    if [[ $verb == list ]]; then
        for s in "$@"; do
            if [[ $STACK_RUNTIME == podman ]]; then printf '%s %s\n' "$s" "$(systemctl is-active "$s.service" 2>/dev/null)"
            else printf '%s %s\n' "$s" "$(docker inspect -f '{{.State.Status}}' "$s" 2>/dev/null || echo missing)"; fi
        done
        return 0
    fi
    (( $# )) || { echo "kiwi-stack: no part of this machine runs by a permission" >&2; return 1; }
    case $verb in
        start) if [[ $STACK_RUNTIME == podman ]]; then
                   for s in "$@"; do systemctl start "$s.service" || return 1; done
               else
                   compose --profile kiwi-leased up --detach "$@" || return 1
               fi ;;
        stop)  if [[ $STACK_RUNTIME == podman ]]; then
                   for s in "$@"; do systemctl stop "$s.service" || true; done
               else
                   compose --profile kiwi-leased stop "$@" || true
               fi ;;
        *)     echo "usage: kiwi-stack lease [list|start|stop] [CONTAINER...]" >&2; return 1 ;;
    esac
}
if [[ ${1:-} == lease ]]; then
    lease "${2:-list}" "${@:3}"
    exit $?
fi
# The host units (kn-gateway.service …) are ordered After=kiwi-stack.service,
# and `start` is kiwi-stack.service's own ExecStart: a blocking restart from
# here would wait for itself. --no-block queues the restart; systemd runs it
# once this service is up.
host_units() { local verb=$1 u; shift; for u in $STACK_UNITS; do systemctl "$verb" "$@" "$u" 2>/dev/null || true; done; }
# podman's conmon says this for every exec into a container under systemd (a health check, a
# cron run): harmless, and in a unit's status it hid everything else
# A unit's state without its log: the journal lines of a timer's last run (an ACME client's
# chatter) filled the status. A failed unit keeps its last lines: there they say why.
unit_status() {
    local u
    for u in $STACK_UNITS; do
        if systemctl is-failed -q "$u" 2>/dev/null; then systemctl status --no-pager -n 10 "$u"
        else systemctl status --no-pager -n 0 "$u"; fi 2>/dev/null || true
    done
}
quiet_conmon() { grep -v -E 'conmon\[[0-9]+\]: conmon [0-9a-f]+ <nwarn>: Failed to open cgroups file' || true; }
# The host and its containers reach the mesh through the VPN client (the WireGuard
# server on a master): one route via that container's address on the stack bridge.
# The bridge comes and goes with the stack, so the route is set after every start.
mesh_route() {
    [[ -n ${STACK_MESH_VIA:-} && -n ${STACK_MESH_SUBNET:-} ]] || return 0
    ip route replace "$STACK_MESH_SUBNET" via "$STACK_MESH_VIA" 2>/dev/null || true
}
misrouted() {
    # A container the machine cannot reach on its own stack network: a route for its address
    # points elsewhere. Seen with a router whose DHCP hands out a route for one address
    # (172.128.0.4 via another gateway) to a machine that has a container at that address:
    # the container runs and has no network. Said, not failed: the stack itself is up.
    [[ $STACK_RUNTIME == podman ]] || return 0
    local s ip dev
    for s in $STACK_SERVICES; do
        # a container asleep (a game server nobody plays on) does not exist until it wakes: its
        # failed inspect ended verify under set -e, after it had said every container runs (0.9.12)
        [[ -e ${KS_SLEEPING:-/run/kiwi-stack/sleeping}/$s ]] && continue
        ip=$(podman inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' "$s" 2>/dev/null | awk '{print $1}') || continue
        [[ -n $ip ]] || continue
        dev=$(ip -o route get "$ip" 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p')
        if [[ -n $dev && $dev != podman* && $dev != knet* && $dev != br-* && $dev != lo ]]; then
            echo "warning: $s ($ip) is not reached on the stack's network: this machine routes $ip through $dev, so the container has no network. A route from the router's DHCP does that; a fixed address for this machine ends it" >&2
        fi
    done
}
own_dns() { # on|off
    # The machine asks its own Pi-hole only while the stack runs. Set for good, it had nobody
    # to ask at boot until the stack was up: the time service could not find its servers, and
    # the stack, which waits for the clock, started a minute and a half late with a failed
    # unit to show for it; Pi-hole's own first fetch of its blocklist failed the same way.
    [[ -n ${STACK_DNS_IP:-} ]] || return 0
    systemctl is-active -q systemd-resolved 2>/dev/null || return 0
    # (a name of its own: a file in /etc of the same name would hide this one)
    local f=/run/systemd/resolved.conf.d/91-kiwi-stack-dns.conf want
    if [[ $1 == on ]]; then
        want=$(printf '%s\n' '[Resolve]' "DNS=$STACK_DNS_IP 1.1.1.1 1.0.0.1" 'Domains=~.')
        [[ -f $f && $(cat "$f") == "$want" ]] && return 0
        mkdir -p /run/systemd/resolved.conf.d
        printf '%s\n' "$want" > "$f"
    else
        [[ -f $f ]] || return 0
        rm -f "$f"
    fi
    systemctl restart systemd-resolved 2>/dev/null || true
}
verify() {
    # every service of the stack is running, or the names of those that are not;
    # a unit still (re)starting counts as down — a pull that cannot finish must not pass.
    # Asked again for a minute: a restarted container's network is followed by the
    # containers sharing it a few seconds later (BindsTo), and the first look caught them
    # stopped (an apply that changed the WireGuard server failed, found with federation)
    local s down=() asleep=() state tries=${KS_VERIFY_TRIES:-13}
    while :; do
        down=() asleep=()
        for s in $STACK_SERVICES; do
            # stopped while nobody uses it, woken by the first who does (a game server): not down
            if [[ -e ${KS_SLEEPING:-/run/kiwi-stack/sleeping}/$s ]]; then
                asleep+=("$s")
                continue
            fi
            # one of a part with a standby runs only with its permission (kiwi-lease): not down
            [[ " ${STACK_LEASED:-} " == *" $s "* ]] && continue
            if [[ $STACK_RUNTIME == podman ]]; then
                state=$(systemctl is-active "$s.service" 2>/dev/null || true)
                [[ $state == active ]] || down+=("$s ($state)")
            else
                state=$(docker inspect -f '{{.State.Status}}' "$s" 2>/dev/null || echo missing)
                [[ $state == running ]] || down+=("$s ($state)")
            fi
        done
        (( ${#down[@]} && --tries > 0 )) || break
        sleep 5
    done
    if (( ${#down[@]} )); then
        printf 'not running: %s\n' "${down[@]}" >&2
        return 1
    fi
    # one that runs and says it is not well (its health check fails): named here, and no failure.
    # An apply that changed something else must not fail for a part that hangs since yesterday;
    # right after a restart a container is "starting", so this never names what the apply restarted
    if [[ $STACK_RUNTIME == podman ]]; then
        local c sick=()
        while read -r c; do
            [[ -n $c && " $STACK_SERVICES " == *" $c "* ]] && sick+=("$c")
        done < <(podman ps --filter health=unhealthy --format '{{.Names}}' 2>/dev/null || true)
        (( ${#sick[@]} == 0 )) || echo "unhealthy (it runs, and its own check fails): ${sick[*]} — kiwi-stack logs <name>" >&2
    fi
    if (( ${#asleep[@]} )); then
        local list
        list=$(printf '%s, ' "${asleep[@]}")
        echo "all ${STACK_SERVICES// /, } running, asleep until someone comes: ${list%, }"
    else
        echo "all ${STACK_SERVICES// /, } running"
    fi
    misrouted
}
vpn_restart() {
    [[ -n ${STACK_VPN_CONTAINER:-} ]] || return 0
    # containers that share the VPN client's network namespace must follow it,
    # or they are left in a namespace that no longer exists
    # shellcheck disable=SC2086
    # One of a part with a standby is restarted only when it runs: a restart would start one that has
    # no permission (kiwi-lease).
    local s running=()
    if [[ $STACK_RUNTIME == podman ]]; then
        for s in $STACK_VPN_CONTAINER ${STACK_VPN_DEPENDENTS:-}; do
            if [[ " ${STACK_LEASED:-} " == *" $s "* ]]; then systemctl try-restart "$s.service"
            else systemctl restart "$s.service"; fi
        done
    else
        for s in ${STACK_VPN_DEPENDENTS:-}; do
            [[ " ${STACK_LEASED:-} " == *" $s "* && $(docker inspect -f '{{.State.Running}}' "$s" 2>/dev/null) != true ]] || running+=("$s")
        done
        docker restart "$STACK_VPN_CONTAINER" "${running[@]}"
    fi
}
# a backup before an update (the owner, 22 Nov 2026: "we backup before updates"): an update that
# breaks a part leaves data as it was a moment before. A failed backup: nothing is updated
backup_first() {
    [[ -x $STACK_DIR/kiwi/backup.sh && ${KIWI_UPDATE_NO_BACKUP:-} != 1 ]] || return 0
    echo "a backup first"
    "$STACK_DIR/kiwi/backup.sh" backup || { echo "the backup before the update failed: nothing was updated (kiwi-stack backup says why)" >&2; return 1; }
}
# the images' disk, nearly full: a master in RAM keeps them in half its memory (crumble, 18 Nov 2026:
# 95 %). podman auto-update pulls every new image before an old one goes; then there is no room.
tight() {
    local root use
    root=$(podman info --format '{{.Store.GraphRoot}}' 2>/dev/null) || return 1
    use=$(df --output=pcent "$root" 2>/dev/null | tail -1 | tr -dc 0-9)
    (( ${use:-0} >= 75 ))
}
# one image at a time: pull it, restart what runs it, drop the old copy; room for one new image is enough
update_one_by_one() {
    local unit image state
    while read -r unit image state; do
        [[ $state == pending ]] || continue
        echo "update: $image (for $unit), one at a time: the disk is nearly full"
        podman pull -q "$image" </dev/null >/dev/null && systemctl restart "$unit" </dev/null
        podman image prune -f </dev/null >/dev/null
    done < <(podman auto-update --dry-run --format '{{.Unit}} {{.Image}} {{.Updated}}' 2>/dev/null)
}
if [[ $STACK_RUNTIME == podman ]]; then
    case "${1:-}" in
        start)   systemctl daemon-reload; systemctl start kiwi-stack.target; mesh_route; own_dns on; host_units restart --no-block ;;
        up)      [[ -n ${KS_RELOADED:-} ]] || systemctl daemon-reload      # (an apply has done that itself, when it was due)
                 systemctl start kiwi-stack.target; mesh_route; own_dns on ;;
        stop)    own_dns off; host_units stop; systemctl stop kiwi-stack.target; mapfile -t u < <(units); systemctl stop "${u[@]}" ;;
        restart) "$0" stop; "$0" start ;;
        update)  backup_first || exit 1
                 if [[ ${STACK_AUTO_UPDATE:-registry} != registry ]]; then echo "auto_update is off: images change with an apply"
                 elif tight; then podman image prune -f >/dev/null; update_one_by_one
                 else podman auto-update; podman image prune -f >/dev/null; fi; mesh_route; host_units restart --no-block ;;
        status)  podman ps --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'; unit_status | quiet_conmon; verify || true ;;
        verify)  verify ;;
        logs)    if [[ -n ${2:-} ]]; then journalctl -f -u "$2.service"; else mapfile -t u < <(units); journalctl -f "${u[@]/#/-u}"; fi ;;
        vpn-restart) vpn_restart ;;
        *) echo "usage: kiwi-stack start|stop|restart|update|status|verify|logs [service]|vpn-restart|ready|backup|snapshots|restore|apply DIR" >&2; exit 1 ;;
    esac
else
    case "${1:-}" in
        start)   compose up --detach --remove-orphans; mesh_route; own_dns on; host_units restart --no-block ;;
        up)      compose up --detach --remove-orphans; mesh_route; own_dns on ;;
        stop)    own_dns off; host_units stop; compose down ;;
        restart) "$0" stop; "$0" start ;;
        update)  backup_first || exit 1
                 if [[ ${STACK_AUTO_UPDATE:-registry} == registry ]]; then compose pull; fi; compose up --detach --remove-orphans; mesh_route; docker image prune -f >/dev/null; host_units restart --no-block ;;
        status)  compose ps; unit_status; verify || true ;;
        verify)  verify ;;
        logs)    compose logs --follow "${@:2}" ;;
        vpn-restart) vpn_restart ;;
        *) echo "usage: kiwi-stack start|stop|restart|update|status|verify|logs [service]|vpn-restart|ready|backup|snapshots|restore|apply DIR" >&2; exit 1 ;;
    esac
fi
