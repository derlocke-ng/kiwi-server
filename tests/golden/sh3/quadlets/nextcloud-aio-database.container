# kiwi-server stack — generated; the fleet file is the place to change it
[Unit]
Description=kiwi stack: nextcloud-aio-database
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/nextcloud-releases/aio-postgresql:latest
ContainerName=nextcloud-aio-database
Network=knet-node.network
AutoUpdate=registry
RunInit=true
ReadOnly=true
User=999
DropCapability=NET_RAW
Tmpfs=/var/run/postgresql
ShmSize=268435456
StopTimeout=1800
Environment=POSTGRES_DB=nextcloud_database
Environment=POSTGRES_USER=nextcloud
Environment=AIO_LOG_LEVEL=warn
Environment=TZ=Europe/Berlin
Environment=PGTZ=Europe/Berlin
EnvironmentFile=/home/user/docker/kiwi/env/nextcloud-aio-database.env
AddHost=sh3.home:172.128.0.5
AddHost=cloud.sh3.home:172.128.0.5
AddHost=vault.sh3.home:172.128.0.5
AddHost=portainer.sh3.home:172.128.0.5
Volume=nextcloud_aio_database:/var/lib/postgresql/data:rw
Volume=nextcloud_aio_database_dump:/mnt/data:rw
HealthCmd=/healthcheck.sh
HealthInterval=30s
HealthTimeout=30s
HealthStartPeriod=0s
HealthRetries=3
LogDriver=journald

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900

[Install]
WantedBy=kiwi-stack.target
