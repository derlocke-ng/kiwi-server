                             sensitive=False)
        self.go.connect("clicked", lambda *_: self.add())
        self.name = Adw.EntryRow(title="Name, like annas-phone")
        self.name.connect("changed", lambda *_: self.go.set_sensitive(bool(self.clean())))
        self.name.connect("entry-activated", lambda *_: self.add())
        g.add(self.name)
        self.groups = sorted((win.fleet_info.get("groups") or {}))
