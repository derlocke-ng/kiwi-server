# immich
services:
  {{ container_prefix }}-immich:
    image: {{ image }}
    container_name: {{ container_prefix }}-immich
    depends_on:
      - {{ container_prefix }}-immich-db
      - {{ container_prefix }}-immich-redis
    environment:
      - DB_HOSTNAME={{ container_prefix }}-immich-db
      - DB_USERNAME=immich
      - DB_PASSWORD={{ db_password }}
      - DB_DATABASE_NAME=immich
      - REDIS_HOSTNAME={{ container_prefix }}-immich-redis
      - IMMICH_TRUSTED_PROXIES={{ docker_subnet }}
{% if machine_learning %}
      - IMMICH_MACHINE_LEARNING_URL=http://{{ container_prefix }}-immich-ml:3003
{% else %}
      - IMMICH_MACHINE_LEARNING_ENABLED=false
{% endif %}
      - TZ={{ timezone }}
{% if accounts_client and ca_cert_dir %}
      # the accounts' page has a certificate of the fleet's CA
      - NODE_EXTRA_CA_CERTS=/kiwi-ca/kiwiCA.crt
{% endif %}
{% for k, v in extra_env.items() %}
      - {{ k }}={{ v }}
{% endfor %}
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    restart: unless-stopped
    # the image's own check
    healthcheck:
      test: ["CMD", "immich-healthcheck"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 120s
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ library_path }}:/data:z
{% if accounts_client and ca_cert_dir %}
      - {{ ca_cert_dir }}:/kiwi-ca:ro,z
{% endif %}
{% for path in external_dirs %}
      - {{ path }}:{{ path }}:ro,z
{% endfor %}
{% if machine_learning %}

  {{ container_prefix }}-immich-ml:
    image: {{ ml_image }}
    container_name: {{ container_prefix }}-immich-ml
    networks:
      {{ network_name }}: {}
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - immich_model_cache:/cache
{% endif %}

  {{ container_prefix }}-immich-redis:
    image: {{ redis_image }}
    container_name: {{ container_prefix }}-immich-redis
    networks:
      {{ network_name }}: {}
    restart: unless-stopped
    # it answers
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: 10m

  {{ container_prefix }}-immich-db:
    image: {{ db_image }}
    container_name: {{ container_prefix }}-immich-db
    shm_size: 134217728
    environment:
      - POSTGRES_PASSWORD={{ db_password }}
      - POSTGRES_USER=immich
      - POSTGRES_DB=immich
      - POSTGRES_INITDB_ARGS=--data-checksums
      - TZ={{ timezone }}
    networks:
      {{ network_name }}: {}
    restart: unless-stopped
    # the database takes connections
    healthcheck:
      test: ["CMD", "pg_isready", "-q"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - immich_db:/var/lib/postgresql/data
