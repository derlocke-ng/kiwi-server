def find_cli():
    here = os.path.dirname(os.path.realpath(__file__))
    for c in (os.environ.get("KIWI_SERVER_CLI"), os.path.join(here, "..", "bin", "kiwi-server"),
              os.path.expanduser("~/.local/bin/kiwi-server"), "/usr/local/bin/kiwi-server"):
        if c and os.path.exists(c):
            return os.path.realpath(c)
    import shutil
    return shutil.which("kiwi-server")


def run_cli(cli, args, timeout=120):
    try:
        r = subprocess.run([cli] + list(args), capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


