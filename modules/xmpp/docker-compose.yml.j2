# xmpp (Prosody): start.sh brings the certificate and the admin's account, then runs the image's own start
services:
  {{ container_prefix }}-xmpp:
    image: {{ image }}
    container_name: {{ container_prefix }}-xmpp
    entrypoint: ["/bin/sh"]
    command: ["/kiwi-start.sh"]
    environment:
      - TZ={{ timezone }}
      - KIWI_ADMIN={{ admin_user }}@{{ xmpp_host }}
      - KIWI_ADMIN_PASSWORD={{ admin_password }}
    # in the WireGuard server's network: 5222 answers at the master's mesh address, and the
    # WireGuard server publishes 5222 and 5269 for a public name
    network_mode: "service:{{ container_prefix }}-vpn-server"
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-xmpp/start.sh:/kiwi-start.sh:ro,z
      - {{ docker_dir }}/{{ container_prefix }}-xmpp/prosody.cfg.lua:/etc/prosody/prosody.cfg.lua:ro,z
      - {{ docker_dir }}/{{ container_prefix }}-xmpp/data:/var/lib/prosody:z
      # the proxy's certificate for the name: the fleet CA's, or Let's Encrypt's for a public name
      - {{ docker_dir }}/{{ container_prefix }}-nginx{{ '/acme/' ~ xmpp_host if xmpp_public else '' }}:/kiwi-certs:ro,z
