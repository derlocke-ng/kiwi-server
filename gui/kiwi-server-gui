class LockDialog(Adw.Dialog):
    """When this computer locks the network's secrets by itself, and whether its key wants a
    password too (`kiwi-server secrets autolock`, `secrets password`; docs/security.md)."""
    IDLE = [("15m", "15 minutes"), ("30m", "30 minutes"), ("1h", "1 hour"), ("8h", "8 hours"), ("0", "Never")]

    def __init__(self, win):
        super().__init__(title="Locking", content_width=520, content_height=680)
        self.win = win
        st = dict(win.store or {})
        auto = st.get("autolock") or {"idle": "30m", "screen": True}
        page = Adw.PreferencesPage()
        tb = Adw.ToolbarView(content=page)
        tb.add_top_bar(Adw.HeaderBar())
        self.set_child(tb)
        g = Adw.PreferencesGroup(title="It locks by itself",
                                 description="So that a computer left unlocked gives away as little as possible. "
                                             "This computer's choice, for every network on it.")
        self.idle = Adw.ComboRow(title="When unused for", model=Gtk.StringList.new([t for _v, t in self.IDLE]))
        values = [v for v, _t in self.IDLE]
        self.idle.set_selected(values.index(str(auto.get("idle"))) if str(auto.get("idle")) in values else 1)
        self.idle.connect("notify::selected", lambda *_: self.set_auto(["--idle", values[self.idle.get_selected()]]))
        g.add(self.idle)
        self.screen = Adw.SwitchRow(title="When the screen locks", active=bool(auto.get("screen", True)))
        self.screen.connect("notify::active", lambda *_: self.set_auto(["--screen", "on" if self.screen.get_active() else "off"]))
        g.add(self.screen)
        page.add(g)
        p = Adw.PreferencesGroup(title="A password for this computer",
                                 description="The keyring opens with your login, so anyone at your unlocked computer could "
                                             "open the network's secrets. With a password they open only together with it, "
                                             "asked once per unlock. Forgotten: the recovery key still opens them.")
        if st.get("password"):
            p.add(plain_row("set", "this computer's key opens only with its password"))
            change = Adw.ButtonRow(title="Change the password…")
            change.connect("activated", lambda *_: self.password(change=True))
            p.add(change)
            off = Adw.ButtonRow(title="Remove the password")
            off.connect("activated", lambda *_: self.password(off=True))
            p.add(off)
        else:
            on = Adw.ButtonRow(title="Set a password…")
            on.connect("activated", lambda *_: self.password())
            p.add(on)
        page.add(p)
        r = Adw.PreferencesGroup(title="The recovery key",
                                 description="It was shown once, when the network's keys were made, and opens them when "
                                             "this computer is gone. Lost, or seen by someone: make a new one. The old one "
                                             "then opens only the copies made before.")
        renew = Adw.ButtonRow(title="A new recovery key…")
        renew.connect("activated", lambda *_: self.new_recovery())
        r.add(renew)
        page.add(r)

    def new_recovery(self):
        """Made, shown, typed back, and only then put in place of the old one."""
        path = self.win.doc.path

        def made():
            rc, out, err = run_cli(self.win.cli, ["secrets", "recovery", path, "--make"])
            key = out.strip()
            GLib.idle_add(lambda: (self.show_new(key) if rc == 0 and key.startswith("AGE-SECRET-KEY-1") else
                                   self.win.alert("No new recovery key", (err or out).strip().replace("error: ", "")), False)[-1])
        threading.Thread(target=made, daemon=True).start()

    def show_new(self, key):
        dlg = Adw.AlertDialog(heading="Your new recovery key",
                              body="Write it down or put it in a password manager now. It replaces the old one only once "
                                   "you have typed its last 8 characters below.")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        shown = Gtk.Label(label=key, selectable=True, wrap=True, wrap_mode=Pango.WrapMode.CHAR, css_classes=["monospace"])
        typed = Gtk.Entry(placeholder_text="its last 8 characters")
        box.append(shown)
        box.append(typed)
        dlg.set_extra_child(box)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("kept", "It is kept")
        dlg.set_response_appearance("kept", Adw.ResponseAppearance.SUGGESTED)
        path = self.win.doc.path

        def answer(_d, r):
            ok = r == "kept" and typed.get_text().strip().upper() == key[-8:].upper()
            shown.set_label("")
            if not ok:
                self.win.toast("Nothing changed: the old recovery key is still the one")
                return

            def work():
                rc, out, err = run_cli(self.win.cli, ["secrets", "recovery", path, "--key-stdin"], input=key + "\n")
                said = ((err or out).strip().replace("error: ", "").replace(":: ", "").splitlines() or [""])[-1]
                GLib.idle_add(lambda: (self.win.toast(said[:160]), self.win.poll(), False)[-1])
            threading.Thread(target=work, daemon=True).start()
        dlg.connect("response", answer)
        dlg.present(self)

    def set_auto(self, args):
        path = self.win.doc.path

        def work():
            rc, out, err = run_cli(self.win.cli, ["secrets", "autolock", path] + args)
            GLib.idle_add(lambda: (self.win.toast(((err or out).strip().replace("error: ", "").splitlines() or [""])[-1][:160]),
                                   self.win.poll(), False)[-1])
        threading.Thread(target=work, daemon=True).start()

    def password(self, change=False, off=False):
        dlg = Adw.AlertDialog(heading="Remove the password" if off else "A password for this computer",
                              body="Its current password first." if off else
                              "8 characters or more. Asked once each time the secrets open.")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        entries = []
        for label in (["Current password"] if (change or off) else []) + ([] if off else ["New password", "The same again"]):
            e = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text=label)
            entries.append(e)
            box.append(e)
        dlg.set_extra_child(box)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("ok", "Remove" if off else "Set")
        dlg.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE if off else Adw.ResponseAppearance.SUGGESTED)
        path = self.win.doc.path

        def answer(_d, r):
            if r != "ok":
                return
            lines = "".join(e.get_text() + "\n" for e in entries)
            for e in entries:
                e.set_text("")
            args = ["secrets", "password", path, "--password-stdin"] + (["--off"] if off else [])

            def work():
                rc, out, err = run_cli(self.win.cli, args, input=lines)
                said = ((err or out).strip().replace("error: ", "").replace(":: ", "").splitlines() or [""])[-1]
                GLib.idle_add(lambda: (self.win.toast(said[:160]), self.win.poll(), self.close() if rc == 0 else None, False)[-1])
            threading.Thread(target=work, daemon=True).start()
        dlg.connect("response", answer)
        dlg.present(self)


