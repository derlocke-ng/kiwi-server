# Local DNS records for {{ hostname }} — generated by kiwi-server from the fleet file.
# Pi-hole reads this as its local DNS records (hosts/custom.list).
{% if fleet_records %}
{% for ip, name in dns_records %}
{{ ip }} {{ name }}
{% endfor %}
{% endif %}
{% for name, ip in extra_records.items() %}
{{ ip }} {{ name }}
{% endfor %}
