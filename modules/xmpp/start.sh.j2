#!/bin/sh
# Before ejabberd starts (as root, for the copying only): the certificate of its name, from
# the reverse proxy's, in a file ejabberd's own user may read; a certificate of its own for a
# hidden service's name; then ejabberd, as its user. Once it runs: the admin's account with
# the password of the settings. The password comes in KIWI_ADMIN_PASSWORD; ejabberd does not
# get it in its environment, and nothing here prints it.
host=$KIWI_HOST
onion=$KIWI_ONION
admin=$KIWI_ADMIN
pw=$KIWI_ADMIN_PASSWORD
unset KIWI_ADMIN_PASSWORD
C=/opt/ejabberd/conf/certs
say() { echo "kiwi: $*"; }
as_ejabberd() { su ejabberd -s /bin/sh -c "$1"; }

# the folder of this name: its accounts, messages, files and certificates. Made once; for a
# service from before there were such folders, from the old folder that holds this name's
# accounts (its own first, else the other service's), which stays as it was
X=/kiwi-xmpp
d=$X/hosts/$host
mentions() { cat "$X/$1"/database/passwd.D* 2>/dev/null | grep -aqF "$host"; }
if [ ! -d "$d/database" ]; then
    from=
    for o in "$KIWI_OLD" "$KIWI_OTHER"; do
        if [ -n "$o" ] && mentions "$o"; then from=$o; break; fi
    done
    if [ -z "$from" ] && [ -n "$(ls -A "$X/$KIWI_OLD/database" 2>/dev/null)" ]; then from=$KIWI_OLD; fi
    rm -rf "$d.new"
    mkdir -p "$d.new"
    if [ -n "$from" ]; then
        cp -a "$X/$from/." "$d.new/" && say "the accounts of $host come from the folder $from (it stays as it was)"
    fi
    mkdir -p "$d.new/database" "$d.new/upload" "$d.new/certs"
    mv "$d.new" "$d"
fi
for x in database upload; do
    rm -rf "/opt/ejabberd/$x"
    ln -s "$d/$x" "/opt/ejabberd/$x"
done
rm -rf "$C"
ln -s "$d/certs" "$C"

n=0
until [ -s /kiwi-certs/fullchain.pem ] && [ -s /kiwi-certs/privkey.pem ]; do
    # a public name: the proxy fetches its certificate at its first start
    [ "$n" = 0 ] && say "waiting for the certificate of $host from the reverse proxy"
    n=$((n + 1)); sleep 10
done
certs() {
    cat /kiwi-certs/fullchain.pem /kiwi-certs/privkey.pem > "$C/.new" && chmod 0600 "$C/.new" \
        && chown ejabberd:ejabberd "$C/.new" && mv "$C/.new" "$C/$host.pem"
}
certs
if [ -n "$onion" ] && [ ! -s "$C/$onion.pem" ]; then
    # nobody signs a .onion name: its certificate is this server's own, made once
    if openssl req -x509 -newkey rsa:2048 -nodes -days 3650 -subj "/CN=$onion" \
            -addext "subjectAltName=DNS:$onion,DNS:rooms.$onion" -keyout "$C/.k" -out "$C/.c" 2>/dev/null; then
        cat "$C/.c" "$C/.k" > "$C/$onion.pem"
        say "made a certificate for $onion"
    fi
    rm -f "$C/.k" "$C/.c"
fi
chown -R ejabberd:ejabberd "$d"
chmod 0600 "$C"/*.pem 2>/dev/null

account() {
    tries=0
    until as_ejabberd "ejabberdctl status" >/dev/null 2>&1; do
        tries=$((tries + 1))
        if [ "$tries" -ge 180 ]; then
            say "ejabberd did not answer in three minutes; the account $admin@$host was not checked"
            return 0
        fi
        sleep 1
    done
    if [ -z "$pw" ]; then
        say "no admin password in the settings; the account $admin@$host was not checked"
        return 0
    fi
    # made when it is not there; its password is the settings' at every start. The words go to
    # ejabberdctl as arguments of a shell that gets them by position, not pasted into a command
    # (the password in the environment of that one command: as an argument of su, one that starts
    # with a dash would be read as an option of su)
    if KIWI_PW=$pw su ejabberd -s /bin/sh -c 'ejabberdctl register "$0" "$1" "$KIWI_PW"' "$admin" "$host" >/dev/null 2>&1; then
        say "made the account $admin@$host"
    elif KIWI_PW=$pw su ejabberd -s /bin/sh -c 'ejabberdctl change_password "$0" "$1" "$KIWI_PW"' "$admin" "$host" >/dev/null 2>&1; then
        :
    else
        say "could not make or set the account $admin@$host"
    fi
}
account &

# a new certificate: taken over and loaded without a restart. Within a minute during the first
# hour (a public name starts on the fleet's certificate until Let's Encrypt's is there), within
# the hour after that (a renewal)
(
    was=$(cat /kiwi-certs/fullchain.pem | sha256sum)
    rounds=0
    while sleep $([ "$rounds" -lt 60 ] && echo 60 || echo 3600); do
        rounds=$((rounds + 1))
        now=$(cat /kiwi-certs/fullchain.pem 2>/dev/null | sha256sum)
        if [ -s /kiwi-certs/fullchain.pem ] && [ "$now" != "$was" ]; then
            certs && as_ejabberd "ejabberdctl reload_config" >/dev/null 2>&1 && say "the renewed certificate is in use"
            was=$now
        fi
    done
) &
exec su ejabberd -s /bin/sh -c "exec ejabberdctl foreground"
