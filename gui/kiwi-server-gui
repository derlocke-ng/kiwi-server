class TextDialog(Adw.Dialog):
    def __init__(self, title, text, mono=True):
        super().__init__(title=title, content_width=820, content_height=620)
        tv = Gtk.TextView(editable=False, monospace=mono, left_margin=10, right_margin=10,
                          top_margin=8, wrap_mode=Gtk.WrapMode.NONE if mono else Gtk.WrapMode.WORD)
        tv.get_buffer().set_text(text)
        sc = Gtk.ScrolledWindow(child=tv, vexpand=True)
        tb = Adw.ToolbarView(content=sc)
        tb.add_top_bar(Adw.HeaderBar())
        self.set_child(tb)


class DoctorDialog(Adw.Dialog):
    def __init__(self, win):
        super().__init__(title="Doctor", content_width=700, content_height=520)
        self.win = win
        self.tv = Gtk.TextView(editable=False, monospace=True, left_margin=10, right_margin=10, top_margin=8)
        sc = Gtk.ScrolledWindow(child=self.tv, vexpand=True)
        hb = Adw.HeaderBar()
        btn = Gtk.Button(label="Build toolchain image")
        btn.set_tooltip_text("podman/docker image with butane, coreos-installer and xorriso — for desktops that do not have them")
        btn.connect("clicked", lambda *_: (self.close(), win.spawn(["toolchain", "build"], "Building the toolchain image…")))
        hb.pack_end(btn)
        tb = Adw.ToolbarView(content=sc)
        tb.add_top_bar(hb)
        self.set_child(tb)
        self.tv.get_buffer().set_text("checking…")
        threading.Thread(target=self.run, daemon=True).start()

    def run(self):
        rc, out, err = run_cli(self.win.cli, ["doctor"])
        GLib.idle_add(self.tv.get_buffer().set_text, (out + err).strip() or "no output")


