# kiwi-server: the fleet's names as {{ hostname }} answers for them (module.yaml says why a file).
# An apply rewrites this file; dnsmasq reloads it by itself, Pi-hole goes on running.
{# on a LAN, a node on that same LAN answers with its LAN address: its traffic stays on the switch #}
{% if fleet_records %}
{% for ip, name in dns_records if name not in moving_names %}
{{ ip if name in mesh_only else lan_addresses.get(ip, ip) }} {{ name }}
{% endfor %}
{% endif %}
{% for name, ip in extra_records.items() %}
{{ ip }} {{ name }}
{% endfor %}
