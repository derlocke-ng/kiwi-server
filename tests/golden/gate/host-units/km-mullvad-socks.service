[Unit]
Description=Kiwi Network: Pi-hole records for the Mullvad SOCKS5 proxies (gate.home)
Documentation=https://github.com/derlocke-ng/kiwi-server https://github.com/derlocke-ng/mullvad-socks5
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# curl gives up after its retries; this bounds anything else
TimeoutStartSec=15min
ExecStart=/usr/bin/bash /home/user/docker/kiwi/mullvad-socks.sh
# root, fetching from the Internet: it may write one directory and nothing else
ProtectSystem=strict
ReadWritePaths=-/home/user/docker/km-pihole
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# no [Install]: km-mullvad-socks.timer starts it (and the apply, once)
