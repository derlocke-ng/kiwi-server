[Unit]
Description=Kiwi Network: Pi-hole's blocklist is there (gate.home)
Documentation=https://github.com/derlocke-ng/kiwi-server
After=kiwi-stack.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=15min
ExecStart=/usr/bin/bash /home/user/docker/kiwi/pihole-blocklist.sh

# no [Install]: km-pihole-blocklist.timer starts it
