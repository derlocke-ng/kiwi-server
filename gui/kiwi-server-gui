class DiffDialog(Adw.Dialog):
    """This copy next to the other computers' (`kiwi-server control diff`): each file that differs,
    who changed it since the last sync, and in the settings the lines, every secret value hidden.
    When both sides changed something, the buttons say which copy counts."""
    WHO = {"here": ("changed on this computer", "accent"), "there": ("changed on the other side", "warning"),
           "both": ("changed on both sides", "error"), "unknown": ("differs", "dim-label")}

    def __init__(self, win, both=False):
        super().__init__(title="This copy and the other", content_width=720, content_height=720)
        self.win, self.both = win, both
        self.load()

    def load(self):
        self.set_child(Adw.StatusPage(title="Comparing the two copies…", child=Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER)))
        path = self.win.doc.path

        def work():
            rc, out, err = run_cli(self.win.cli, ["control", "diff", path, "--porcelain"], timeout=180)
            try:
                got = json.loads(out)["differences"] if rc == 0 else None
            except (ValueError, KeyError):
                got = None
            GLib.idle_add(self.show, got, (err.strip().replace("error: ", "").splitlines() or ["no answer"])[-1])
        threading.Thread(target=work, daemon=True).start()

    def show(self, got, why):
        tb = Adw.ToolbarView()
        tb.add_top_bar(Adw.HeaderBar())
        if got is None:
            tb.set_content(Adw.StatusPage(title="The two copies could not be compared", description=why,
                                          icon_name="dialog-information-symbolic"))
            self.set_child(tb)
            return False
        page = Adw.PreferencesPage()
        if not got:
            tb.set_content(Adw.StatusPage(title="The two copies are the same", icon_name="object-select-symbolic",
                                          description="Nothing to decide."))
            self.set_child(tb)
            return False
        both = any(r["who"] == "both" and not r.get("auto") for r in got)
        g = Adw.PreferencesGroup(title="What differs", description=(
            "Both sides changed the files marked red: say below which side counts for them. Everything else is "
            "merged by itself." if both else "Nothing to decide: the next sync makes one copy of the two by itself."))
        for r in sorted(got, key=lambda r: (bool(r.get("auto")), r["path"])):
            words, style = self.WHO[r["who"]]
            if r.get("auto"):
                words, style = words + ", merged by itself", "dim-label"
            name = r["path"].replace("secrets/", "secret: ").replace("fleet.yaml", "the settings (fleet.yaml)")
            row = Adw.ExpanderRow(title=GLib.markup_escape_text(name),
                                  subtitle=GLib.markup_escape_text(words + ("" if r["state"] == "changed" else ", " + r["state"])))
            row.add_suffix(Gtk.Label(label="●", css_classes=[style], valign=Gtk.Align.CENTER))
            if r["lines"]:
                view = Gtk.TextView(editable=False, cursor_visible=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                                    top_margin=8, bottom_margin=8, left_margin=10, right_margin=10)
                buf = view.get_buffer()
                tags = {"-": buf.create_tag(None, foreground="#c4332b"), "+": buf.create_tag(None, foreground="#13805c"),
                        "@": buf.create_tag(None, foreground="#8a9297")}
                for line in r["lines"]:
                    tag = tags.get(line[:1])
                    end = buf.get_end_iter()
                    if tag:
                        buf.insert_with_tags(end, line + "\n", tag)
                    else:
                        buf.insert(end, line + "\n")
                row.add_row(view)
                row.set_expanded(len(got) == 1 or (r["who"] == "both" and not r.get("auto")))
            else:
                row.set_enable_expansion(False)
            g.add(row)
        page.add(g)
        legend = Adw.PreferencesGroup(description="Red: as the other copy has it. Green: as this computer has it. "
                                                  "Secret values show as •••; of a secret file only its size and "
                                                  "the names that differ are shown, never a value.")
        page.add(legend)
        if both:
            g = Adw.PreferencesGroup(title="For the files marked red, which side counts?",
                                     description="Only those files: every other change of both sides is kept.")
            box = Gtk.Box(spacing=10, halign=Gtk.Align.START)
            for label, how, style in (("This computer's", "here", "suggested-action"), ("The other one's", "there", "")):
                b = Gtk.Button(label=label, css_classes=["pill"] + ([style] if style else []))
                b.connect("clicked", lambda _b, h=how: self.decide(h))
                box.append(b)
            g.add(box)
            page.add(g)
        tb.set_content(page)
        self.set_child(tb)
        return False

    def decide(self, keep):
        """Of what both changed, this side's or the other's; everything else merged (`--keep`)."""
        path = self.win.doc.path
        self.set_child(Adw.StatusPage(title="Making one copy of the two…",
                                      child=Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER)))

        def done(rc, out, err):
            if rc != 0:
                self.win.toast("Not in step: %s" % ((err or out).strip().splitlines() or ["?"])[-1][:160])
                self.load()
                return
            self.win.open_path(path, sync=False)
            self.win.toast("In step: one copy of the two, %s for what both changed"
                           % ("this computer's" if keep == "here" else "the other's"), "ok")
            self.close()
        run_cli_then(self.win.cli, ["control", "push", path, "--keep", keep], done, timeout=180)


class ActivityDialog(Adw.Dialog):
    """The control node's Activity: its newest tasks and who did what, as on the control page.
    Through `kiwi-server control activity`, with this computer's key."""
    VERBS = {"status": "Checked", "plan": "Previewed", "apply": "Applied to", "check": "Checked the names",
             "backup": "Saved the network", "watch": "Looked for restarted masters", "save": "Saved the data of",
             "update": "Updated every machine", "rotate": "Replaced the SSH keys", "setup": "Set up",
             "build": "Made the install media of", "restore": "Brought back on", "unlock": "Unlocked", "remove": "Removed",
             "rotate-seed": "Replaced the secrets inside the services", "tell-test": "Sent a test message",
             "start-new": "Started a new backup history of", "prune": "Removed old snapshots on",
             "doctor": "Checked the tools of the control node", "adopt": "Took in",
             "service": "Looked after a container on", "reboot": "Restarted", "poweroff": "Switched off", "wake": "Woke",
             "move": "Moved a part between", "switch": "Gave a part to its standby, from", "mtu": "Measured the MTU of",
             "rotate-ring": "Replaced the keys of an unlock ring"}
    STATE = {"waiting": "waiting", "running": "running", "ok": "done", "failed": "did not work"}

    def __init__(self, win, host=None):
        """`host`: only what was done to this machine (its History, as on its page on the control node)."""
        super().__init__(title="History of %s" % host if host else "Activity", content_width=640, content_height=700)
        self.win, self.host = win, host
        self.load()

    def mine(self, x):
        return not self.host or self.host in (x.get("hosts") or [])

    def load(self):
        self.set_child(Adw.StatusPage(title="Asking the control node…", child=Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER)))
        path = self.win.doc.path

        def work():
            rc, out, err = run_cli(self.win.cli, ["control", "activity", path, "--porcelain"], timeout=60)
            try:
                got = json.loads(out.strip().splitlines()[-1]) if rc == 0 and out.strip() else None
            except (ValueError, IndexError):
                got = None
            why = (err.strip().replace("error: ", "").splitlines() or ["no answer"])[-1]
            GLib.idle_add(self.show, got, why)
        threading.Thread(target=work, daemon=True).start()

    def show(self, got, why):
        tb = Adw.ToolbarView()
        hb = Adw.HeaderBar()
        again = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Ask again")
        again.connect("clicked", lambda *_: self.load())
        hb.pack_start(again)
        tb.add_top_bar(hb)
        if got is None:
            tb.set_content(Adw.StatusPage(title="The control node did not tell", description=why,
                                          icon_name="dialog-information-symbolic"))
            self.set_child(tb)
            return False
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(title="Tasks", description="What the control node did or does, newest first.")
        jobs = [j for j in got.get("jobs") or [] if self.mine(j)]
        entries = [e for e in got.get("entries") or [] if self.mine(e)]
        for j in jobs:
            when = (j.get("started") or j.get("id") or "")[:16].replace("T", " ")
            title = ("%s %s" % (self.VERBS.get(j.get("action"), j.get("action") or ""), " ".join(j.get("hosts") or []))).strip()
            row = plain_row(title, "%s · %s" % (when, j.get("user") or ""))
            row.add_suffix(Gtk.Label(label=self.STATE.get(j.get("state"), j.get("state") or ""),
                                     css_classes=["error" if j.get("state") == "failed" else "dim-label"]))
            g.add(row)
        if not jobs:
            g.add(plain_row("None since its page was last unlocked."))
        page.add(g)
        g = Adw.PreferencesGroup(title="Log", description="What was done to %s, and by whom." % self.host if self.host
                                 else "Who did what there: on its page, or from a computer.")
        for e in entries:
            sub = "%s · %s" % ((e.get("time") or "")[:16].replace("T", " "), e.get("user") or "")
            if e.get("address"):
                sub += " · %s" % e["address"]
            what = self.VERBS.get(e.get("what"), e.get("what") or "")
            row = plain_row(("%s %s" % (what, " ".join(e.get("hosts") or []))).strip(), sub)
            if e.get("result"):                 # how a task ended: as the machine's History on the page says it
                row.add_suffix(Gtk.Label(label=self.STATE.get(e["result"], e["result"]),
                                         css_classes=["error" if e["result"] == "failed" else "dim-label"]))
            g.add(row)
        if not entries:
            g.add(plain_row("Empty."))
        page.add(g)
        tb.set_content(page)
        self.set_child(tb)
        return False


class AccountsDialog(Adw.Dialog):
    """The network's accounts (the accounts module) and Jabber's sign-up page: requests to accept or
    deny, invite codes, the accounts and their password links. Through `kiwi-server accounts`, as
    the control page's Accounts does."""

    # the services the network's accounts can sign people in to (kiwi-server accounts connect)
    CONNECTABLE = (("git", "Forgejo (git)"), ("cloud", "Nextcloud (files)"), ("paperless", "Paperless (documents)"),
                   ("vault", "Vaultwarden (passwords)"), ("immich", "Immich (photos)"), ("control", "Game page (play)"))

    def __init__(self, win):
        super().__init__(title="Accounts", content_width=660, content_height=720)
        self.win = win
        self.load()

    def load(self):
        self.set_child(Adw.StatusPage(title="Asking the accounts…", child=Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER)))
        path = self.win.doc.path

        def ask(*args):
            rc, out, err = run_cli(self.win.cli, ["accounts", path] + list(args))
            try:
                return (json.loads(out.strip().splitlines()[-1]) if rc == 0 and out.strip() else None), (err.strip().splitlines() or [""])[-1]
            except (ValueError, IndexError):
                return None, "the answer could not be read"

        def work():
            got = {k: ask(*a) for k, a in (("people", ("list",)), ("requests", ("requests",)), ("invites", ("invites",)),
                                            ("jrequests", ("requests", "--jabber")), ("jinvites", ("invites", "--jabber")))}
            rc, out, _err = run_cli(self.win.cli, ["list", path, "--porcelain"])
            try:
                listed = json.loads(out) if rc == 0 else {}
            except ValueError:
                listed = {}
            got["hosts"], got["play"] = listed.get("hosts") or [], listed.get("play")
            GLib.idle_add(lambda: self.build(got) and False)
        threading.Thread(target=work, daemon=True).start()

    def act(self, args, done_text, show=None):
        """One change, beside the window; then the list again. `show`: what of the answer to show (a code, a link)."""
        path = self.win.doc.path

        def work():
            rc, out, err = run_cli(self.win.cli, ["accounts", path] + list(args), timeout=180)
            GLib.idle_add(lambda: self.after(rc, out, err, done_text, show) and False)
        threading.Thread(target=work, daemon=True).start()

    def after(self, rc, out, err, done_text, show):
        if rc != 0:
            self.win.toast((err.strip().splitlines() or ["not done"])[-1].replace("error: ", ""))
            return
        if show:
            try:
                answer = json.loads(out.strip().splitlines()[-1])
            except (ValueError, IndexError):
                answer = {}
            title, key, note = show
            TextDialog(title, "%s\n\n%s" % (answer.get(key, ""), note), mono=False).present(self.win)
        self.win.toast(done_text)
        self.load()

