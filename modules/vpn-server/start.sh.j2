#!/usr/bin/env sh
# WG_POST_UP for the WireGuard server of {{ hostname }} — generated by kiwi-server.
# Runs inside the wg-easy container every time wg0 comes up.
{# the client groups: the legacy isolated_subnet is one more group; reach entries
   may name a host by its full name or its first label #}
{% set all_groups = {} %}
{% for gname, g in (groups or {}).items() %}{% set _ = all_groups.update({gname: g}) %}{% endfor %}
{% if isolated_subnet %}{% set _ = all_groups.update({'isolated': {'subnet': isolated_subnet, 'reach': ['nodes'] + isolated_allow, 'peers': false}}) %}{% endif %}
{% set host_ips = {} %}
{% for ip, name in dns_records %}{% set _ = host_ips.update({name: ip, name.split('.')[0]: ip}) %}{% endfor %}
sleep 2

# MTU: clamp TCP MSS to the path MTU so WireGuard's overhead cannot stall connections
iptables -t mangle -A FORWARD -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu

# clients never reach the docker network behind the server
iptables -A FORWARD -s {{ mesh_subnet }} -d {{ docker_subnet }} -j DROP
{% for gname, g in all_groups.items() %}
{% set subnet = g.get('subnet') %}
{% set reach = g.get('reach', ['all']) or [] %}
{% set peers = g.get('peers', true) %}
{% set internet = g.get('internet', true) %}
{% set admin = g.get('admin', false) %}

# group {{ gname }} ({{ subnet }}): reach {{ reach | join(', ') if reach else 'nothing' }}; other clients {{ 'yes' if peers else 'no' }}; internet {{ 'yes' if internet else 'no' }}; admin pages {{ 'yes' if admin else 'no' }}
# (before the wg0 accept-all below — iptables stops at the first match)
iptables -A FORWARD -s {{ subnet }} -d {{ server_ip }} -j ACCEPT
{% if not admin %}
iptables -A INPUT -i wg0 -s {{ subnet }} -p tcp --dport 51821 -j DROP
iptables -A INPUT -i wg0 -s {{ subnet }} -p tcp --dport 80 -j DROP
iptables -A INPUT -i wg0 -s {{ subnet }} -p tcp --dport 443 -j DROP
{% endif %}
{% if not peers %}
iptables -A FORWARD -p icmp --icmp-type echo-request -s {{ subnet }} -d {{ mesh_subnet }} -j DROP
iptables -A FORWARD -p icmp --icmp-type echo-reply -s {{ subnet }} -d {{ mesh_subnet }} -j DROP
{% endif %}
{% if 'all' in reach %}
{% if not peers %}
{% for ip in mesh_ips | reject('equalto', server_ip) | unique %}
iptables -A FORWARD -s {{ subnet }} -d {{ ip }} -j ACCEPT
{% endfor %}
iptables -A FORWARD -s {{ subnet }} -d {{ mesh_subnet }} -j DROP
{% endif %}
{% else %}
{% set allowed = [] %}
{% for r in reach %}
{% if r == 'nodes' %}{% for ip in mesh_ips %}{% set _ = allowed.append(ip) %}{% endfor %}
{% elif r in host_ips %}{% set _ = allowed.append(host_ips[r]) %}
{% else %}{% set _ = allowed.append(r) %}{% endif %}
{% endfor %}
{% for dest in allowed | reject('equalto', server_ip) | unique %}
iptables -A FORWARD -s {{ subnet }} -d {{ dest }} -j ACCEPT
{% endfor %}
{% if peers %}
{% for ip in mesh_ips | reject('equalto', server_ip) | reject('in', allowed) | unique %}
iptables -A FORWARD -s {{ subnet }} -d {{ ip }} -j DROP
{% endfor %}
{% else %}
iptables -A FORWARD -s {{ subnet }} -d {{ mesh_subnet }} -j DROP
{% endif %}
{% endif %}
{% if not internet %}
iptables -A FORWARD -s {{ subnet }} ! -d {{ mesh_subnet }} -j DROP
{% else %}
iptables -t nat -A POSTROUTING -s {{ subnet }} -o eth0 -j MASQUERADE
{% endif %}
{% endfor %}

# the admin pages for clients outside every group (the plain mesh, {{ wg_subnet }})
{% if not admin_from_mesh %}
iptables -A INPUT -i wg0 -p tcp --dport 51821 -j DROP
iptables -A INPUT -i wg0 -p tcp --dport 80 -j DROP
iptables -A INPUT -i wg0 -p tcp --dport 443 -j DROP
{% endif %}

# stock wg-easy post-up
iptables -t nat -A POSTROUTING -s {{ wg_subnet }} -o eth0 -j MASQUERADE
iptables -A INPUT -p udp -m udp --dport 51820 -j ACCEPT
iptables -A INPUT -p tcp -m tcp --dport 80 -j ACCEPT
iptables -A FORWARD -i wg0 -j ACCEPT
iptables -A FORWARD -o wg0 -j ACCEPT
# the master itself and its containers reach the nodes as the server's mesh address
iptables -t nat -A POSTROUTING -s {{ docker_subnet }} -o wg0 -j MASQUERADE
{% if has_vpn_client %}

# the double hop: everything leaves through the VPN client …
ip route del default
ip route add default via {{ vpn_client_ip }}

# … except the server's own ports, which must answer on the real interface
grep -q novpn /etc/iproute2/rt_tables 2>/dev/null || echo "201 novpn" >> /etc/iproute2/rt_tables
ip rule add fwmark 65 table novpn
ip route add default via {{ docker_gateway }} dev eth0 table novpn
ip route flush cache
iptables -t mangle -A OUTPUT -p udp --sport 51820 -j MARK --set-mark 65
iptables -t mangle -A OUTPUT -p tcp --sport 51821 -j MARK --set-mark 65
iptables -t mangle -A OUTPUT -p tcp --sport 80 -j MARK --set-mark 65
{% endif %}
