# reverse-proxy (nginx) — TLS termination for every web service on the node
services:
  {{ container_prefix }}-nginx:
    image: {{ image }}
    container_name: {{ container_prefix }}-nginx
{% if network_mode %}
    network_mode: "service:{{ container_prefix }}-{{ network_mode }}"
{% else %}
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    ports:
      - "80:80"
      - "443:443"
{% endif %}
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-nginx/nginx.conf:/etc/nginx/nginx.conf:ro,z
      - {{ docker_dir }}/{{ container_prefix }}-nginx/fullchain.pem:/etc/nginx/fullchain.pem:ro,z
      - {{ docker_dir }}/{{ container_prefix }}-nginx/privkey.pem:/etc/nginx/privkey.pem:ro,z
{% if onion_fullchain_present %}
      - {{ docker_dir }}/{{ container_prefix }}-nginx/onion-fullchain.pem:/etc/nginx/onion-fullchain.pem:ro,z
      - {{ docker_dir }}/{{ container_prefix }}-nginx/onion-privkey.pem:/etc/nginx/onion-privkey.pem:ro,z
{% endif %}
{% if exposed.names %}
      # the network's own addresses, for the nodes (fail2ban's kn-fail2ban-own writes them)
      - {{ docker_dir }}/{{ container_prefix }}-nginx/own:/etc/nginx/kiwi-own:ro,z
{% endif %}
{% if public_names %}
      - {{ docker_dir }}/{{ container_prefix }}-nginx/start.sh:/etc/nginx/start.sh:ro,z
      - {{ docker_dir }}/{{ container_prefix }}-nginx/acme:/etc/nginx/acme:z
      # real files where the official image has links to stdout: fail2ban reads them
      - {{ docker_dir }}/{{ container_prefix }}-nginx/log:/var/log/nginx:z
      - {{ docker_dir }}/{{ container_prefix }}-nginx/www:/var/www/acme:z
{% if via %}
      # fail2ban's list of banned addresses
      - {{ docker_dir }}/{{ container_prefix }}-nginx/banned:/etc/nginx/banned:ro,z
{% endif %}
    command: /bin/sh /etc/nginx/start.sh
{% endif %}
