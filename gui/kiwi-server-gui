class FederationDialog(Adw.Dialog):
    """The partner networks in federation.yaml and what each may reach here."""

    def __init__(self, win):
        super().__init__(title="Federation", content_width=620, content_height=600)
        self.win = win
        self.path = os.path.join(os.path.dirname(win.doc.path), "federation.yaml")
        try:
            with open(self.path) as fh:
                self.data = yaml.safe_load(fh) or {}
        except OSError:
            self.data = {}
        page = Adw.PreferencesPage()
        intro = Adw.PreferencesGroup(description="Networks linked to this one. Each sees only what is shared here.")
        intro.set_header_suffix(help_button("A partner reaches the names listed under Shared here (a node, node:port "
                                            "or service.node, e.g. cloud.papaya) from the addresses under From "
                                            "(empty: its whole network). One network can also leave to the Internet "
                                            "through the other, over the same link: switch it on here, and the "
                                            "matching switch in the other network. Apply the master and the nodes "
                                            "after a change.",
                                            DOCS + "docs/design/federation.md"))
        link = Adw.ButtonRow(title="Link another network…", start_icon_name="list-add-symbolic")
        link.connect("activated", lambda *_: self.link())
        intro.add(link)
        page.add(intro)
        self.rows = {}
        for name, p in self.data.items():
            p = p or {}
            g = Adw.PreferencesGroup(title=name)
            g.set_header_suffix(info_button("%s at %s, %s, its names .%s" % (
                name, p.get("endpoint", "?"), p.get("mesh", "?"), p.get("domain", "?"))))
            share = Adw.EntryRow(title="Shared here (ticked under “Who may reach what…”)", text=" ".join(p.get("share") or []))
            frm = Adw.EntryRow(title="From", text=" ".join(p.get("from") or []))
            g.add(share)
            g.add(frm)
            # the way to the internet over the link: this network through the partner, or the partner through this one
            out = Adw.SwitchRow(title="Leave to the Internet through it", active=bool(p.get("exit")),
                                subtitle="Your devices come out at %s's master. It has to allow that on its side." % name)
            let = Adw.SwitchRow(title="It may leave to the Internet through this network", active=bool(p.get("internet")),
                                subtitle="%s's devices come out at your master. To the Internet only." % name)
            g.add(out)
            g.add(let)
            self.rows[name] = (share, frm, out, let)
            page.add(g)
        save = Gtk.Button(label="Save", css_classes=["suggested-action"], sensitive=bool(self.rows))
        save.connect("clicked", lambda *_: self.save())
        head = Adw.HeaderBar()
        head.pack_end(save)
        tb = Adw.ToolbarView(content=page)
        tb.add_top_bar(head)
        self.set_child(tb)

    def save(self):
        leaving = [n for n, r in self.rows.items() if r[2].get_active()]
        both = [n for n, r in self.rows.items() if r[2].get_active() and r[3].get_active()]
        if len(leaving) > 1 or both:
            self.win.toast("Two networks cannot leave through each other" if both else
                           "Only one partner can be the way to the Internet")
            return
        for name, (share, frm, out, let) in self.rows.items():
            entry = dict(self.data.get(name) or {}, share=share.get_text().split(), **{"from": frm.get_text().split()})
            for key, row in (("exit", out), ("internet", let)):
                if row.get_active():
                    entry[key] = True
                else:
                    entry.pop(key, None)
            self.data[name] = entry
        text = ("# federation.yaml — the partner networks and what each may reach here.\n"
                + yaml.safe_dump(self.data, sort_keys=False, default_flow_style=None))
        with open(self.path, "w") as fh:
            fh.write(text)
        self.close()
        self.win.toast("Saved — apply the master and the nodes")

    def link(self):
        dlg = Gtk.FileDialog(title="The other network's fleet file")

        def done(d, res):
            try:
                other = d.open_finish(res).get_path()
            except GLib.Error:
                return
            self.close()
            self.win.spawn(["federate", self.win.doc.path, other], "Linking the networks…")
        dlg.open(self.win, None, done)


class AccessDialog(Adw.Dialog):
    """Who may reach what: the VPN's groups and the linked networks, ticked per machine and
    service. Reads and writes through `kiwi-server access`, as the control page does."""

    def __init__(self, win):
        super().__init__(title="Who may reach what", content_width=660, content_height=700)
        self.win = win
        # the rules are read beside the window, which stays usable meanwhile
        self.set_child(Adw.StatusPage(title="Reading the rules…", child=Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER)))
        path = win.doc.path

        def work():
            rc, out, err = run_cli(win.cli, ["access", path, "--porcelain"])
            orc, oout, _oerr = run_cli(win.cli, ["onion", path, "--porcelain"])
            GLib.idle_add(lambda: self.build(rc, out, err, (orc, oout)) and False)
        threading.Thread(target=work, daemon=True).start()

    def build(self, rc, out, err, onion):
        win = self.win
        try:
            data = json.loads(out) if rc == 0 else {}
        except ValueError:
            data = {}
        self.who, self.machines = data.get("who") or [], [m for m in data.get("machines") or [] if not m["master"]]
        page = Adw.PreferencesPage()
        intro = Adw.PreferencesGroup(description=(
            "A device on the VPN belongs to a group: you choose it when you add the device. A linked network is another "
            "Kiwi network. Switch on what each may open. A machine: all of it. A service: only that page.")
            if data else "The rules could not be read: %s" % ((err.strip().splitlines() or ["no answer"])[-1]))
        intro.set_header_suffix(help_button("The master lets through what is given here and drops the rest; a machine that "
                                            "is reached for single services refuses the others itself. The master is always "
                                            "reachable: it answers the names. Apply the machines after a change.",
                                            DOCS + "docs/network.md"))
        page.add(intro)
        self.rows = {}
        for w in self.who:
            group = w["kind"] == "group"
            g = Adw.PreferencesGroup(title=w["name"], description="%s · %s%s. Now: %s." % (
                "group" if group else "linked network", w["range"],
                (" · " + ", ".join(w["devices"])) if w["devices"] else "", w["says"]))
            r = {"all": None, "machines": {}, "flags": {}}
            r["apps"] = None
            if group:
                r["all"] = Adw.SwitchRow(title="Everything on the VPN", active=w["open"]["all"])
                g.add(r["all"])
                r["apps"] = Adw.SwitchRow(title="Every app", active=w["open"].get("apps", False),
                                          subtitle="The pages of every machine: no admin pages, nothing else of the machines")
                g.add(r["apps"])
            for m in self.machines:
                o = w["open"]["machines"].get(m["name"]) or {"whole": False, "services": [], "ports": []}
                exp = Adw.ExpanderRow(title=m["name"], subtitle="all of it" if o["whole"] else
                                      (", ".join(o["services"] + [":" + x for x in o["ports"]]) or "nothing"))
                whole = Adw.SwitchRow(title="All of it", active=o["whole"])
                exp.add_row(whole)
                svc = {}
                for name in m["services"]:
                    svc[name] = Adw.SwitchRow(title=name, active=name in o["services"], subtitle=(
                        "an admin page: only with this, or with “The admin pages”" if name in m.get("admin", [])
                        else "only this page"))
                    exp.add_row(svc[name])
                r["machines"][m["name"]] = (whole, svc)
                g.add(exp)
            extra = ["%s:%s" % (n, x) for n, o in w["open"]["machines"].items() for x in o["ports"]] + w["open"]["other"]
            r["extra"] = Adw.EntryRow(title="Single ports, like lychee:22", text=" ".join(extra))
            g.add(r["extra"])
            if group:
                for key, title in (("peers", "Other devices on the VPN"), ("internet", "The Internet through the VPN"),
                                   ("admin", "The admin pages (control page, Portainer, Pi-hole, backups)")):
                    r["flags"][key] = Adw.SwitchRow(title=title, active=bool(w[key]))
                    g.add(r["flags"][key])
            self.rows[w["name"]] = r
            page.add(g)
        # hidden services: a site for anyone with Tor Browser, or for named people (kiwi-server onion)
        rc, out = onion
        try:
            self.hidden = {"%s.%s" % (x["service"], x["host"]): x for x in json.loads(out)["services"]} if rc == 0 else {}
        except (ValueError, KeyError):
            self.hidden = {}
        self.onion = {}
        tor = Adw.PreferencesGroup(title="Hidden services", description=(
            "An address that anyone opens with Tor Browser, without your VPN: for people you do not know. No names: "
            "anyone with the address gets in. With names, only who holds a key finds it (kiwi-server onion … --show NAME "
            "prints a person's key). Tor never leaves through a home connection: it leaves at the master."))
        for m in [x for x in (data.get("machines") or []) if x["services"]]:
            exp = Adw.ExpanderRow(title=m["name"], subtitle=", ".join(
                sv for sv in m["services"] if "%s.%s" % (sv, m["name"]) in self.hidden) or "none")
            # the sites their modules mark as usable over Tor, and what is a hidden service already
            usable = set(m.get("tor") if m.get("tor") is not None else m["services"])
            usable |= {k[:-len(m["name"]) - 1] for k in self.hidden if k.endswith("." + m["name"])}
            for sv in sorted(usable):
                what = "%s.%s" % (sv, m["name"])
                has = self.hidden.get(what)
                on = Adw.SwitchRow(title=sv, subtitle=("http://" + has["address"]) if has else "not a hidden service",
                                   active=bool(has))
                who = Adw.EntryRow(title="%s: only these people (empty: anyone)" % sv, text=" ".join(has["clients"]) if has else "")
                exp.add_row(on)
                exp.add_row(who)
                self.onion[what] = (on, who)
            tor.add(exp)
        if data and self.onion:
            page.add(tor)
        more = Adw.PreferencesGroup(title="A new group", description="It starts with nothing. A device joins it under "
                                                                      "“Add a phone or laptop…”.")
        self.new = Adw.EntryRow(title="Its name, like family")
        more.add(self.new)
        if data:
            page.add(more)
        save = Gtk.Button(label="Save", css_classes=["suggested-action"], sensitive=bool(data))
        save.connect("clicked", lambda *_: self.save())
        head = Adw.HeaderBar()
        head.pack_end(save)
        tb = Adw.ToolbarView(content=page)
        tb.add_top_bar(head)
        self.set_child(tb)

    def wanted(self, w):
        """(reach, {flag: bool}) as the switches of one group or linked network stand."""
        r = self.rows[w["name"]]
        if r["all"] is not None and r["all"].get_active():
            reach = ["all"]
        else:
            reach = ["apps"] if r["apps"] is not None and r["apps"].get_active() else []
            for m in self.machines:
                whole, svc = r["machines"][m["name"]]
                if whole.get_active():
                    reach.append(m["name"])
                else:
                    reach += ["%s.%s" % (s, m["name"]) for s, row in svc.items() if row.get_active()]
            reach += [e for e in r["extra"].get_text().split() if e not in reach]
        return reach, {k: row.get_active() for k, row in r["flags"].items()}

    def save(self):
        calls = []
        new = self.new.get_text().strip().lower()
        if new:
            calls.append([new, "--new"])
        for w in self.who:
            reach, flags = self.wanted(w)
            args = []
            if sorted(reach) != sorted(w["reach"]):
                args = [w["name"]] + (reach or ["nothing"])
            diff = [x for k, v in flags.items() if v != bool(w[k]) for x in ("--" + k, "yes" if v else "no")]
            if diff:
                args = (args or [w["name"], "--add"]) + diff
            if args:
                calls.append(args)
        tor = []                    # the same for the hidden services: `kiwi-server onion`
        for what, (on, who) in self.onion.items():
            has, names = self.hidden.get(what), who.get_text().lower().split()
            if not on.get_active():
                if has:
                    tor.append([what, "--remove"])
                continue
            if not has:
                tor.append([what])
            tor += [[what, "--client", n] for n in names if not has or n not in has["clients"]]
            tor += [[what, "--remove", "--client", n] for n in (has["clients"] if has else []) if n not in names]
        if not calls and not tor:
            self.close()
            return
        for cmd, args in [("access", a) for a in calls] + [("onion", a) for a in tor]:
            rc, out, err = run_cli(self.win.cli, [cmd, self.win.doc.path] + args)
            if rc != 0:
                self.win.toast("%s: %s" % (args[0], (err.strip().splitlines() or ["not saved"])[-1].replace("error: ", "")))
                return
        path = self.win.doc.path
        self.close()
        self.win.open_path(path, sync=False)        # the fleet file changed under the app
        self.win.toast("Saved — apply the master, and the machines whose services are named")


