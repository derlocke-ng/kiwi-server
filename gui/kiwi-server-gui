        box.append(Gtk.Label(label="On the VPN a device reaches your services from anywhere. Give it a name.",
                             wrap=True, xalign=0))
        g = Adw.PreferencesGroup()
        self.go = Gtk.Button(label="Add it", css_classes=["suggested-action", "pill"], halign=Gtk.Align.CENTER,
                             sensitive=False)
        self.go.connect("clicked", lambda *_: self.add())
        self.name = Adw.EntryRow(title="Name, like annas-phone")
        self.name.connect("changed", lambda *_: self.go.set_sensitive(bool(self.clean())))
        self.name.connect("entry-activated", lambda *_: self.add())
        g.add(self.name)
        self.groups = sorted((win.fleet_info.get("groups") or {}))
        self.group = None
        if self.groups:
            self.group = Adw.ComboRow(title="Who is it for?", subtitle="The group decides what it may reach",
                                      model=Gtk.StringList.new(self.groups))
            if "devices" in self.groups:
                self.group.set_selected(self.groups.index("devices"))
            g.add(self.group)
        box.append(g)
        self.note = Gtk.Label(wrap=True, xalign=0, visible=False, css_classes=["error"])
        box.append(self.note)
        box.append(self.go)
        self.have = Adw.PreferencesGroup(title="On your VPN already")
        box.append(self.have)
        self.have_rows = []
        self.fill()
        self.nav.add(Adw.NavigationPage(title="Add a phone or laptop", child=box))
        self.set_child(self.nav)

    def fill(self):
        """The devices this network has, each with its code again and a way off the VPN."""
        for row in self.have_rows:
            self.have.remove(row)
        self.have_rows = []
        folder = os.path.join(self.win.doc.dir, "secrets", "devices")
        names = sorted(n[:-5] for n in os.listdir(folder) if n.endswith(".conf")) if os.path.isdir(folder) else []
        self.have.set_visible(bool(names))
        for name in names:
            row = Adw.ActionRow(use_markup=False, title=name)
            show = Gtk.Button(label="Show its code", valign=Gtk.Align.CENTER, css_classes=["flat"])
            show.connect("clicked", lambda _b, n=name: self.done(0, "", n))
            drop = Gtk.Button(label="Remove", valign=Gtk.Align.CENTER, css_classes=["flat"])
            drop.connect("clicked", lambda _b, n=name: self.ask_remove(n))
            row.add_suffix(show)
            row.add_suffix(drop)
            self.have.add(row)
            self.have_rows.append(row)

    def ask_remove(self, name):
        dlg = Adw.AlertDialog(heading="Remove %s?" % name,
                              body="It is off your VPN at once and its code and file stop working. For a lost or "
                                   "sold phone. To use the device again, add it anew.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("go", "Remove")
        dlg.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r != "go":
                return

            def work():
                rc, out, err = run_cli(self.win.cli, ["enroll", self.win.doc.path, name, "--remove"], timeout=180)
                GLib.idle_add(self.removed, rc, (err or out), name)
            threading.Thread(target=work, daemon=True).start()
        dlg.connect("response", resp)
        dlg.present(self)

    def removed(self, rc, text, name):
        if rc != 0:
            self.note.set_label((text.replace("error: ", "").strip().splitlines() or ["It did not work."])[-1])
            self.note.set_visible(True)
        else:
            self.win.toast("%s is off your VPN" % name)
            self.win.sync(after_save=True)
        self.fill()
        return False

    def clean(self):
        name = self.name.get_text().strip().lower().replace(" ", "-")
        return name if re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", name) else ""

    def add(self):
        name = self.clean()
        if not name:
            return
        self.go.set_sensitive(False)
        self.go.set_label("Adding…")
        args = ["enroll", self.win.doc.path, name]
        if self.group is not None:
            args += ["--group", self.groups[self.group.get_selected()]]

        def work():
            rc, out, err = run_cli(self.win.cli, args, timeout=180)
            GLib.idle_add(self.done, rc, (err or out), name)
        threading.Thread(target=work, daemon=True).start()

    def done(self, rc, text, name):
        conf = os.path.join(self.win.doc.dir, "secrets", "devices", name + ".conf")
        if rc != 0 or not os.path.isfile(conf):
            self.note.set_label((text.replace("error: ", "").strip().splitlines() or ["It did not work."])[-1])
            self.note.set_visible(True)
            self.go.set_label("Add it")
            self.go.set_sensitive(True)
            return False
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        box.append(Gtk.Label(label="%s is ready" % name, xalign=0, css_classes=["title-2"]))
        qr = None
        try:                                 # kiwi-server draws it itself: nothing else to install
            r = subprocess.run([self.win.cli, "qr", conf, "--png"], capture_output=True, timeout=30)
            if r.returncode == 0 and r.stdout.startswith(b"\x89PNG"):
                qr = Gtk.Picture.new_for_paintable(Gdk.Texture.new_from_bytes(GLib.Bytes.new(r.stdout)))
                qr.set_size_request(300, 300)
                qr.set_can_shrink(False)
        except (OSError, subprocess.TimeoutExpired, GLib.Error):
            qr = None
        control = self.win.control_host()
        if qr is not None:
            box.append(Gtk.Label(label="On the phone: install the WireGuard app, tap +, then Scan from QR code.",
                                 wrap=True, xalign=0))
            box.append(qr)
        else:
            box.append(Gtk.Label(label="The QR code could not be drawn here." + (
                " Your control page shows it: Devices, then Show its QR code." if control else ""),
                wrap=True, xalign=0))
        box.append(Gtk.Label(label="On a laptop: install WireGuard and import the file.", wrap=True, xalign=0))
        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        save = Gtk.Button(label="Save the file…")
        save.connect("clicked", lambda *_: self.save(conf, name))
        buttons.append(save)
        if control and qr is None:
            host = (self.win.status.get(control) or {}).get("hostname") or control
            page = Gtk.Button(label="Open the control page")
            page.connect("clicked", lambda *_: Gtk.UriLauncher.new("https://control.%s/devices" % host).launch(self.win, None, None))
            buttons.append(page)
        close = Gtk.Button(label="Done", css_classes=["suggested-action"])
        close.connect("clicked", lambda *_: self.close())
        buttons.append(close)
        box.append(buttons)
        box.append(Gtk.Label(label="Whoever has the code or the file is on your VPN as this device.", wrap=True,
                             xalign=0, css_classes=["dim-label", "caption"]))
        self.nav.push(Adw.NavigationPage(title="Ready", child=box, can_pop=False))
        if text is not None and rc == 0 and text != "":
            self.win.sync(after_save=True)      # the control node learns the new device
        return False

    def save(self, conf, name):
        dlg = Gtk.FileDialog(title="Save the device's file", initial_name=name + ".conf")

        def chosen(d, res):
            try:
                dest = d.save_finish(res).get_path()
            except GLib.Error:
                return
            shutil.copyfile(conf, dest)
            os.chmod(dest, 0o600)
            self.win.toast("Saved. Import it in WireGuard on the laptop, then delete the file.")
        dlg.save(self.win, None, chosen)


def in_plain_words(text):
    """What a problem line means and what to do, before the technical words."""
    low = text.lower()
    for key, plain in (
            ("unreachable", "It does not answer. Is it switched on and online, and is this computer on your VPN?"),
            ("disk is locked", "Its disk is encrypted and waits to be unlocked after a restart."),
            ("waiting for a reboot", "It installed updates and restarts by itself in its update window. Nothing to do."),
            ("not running", "A service on it stopped. Apply usually brings it back.")):
        if key in low:
            return "%s  (%s)" % (plain, text)
    return text


def likely_folder():
    """A folder something already syncs on this computer, with kiwi in it."""
    for base in ("~/Nextcloud", "~/Syncthing", "~/Sync", "~/Dropbox"):
        if os.path.isdir(os.path.expanduser(base)):
            return os.path.join(os.path.expanduser(base), "kiwi")
    return os.path.expanduser("~/Nextcloud/kiwi")


class FolderDialog(Adw.Dialog):
    """Keep the network in a folder that something else syncs (Nextcloud, Syncthing): other
    computers then join from that folder. For a network without a home server that looks
    after it."""

    def __init__(self, win):
        super().__init__(title="Keep the network in a synced folder", content_width=540)
        self.win = win
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        box.append(Gtk.Label(label="Choose a folder that Nextcloud, Syncthing or the like keeps the same on your "
                                   "computers. The network goes there encrypted: whoever runs the syncing cannot read "
                                   "it. Your other computers join from that folder.", wrap=True, xalign=0))
        g = Adw.PreferencesGroup()
        self.path = Adw.EntryRow(title="Folder")
        self.path.set_text(tilde(likely_folder()))
        self.path.connect("entry-activated", lambda *_: self.go())
        g.add(self.path)
        box.append(g)
        self.note = Gtk.Label(wrap=True, xalign=0, visible=False, css_classes=["error"])
        box.append(self.note)
        self.b = Gtk.Button(label="Use this folder", css_classes=["suggested-action", "pill"], halign=Gtk.Align.CENTER)
        self.b.connect("clicked", lambda *_: self.go())
        box.append(self.b)
        self.set_child(box)

    def go(self):
        folder = os.path.expanduser(self.path.get_text().strip())
        if not folder or (self.win.doc.dirty and not self.win.save()):
            return
        self.b.set_sensitive(False)

        def work():
            rc, out, err = run_cli(self.win.cli, ["control", "push", self.win.doc.path, "--dir", folder], timeout=180)
            GLib.idle_add(done, rc, (err or out))

        def done(rc, text):
            if rc == 0:
                self.close()
                self.win.toast("The network is in %s now. On another computer: Join, with that folder." % tilde(folder))
            else:
                self.note.set_label((text.replace("error: ", "").strip().splitlines() or ["It did not work."])[-1])
                self.note.set_visible(True)
                self.b.set_sensitive(True)
            return False
        threading.Thread(target=work, daemon=True).start()


