[Unit]
Description=Kiwi Network: the tunnel to the master or a standby ({{ hostname }})
Documentation=https://github.com/derlocke-ng/kiwi-server
After=kiwi-stack.service network-online.target
Wants=kiwi-stack.service

[Service]
ExecStart=/usr/bin/bash {{ docker_dir }}/{{ container_prefix }}-vpn-client/master-switch.sh watch
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
