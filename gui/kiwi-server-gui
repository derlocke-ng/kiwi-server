    def invite(self):
        """The link for one more computer, made here (`kiwi-server control invite`), shown with
        a button that copies it and as a QR code."""
        self.toast("Asking the control page for a link…")

        def work():
            try:
                r = subprocess.run([self.cli, "control", "invite", self.doc.path, "--porcelain"],
                                   stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
                rc, out, err = r.returncode, r.stdout, r.stderr
            except (OSError, subprocess.TimeoutExpired) as e:
                rc, out, err = 1, "", str(e)
            GLib.idle_add(done, rc, out, err)

        def done(rc, out, err):
            try:
                data = json.loads(out) if rc == 0 else {}
            except ValueError:
                data = {}
            if not data.get("link"):
                why = (err.replace("error: ", "").strip().splitlines() or ["no link came back"])[-1]
                dlg = Adw.AlertDialog(heading="No link", body=why[:300])
                dlg.add_response("close", "Close")
                dlg.present(self)
                return False
            InviteDialog(self, data["link"], data.get("qr") or "").present(self)
            return False
        threading.Thread(target=work, daemon=True).start()

