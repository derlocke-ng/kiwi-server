        pills.append(pill(win.value_of(name, "role", "bare"), "dim"))
        mods = st.get("modules") or []
        if mods:
            pills.append(pill("%d modules" % len(mods), "acc", ", ".join(mods)))
        self.pills.set_child(pills)


