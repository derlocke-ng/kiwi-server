# tang: one container per ring, its keys in a directory of its own
services:
{% for ring, port in rings.items() %}
  {{ container_prefix }}-tang-{{ ring }}:
    image: {{ image }}
    container_name: {{ container_prefix }}-tang-{{ ring }}
    environment:
      - TZ={{ timezone }}
{% if node_type == 'master' %}
      # in the VPN server's namespace: it publishes the port, behind its gate for the home's addresses
      - TANG_PORT={{ port }}
    network_mode: "service:{{ container_prefix }}-vpn-server"
    depends_on: [{{ container_prefix }}-vpn-server]
{% else %}
    networks:
      {{ network_name }}: {}
    ports:
      - "{{ port }}:7500"
{% endif %}
    restart: unless-stopped
    # it hands out its keys
    healthcheck:
      test: ["CMD", "curl", "-sf", "-o", "/dev/null", "http://localhost:{{ port if node_type == 'master' else 7500 }}/adv"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-tang/{{ ring }}:/db:z
{% endfor %}
