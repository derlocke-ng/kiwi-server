# fail2ban jails for gate.home — generated by kiwi-server; the fleet file is the place to change them
[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
banaction = iptables-multiport
# never: this machine, the mesh, the docker network, and what the fleet names
ignoreip = 127.0.0.1/8 ::1 10.8.0.0/16 172.64.0.0/24 

[sshd]
enabled  = true
port     = 22
logpath  = /var/log/kiwi/sshd.log
backend  = polling
# aggressive: also preauth disconnects and timeouts, which is most of what bots do
mode     = aggressive
