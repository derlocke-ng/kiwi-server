def messages_file():
    """Where the app keeps what it said: its little messages vanish after a few seconds."""
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "kiwi-server", "messages.json")


def load_messages():
    try:
        with open(messages_file()) as fh:
            got = json.load(fh)
        return [m for m in got if isinstance(m, dict) and m.get("text")][:300]
    except (OSError, ValueError):
        return []


def save_messages(items):
    path = messages_file()
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        tmp = path + ".tmp"
        with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as fh:
            json.dump(items[:300], fh)
        os.replace(tmp, path)
    except OSError:
        pass


def message_kind(text):
    """bad, warn, ok or info, from the words of a message."""
    low = text.lower()
    if re.search(r"\b(fail\w*|could not|did not|cannot|can't|error|refused|not saved|wrong|lost)\b", low):
        return "bad"
    if re.search(r"\b(first|needs?|waits?|locked|left out|newer)\b", low):
        return "warn"
    if re.search(r"\b(done|saved|holds|sent|added|removed|updated|copied|ready|fine again|in step|applied)\b", low):
        return "ok"
    return "info"


def ago_words(t):
    s = max(0, int(time.time() - t))
    return ("just now" if s < 45 else "%d min ago" % max(1, s // 60) if s < 5400 else "%d h ago" % (s // 3600) if s < 172800
            else time.strftime("%d %b, %H:%M", time.localtime(t)))


class FleetDoc:
    """fleet.yaml as a dict, with get/set by path for either scope."""

    def __init__(self, path=None):
        self.path = path
        self.data = {"defaults": {}, "hosts": {}}
        self.dirty = False
        if path:
            with open(path, encoding="utf-8") as f:
                data = yaml.safe_load(f) or {}
            if not isinstance(data, dict):
                raise ValueError("not a mapping")
            data.setdefault("defaults", {})
            data.setdefault("hosts", {})
            if data["defaults"] is None:
                data["defaults"] = {}
            if data["hosts"] is None:
                data["hosts"] = {}
            self.data = data

    @property
    def dir(self):
        return os.path.dirname(os.path.abspath(self.path)) if self.path else os.getcwd()

    def hosts(self):
        return list(self.data["hosts"])

    def block(self, scope):
        if scope == "defaults":
            return self.data["defaults"]
        h = self.data["hosts"].get(scope)
        if h is None:
            h = self.data["hosts"][scope] = {}
        return h

    def get(self, scope, path):
        d = self.block(scope)
        for p in path:
            if not isinstance(d, dict) or p not in d:
                return None
            d = d[p]
        return d

    def set(self, scope, path, value):
        d = self.block(scope)
        for p in path[:-1]:
            if not isinstance(d.get(p), dict):
                d[p] = {}
            d = d[p]
        if value is None:
            if path[-1] in d:
                del d[path[-1]]
            self._prune(scope, path[:-1])
        else:
            d[path[-1]] = value
        self.dirty = True

    def _prune(self, scope, parents):
        """The blocks a removed value leaves empty, from the inside out, and nothing else: an empty
        {} elsewhere can mean something (a hidden service with its defaults, `onion: services:
        {git: {}}`, was dropped by any other change of its machine until 2.183.0, as on the page
        until 2.179.1)."""
        for i in range(len(parents), 0, -1):
            parent = self.get(scope, parents[:i - 1]) if i > 1 else self.block(scope)
            if isinstance(parent, dict) and parent.get(parents[i - 1]) == {}:
                del parent[parents[i - 1]]
            else:
                break

    def add_host(self, name):
        self.data["hosts"][name] = {}
        self.dirty = True

    def remove_host(self, name):
        self.data["hosts"].pop(name, None)
        self.dirty = True

    def save(self, path=None):
        self.path = path or self.path
        text = ("# fleet.yaml — written by kiwi-server-gui. Comments are not kept here;\n"
                "# `kiwi-server init` writes a commented example to read along.\n"
                + yaml.safe_dump(self.data, sort_keys=False, allow_unicode=True, default_flow_style=False))
        try:
            mode = os.stat(self.path).st_mode & 0o777
        except OSError:
            mode = 0o600   # new file: it holds secrets
        tmp = self.path + ".tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, self.path)
        self.dirty = False


