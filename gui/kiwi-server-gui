        self.nav = Adw.NavigationView()
        self.pages = [self.step_page(i, st) for i, st in enumerate(self.steps)]
        self.nav.add(self.pages[0])
        self.set_child(self.nav)
        self.update_when()

    # ---- the pages ----
    def step_page(self, i, step):
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(title=step["step"], description=step.get("intro", ""))
        page.add(g)
        for q in step["questions"]:
            if q.get("type") == "machines":
                page.add(self.machines_group(q))
            else:
                g.add(self.row_for(q))
        last = i == len(self.steps) - 1
        go = Gtk.Button(label="Create the fleet" if last else "Next", css_classes=["suggested-action", "pill"],
                        halign=Gtk.Align.CENTER, margin_top=6, margin_bottom=12)
        go.connect("clicked", lambda *_: self.create() if last else self.nav.push(self.pages[i + 1]))
        tv = Adw.ToolbarView(content=page)
        tv.add_top_bar(Adw.HeaderBar())
        tv.add_bottom_bar(go)
        return Adw.NavigationPage(title="%d of %d · %s" % (i + 1, len(self.steps), step["step"]), child=tv)

    def row_for(self, q, into=None):
        """A row for one question; its value is read through self.get (or into, for a machine)."""
        kind, get = q.get("type", "string"), None
        if kind == "choice":
            opts = q["options"]
            row = Adw.ComboRow(title=q["label"], model=Gtk.StringList.new([o["label"] for o in opts]), use_subtitle=True)
            row.set_selected(next((n for n, o in enumerate(opts) if o["value"] == q.get("default")), 0))
            row.connect("notify::selected", lambda *_: self.update_when())
            get = lambda r=row, o=opts: o[r.get_selected()]["value"]
        elif kind == "bool":
            row = Adw.SwitchRow(title=q["label"], active=bool(q.get("default")))
            get = row.get_active
        else:
            row = (Adw.PasswordEntryRow if q.get("secret") else Adw.EntryRow)(title=q["label"])
            row.set_text(str(q.get("default") or ""))
            get = lambda r=row: r.get_text().strip()
        if q.get("help"):
            row.add_suffix(help_button(q["help"], DOCS + "README.md"))
        (into if into is not None else self.get)[q["id"]] = get
        if into is None:
            self.rows[q["id"]] = (row, q.get("when"))
        return row

    def machines_group(self, q):
        self.machine_q = q
        g = Adw.PreferencesGroup(title=q["label"], description="Add one with +, or none: they can come later.")
        add = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="Add a machine", css_classes=["flat"],
                         valign=Gtk.Align.CENTER)
        add.connect("clicked", lambda *_: self.add_machine(g))
        head = Gtk.Box(spacing=4, valign=Gtk.Align.CENTER)
        if q.get("help"):
            head.append(help_button(q["help"], DOCS + "README.md"))
        head.append(add)
        g.set_header_suffix(head)
        self.machine_group = g
        return g

    def add_machine(self, g):
        n = len(self.machines)
        taken = {m["name"]() for m in self.machines} | ({self.get["master_name"]()} if "master_name" in self.get else set())
        name = next((x for x in self.suggest.get("nodes", []) if x not in taken), "node%d" % (n + 1))
        addrs = self.suggest.get("addresses") or []
        exp = Adw.ExpanderRow(title=name, subtitle="a machine at home", expanded=True)
        fields = {}
        for f in self.machine_q.get("fields") or []:
            f = dict(f)
            if f.get("default_from") == "fruits":
                f["default"] = name
            elif f.get("default_from") == "suggest":
                f["default"] = addrs[n] if n < len(addrs) else ""
            row = self.row_for(f, into=fields)
            exp.add_row(row)
            fields["_row_" + f["id"]] = (row, f.get("when"))
        rm = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Remove it", css_classes=["flat"],
                        valign=Gtk.Align.CENTER)
        exp.add_suffix(rm)
        entry = {"exp": exp, "fields": fields, "name": fields["name"]}
        name_row = fields["_row_name"][0]
        name_row.connect("changed", lambda r: exp.set_title(r.get_text().strip() or "a machine"))
        rm.connect("clicked", lambda *_: (g.remove(exp), self.machines.remove(entry)))
        self.machines.append(entry)
        g.add(exp)
        self.update_when()

    def update_when(self):
        """Show a question only while its `when` holds (key == 'value')."""
        def holds(cond, values):
            if not cond:
                return True
            key, _sep, val = cond.partition(" == ")
            return key in values and str(values[key]()) == val.strip("'")
        for row, cond in self.rows.values():
            row.set_visible(holds(cond, self.get))
        for m in self.machines:
            for k, v in m["fields"].items():
                if k.startswith("_row_"):
                    v[0].set_visible(holds(v[1], {x: g for x, g in m["fields"].items() if not x.startswith("_row_")}))

    # ---- the end ----
    def answers(self):
        a = {k: g() for k, g in self.get.items() if self.rows[k][0].get_visible()}
        a["nodes"] = [{k: g() for k, g in m["fields"].items() if not k.startswith("_row_") and m["fields"]["_row_" + k][0].get_visible()}
                      for m in self.machines]
        return a

    def create(self):
        a = self.answers()
        if not a.get("master_address"):
            self.win.alert("The master's address", "What phones and the machines at home connect to: its public address "
                           "or name, e.g. 203.0.113.7. netcup shows it in its control panel.")
            return
        # the answers may hold a Mullvad key: they pass through memory, not the disk
        tmp = os.path.join(GLib.get_user_runtime_dir(), "kiwi-init-%d.json" % os.getpid())
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(a, f)
        spinner = Adw.StatusPage(title="Making the fleet", description="keys, the fleet file and, if asked, the secret store")
        self.nav.push(Adw.NavigationPage(title="Making the fleet", child=spinner, can_pop=False))

        def work():
            try:
                rc, out, err = run_cli(self.win.cli, ["init", self.path, "--answers", tmp], timeout=300)
            finally:
                os.remove(tmp)
            GLib.idle_add(self.done, rc, out, err)
        threading.Thread(target=work, daemon=True).start()

    def done(self, rc, out, err):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        ok = rc == 0
        box.append(Gtk.Label(label="The fleet is ready" if ok else "The fleet was not made", xalign=0,
                             css_classes=["title-2"]))
        if ok and "recovery key" in out:
            box.append(Gtk.Label(label="Write the recovery key below down now, on paper or in a password manager: it is "
                                       "shown only once, and without it a lost keyring means lost secrets.",
                                 wrap=True, xalign=0, css_classes=["warning"]))
        tv = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR, vexpand=True)
        tv.get_buffer().set_text((out + ("\n" + err if err.strip() else "")).strip())
        box.append(Gtk.ScrolledWindow(child=tv, vexpand=True, min_content_height=360))
        b = Gtk.Button(label="Open the fleet" if ok else "Back", css_classes=["suggested-action", "pill"],
                       halign=Gtk.Align.CENTER)
        b.connect("clicked", lambda *_: (self.close(), ok and self.win.open_path(self.path)))
        box.append(b)
        self.nav.push(Adw.NavigationPage(title="Done" if ok else "Not made", child=box, can_pop=not ok))
        return False


