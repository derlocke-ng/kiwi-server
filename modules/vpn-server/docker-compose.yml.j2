# vpn-server (wg-easy) — the entry point; start.sh (WG_POST_UP) sets the double hop and the isolation rules
services:
  {{ container_prefix }}-vpn-server:
    image: {{ image }}
    container_name: {{ container_prefix }}-vpn-server
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    environment:
      - WG_HOST={{ wg_host }}
      - PASSWORD={{ wg_password }}
      - WG_PORT={{ wg_port }}
      - WG_POST_UP=bash /etc/wireguard/start.sh
      - WG_POST_DOWN=true
      - WG_PERSISTENT_KEEPALIVE=25
      - UI_TRAFFIC_STATS={{ 'true' if ui_traffic_stats else 'false' }}
      - WG_DEFAULT_DNS={{ server_ip }}
      - WG_DEFAULT_ADDRESS={{ wg_default_address }}
      - WG_MTU={{ wg_mtu }}
{% for k, v in extra_env.items() %}
      - {{ k }}={{ v }}
{% endfor %}
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    ports:
      - "{{ public_ip ~ ':' if public_ip else '' }}{{ wg_port }}:51820/udp"
      - "127.0.0.1:51821:51821/tcp"
{% if federation %}
      - "{{ public_ip ~ ':' if public_ip else '' }}{{ federation_port }}:{{ federation_port }}/udp"
{% endif %}
{% for port in unlock_relay %}
      - "{{ public_ip ~ ':' if public_ip else '' }}{{ port }}:{{ port }}/tcp"
{% endfor %}
{% for port in local_rings.values() %}
      - "{{ public_ip ~ ':' if public_ip else '' }}{{ port }}:{{ port }}/tcp"
{% endfor %}
{# Jabber lives in this namespace too: a public name's clients (5222) and other servers (5269) #}
{# (a separate public instance has a container of its own and publishes them itself) #}
{% set xmpp_name = module_config.get('xmpp', {}).get('xmpp_domain') %}
{% if xmpp_name and not module_config.get('xmpp', {}).get('separate') %}
      - "{{ public_ip ~ ':' if public_ip else '' }}5222:5222/tcp"
      - "{{ public_ip ~ ':' if public_ip else '' }}5223:5223/tcp"
      - "{{ public_ip ~ ':' if public_ip else '' }}5269:5269/tcp"
{% endif %}
{# nginx lives in this namespace, so a public reverse proxy's ports are published here #}
{% if public_names or (exposed or {}).get('names') %}
      - "{{ public_ip ~ ':' if public_ip else '' }}80:80/tcp"
      - "{{ public_ip ~ ':' if public_ip else '' }}443:443/tcp"
{% endif %}
{# and what it hands on to a node besides web sites #}
{% for p in (exposed or {}).get('ports', []) %}
      - "{{ public_ip ~ ':' if public_ip else '' }}{{ p.port }}:{{ p.port }}/{{ p.proto or 'tcp' }}"
{% endfor %}
{% if has_dns and module_config.get('dns', {}).get('network_mode') == 'vpn-server' %}
      - "127.0.0.1:8080:{{ module_config.get('dns', {}).get('web_port') or 8081 }}/tcp"
{% endif %}
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
{# Tor in this namespace binds the mesh address, which exists only once start.sh has brought wg0 up #}
{% if module_config.get('tor', {}).get('network_mode') == 'vpn-server' %}
      - net.ipv4.ip_nonlocal_bind=1
{% endif %}
    restart: unless-stopped
    # the WireGuard interface is up (the image's own check)
    healthcheck:
      test: ["CMD-SHELL", "wg show | grep -q interface"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-vpn-server:/etc/wireguard:z
{% if translated %}
  # the link's DNS: a partner's names under the alias it has here (fed-dns.py; Pi-hole asks it)
  {{ container_prefix }}-fed-dns:
    image: {{ fed_dns_image }}
    container_name: {{ container_prefix }}-fed-dns
    network_mode: "service:{{ container_prefix }}-vpn-server"
    command: ["python3", "/app/fed-dns.py", "/app/fed-dns.json"]
    read_only: true
    cap_drop: [ALL]
    user: "65534:65534"
    depends_on:
      - {{ container_prefix }}-vpn-server
    restart: unless-stopped
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-vpn-server/fed-dns:/app:ro,z
{% endif %}
