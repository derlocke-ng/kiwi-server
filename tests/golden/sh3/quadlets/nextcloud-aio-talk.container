# kiwi-server stack — generated; the fleet file is the place to change it
[Unit]
Description=kiwi stack: nextcloud-aio-talk
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/nextcloud-releases/aio-talk:latest
ContainerName=nextcloud-aio-talk
Network=knet-node.network
AutoUpdate=registry
RunInit=true
ReadOnly=true
User=1000
DropCapability=NET_RAW
Tmpfs=/run
Tmpfs=/opt/eturnal/run
Tmpfs=/conf
Tmpfs=/tmp
Environment=NC_DOMAIN=cloud.sh3.home
Environment=TALK_HOST=nextcloud-aio-talk
Environment=AIO_LOG_LEVEL=warn
Environment=TZ=Europe/Berlin
Environment=TALK_PORT=3478
EnvironmentFile=/home/user/docker/kiwi/env/nextcloud-aio-talk.env
AddHost=sh3.home:172.128.0.5
AddHost=cloud.sh3.home:172.128.0.5
AddHost=vault.sh3.home:172.128.0.5
AddHost=portainer.sh3.home:172.128.0.5
PublishPort=3478:3478/tcp
PublishPort=3478:3478/udp
HealthCmd=/healthcheck.sh
HealthInterval=30s
HealthTimeout=30s
HealthStartPeriod=0s
HealthRetries=3
LogDriver=journald

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900

[Install]
WantedBy=kiwi-stack.target
