#!/usr/bin/env bash
# Game servers of {{ hostname }} that sleep: generated by kiwi-server, run by {{ container_prefix }}-games-sleep.service.
#
# A server with `sleep: N` in the games settings is stopped after N minutes in which no packet
# came in for it from a player, and started again by the first one that does. Counted in the
# mangle table (every way in passes there: the LAN, the VPN client, the master's forward), only
# packets of connections that came from outside, so the server's own talk to the Internet (a
# master server list) does not keep it awake. A sleeping server has a file in $DIR: kiwi-stack's
# status and kiwi-server's count it as sleeping, not as down. One stopped by hand has none and
# stays stopped.
set -u
RUNTIME={{ runtime }}
DIR=${KS_SLEEPING:-/run/kiwi-stack/sleeping}
CHAIN=KN-GAMES-SLEEP
STEP=${KIWI_SLEEP_STEP:-5}
MINUTE=${KIWI_SLEEP_MINUTE:-60}     # (seconds: the tests make it shorter)
# container, minutes, its ports
SERVERS=(
{% for n, s in servers.items() if s.game in catalog and s.sleep %}{% set g = catalog[s.game] %}{% set shift = (s.port | int) - (g.ports[0].split('/')[0] | int) if s.port else 0 %}
    "{{ container_prefix }}-game-{{ n }} {{ s.sleep | int }}{% for p in g.ports %} {{ (p.split('/')[0] | int) + shift }}/{{ p.split('/')[1] }}{% endfor %}"
{% endfor %}
)

say() { echo "[games-sleep] $*"; }
tables() { echo iptables; command -v ip6tables >/dev/null 2>&1 && ip6tables -t mangle -S >/dev/null 2>&1 && echo ip6tables; }

rules() {
    local t line name _min p
    for t in $(tables); do
        "$t" -t mangle -N "$CHAIN" 2>/dev/null || "$t" -t mangle -F "$CHAIN"
        "$t" -t mangle -C PREROUTING -j "$CHAIN" 2>/dev/null || "$t" -t mangle -I PREROUTING -j "$CHAIN"
        for line in "${SERVERS[@]}"; do
            read -r name _min ports <<<"$line"
            for p in $ports; do
                # no target: the rule only counts, and the packet goes on as before
                "$t" -t mangle -A "$CHAIN" -p "${p#*/}" --dport "${p%/*}" -m conntrack --ctdir ORIGINAL -m comment --comment "$name"
            done
        done
    done
}

unrules() {
    local t
    for t in $(tables); do
        "$t" -t mangle -D PREROUTING -j "$CHAIN" 2>/dev/null
        "$t" -t mangle -F "$CHAIN" 2>/dev/null
        "$t" -t mangle -X "$CHAIN" 2>/dev/null
    done
    return 0
}

# "container packets" per server, over both tables
counts() {
    local t
    for t in $(tables); do
        "$t" -t mangle -L "$CHAIN" -v -x -n 2>/dev/null
    done | awk '{ for (i = 1; i <= NF; i++) if ($i == "/*") { n[$(i + 1)] += $1 } } END { for (k in n) print k, n[k] }'
}

running() {
    if [[ $RUNTIME == podman ]]; then
        systemctl -q is-active "$1.service"
    else
        [[ $(docker inspect -f '{{ '{{' }}.State.Running{{ '}}' }}' "$1" 2>/dev/null) == true ]]
    fi
}

stop_it() {
    touch "$DIR/$1"         # first: a look at the stack while it stops sees it sleeping, not down
    if [[ $RUNTIME == podman ]]; then systemctl stop "$1.service"; else docker stop "$1" >/dev/null; fi
}

start_it() {
    if [[ $RUNTIME == podman ]]; then systemctl start --no-block "$1.service"; else docker start "$1" >/dev/null; fi
    rm -f "$DIR/$1"
}

watch() {
    local -A last seen
    local line name min ports now c first=1
    mkdir -p "$DIR"
    while :; do
        now=$(date +%s)
        declare -A got=()
        while read -r name c; do got[$name]=$c; done < <(counts)
        for line in "${SERVERS[@]}"; do
            read -r name min ports <<<"$line"
            c=${got[$name]:-0}
            if [[ $c != "${last[$name]:-}" ]]; then
                if (( ! first )) && [[ -e $DIR/$name ]]; then
                    say "$name: a player knocked, it wakes up"
                    start_it "$name"
                fi
                last[$name]=$c
                seen[$name]=$now
            fi
            if running "$name"; then
                if [[ -e $DIR/$name ]]; then rm -f "$DIR/$name"; fi      # started by someone else
                if (( now - ${seen[$name]:-$now} >= min * MINUTE )); then
                    say "$name: nobody played for $min minutes, it sleeps"
                    stop_it "$name"
                fi
            elif [[ ! -e $DIR/$name ]]; then
                seen[$name]=$now        # stopped by hand, or starting: its time begins when it runs
            fi
        done
        first=0
        unset got
        sleep "$STEP"
    done
}

case "${1:-}" in
    start) rules ;;
    watch) watch ;;
    stop)
        unrules
        # the servers asleep start again: without the watch, nothing would ever wake them.
        # Not while the machine shuts down: they start with it.
        [[ $(systemctl is-system-running 2>/dev/null) == stopping ]] && exit 0
        for f in "$DIR"/*; do [[ -e $f ]] && start_it "$(basename "$f")"; done
        exit 0
        ;;
    *) echo "usage: $0 start|watch|stop" >&2; exit 2 ;;
esac
