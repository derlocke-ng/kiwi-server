    def leave_out(self, host, key):
        """A warning this machine does not show any more (its setting `quiet`): it stays as a note.
        Gone from the screen at once; the next look at the machines says the same by itself."""
        if self.doc.dirty:
            self.toast("Save your other changes first")
            return
        now = list(self.doc.get(host, ("quiet",)) or [])
        if key in now:
            return
        self.doc.set(host, ("quiet",), now + [key])
        try:
            self.doc.save()
        except OSError as e:
            self.alert("Save failed", str(e))
            return
        live = self.live.get(host)
        if live:
            gone = [p for p in live.get("problems") or [] if p.get("key") == key and p.get("level") == "warn"]
            live["problems"] = [p for p in live["problems"] if p not in gone]
            live.setdefault("notes", []).extend("left out on purpose: " + p["text"] for p in gone)
            levels = {p.get("level") for p in live["problems"]}
            live["state"] = "bad" if "bad" in levels else "warn" if "warn" in levels else "ok"
        self.mark_dirty()
        self.render_current()
        self.toast("%s: that warning is left out from now on (its settings bring it back)" % host, "ok")
        self.sync(after_save=True)

