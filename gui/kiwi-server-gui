        g = Adw.PreferencesGroup(title="What next", description="Your machines run. These make the network useful and safe.")
        for title, text, label, action in rows:
            row = Adw.ActionRow(use_markup=False, title=title, subtitle=text, subtitle_lines=4)
            b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
