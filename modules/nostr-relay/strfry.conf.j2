##
## strfry for {{ hostname }} — generated by kiwi-modules; wss://{{ relay_host }} through the reverse proxy
##

db = "{{ db_path }}/"

dbParams {
    maxreaders = 256
    mapsize = 10995116277760
    noReadAhead = false
}

events {
    maxEventSize = {{ max_event_bytes }}
    rejectEventsNewerThanSeconds = 900
    rejectEventsOlderThanSeconds = {{ (keep_days * 86400) if keep_days else 0 }}
    rejectEphemeralEventsOlderThanSeconds = 60
    ephemeralEventsLifetimeSeconds = 300
    maxNumTags = 2000
    maxTagValSize = 1024
}

relay {
    bind = "0.0.0.0"
    port = 7777
    nofiles = 0
    realIpHeader = "x-real-ip"

    info {
        name = "{{ relay_name or hostname }}"
        description = "{{ relay_description }}"
        pubkey = "{{ relay_pubkey }}"
        contact = "{{ relay_contact }}"
        icon = ""
        nips = ""
    }

    maxWebsocketPayloadSize = {{ [max_event_bytes * 2, 131072] | max }}
    maxReqFilterSize = 200
    autoPingSeconds = 55
    enableTcpKeepalive = false
    queryTimesliceBudgetMicroseconds = 10000
    maxFilterLimit = {{ max_filter_limit }}
    maxSubsPerConnection = {{ max_subs_per_connection }}

    writePolicy {
        plugin = "{{ '' if open_writes else '/app/kiwi-write-policy.py' }}"
    }

    # NIP-42. The image's patch challenges a connection when it first writes, and tells the
    # write policy which key it proved (images/strfry).
    auth {
        enabled = {{ 'false' if open_writes else 'true' }}
        serviceUrl = "{{ '' if open_writes else 'wss://' ~ relay_host }}"
    }

    compression {
        enabled = true
        slidingWindow = true
    }

    logging {
        dumpInAll = false
        dumpInEvents = false
        dumpInReqs = false
        logWebsocketPayloads = false
    }

    numThreads {
        ingester = 3
        reqWorker = 3
        reqMonitor = 3
        negentropy = 2
    }

    negentropy {
        enabled = {{ 'true' if negentropy else 'false' }}
        maxSyncEvents = 1000000
    }
}
