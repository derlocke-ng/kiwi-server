# fail2ban jails for {{ hostname }} — generated by kiwi-server; the fleet file is the place to change them
[DEFAULT]
bantime  = {{ bantime }}
findtime = {{ findtime }}
maxretry = {{ maxretry }}
banaction = iptables-multiport
# never: this machine, the mesh, the docker network, and what the fleet names
ignoreip = 127.0.0.1/8 ::1 {{ mesh_subnet }} {{ docker_subnet }} {{ ignore | join(' ') }}

[sshd]
enabled  = true
port     = {{ ssh_port }}
logpath  = /var/log/kiwi/sshd.log
backend  = polling
# aggressive: also preauth disconnects and timeouts, which is most of what bots do
mode     = aggressive
{% if has_reverse_proxy and (module_config.get('reverse-proxy') or {}).get('public') %}

# the public sites: nginx is reached through the host's port forwarding, so a ban goes into
# FORWARD (where those packets pass), not INPUT
[nginx-bad-request]
enabled  = true
port     = http,https
chain    = FORWARD
logpath  = /var/log/nginx/access.log
backend  = polling

[nginx-http-auth]
enabled  = true
port     = http,https
chain    = FORWARD
logpath  = /var/log/nginx/error.log
backend  = polling

# scanners asking for what is not here: WordPress, PHP admin pages, dotfiles, CGI
[kiwi-nginx-probe]
enabled  = true
port     = http,https
chain    = FORWARD
filter   = kiwi-nginx-probe
logpath  = /var/log/nginx/access.log
backend  = polling
maxretry = 3

# who keeps asking faster than the proxy allows (its rate limit says so in its error log)
[nginx-limit-req]
enabled  = true
port     = http,https
chain    = FORWARD
logpath  = /var/log/nginx/error.log
backend  = polling
maxretry = 10

# who is refused again and again: wrong passwords at a login, a page they may not see
[kiwi-nginx-refused]
enabled  = true
port     = http,https
chain    = FORWARD
filter   = kiwi-nginx-refused
logpath  = /var/log/nginx/access.log
backend  = polling
maxretry = 20

{% endif %}

# who was banned three times in a day is out for a week, on every port
[recidive]
enabled  = true
logpath  = /config/log/fail2ban/fail2ban.log
backend  = polling
banaction = iptables-allports
{% if has_reverse_proxy and (module_config.get('reverse-proxy') or {}).get('public') %}
action   = %(banaction)s[name=recidive, chain=INPUT]
           %(banaction)s[name=recidive-forward, chain=FORWARD]
{% endif %}
bantime  = 1w
findtime = 1d
maxretry = 3
