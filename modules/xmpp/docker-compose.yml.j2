# xmpp (ejabberd): start.sh brings the certificates and the admin's account, then runs ejabberd as its own user
{% macro service(name, config, data, host, onion_host, certs) %}
  {{ name }}:
    image: {{ image }}
    container_name: {{ name }}
    init: true
    # root only for start.sh, which copies the certificate's key for ejabberd's user and then becomes that user
    user: "0:0"
    entrypoint: ["/bin/sh"]
    command: ["/kiwi-start.sh"]
    environment:
      - TZ={{ timezone }}
      # the database belongs to this name: it must not change with the container
      - ERLANG_NODE_ARG=ejabberd@localhost
      - ERL_EPMD_ADDRESS=127.0.0.1
      - KIWI_HOST={{ host }}
      - KIWI_ONION={{ onion_host }}
      - KIWI_ADMIN={{ admin_user }}
      - KIWI_ADMIN_PASSWORD={{ admin_password }}
      # where its accounts were before they had a folder of their own per name (data, public)
      - KIWI_OLD={{ data }}
      - KIWI_OTHER={{ 'public' if data == 'data' else 'data' }}
{{ caller() }}
    restart: unless-stopped
    stop_grace_period: 60s
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-xmpp/start.sh:/kiwi-start.sh:ro,z
      - {{ docker_dir }}/{{ container_prefix }}-xmpp/{{ config }}:/opt/ejabberd/conf/ejabberd.yml:ro,z
      # the accounts, messages and files of each name in a folder of its own (hosts/<name>): when
      # one service becomes two or two one, the accounts stay with their name
      - {{ docker_dir }}/{{ container_prefix }}-xmpp:/kiwi-xmpp:z
      # the proxy's certificate for the name: the fleet CA's, or Let's Encrypt's for a public name
      - {{ docker_dir }}/{{ container_prefix }}-nginx{{ certs }}:/kiwi-certs:ro,z
{% endmacro %}
services:
{# the service in the network of the machine's door to the VPN: 5222 answers at its mesh address.
   With a public name (and no second instance) a master's WireGuard server publishes its ports;
   to a node the master hands them on #}
{% call service(container_prefix ~ '-xmpp', 'ejabberd.yml', 'data', main_host, (onion or {}).get('jabber', ''),
                '/acme/' ~ xmpp_domain if one_public else '') %}
    network_mode: "service:{{ container_prefix }}-{{ door }}"
    depends_on:
      - {{ container_prefix }}-{{ door }}
{% endcall %}
{% if two %}
{# the public instance: a container of its own. A master publishes its ports on the machine's
   own address; a node's are reached through the master only #}
{% call service(container_prefix ~ '-xmpp-public', 'ejabberd-public.yml', 'public', xmpp_domain, (onion or {}).get('xmpp', ''),
                '/acme/' ~ xmpp_domain) %}
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
{% if node_type == 'master' %}
    ports:
      - "5222:5222"
      - "5223:5223"
      - "5269:5269"
{% endif %}
{% endcall %}
{% endif %}
{% if join_on %}
{# the sign-up page: invite codes and requests, Jabber addresses made over ejabberd's API (5281, the stack network only) #}
{% set pages = {} %}
{# each page says the name of its own service: the addresses it makes end in it #}
{% if two %}
{% set _ = pages.update({internal_host: {"api": "http://" ~ container_prefix ~ "-" ~ door ~ ":5281/api", "host": internal_host, "onion": (onion or {}).get('jabber', ''), "brand": internal_host},
                         xmpp_domain: {"api": "http://" ~ container_prefix ~ "-xmpp-public:5281/api", "host": xmpp_domain, "onion": (onion or {}).get('xmpp', ''), "brand": xmpp_domain}}) %}
{% else %}
{% for page in [internal_host, xmpp_domain] if page %}
{% set _ = pages.update({page: {"api": "http://" ~ container_prefix ~ "-" ~ door ~ ":5281/api", "host": main_host, "onion": (onion or {}).get('jabber', ''), "brand": main_host}}) %}
{% endfor %}
{% endif %}
  {{ container_prefix }}-xmpp-join:
    image: {{ join_image }}
    container_name: {{ container_prefix }}-xmpp-join
    restart: unless-stopped
    command: ["signup", "serve", "--state", "/state", "--ejabberd", {{ pages | tojson | tojson }},
              "--ways", "{{ join_ways }}", "--brand", {{ (main_host) | tojson }}, "--terms-file", "/state/terms.txt", "--listen", "0.0.0.0:8080"]
    networks:
      {{ network_name }}: {}
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-xmpp/join:/state:z
    logging:
      driver: json-file
      options:
        max-size: 10m
{% endif %}
