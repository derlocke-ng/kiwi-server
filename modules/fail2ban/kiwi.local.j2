# fail2ban jails for {{ hostname }} — generated by kiwi-server; the fleet file is the place to change them
[DEFAULT]
bantime  = {{ bantime }}
findtime = {{ findtime }}
maxretry = {{ maxretry }}
banaction = iptables-multiport
# never: this machine, the mesh, the docker network, and what the fleet names
ignoreip = 127.0.0.1/8 ::1 {{ mesh_subnet }} {{ docker_subnet }} {{ ignore | join(' ') }}

[sshd]
enabled  = true
port     = {{ ssh_port }}
logpath  = /var/log/kiwi/sshd.log
backend  = polling
# aggressive: also preauth disconnects and timeouts, which is most of what bots do
mode     = aggressive
{% if f2b_web %}

# the public sites.{% if f2b_behind %} They come through the master, which hands each connection on with
# the visitor's address in front: only nginx knows that address here, so a ban is a line in
# nginx's list of banned addresses (kiwi-nginx-deny), not a firewall rule
{% set ban = 'action   = kiwi-nginx-deny' %}
{% else %} nginx is reached through the host's port forwarding, so a ban goes into
# FORWARD (where those packets pass), not INPUT
{% set ban = 'chain    = FORWARD' %}
{% endif %}
[nginx-bad-request]
enabled  = true
port     = http,https
{{ ban }}
logpath  = /var/log/nginx/access.log
backend  = polling

[nginx-http-auth]
enabled  = true
port     = http,https
{{ ban }}
logpath  = /var/log/nginx/error.log
backend  = polling

# scanners asking for what is not here: WordPress, PHP admin pages, dotfiles, CGI
[kiwi-nginx-probe]
enabled  = true
port     = http,https
{{ ban }}
filter   = kiwi-nginx-probe
logpath  = /var/log/nginx/access.log
backend  = polling
maxretry = 3

# a flood, not a visitor: the rate limit already answers who asks too fast with 429 (and a
# page's own files are not counted); only who keeps on at two refusals a second for a minute is banned
[nginx-limit-req]
enabled  = true
port     = http,https
{{ ban }}
logpath  = /var/log/nginx/error.log
backend  = polling
findtime = 1m
maxretry = 120

# who is refused again and again where no app counts the wrong logins itself: a page they may
# not see, a password tried at the proxy. Generous: an app or a sync client gets 401s too
[kiwi-nginx-refused]
enabled  = true
port     = http,https
{{ ban }}
filter   = kiwi-nginx-refused
logpath  = /var/log/nginx/access.log
backend  = polling
maxretry = 40
{% for j in f2b_jails %}

# {{ j.name }}: wrong logins, as its own log tells them (kn-f2b-tap copies those lines out)
[kiwi-{{ j.name }}]
enabled  = true
port     = http,https
{{ ban }}
filter   = kiwi-app
failregex = {{ j.failregex }}
logpath  = /kiwi-apps/{{ j.name }}.log
backend  = polling
{% if j.maxretry %}
maxretry = {{ j.maxretry }}
{% endif %}
{% endfor %}

{% endif %}

# who was banned three times in a day is out for a week, on every port
[recidive]
enabled  = true
logpath  = /config/log/fail2ban/fail2ban.log
backend  = polling
banaction = iptables-allports
{% if f2b_behind %}
action   = %(banaction)s[name=recidive, chain=INPUT]
           kiwi-nginx-deny
{% elif f2b_web %}
action   = %(banaction)s[name=recidive, chain=INPUT]
           %(banaction)s[name=recidive-forward, chain=FORWARD]
{% endif %}
bantime  = 1w
findtime = 1d
maxretry = 3
