def to_text(ftype, value):
    if value is None:
        return ""
    if ftype in ("list",):
        return " ".join(str(v) for v in value) if isinstance(value, list) else str(value)
    if ftype == "lines":
        return "\n".join(str(v) for v in value) if isinstance(value, list) else str(value)
    if ftype == "map":
        return "\n".join("%s=%s" % (k, v) for k, v in value.items()) if isinstance(value, dict) else str(value)
    if ftype == "object":
        return yaml.safe_dump(value, sort_keys=False, default_flow_style=False).rstrip("\n") if value else ""
    return str(value)


def from_text(ftype, text):
    text = text.strip() if ftype != "text" else text.rstrip()
    if text == "":
        return None
    if ftype == "list":
        return text.split()
    if ftype == "lines":
        return [ln.strip() for ln in text.splitlines() if ln.strip()]
    if ftype == "map":
        out = {}
        for ln in text.splitlines():
            if "=" in ln:
                k, v = ln.split("=", 1)
                out[k.strip()] = v.strip()
        return out or None
    if ftype == "int":
        try:
            return int(text)
        except ValueError:
            return None
    if ftype == "object":
        try:
            v = yaml.safe_load(text)
        except yaml.YAMLError:
            return None   # kept as typed until it parses; validate reports it
        return v if isinstance(v, (dict, list)) and v else None
    return text


class Form:
    """Builds rows for one scope and writes changes back into the doc."""

    def __init__(self, win, doc, scope, roles, targets):
        self.win, self.doc, self.scope, self.roles, self.targets = win, doc, scope, roles, targets
        self.loading = False
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, hexpand=True)
        self.side = Gtk.ListBox(css_classes=["navigation-sidebar"])
        self.side.connect("row-selected", self.on_section)
        side = Gtk.ScrolledWindow(child=self.side, hscrollbar_policy=Gtk.PolicyType.NEVER, width_request=180)
        self.page = Gtk.Box()               # what the window shows: the sections beside their pages
        self.page.append(side)
        self.page.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        self.page.append(self.stack)
        self.role_parts = []
        self.build()

    # ---- sections ----
    def section(self, name, label, groups, at=None):
        """A page of its own with a row in the sidebar; `at` inserts the row there."""
        page = Adw.PreferencesPage()
        for g in groups:
            page.add(g)
        self.stack.add_named(page, name)
        row = Gtk.ListBoxRow(child=Gtk.Label(label=label, xalign=0, ellipsize=3))
        row.ks_name = name
        self.side.insert(row, -1 if at is None else at)
        return row, page

    def heading(self, text, at=None):
        lbl = Gtk.Label(label=text, xalign=0, margin_top=12, css_classes=["dim-label", "caption-heading"])
        row = Gtk.ListBoxRow(child=lbl, selectable=False, activatable=False)
        self.side.insert(row, -1 if at is None else at)
        return row

    def on_section(self, _box, row):
        if row is not None and getattr(row, "ks_name", None):
            self.stack.set_visible_child_name(row.ks_name)
            self.win.settings_section = row.ks_name      # the same section on the next host

    def select(self, name):
        rows, row = [], self.side.get_first_child()
        while row is not None:
            if getattr(row, "ks_name", None):
                rows.append(row)
            row = row.get_next_sibling()
        pick = next((r for r in rows if r.ks_name == name), rows[0] if rows else None)
        if pick is not None:
            self.side.select_row(pick)

    def effective_target(self):
        return self.doc.get(self.scope, ("target",)) or self.doc.get("defaults", ("target",)) or "coreos"

    # ---- helpers ----
    def inherited(self, field):
        """What the value is when this scope does not set it."""
        if self.scope != "defaults":
            v = self.doc.get("defaults", field["path"])
            if v is not None:
                return v
        return field.get("default")

    def current(self, field):
        return self.doc.get(self.scope, field["path"])

    def write(self, field, value):
        if self.loading:
            return
        self.doc.set(self.scope, field["path"], value)
        self.win.mark_dirty()
        if field["path"] == ("target",):
            GLib.idle_add(self.rebuild)
        elif field["path"] == ("role",) or (len(field["path"]) == 2 and field["path"][1] in ("modules", "preset")):
            self.rebuild_role_group()

    def role_name(self):
        r = self.doc.get(self.scope, ("role",))
        if r is None and self.scope != "defaults":
            r = self.doc.get("defaults", ("role",))
        return r or "bare"

    def visible(self, field):
        sc = field.get("scope", "all")
        return sc == "all" or (sc == "defaults") == (self.scope == "defaults")

    # ---- rows ----
    def row_for(self, field):
        t = field["type"]
        if t in ("text", "lines", "map", "object"):
            row = self.text_row(field)
        elif t == "bool":
            row = self.bool_row(field)
        elif t == "enum":
            row = self.enum_row(field)
        else:
            row = self.entry_row(field)
        if field.get("help"):
            btn = help_button(field["help"], DOCS + field.get("doc", "README.md#the-fleet-file"))
            if isinstance(row, Adw.ExpanderRow):
                row.add_suffix(btn)
            elif hasattr(row, "ks_switch"):         # the (?) before the switch, not after it
                row.remove(row.ks_switch)
                row.add_suffix(btn)
                row.add_suffix(row.ks_switch)
            else:
                row.add_suffix(btn)
        return row

    def entry_row(self, field):
        cls = Adw.PasswordEntryRow if field["type"] == "secret" else Adw.EntryRow
        row = cls(title=field["label"])
        inh = to_text(field["type"], self.inherited(field))
        cur = self.current(field)
        if cur is not None:
            row.set_text(to_text(field["type"], cur))
        sub = []
        if field.get("help"):
            sub.append(field["help"])
        if self.scope != "defaults" and inh:
            sub.append("inherited: %s" % ("••••" if field["type"] == "secret" else inh))
        elif field.get("placeholder"):
            sub.append("e.g. %s" % field["placeholder"])
        if sub:
            row.set_tooltip_text(" — ".join(sub))
            # EntryRow has no subtitle; a dim hint label as suffix keeps it visible
            shown = sub[-1] if (self.scope != "defaults" and inh) or field.get("placeholder") else ""
            if shown:
                hint = Gtk.Label(label=shown, ellipsize=3, max_width_chars=28, valign=Gtk.Align.CENTER)
                hint.add_css_class("dim-label")
                hint.add_css_class("caption")
                row.add_suffix(hint)
        if field["type"] == "file":
            btn = Gtk.Button(icon_name="document-open-symbolic", valign=Gtk.Align.CENTER,
                             tooltip_text="Choose a file")
            btn.add_css_class("flat")
            btn.connect("clicked", lambda *_: self.pick_file(row))
            row.add_suffix(btn)
        if field.get("apply"):
            # writing this field rebuilds the form (the module list): commit on Enter
            # or the apply button, not on every keystroke
            row.set_show_apply_button(True)
            row.connect("apply", lambda r: self.write(field, from_text(field["type"], r.get_text())))
        else:
            row.connect("changed", lambda r: self.write(field, from_text(field["type"], r.get_text())))
        return row

    def pick_file(self, row):
        dlg = Gtk.FileDialog(title="Choose a file")
        if self.doc.path:
            dlg.set_initial_folder(Gio.File.new_for_path(self.doc.dir))

        def done(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            p = f.get_path()
            rel = os.path.relpath(p, self.doc.dir)
            row.set_text(rel if not rel.startswith("..") else p)
        dlg.open(self.win, None, done)

    def text_row(self, field):
        exp = Adw.ExpanderRow(title=field["label"])
        tv = Gtk.TextView(monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=6,
                          bottom_margin=6, left_margin=8, right_margin=8)
        tv.add_css_class("ks-textbox")
        tv.set_size_request(-1, 110)
        cur = self.current(field)
        tv.get_buffer().set_text(to_text(field["type"], cur) if cur is not None else "")
        inh = self.inherited(field)
        if self.scope != "defaults" and inh:
            exp.set_subtitle(esc("inherited: %s" % to_text(field["type"], inh).replace("\n", " · ")[:80], -1))
        if cur is not None:
            exp.set_expanded(True)

        def changed(buf):
            s = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), True)
            self.write(field, from_text(field["type"], s))
        tv.get_buffer().connect("changed", changed)
        box = Gtk.Box(margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
        box.append(tv)
        tv.set_hexpand(True)
        exp.add_row(box)
        return exp

    def bool_row(self, field):
        inh = self.inherited(field)
        cur = self.current(field)
        if self.scope == "defaults":
            row = Adw.ActionRow(title=field["label"])
            sw = Gtk.Switch(valign=Gtk.Align.CENTER, active=bool(cur if cur is not None else inh))
            sw.connect("notify::active", lambda w, _p: self.write(field, bool(w.get_active())))
            row.add_suffix(sw)
            row.set_activatable_widget(sw)
            row.ks_switch = sw
            return row
        row = Adw.ComboRow(title=field["label"])
        row.set_model(Gtk.StringList.new(["Inherit (%s)" % ("on" if inh else "off"), "On", "Off"]))
        row.set_selected(0 if cur is None else (1 if cur else 2))
        row.connect("notify::selected",
                    lambda r, _p: self.write(field, {0: None, 1: True, 2: False}[r.get_selected()]))
        return row

    def enum_row(self, field):
        opts = list(field.get("options") or [])
        if field["path"] == ("target",):
            opts = list(self.targets)
        elif field["path"] == ("role",):
            opts = [r["name"] for r in self.roles]
        inh = self.inherited(field)
        cur = self.current(field)
        labels = list(opts)
        if self.scope != "defaults":
            labels = ["Inherit (%s)" % inh] + labels
        row = Adw.ComboRow(title=field["label"])
        row.set_model(Gtk.StringList.new(labels))
        if cur in opts:
            row.set_selected(opts.index(cur) + (0 if self.scope == "defaults" else 1))
        elif self.scope == "defaults" and inh in opts:
            row.set_selected(opts.index(inh))
        else:
            row.set_selected(0)

        def changed(r, _p):
            i = r.get_selected()
            if self.scope != "defaults":
                self.write(field, None if i == 0 else opts[i - 1])
            else:
                self.write(field, opts[i])
        row.connect("notify::selected", changed)
        return row

    # ---- assembly ----
    def build(self):
        self.loading = True
        target = self.effective_target()
        system = False
        for title, fields in BASE_GROUPS:
            if self.scope != "defaults" and target not in SECTION_TARGETS.get(title, (target,)):
                continue
            rows = [self.row_for(f) for f in fields if self.visible(f)]
            if not rows:
                continue
            if title != "Machine" and not system:
                self.heading("System")
                system = True
            g = Adw.PreferencesGroup(title=title)
            for r in rows:
                g.add(r)
            self.section("base:" + title, SECTION_LABELS.get(title, title), [g])
        self.rebuild_role_group()
        self.loading = False
        self.select(getattr(self.win, "settings_section", None))

    def rebuild(self):
        """Everything again, e.g. after the target changed which sections there are."""
        while (row := self.side.get_first_child()) is not None:
            self.side.remove(row)
        while (page := self.stack.get_first_child()) is not None:
            self.stack.remove(page)
        self.role_parts = []
        self.build()
        return False

    def effective_modules(self, role):
        """The preset's modules, or the fleet's override, with dependencies."""
        v = self.doc.get(self.scope, (role["name"], "modules"))
        if v is None and self.scope != "defaults":
            v = self.doc.get("defaults", (role["name"], "modules"))
        if isinstance(v, list):
            wanted = [str(x) for x in v]
        elif isinstance(v, str) and v.strip():
            wanted = v.split()
        elif role.get("presets"):
            pr = self.doc.get(self.scope, (role["name"], "preset"))
            if pr is None and self.scope != "defaults":
                pr = self.doc.get("defaults", (role["name"], "preset"))
            presets = role["presets"]
            pr = pr if pr in presets else next(iter(presets))
            wanted = list(presets[pr].get("modules") or [])
        else:
            wanted = list(role.get("modules") or [])
        out = []

        def visit(m, seen):
            if m in out or m in seen:
                return
            seen.add(m)
            for d in (self.win.module_schemas.get(m) or {}).get("requires", []):
                visit(d, seen)
            out.append(m)
        for m in wanted:
            visit(m, set())
        return out

    def _field(self, path, s, default):
        doc = "modules/%s/module.yaml" % path[1] if len(path) == 3 else "roles/%s/role.yaml" % path[0]
        f = dict(path=path, type=s["type"], label=s["label"] + (" *" if s.get("required") else ""),
                 help=s.get("help", ""), options=s.get("options") or [], default=default,
                 placeholder=s.get("placeholder", ""), doc=doc)
        if s.get("targets"):
            f["help"] = (f["help"] + " (%s only)" % "/".join(s["targets"])).strip()
        return f

    def rebuild_role_group(self):
        """The role's page and one page per module, after Machine in the sidebar."""
        current = self.stack.get_visible_child_name()
        for row, page in self.role_parts:
            self.side.remove(row)
            if page is not None:
                self.stack.remove(page)
        self.role_parts = []
        name = self.role_name()
        role = next((r for r in self.roles if r["name"] == name), None)
        if not role:
            return
        was = self.loading
        self.loading = True
        at = [1]                            # right after Machine

        def add(*part):
            row = part[0] if len(part) == 1 else self.section(*part, at=at[0])[0]
            self.role_parts.append((row, self.stack.get_child_by_name(part[0]) if len(part) > 1 else None))
            at[0] += 1
        stack = bool(role.get("stack"))
        groups = []
        if stack:
            g = Adw.PreferencesGroup(title=role["title"])
            g.add(self.row_for(dict(
                path=(name, "modules"), type="list", label="Modules", apply=True,
                help="Space separated, Enter applies. Empty: the preset — %s" % " ".join(role.get("modules") or []),
                doc="README.md#roles-and-modules",
                default=list(role.get("modules") or []), placeholder=" ".join(role.get("modules") or []))))
            groups.append(g)
        by_group = {}
        for st in role["settings"]:
            by_group.setdefault(st.get("group") or "Settings", []).append(st)
        for gname, items in by_group.items():
            g = Adw.PreferencesGroup(title=gname if groups else role["title"])
            for st in items:
                g.add(self.row_for(self._field((name, st["key"]), st, st.get("default"))))
            groups.append(g)
        if groups:
            groups[0].set_header_suffix(info_button(role["description"] + (
                "" if role.get("status") == "stable" else " [%s]" % role.get("status")), DOCS + "roles/%s/role.yaml" % name))
            add("role", role["title"], groups)
        if stack:
            mdefaults = dict(role.get("module_defaults") or {})
            if role.get("presets"):
                pr = self.doc.get(self.scope, (role["name"], "preset")) or self.doc.get("defaults", (role["name"], "preset"))
                pr = pr if pr in role["presets"] else next(iter(role["presets"]))
                for m, d in (role["presets"][pr].get("module_defaults") or {}).items():
                    mdefaults[m] = {**(mdefaults.get(m) or {}), **d}
            mods = [m for m in self.effective_modules(role) if self.win.module_schemas.get(m)]
            if mods:
                add(self.heading("Modules", at=at[0]))
            for m in mods:
                schema = self.win.module_schemas[m]
                g = Adw.PreferencesGroup(title=schema["title"])
                if schema.get("description"):
                    g.set_header_suffix(info_button(schema["description"], DOCS + "modules/%s/module.yaml" % m))
                for st in schema["settings"]:
                    default = (mdefaults.get(m) or {}).get(st["key"], st.get("default"))
                    g.add(self.row_for(self._field((name, m, st["key"]), st, default)))
                if not schema["settings"]:
                    g.add(Adw.ActionRow(title="No settings", subtitle="On or off, nothing else."))
                add("mod:" + m, schema["title"], [g])
        self.loading = was
        if current and self.stack.get_child_by_name(current):
            self.select(current)


