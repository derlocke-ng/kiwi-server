[Unit]
Description=Backup of {{ hostname }} to {{ server }}
Documentation=https://github.com/derlocke-ng/kiwi-server
{% if runtime == 'docker' %}
After=docker.service kiwi-stack.service network-online.target
Requires=docker.service
{% else %}
After=kiwi-stack.service network-online.target
{% endif %}
Wants=network-online.target
# for a server that is rebooting, say; the night's run is over before the next one is due
StartLimitIntervalSec=12h
StartLimitBurst=4

[Service]
Type=oneshot
Restart=on-failure
RestartSec=1h
ExecCondition=/usr/bin/bash {{ docker_dir }}/kiwi/backup.sh due
ExecStart=/usr/bin/bash {{ docker_dir }}/kiwi/backup.sh backup
ExecStopPost=/usr/bin/bash {{ docker_dir }}/kiwi/backup.sh thaw
Nice=10
IOSchedulingClass=idle
