        b = Gtk.MenuButton(child=Gtk.Label(label="?", css_classes=["heading"]), valign=Gtk.Align.CENTER,
                           tooltip_text="What is this?", css_classes=["flat", "circular", "ks-help"])
    b.update_property([Gtk.AccessibleProperty.LABEL], ["More about this"])
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=10, margin_bottom=10,
                  margin_start=12, margin_end=12)
    box.append(Gtk.Label(label=text, wrap=True, max_width_chars=56, xalign=0, selectable=info))
    if link:
        box.append(Gtk.LinkButton(uri=link, label="More in the docs", halign=Gtk.Align.START, css_classes=["flat"]))
    b.set_popover(Gtk.Popover(child=box))
    return b


