        box.append(self.note)
        box.append(self.go)
        self.nav.add(Adw.NavigationPage(title="Add a phone or laptop", child=box))
        self.set_child(self.nav)

    def clean(self):
        name = self.name.get_text().strip().lower().replace(" ", "-")
        return name if re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", name) else ""

    def add(self):
        name = self.clean()
        if not name:
            return
        self.go.set_sensitive(False)
        self.go.set_label("Adding…")
        args = ["enroll", self.win.doc.path, name]
        if self.group is not None:
            args += ["--group", self.groups[self.group.get_selected()]]

        def work():
            rc, out, err = run_cli(self.win.cli, args, timeout=180)
            GLib.idle_add(self.done, rc, (err or out), name)
        threading.Thread(target=work, daemon=True).start()

    def done(self, rc, text, name):
        conf = os.path.join(self.win.doc.dir, "secrets", "devices", name + ".conf")
        if rc != 0 or not os.path.isfile(conf):
            self.note.set_label((text.replace("error: ", "").strip().splitlines() or ["It did not work."])[-1])
            self.note.set_visible(True)
            self.go.set_label("Add it")
            self.go.set_sensitive(True)
            return False
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        box.append(Gtk.Label(label="%s is ready" % name, xalign=0, css_classes=["title-2"]))
        qr = None
        tool = shutil.which("qrencode") or shutil.which("qrencode", path="/home/linuxbrew/.linuxbrew/bin")
        if tool:
            try:
                with open(conf, "rb") as f:
                    r = subprocess.run([tool, "-t", "PNG", "-s", "6", "-m", "2", "-o", "-"], input=f.read(),
                                       capture_output=True, timeout=20)
                if r.returncode == 0:
                    qr = Gtk.Picture.new_for_paintable(Gdk.Texture.new_from_bytes(GLib.Bytes.new(r.stdout)))
                    qr.set_size_request(280, 280)
            except (OSError, subprocess.TimeoutExpired, GLib.Error):
                qr = None
        control = self.win.control_host()
        if qr is not None:
            box.append(Gtk.Label(label="On the phone: install the WireGuard app, tap +, then Scan from QR code.",
                                 wrap=True, xalign=0))
            box.append(qr)
        else:
            box.append(Gtk.Label(label="For a phone you need its QR code. " + (
                "Your control page shows it: Devices, then Show its QR code." if control else
                "Install qrencode on this computer (brew install qrencode) and the code is shown here."),
                wrap=True, xalign=0))
        box.append(Gtk.Label(label="On a laptop: install WireGuard and import the file.", wrap=True, xalign=0))
        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        save = Gtk.Button(label="Save the file…")
        save.connect("clicked", lambda *_: self.save(conf, name))
        buttons.append(save)
        if control and qr is None:
            host = (self.win.status.get(control) or {}).get("hostname") or control
            page = Gtk.Button(label="Open the control page")
            page.connect("clicked", lambda *_: Gtk.UriLauncher.new("https://control.%s/devices" % host).launch(self.win, None, None))
            buttons.append(page)
        close = Gtk.Button(label="Done", css_classes=["suggested-action"])
        close.connect("clicked", lambda *_: self.close())
        buttons.append(close)
        box.append(buttons)
        box.append(Gtk.Label(label="Whoever has the code or the file is on your VPN as this device.", wrap=True,
                             xalign=0, css_classes=["dim-label", "caption"]))
        self.nav.push(Adw.NavigationPage(title="Ready", child=box, can_pop=False))
        self.win.sync(after_save=True)          # the control node learns the new device
        return False

    def save(self, conf, name):
        dlg = Gtk.FileDialog(title="Save the device's file", initial_name=name + ".conf")

        def chosen(d, res):
            try:
                dest = d.save_finish(res).get_path()
            except GLib.Error:
                return
            shutil.copyfile(conf, dest)
            os.chmod(dest, 0o600)
            self.win.toast("Saved. Import it in WireGuard on the laptop, then delete the file.")
        dlg.save(self.win, None, chosen)


def in_plain_words(text):
    """What a problem line means and what to do, before the technical words."""
    low = text.lower()
    for key, plain in (
            ("unreachable", "It does not answer. Is it switched on and online, and is this computer on your VPN?"),
            ("disk is locked", "Its disk is encrypted and waits to be unlocked after a restart."),
            ("waiting for a reboot", "It installed updates and restarts by itself in its update window. Nothing to do."),
            ("not running", "A service on it stopped. Apply usually brings it back.")):
        if key in low:
            return "%s  (%s)" % (plain, text)
    return text


class JoinDialog(Adw.Dialog):
    """Join a fleet that exists: paste the invite link from its control page. One field."""

    def __init__(self, win):
        super().__init__(title="Join a fleet", content_width=520)
        self.win = win
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        box.append(Gtk.Label(label="On the fleet's control page: Computers, Add a computer. Paste the link here.",
                             wrap=True, xalign=0))
        g = Adw.PreferencesGroup()
        self.go = Gtk.Button(label="Join", css_classes=["suggested-action", "pill"], halign=Gtk.Align.CENTER,
                             sensitive=False)
        self.go.connect("clicked", lambda *_: self.join())
        self.link = Adw.EntryRow(title="Invite link")
        self.link.connect("entry-activated", lambda *_: self.join())
        self.link.connect("changed", lambda *_: self.go.set_sensitive("#join=" in self.link.get_text()))
        g.add(self.link)
        folder = os.path.expanduser("~/kiwi")
        n = 2
        while os.path.exists(folder) and os.listdir(folder):
            folder, n = os.path.expanduser("~/kiwi-%d" % n), n + 1
        self.folder = folder
        g.add(Adw.ActionRow(title="Folder", subtitle=tilde(folder)))
        box.append(g)
        self.note = Gtk.Label(wrap=True, xalign=0, visible=False, css_classes=["error"])
        box.append(self.note)
        box.append(self.go)
        self.set_child(box)
        # a link on the clipboard: it is what the user came with
        Gdk.Display.get_default().get_clipboard().read_text_async(None, self.pasted)

    def pasted(self, clip, res):
        try:
            text = (clip.read_text_finish(res) or "").strip()
        except GLib.Error:
            return
        if "#join=" in text and not self.link.get_text():
            self.link.set_text(text)

    def join(self):
        link = self.link.get_text().strip()
        if "#join=" not in link:
            return
        self.go.set_sensitive(False)
        self.go.set_label("Joining…")
        self.note.set_visible(False)
        path = os.path.join(self.folder, "fleet.yaml")

        def work():
            os.makedirs(self.folder, mode=0o700, exist_ok=True)
            # the link on stdin, not among the arguments other programs can read
            try:
                r = subprocess.run([self.win.cli, "control", "join", path], input=link + "\n",
                                   capture_output=True, text=True, timeout=180)
                rc, err = r.returncode, (r.stderr or r.stdout)
            except (OSError, subprocess.TimeoutExpired) as e:
                rc, err = 1, str(e)
            GLib.idle_add(self.done, rc, err, path)
        threading.Thread(target=work, daemon=True).start()

    def done(self, rc, err, path):
        if rc == 0:
            self.close()
            self.win.open_path(path)
            self.win.toast("Joined: this computer keeps in step with the fleet by itself")
        else:
            self.note.set_label(err.replace("error: ", "").strip())
            self.note.set_visible(True)
            self.go.set_label("Join")
            self.go.set_sensitive(True)
        return False


