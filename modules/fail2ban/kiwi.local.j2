# fail2ban jails for {{ hostname }} — generated by kiwi-server; the fleet file is the place to change them
[DEFAULT]
bantime  = {{ bantime }}
findtime = {{ findtime }}
maxretry = {{ maxretry }}
banaction = iptables-multiport
# never: this machine, the mesh, the docker network, and what the fleet names
ignoreip = 127.0.0.1/8 ::1 {{ mesh_subnet }} {{ docker_subnet }} {{ ignore | join(' ') }}

[sshd]
enabled  = true
port     = {{ ssh_port }}
logpath  = /var/log/kiwi/sshd.log
backend  = polling
# aggressive: also preauth disconnects and timeouts, which is most of what bots do
mode     = aggressive
