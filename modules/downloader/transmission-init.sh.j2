#!/bin/sh
# Transmission on {{ hostname }}: run by its image before the daemon starts; generated by kiwi-server.
# It shares the VPN client's network. No router there answers a request to open a port (UPnP,
# NAT-PMP), and Transmission went on asking every eight seconds: two lines in the machine's log
# each time, twenty thousand a day (seen 28 Nov 2026). Its own setting for that is switched off.
f=/config/settings.json
[ -f "$f" ] && sed -i 's/"port-forwarding-enabled": *true/"port-forwarding-enabled": false/' "$f"
exit 0
