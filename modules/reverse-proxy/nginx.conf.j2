# nginx for {{ hostname }} — generated by kiwi-server from the modules' server blocks.
{% macro headers(s, pad) %}
{% if (s.hsts or (s.hsts is none and hsts)) and not (s.public and acme_staging) %}
{{ pad }}add_header Strict-Transport-Security "max-age=15768000; includeSubDomains; preload;" always;
{% endif %}
{{ pad }}add_header Referrer-Policy "no-referrer" always;
{{ pad }}add_header X-Content-Type-Options "nosniff" always;
{{ pad }}add_header X-Frame-Options "SAMEORIGIN" always;
{{ pad }}add_header X-Robots-Tag "noindex, nofollow" always;
{% endmacro %}
{% macro proxy(s) %}
            set $backend {{ s.proxy_pass }};
            proxy_pass $backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $server_name;
{% if s.websocket %}
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
{% endif %}
{% if s.proxy_ssl %}
            proxy_ssl_verify off;
{% endif %}
{% for d in s.extra_directives %}
            {{ d }}
{% endfor %}
{% endmacro %}
worker_processes auto;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    types {
        text/javascript mjs;
    }

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;
    gzip on;
    gzip_vary on;
    gzip_comp_level 4;
    gzip_min_length 256;
    gzip_proxied expired no-cache no-store private no_last_modified no_etag auth;
    gzip_types application/atom+xml text/javascript application/javascript application/json application/ld+json application/manifest+json application/rss+xml application/vnd.geo+json application/vnd.ms-fontobject application/wasm application/x-font-ttf application/x-web-app-manifest+json application/xhtml+xml application/xml font/opentype image/bmp image/svg+xml image/x-icon text/cache-manifest text/css text/plain text/vcard text/vnd.rim.location.xloc text/vtt text/x-component text/x-cross-domain-policy;

    ssl_certificate     /etc/nginx/fullchain.pem;
    ssl_certificate_key /etc/nginx/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

{% set cors_servers = servers | selectattr('cors') | list %}
{% if cors_servers %}
    # a browser's CORS preflight only: DAV clients use OPTIONS too, and need the server's answer
    map "$request_method:$http_access_control_request_method" $kiwi_cors_preflight {
        default 0;
        "~^OPTIONS:.+" 1;
    }
{% for c in cors_servers %}
    map $http_origin ${{ c.cors.map }} {
        default "";
{% for o in c.cors.origins %}
        "{{ o }}" $http_origin;
{% endfor %}
    }
{% endfor %}

{% endif %}
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    # Backends are resolved per request through docker's DNS (proxy_pass with a
    # variable): nginx starts even when a backend does not exist yet — Nextcloud
    # AIO creates its containers after the first setup — and follows a recreated one.
    resolver {{ '127.0.0.11' if runtime == 'docker' else docker_gateway }} valid=30s ipv6=off;
    resolver_timeout 5s;

    # everything on 80 goes to https
    server {
        listen 80 default_server;
        server_name _;
{% if public_names %}

        # Let's Encrypt asks for its challenge here
        location /.well-known/acme-challenge/ {
            root /var/www/acme;
        }

        location / {
            return 301 https://$host$request_uri;
        }
{% else %}
        return 301 https://$host$request_uri;
{% endif %}
    }

    # a name no module announced: close the connection instead of serving the first block
    server {
        listen 443 ssl default_server;
        http2 on;
        server_name _;
        return 444;
    }
{% for s in servers %}

    # {{ s.comment }}
    server {
        listen 443 ssl;
        http2 on;
        server_name {{ s.server_name }};
{% if s.public %}
        ssl_certificate     /etc/nginx/acme/{{ s.server_name }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/acme/{{ s.server_name }}/privkey.pem;
{% elif public_names %}
        # 443 is open to the internet on this machine; this site is not for it
        allow {{ mesh_subnet }};
        deny all;
{% endif %}
        {{ headers(s, '        ') | trim }}
        client_max_body_size {{ s.client_max_body_size or '0' }};
{% if s.proxy_read_timeout %}
        proxy_read_timeout {{ s.proxy_read_timeout }};
        client_body_timeout {{ s.proxy_read_timeout }};
{% endif %}

        location / {
            {{ proxy(s) | trim }}
        }
{% if s.cors %}

        # browsers on the origins in the map above; a DAV client's own OPTIONS goes through
        location ^~ {{ s.cors.path }} {
            if ($kiwi_cors_preflight) {
                add_header Access-Control-Allow-Origin ${{ s.cors.map }} always;
                add_header Access-Control-Allow-Methods "{{ s.cors.methods }}" always;
                add_header Access-Control-Allow-Headers "{{ s.cors.allow_headers }}" always;
                add_header Access-Control-Max-Age 600 always;
                add_header Vary Origin always;
                return 204;
            }
            add_header Access-Control-Allow-Origin ${{ s.cors.map }} always;
            add_header Access-Control-Expose-Headers "{{ s.cors.expose_headers }}" always;
            add_header Vary Origin always;
            # an add_header here drops the server's own, so they are repeated
            {{ headers(s, '            ') | trim }}
            {{ proxy(s) | trim }}
        }
{% endif %}
{% for loc in s.extra_locations %}

        location {{ loc.path }} {
            {{ loc.config }}
{% if loc.proxy %}
            {{ proxy(s) | trim }}
{% endif %}
        }
{% endfor %}
    }
{% endfor %}
}
