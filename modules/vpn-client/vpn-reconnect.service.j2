[Unit]
Description=Kiwi Network: the VPN client connects anew ({{ hostname }}): another server, another exit
Documentation=https://github.com/derlocke-ng/kiwi-server
After=kiwi-stack.service

[Service]
Type=oneshot
TimeoutStartSec=10min
# kiwi-stack's own restart: the containers that live in the VPN client's network follow it
ExecStart=/usr/local/bin/kiwi-stack vpn-restart
