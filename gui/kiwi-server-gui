    def via_control_node(self, args):
        """An apply this computer would run itself, as a job on the control node instead, when this copy
        belongs to one and the preference says so: one admin, the node; its log comes here the same.
        None: run it here (a first apply over SSH, no control node, or the preference off)."""
        if not args or args[0] not in ("apply", "move", "switch") or "--ssh" in args or not gui_conf().get("apply_on_node", True):
            return None
        if not os.path.isfile(os.path.join(os.path.dirname(self.doc.path or ""), "control", "remote")):
            return None
        if args[0] == "move":       # ["move", fleet, part, from, to, "--yes"]: the node moves it, and keeps what it changes
            return ["control", "run", self.doc.path, "move", args[3], args[4], "--part", args[2]] if len(args) == 6 else None
        if args[0] == "switch":     # ["switch", fleet, part, from, "--yes"]
            controls = {n for n, h in (self.status or {}).items() if "control" in (h.get("modules") or [])}
            if len(args) == 5 and args[3] in controls:
                return None         # the control node's own machine is the one gone: switched from here
            return ["control", "run", self.doc.path, "switch", args[3], "--part", args[2]] if len(args) == 5 else None
        hosts = [a for a in args[2:] if not a.startswith("-")]
        flags = {a for a in args[2:] if a.startswith("-")}
        if flags - {"--changed", "--update"}:
            return None
        if "--changed" in flags:
            hosts += [h for h in (self.fleet_info or {}).get("changed") or [] if h not in hosts]
        if "--update" in flags:             # the node's update is every machine, its own last
            every = set(self.status or {})        # every machine of the fleet (self.status: the listing by name)
            return ["control", "run", self.doc.path, "update"] if every and set(hosts) >= every else None
        return ["control", "run", self.doc.path, "apply"] + hosts if hosts else None

    def spawn(self, args, msg):
        if self.busy:
            return
        args = self.via_control_node(args) or args
        # several machines at once: the kiwi fills by the machine (each says ":: NAME: applied")
        many = [a for a in args[2:] if not a.startswith("-")] if args[:1] == ["apply"] else []
        self._job_steps = len(many) if len(many) > 1 else 0
        self.set_busy(True, msg)
        if not self.jobs:
            self.b_log.set_active(True)     # with the strip the output opens by its button, or when a job fails
        agent_ask({"forget": True}, 2)      # what runs now may change what the resident kiwi-server keeps
        cmd = [self.cli] + list(args)

        def worker():
            GLib.idle_add(self.append_log, "\n$ %s\n" % " ".join(shlex.quote(c) for c in cmd))
            rc, said = 1, []
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                        text=True, stdin=subprocess.DEVNULL, start_new_session=True)
                self._proc = proc
                for line in proc.stdout:
                    said.append(line)
                    GLib.idle_add(self.append_log, line)
                    if self.jobs and self._job_steps and re.match(r":: \S+: applied\s*$", line):
                        GLib.idle_add(self.jobs.step)
                rc = proc.wait()
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self.append_log, "%s\n" % e)
            self._proc = None
            GLib.idle_add(self.after_spawn, rc, "".join(said[-40:]), list(args))
        threading.Thread(target=worker, daemon=True).start()

    def stop_task(self):
        """Stop what is running: the command and everything it started. A second press does not ask."""
        proc = getattr(self, "_proc", None)
        if proc is None or proc.poll() is not None:
            return
        import signal
        again = getattr(self, "_stopping", None) is proc
        self._stopping = proc
        try:
            os.killpg(proc.pid, signal.SIGKILL if again else signal.SIGTERM)
        except OSError:
            pass
        self.append_log("\n(stopped here%s)\n" % (", hard" if again else ""))

    def after_spawn(self, rc, said="", args=()):
        self._job_ok = rc == 0
        self.set_busy(False, "")
        if rc != 0 and args[:1] == ["apply"] and "host key is not the one on record" in said:
            self.other_host_key(args, said)
        else:
            self.toast("Done" if rc == 0 else "Failed — see the output")
        self.poll()
        after, self._after_spawn = getattr(self, "_after_spawn", None), None
        if after:
            after()
        return False

    def other_host_key(self, args, said):
        """A machine answers with another key than the one remembered: right after a new
        install, and the one thing that must not be waved through otherwise."""
        m = re.search(r"ssh-keygen -R (\S+)", said)
        host = args[2] if len(args) > 2 else "the machine"
        dlg = Adw.AlertDialog(
            heading="%s shows another key" % host,
            body="Kiwi Server remembers every machine by a key. %s now shows a different one. That is right if you "
                 "have just installed it anew. If you have not, stop here: something else may be answering at its "
                 "address." % host)
        dlg.add_response("stop", "Stop")
        dlg.add_response("anew", "I installed it anew")
        dlg.set_close_response("stop")

        def answer(_d, r):
            if r != "anew":
                return
            again = [a for a in args if a != "--new-host-key"]
            if "--ssh" not in again and m:
                again += ["--ssh", "%s@%s" % (self.admin_user(host), m.group(1))]
            self.spawn(again + ["--new-host-key"], "Setting up %s…" % host)
        dlg.connect("response", answer)
        dlg.present(self)

    def set_busy(self, busy, msg):
        self.busy = busy
        if self.jobs:                       # the kit's strip: the kiwi fills, or goes round with nothing to count
            if busy:
                self.jobs.start(msg or "Working…", getattr(self, "_job_steps", 0))
            elif self.jobs.busy:
                self.jobs.finish(getattr(self, "_job_ok", True))
                self._job_steps, self._job_ok = 0, True
        else:
            self.progress.set_visible(busy)
        self.b_stop.set_visible(busy)
        if busy and self._pulse is None and not self.jobs:
            self._pulse = GLib.timeout_add(120, self._do_pulse)
        elif not busy and self._pulse is not None:
            GLib.source_remove(self._pulse)
            self._pulse = None
        self.set_actions_sensitive()
        self.store_button.set_sensitive(not busy)
        self.title.set_subtitle(msg if msg else (tilde(self.doc.path) if self.doc.path else "no fleet open"))

    def _do_pulse(self):
        self.progress.pulse()
        if not self.busy:
            self._pulse = None
            return False
        return True

    def append_log(self, text):
        self.logbuf.insert(self.logbuf.get_end_iter(), text)
        mark = self.logbuf.create_mark(None, self.logbuf.get_end_iter(), False)
        self.logview.scroll_mark_onscreen(mark)
        self.logbuf.delete_mark(mark)
        return False

    def toast(self, text, kind=None, hint=""):
        self.toasts.add_toast(Adw.Toast.new(text))
        self.remember(text, kind, hint)

    def remember(self, text, kind=None, hint=""):
        """Into the bell's list: what the app said, with its time; kept after the app closes."""
        if not hasattr(self, "messages"):
            return
        fleet = os.path.basename(os.path.dirname(self.doc.path)) if getattr(self, "doc", None) and self.doc.path else ""
        self.messages.insert(0, {"at": time.time(), "text": text, "kind": kind or message_kind(text), "hint": hint, "fleet": fleet})
        del self.messages[300:]
        save_messages(self.messages)
        self.unread += 1
        self.update_bell()

    def update_bell(self):
        if not hasattr(self, "bell_badge"):
            return
        self.bell_badge.set_visible(self.unread > 0)
        self.bell_badge.set_label(str(self.unread) if self.unread < 100 else "99+")
        bad = any(m["kind"] == "bad" for m in self.messages[:self.unread])
        (self.bell_badge.add_css_class if bad else self.bell_badge.remove_css_class)("bad")

    def fill_bell(self, *_):
        """The list, newest first, when the bell opens: what was said, when, and what to do."""
        self.unread = 0
        self.update_bell()
        box = self.bell_list
        while box.get_first_child():
            box.remove(box.get_first_child())
        icons = {"bad": "dialog-error-symbolic", "warn": "dialog-warning-symbolic", "ok": "object-select-symbolic",
                 "info": "dialog-information-symbolic"}
        for m in self.messages[:120]:
            row = Gtk.Box(spacing=10, css_classes=["ks-msg"])
            row.append(Gtk.Image(icon_name=icons.get(m["kind"], icons["info"]), valign=Gtk.Align.START, margin_top=2,
                                 css_classes=[m["kind"]]))
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
            col.append(Gtk.Label(label=m["text"], xalign=0, wrap=True, wrap_mode=2, max_width_chars=46, selectable=True))
            if m.get("hint"):
                col.append(Gtk.Label(label=m["hint"], xalign=0, wrap=True, max_width_chars=46, css_classes=["caption"]))
            col.append(Gtk.Label(label=" · ".join(x for x in (ago_words(m["at"]), m.get("fleet") or "") if x), xalign=0,
                                 css_classes=["caption", "dim-label"]))
            row.append(col)
            box.append(row)
        self.bell_empty.set_visible(not self.messages)
        self.bell_clear.set_sensitive(bool(self.messages))

    def clear_bell(self, *_):
        self.messages = []
        save_messages(self.messages)
        self.fill_bell()

    def alert(self, heading, body):
        dlg = Adw.AlertDialog(heading=heading, body=body)
        dlg.add_response("close", "Close")
        dlg.present(self)


class Application(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.path = None
        for name, cb in (("about", self.show_about), ("doctor", self.show_doctor)):
            act = Gio.SimpleAction(name=name)
            act.connect("activate", lambda _a, _p, cb=cb: cb())
            self.add_action(act)

    def show_doctor(self):
        win = self.get_active_window()
        if win:
            DoctorDialog(win).present(win)

    def show_about(self):
        win = self.get_active_window()
        cli = getattr(win, "cli", None) or find_cli()
        version = "?"
        if cli:
            rc, out, _err = run_cli(cli, ["version"])
            if rc == 0 and out.split():
                version = out.split()[-1]
        kw = dict(application_name="Kiwi Server", application_icon=APP_ID, developer_name="derlocke-ng",
                  version=version, website="https://github.com/derlocke-ng/kiwi-server",
                  issue_url="https://github.com/derlocke-ng/kiwi-server/issues",
                  license_type=Gtk.License.GPL_3_0,
                  comments="Create and manage a kiwi-network: unattended install ISOs and first-boot scripts "
                           "for kiwi-master and kiwi-node machines, applied and enrolled over SSH. "
                           "Part of the Kiwi Network.")
        dlg = Adw.AboutDialog(**kw) if hasattr(Adw, "AboutDialog") else Adw.AboutWindow(transient_for=win, **kw)
        dlg.add_credit_section("Icon", ["kiwi-icons https://github.com/derlocke-ng/kiwi-icons"])
        dlg.add_link("Kiwi Network", "https://github.com/derlocke-ng/kiwi-network")
        if hasattr(Adw, "AboutDialog"):
            dlg.present(win)
        else:
            dlg.present()

    def do_startup(self):
        Adw.Application.do_startup(self)
        # run from a checkout, before install.sh put the icon into hicolor: the
        # data/icons directory next to this script holds it under the app id
        icons = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "data", "icons")
        if os.path.isfile(os.path.join(icons, APP_ID + ".svg")):
            Gtk.IconTheme.get_for_display(Gdk.Display.get_default()).add_search_path(os.path.realpath(icons))
        apply_scheme(gui_conf().get("scheme", "system"))
        self.set_accels_for_action("win.preferences", ["<Control>comma"])
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_open(self, files, _n, _hint):
        self.path = files[0].get_path()
        self.do_activate()

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            cli = find_cli()
            if not cli:
                dlg = Adw.AlertDialog(heading="kiwi-server not found",
                                      body="The CLI must be installed next to this GUI:\n  kiwi install kiwi-server")
                dlg.add_response("close", "Close")
                tmp = Adw.ApplicationWindow(application=self, title="Kiwi Server", icon_name=APP_ID,
                                            default_width=420, default_height=200)
                tmp.present()
                dlg.connect("response", lambda *_: self.quit())
                dlg.present(tmp)
                return
            win = Window(self, cli)
            recent = load_recent()
            if self.path or recent:
                win.open_path(self.path or recent[0])
        win.present()


if __name__ == "__main__":
    import signal
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    sys.exit(Application().run(sys.argv))
