# nginx for {{ hostname }} — generated by kiwi-server from the modules' server blocks.
{% macro headers(s, pad) %}
{% if (s.hsts or (s.hsts is none and hsts)) and not (s.public and acme_staging) %}
{{ pad }}add_header Strict-Transport-Security "max-age=15768000; includeSubDomains; preload;" always;
{% endif %}
{{ pad }}add_header Referrer-Policy "{{ s.referrer_policy or 'no-referrer' }}" always;
{{ pad }}add_header X-Content-Type-Options "nosniff" always;
{{ pad }}add_header X-Frame-Options "SAMEORIGIN" always;
{{ pad }}add_header X-Robots-Tag "noindex, nofollow" always;
{% endmacro %}
{% macro proxy(s, hidden=false) %}
            set $backend {{ s.proxy_pass }};
            proxy_pass $backend;
            proxy_http_version 1.1;
{% if hidden %}
            # the service hears its usual name and https, so it does not send a stranger to a name only the VPN knows
            proxy_set_header Host {{ s.server_name }};
            proxy_set_header X-Real-IP 127.0.0.1;
            proxy_set_header X-Forwarded-For 127.0.0.1;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Host {{ s.server_name }};
            proxy_redirect https://{{ s.server_name }}/ /;
            # and what a page links to under that name leads back here: asked for unpacked, so that it can be read
            proxy_set_header Accept-Encoding "";
            sub_filter 'https://{{ s.server_name }}/' '/';
            sub_filter_once off;
{% else %}
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $server_name;
{% endif %}
{% if s.websocket %}
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
{% endif %}
{% if s.proxy_ssl %}
            proxy_ssl_verify off;
{% endif %}
{# a site with its own allow and deny lines here: nginx then leaves out the ones of the server
   block above, so who is shut out of this name (federation, VPN groups) is said here again, first #}
{% set own = namespace(rules=false) %}
{% for d in s.extra_directives %}{% if d.startswith('allow ') or d.startswith('deny ') %}{% set own.rules = true %}{% endif %}{% endfor %}
{% if own.rules and not hidden %}
{% set fed = federation or {} %}
{% set fn = (fed.names or {}).get(s.server_name) %}
{% for c in (fn.allow or []) if fn %}
            allow {{ c }};
{% endfor %}
{% for c in ((fn.deny or []) if fn else (fed.deny or [])) %}
            deny {{ c }};
{% endfor %}
{% set acc = access or {} %}
{% for c in (acc.names or {}).get(s.server_name, acc.others or []) %}
            deny {{ c }};
{% endfor %}
{% endif %}
{% for d in s.extra_directives %}
{# at a hidden service: no allow or deny (they are about the VPN's addresses), and no proxy_redirect of the
   site's own: the one above is there already, and nginx does not start with two #}
{% if not (hidden and (d.startswith('allow ') or d.startswith('deny ') or d.startswith('proxy_redirect '))) %}
            {{ d }}
{% endif %}
{% endfor %}
{% endmacro %}
worker_processes auto;
error_log  /var/log/nginx/error.log warn;
{% if public_names %}
error_log  stderr warn;                 # the files are for fail2ban; the journal keeps its copy
{% endif %}
pid        /var/run/nginx.pid;

events {
    worker_connections 1024;
}
{% set ex = exposed or {} %}
{# with names handed on to nodes, 443 belongs to the stream block: this machine's own sites move behind it #}
{% set tls_listen = '127.0.0.1:8443 ssl proxy_protocol' if ex.names else '443 ssl' %}
{% if ex.names or ex.ports %}

# What lives on a node and is open to the internet. A connection for one of those names goes
# on to the node as it came, still encrypted (the node holds the certificate), with the
# address it came from in front (PROXY protocol). Everything else is this machine's own.
stream {
{% if rate_limit %}
    # one address may hold this many connections at once through this door: what is handed on to a
    # node is counted here too, where the node's own limits cannot keep an address out
    limit_conn_zone $binary_remote_addr zone=kiwi_door:10m;
    limit_conn_log_level warn;
{% endif %}
{% if ex.names %}
    map $ssl_preread_server_name $kiwi_to {
        default 127.0.0.1:8443;
{% for name, ip in ex.names.items() %}
        {{ name }} {{ ip }}:8443;
{% endfor %}
    }
    server {
        listen 443;
        ssl_preread on;
        proxy_pass $kiwi_to;
        proxy_protocol on;
        proxy_connect_timeout 10s;
{% if rate_limit %}
        limit_conn kiwi_door {{ rate_limit * 4 }};
{% endif %}
        proxy_timeout 1h;
    }
{% endif %}
{% for p in ex.ports or [] %}
    server {
        listen {{ p.port }}{{ ' udp' if p.proto == 'udp' }};
        proxy_pass {{ p.to }};
{% if p.proxy_protocol %}
        proxy_protocol on;
{% endif %}
        proxy_connect_timeout 10s;
{% if rate_limit %}
        limit_conn kiwi_door {{ rate_limit * 4 }};
{% endif %}
        proxy_timeout {{ '10m' if p.proto == 'udp' else '1h' }};
    }
{% endfor %}
}
{% endif %}

http {
{% if onion %}
    # a .onion name is 62 characters: more than nginx's table of names takes as it comes
    server_names_hash_bucket_size 128;
{% endif %}
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    types {
        text/javascript mjs;
    }

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;
{% if public_names %}
    access_log /dev/stdout main;
{% endif %}

{% if rate_limit and (public_names or onion) %}
    # how fast one address may ask a site that strangers reach; who keeps asking faster gets 429.
    # A page's own files (scripts, styles, pictures, fonts) are not counted: a web app loads a
    # hundred of them at once, and that is someone using it, not an attack (an empty key is not limited)
    map $uri $kiwi_limit_key {
        default $binary_remote_addr;
        ~*\.(?:css|js|mjs|map|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|otf|eot|webmanifest|wasm)$ "";
    }
    limit_req_zone $kiwi_limit_key zone=kiwi_public:10m rate={{ rate_limit }}r/s;
    limit_conn_zone $kiwi_limit_key zone=kiwi_conn:10m;
    # a hidden service's visitors all come from Tor, as one address: the limit is the site's
    limit_req_zone $server_name zone=kiwi_onion:1m rate={{ rate_limit * 3 }}r/s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_req_log_level warn;
{% endif %}
    # a client that sends its request or takes its answer too slowly is let go
    client_header_timeout 20s;
    send_timeout 60s;
    reset_timedout_connection on;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;
    gzip on;
    gzip_vary on;
    gzip_comp_level 4;
    gzip_min_length 256;
    gzip_proxied expired no-cache no-store private no_last_modified no_etag auth;
    gzip_types application/atom+xml text/javascript application/javascript application/json application/ld+json application/manifest+json application/rss+xml application/vnd.geo+json application/vnd.ms-fontobject application/wasm application/x-font-ttf application/x-web-app-manifest+json application/xhtml+xml application/xml font/opentype image/bmp image/svg+xml image/x-icon text/cache-manifest text/css text/plain text/vcard text/vnd.rim.location.xloc text/vtt text/x-component text/x-cross-domain-policy;

{% if ex.names %}
    # the stream block above hands every connection over with the address it came from
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
{% endif %}
{% if via and public_names %}
    # whom fail2ban banned here (its action kiwi-nginx-deny): the visitors come through the master, so
    # only nginx knows their address. The list is empty until someone is banned
    geo $kiwi_banned {
        default 0;
        include /etc/nginx/banned/*.map;
    }
{% endif %}
{% if ex.names or (via and public_names) or onion %}
    # sites answer on a port of their own behind the door people use (443, or Tor's 80): a redirect must not name it
    port_in_redirect off;
{% endif %}
    ssl_certificate     /etc/nginx/fullchain.pem;
    ssl_certificate_key /etc/nginx/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

{% set cors_servers = servers | selectattr('cors') | list %}
{% if cors_servers %}
    # a browser's CORS preflight only: DAV clients use OPTIONS too, and need the server's answer
    map "$request_method:$http_access_control_request_method" $kiwi_cors_preflight {
        default 0;
        "~^OPTIONS:.+" 1;
    }
{% for c in cors_servers %}
    map $http_origin ${{ c.cors.map }} {
        default "";
{% for o in c.cors.origins %}
        "{{ o }}" $http_origin;
{% endfor %}
    }
{% endfor %}

{% endif %}
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    # Backends are resolved per request through docker's DNS (proxy_pass with a
    # variable): nginx starts even when a backend does not exist yet — Nextcloud
    # AIO creates its containers after the first setup — and follows a recreated one.
    resolver {{ '127.0.0.11' if runtime == 'docker' else docker_gateway }} valid=30s ipv6=off;
    resolver_timeout 5s;

    # everything on 80 goes to https
    server {
        listen 80 default_server;
        server_name _;
{% if public_names or ex.names %}
{% if ex.names %}

        # the addresses this network's own machines come from (fail2ban here writes them down): the
        # nodes this machine hands visitors on to ask for them, so that they never ban them either
        location = /.well-known/kiwi-own {
            allow {{ mesh_subnet }};
            deny all;
            default_type text/plain;
            alias /etc/nginx/kiwi-own/list;
        }
{% endif %}
{% if public_names %}

        # Let's Encrypt asks for its challenge here
        location /.well-known/acme-challenge/ {
            root /var/www/acme;
        }
{% endif %}

        location / {
            return 301 https://$host$request_uri;
        }
{% else %}
        return 301 https://$host$request_uri;
{% endif %}
    }

{% for name, ip in (ex.names or {}).items() %}
    # {{ name }} lives on a node: Let's Encrypt's question goes there too
    server {
        listen 80;
        server_name {{ name }};
        location /.well-known/acme-challenge/ {
            proxy_pass http://{{ ip }}:80;
            proxy_set_header Host $host;
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

{% endfor %}
    # a name no module announced: close the connection instead of serving the first block
    server {
        listen {{ tls_listen }} default_server;
        http2 on;
        server_name _;
        return 444;
    }
{% if via and public_names %}
    server {
        listen 8443 ssl proxy_protocol default_server;
        http2 on;
        server_name _;
        return 444;
    }
{% endif %}
{% for s in servers %}

    # {{ s.comment }}
    server {
{% if s.public and via %}
        # from the VPN, as every site of this machine
        listen 443 ssl;
        # open to the internet through the master: it hands the connection on, with the visitor's address in front
        listen 8443 ssl proxy_protocol;
        set_real_ip_from {{ via }};
        real_ip_header proxy_protocol;
        if ($kiwi_banned) {
            return 403;
        }
{% else %}
        listen {{ tls_listen }};
{% endif %}
        http2 on;
        server_name {{ s.server_name }};
{% set fed = federation or {} %}
{% set fn = (fed.names or {}).get(s.server_name) %}
{% if fn %}
        # federation: shared with these partner addresses, not with the rest of the partners
{% for c in fn.allow or [] %}
        allow {{ c }};
{% endfor %}
{% for c in fn.deny or [] %}
        deny {{ c }};
{% endfor %}
{% elif fed.deny %}
        # federation: not shared with partner networks
{% for c in fed.deny %}
        deny {{ c }};
{% endfor %}
{% endif %}
{% set acc = access or {} %}
{% for c in (acc.names or {}).get(s.server_name, acc.others or []) %}
        deny {{ c }};      # a VPN group that reaches this machine for other services only
{% endfor %}
{% if s.public %}
        ssl_certificate     /etc/nginx/acme/{{ s.server_name }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/acme/{{ s.server_name }}/privkey.pem;
{% if rate_limit %}
        limit_req zone=kiwi_public burst={{ rate_limit * 4 }} nodelay;
        limit_conn kiwi_conn 60;
{% endif %}
{% elif public_names and not via %}
        # 443 is open to the internet on this machine; this site is not for it
        allow {{ mesh_subnet }};
        deny all;
{% endif %}
        {{ headers(s, '        ') | trim }}
        client_max_body_size {{ s.client_max_body_size or '0' }};
{% if s.proxy_read_timeout %}
        proxy_read_timeout {{ s.proxy_read_timeout }};
        client_body_timeout {{ s.proxy_read_timeout }};
{% endif %}

        location / {
            {{ proxy(s) | trim }}
        }
{% if s.cors %}

        # browsers on the origins in the map above; a DAV client's own OPTIONS goes through
        location ^~ {{ s.cors.path }} {
            if ($kiwi_cors_preflight) {
                add_header Access-Control-Allow-Origin ${{ s.cors.map }} always;
                add_header Access-Control-Allow-Methods "{{ s.cors.methods }}" always;
                add_header Access-Control-Allow-Headers "{{ s.cors.allow_headers }}" always;
                add_header Access-Control-Max-Age 600 always;
                add_header Vary Origin always;
                return 204;
            }
            add_header Access-Control-Allow-Origin ${{ s.cors.map }} always;
            add_header Access-Control-Expose-Headers "{{ s.cors.expose_headers }}" always;
            add_header Vary Origin always;
            # an add_header here drops the server's own, so they are repeated
            {{ headers(s, '            ') | trim }}
            {{ proxy(s) | trim }}
        }
{% endif %}
{% for loc in s.extra_locations %}

        location {{ loc.path }} {
            {{ loc.config }}
{% if loc.proxy %}
            {{ proxy(s) | trim }}
{% endif %}
        }
{% endfor %}
    }
{% endfor %}
{% for s in servers if (onion or {}).get(s.server_name) %}

    # {{ s.comment }}, as a hidden service: Tor hands it over on this port, which only the stack reaches
    server {
        listen 8043;
{% if onion_fullchain_present %}
        # and with TLS, for a visitor who asks https://<address>: a certificate of the fleet's CA for the address
        listen 8044 ssl;
        ssl_certificate     /etc/nginx/onion-fullchain.pem;
        ssl_certificate_key /etc/nginx/onion-privkey.pem;
{% endif %}
        server_name {{ onion[s.server_name] }};
{% if rate_limit %}
        limit_req zone=kiwi_onion burst={{ rate_limit * 12 }} nodelay;
{% endif %}
        {{ headers(s, '        ') | trim }}
        client_max_body_size {{ s.client_max_body_size or '0' }};
{% if s.proxy_read_timeout %}
        proxy_read_timeout {{ s.proxy_read_timeout }};
        client_body_timeout {{ s.proxy_read_timeout }};
{% endif %}

        location / {
            {{ proxy(s, true) | trim }}
        }
{% for loc in s.extra_locations %}

        location {{ loc.path }} {
            {{ loc.config }}
{% if loc.proxy %}
            {{ proxy(s, true) | trim }}
{% endif %}
        }
{% endfor %}
    }
{% endfor %}
{% if onion %}

    # an address that is no hidden service of this machine: nothing
    server {
        listen 8043 default_server;
{% if onion_fullchain_present %}
        listen 8044 ssl default_server;
{% endif %}
        server_name _;
        return 444;
    }
{% endif %}
}
