#!/bin/sh
# dhcp-relay for {{ hostname }} — generated by kiwi-server. The site's two machines share the moving
# address {{ follow }} (the vip module): only the one that holds it relays the LAN's DHCP to its
# Pi-hole. Both Pi-holes have the whole range; the one that takes over answers a device that asks
# for its old address with that address (Pi-hole's DHCP is authoritative), so devices keep theirs.
# Halves of the range on both at once gave a device another address at nearly every restart: each
# Pi-hole refused the other's leases (tests/drills/dhcp-pair.sh, 22 Nov 2026).
VIP="{{ follow }}"
pid=""
stop() { [ -n "$pid" ] && kill "$pid" 2>/dev/null; exit 0; }
trap stop TERM INT
while :; do
    if ip -4 -o addr show | grep -q " $VIP/"; then
        if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
            dhcp-helper -n -s "{{ dns_ip }}" &
            pid=$!
            echo "holds $VIP: relaying DHCP to {{ dns_ip }}"
        fi
    elif [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
        pid=""
        echo "gave $VIP up: not relaying"
    fi
    sleep 2
done
