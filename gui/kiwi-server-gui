class JoinDialog(Adw.Dialog):
    """Join a fleet that exists: paste the invite link from its control page. One field."""

    def __init__(self, win):
        super().__init__(title="Join a fleet", content_width=520)
        self.win = win
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        box.append(Gtk.Label(label="With a link: on the network's control page, Computers, Add a computer. Paste the "
                                   "link here.\nWithout a control page: name the synced folder the network is kept in.",
                             wrap=True, xalign=0))
        g = Adw.PreferencesGroup()
        self.go = Gtk.Button(label="Join", css_classes=["suggested-action", "pill"], halign=Gtk.Align.CENTER,
                             sensitive=False)
        self.go.connect("clicked", lambda *_: self.join())
        self.link = Adw.EntryRow(title="Invite link")
        self.link.connect("entry-activated", lambda *_: self.join())
        self.link.connect("changed", lambda *_: self.ready())
        g.add(self.link)

        def from_clipboard(clip, res):        # a link copied a moment ago is there already
            try:
                text = (clip.read_text_finish(res) or "").strip()
            except GLib.Error:
                return
            if "/#join=" in text and "\n" not in text and not self.link.get_text():
                self.link.set_text(text)
        win.get_clipboard().read_text_async(None, from_clipboard)
        self.shared = Adw.EntryRow(title="…or the synced folder")
        if os.path.isfile(os.path.join(likely_folder(), "kiwi-fleet.json")):
            self.shared.set_text(tilde(likely_folder()))          # a network is waiting there
        self.shared.connect("changed", lambda *_: self.ready())
        self.shared.connect("entry-activated", lambda *_: self.join())
        g.add(self.shared)
        folder, n, asked = os.path.expanduser("~/kiwi"), 2, ""
        while os.path.exists(folder) and os.listdir(folder):
            waiting = os.path.join(folder, "control", "folder")
            if os.path.isfile(waiting) and not os.path.isfile(os.path.join(folder, "fleet.yaml")):
                with open(waiting) as f:                 # this computer asked to join from here before:
                    asked = f.read().strip()             # the same request goes on, not a second one
                break
            folder, n = os.path.expanduser("~/kiwi-%d" % n), n + 1
        self.folder = folder
        g.add(Adw.ActionRow(title="It goes into", subtitle=tilde(folder)))
        box.append(g)
        self.note = Gtk.Label(wrap=True, xalign=0, visible=False, css_classes=["error"])
        box.append(self.note)
        if asked:
            self.shared.set_text(tilde(asked))
            self.note.set_css_classes([])
            self.note.set_label("This computer asked to join before. Once it was accepted on a computer that has "
                                "the network, press Join.")
            self.note.set_visible(True)
        box.append(self.go)
        self.set_child(box)
        # a link on the clipboard: it is what the user came with
        Gdk.Display.get_default().get_clipboard().read_text_async(None, self.pasted)

    def pasted(self, clip, res):
        try:
            text = (clip.read_text_finish(res) or "").strip()
        except GLib.Error:
            return
        if "#join=" in text and not self.link.get_text():
            self.link.set_text(text)

    def ready(self):
        self.go.set_sensitive("#join=" in self.link.get_text() or bool(self.shared.get_text().strip()))

    def join(self):
        link, shared = self.link.get_text().strip(), os.path.expanduser(self.shared.get_text().strip())
        if "#join=" not in link and not shared:
            return
        self.go.set_sensitive(False)
        self.go.set_label("Joining…")
        self.note.set_visible(False)
        path = os.path.join(self.folder, "fleet.yaml")

        def work():
            os.makedirs(self.folder, mode=0o700, exist_ok=True)
            try:
                if "#join=" in link:         # the link on stdin, not among the arguments other programs can read
                    r = subprocess.run([self.win.cli, "control", "join", path], input=link + "\n",
                                       capture_output=True, text=True, timeout=180)
                else:
                    r = subprocess.run([self.win.cli, "control", "join", path, "--dir", shared],
                                       stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=180)
                rc, out = r.returncode, (r.stderr or r.stdout)
            except (OSError, subprocess.TimeoutExpired) as e:
                rc, out = 1, str(e)
            GLib.idle_add(self.done, rc, out, path)
        threading.Thread(target=work, daemon=True).start()

    def done(self, rc, out, path):
        text = out.replace("error: ", "").replace(":: ", "").strip()
        if rc == 0 and os.path.isfile(path):
            self.close()
            self.win.open_path(path)
            self.win.toast("Joined: this computer keeps in step with the network by itself")
            return False
        if rc == 0 or "not accepted yet" in text:      # asked through the folder: the other computer answers
            self.note.set_css_classes([])
            self.note.set_label("This computer asked to join. On a computer that has the network, open Kiwi Server "
                                "and accept it; wait until the folder has synced, then press Join again here.")
        else:
            self.note.set_css_classes(["error"])
            self.note.set_label(text)
        self.note.set_visible(True)
        self.go.set_label("Join")
        self.go.set_sensitive(True)
        return False


