class SnapshotsDialog(Adw.Dialog):
    """What the backup servers keep of one machine, a module per group, each time with Restore."""

    def __init__(self, win, host):
        super().__init__(title="Snapshots of %s" % host, content_width=620, content_height=640)
        self.win, self.host = win, host
        self.page = Adw.PreferencesPage()
        self.status = Adw.StatusPage(title="Asking the backup servers…", child=Adw.Spinner())
        self.stack = Gtk.Stack()
        self.stack.add_named(self.status, "wait")
        self.stack.add_named(self.page, "list")
        tb = Adw.ToolbarView(content=self.stack)
        tb.add_top_bar(Adw.HeaderBar())
        self.set_child(tb)
        threading.Thread(target=self.load, daemon=True).start()

    def load(self):
        rc, out, err = run_cli(self.win.cli, ["backups", self.win.doc.path, self.host, "--porcelain"], timeout=180)
        GLib.idle_add(self.show_list, json.loads(out) if rc == 0 else None, err.strip())

    def show_list(self, data, err):
        if data is None:
            self.status.set_title("No answer")
            self.status.set_description(err.splitlines()[-1] if err else "")
            self.status.set_child(None)
            return False
        times = {}          # module -> minute -> (newest time, servers)
        for sv in data["servers"]:
            for sn in sv["snapshots"]:
                key = sn["time"][:16]
                at, servers = times.setdefault(sn["module"], {}).get(key, ("", set()))
                servers.add(sv["server"].removeprefix("backup.").split(".")[0])
                times[sn["module"]][key] = (max(at, sn["time"]), servers)
        missed = [sv["server"] for sv in data["servers"] if not sv["ok"]]
        if missed:
            g = Adw.PreferencesGroup()
            g.add(plain_row("Nothing found on %s" % ", ".join(missed), "Not reached, or it keeps no repository of this machine"))
            self.page.add(g)
        for module in sorted(times):
            g = Adw.PreferencesGroup(title=module)
            for key in sorted(times[module], reverse=True)[:30]:
                at, servers = times[module][key]
                row = plain_row(local_time(at), " · ".join(sorted(servers)))
                b = Gtk.Button(label="Restore", valign=Gtk.Align.CENTER, css_classes=["flat"])
                b.connect("clicked", self.ask, module, at)
                row.add_suffix(b)
                g.add(row)
            self.page.add(g)
        if not times:
            self.status.set_title("No snapshots yet")
            self.status.set_child(None)
            return False
        self.stack.set_visible_child_name("list")
        return False

    def ask(self, _b, module, at):
        dlg = Adw.AlertDialog(heading="Restore %s?" % module,
                              body="%s on %s goes back to %s. What it has now is replaced." % (module, self.host, local_time(at)))
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("go", "Restore")
        dlg.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r == "go":
                self.close()
                self.win.spawn(["backups", self.win.doc.path, self.host, module, "--restore", "--at", at],
                               "Restoring %s on %s…" % (module, self.host))
        dlg.connect("response", resp)
        dlg.present(self)


def long_row(title, subtitle="", **kw):
    """A row whose text is shown whole, over as many lines as it takes: `<` and `&` are just
    characters (use_markup is set before the text, which the constructor does not promise)."""
    row = Adw.ActionRow(use_markup=False, title_lines=0, subtitle_lines=0, **kw)
    row.set_title(title)
    row.set_subtitle(subtitle)
    return row


class UnlockDialog(Adw.Dialog):
    """Who opens whom (`unlock FLEET --porcelain`, docs/design/unlock.md): how each machine's disk
    opens at boot, with which rings, and whether it comes back by itself after a power cut."""

    def __init__(self, win):
        super().__init__(title="Disk unlock", content_width=620, content_height=640)
        self.win = win
        self.page = Adw.PreferencesPage()
        self.status = Adw.StatusPage(title="Looking at the fleet…", child=Adw.Spinner())
        self.stack = Gtk.Stack()
        self.stack.add_named(self.status, "wait")
        self.stack.add_named(self.page, "list")
        tb = Adw.ToolbarView(content=self.stack)
        tb.add_top_bar(Adw.HeaderBar())
        self.set_child(tb)
        threading.Thread(target=self.load, daemon=True).start()

    def load(self):
        rc, out, err = run_cli(self.win.cli, ["unlock", self.win.doc.path, "--porcelain"])
        try:
            rows = json.loads(out)["machines"] if rc == 0 else None
        except (ValueError, KeyError):
            rows = None
        GLib.idle_add(self.show, rows, err.strip())

    def show(self, rows, err):
        if rows is None:
            self.status.set_title("No answer")
            self.status.set_description(err.splitlines()[-1] if err else "")
            self.status.set_child(None)
            return False
        g = Adw.PreferencesGroup(title="Who opens whom", description="Change a machine's rings in its settings (Disk unlock).")
        for m in rows:
            if not m["rings"]:
                g.add(long_row(m["name"], m["way"]))
                continue
            rings = ", ".join("%s on %s%s" % (r["ring"], r["server"] or "nobody", "" if r["path"] == "the LAN" else " (%s)" % r["path"])
                              for r in m["rings"])
            if m["power_cut"] == "waits":
                cut = "After a power cut it waits for a person."
            elif m["needs"]:
                cut = "After a power cut it opens, as long as %s start%s too." % (" and ".join(m["needs"]), "s" if len(m["needs"]) == 1 else "")
            else:
                cut = "After a power cut it opens, also with one of its rings' machines off."
            row = long_row(m["name"], "%s, with %d of: %s. %s" % (m["way"], m["threshold"], rings, cut))
            img = Gtk.Image(icon_name="dialog-warning-symbolic" if m["power_cut"] == "waits" or m["needs"] else "emblem-ok-symbolic",
                            valign=Gtk.Align.CENTER)
            img.add_css_class("warning" if m["power_cut"] == "waits" or m["needs"] else "success")
            row.add_prefix(img)
            g.add(row)
        self.page.add(g)
        self.stack.set_visible_child_name("list")
        return False


class RecoveryDialog(Adw.Dialog):
