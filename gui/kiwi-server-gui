    # ---- schema from the CLI ----
    def load_schema(self):
        # both questions at once: each starts kiwi-server, and the window waits for them
        got = {}
        # the open network's module sources add modules: the roles are asked with its fleet file
        doc = getattr(self, "doc", None)
        more = {"roles": ["--fleet", doc.path] if doc is not None and getattr(doc, "path", None) else []}
        ask = [threading.Thread(target=lambda w=w: got.__setitem__(w, run_cli(self.cli, [w, "--porcelain"] + more.get(w, []))),
                                daemon=True)
               for w in ("roles", "targets")]
        for a in ask:
            a.start()
        for a in ask:
            a.join()
        rc, out, err = got["roles"]
        if rc == 0:
            data = json.loads(out)
            self.roles = data["roles"]
            self.module_schemas = {m["name"]: m for m in data.get("modules", [])}
        else:
            self.append_log("roles: %s\n" % err)
        rc, out, err = got["targets"]
        if rc == 0:
            self.targets = json.loads(out)["targets"]

