# kiwi-server stack — generated; the fleet file is the place to change it
[Unit]
Description=kiwi stack: kn-vpn-client
StartLimitIntervalSec=0

[Container]
Image=docker.io/qmcgaw/gluetun:v3
ContainerName=kn-vpn-client
Network=knet-node.network
IP=172.128.0.2
AutoUpdate=registry
AddCapability=NET_ADMIN
Sysctl=net.ipv4.tcp_mtu_probing=1
Sysctl=net.ipv4.tcp_base_mss=1024
AddDevice=/dev/net/tun:/dev/net/tun
Environment=VPN_SERVICE_PROVIDER=custom
Environment=VPN_TYPE=wireguard
Environment=TZ=Europe/Berlin
Environment=WIREGUARD_MTU=1412
Environment=WIREGUARD_PERSISTENT_KEEPALIVE_INTERVAL=25s
Environment=DOT_PROVIDERS=quad9
Environment=BLOCK_MALICIOUS=off
AddHost=min.home:172.128.0.5
Volume=/home/user/docker/kn-vpn-client/post-rules.txt:/iptables/post-rules.txt:z
Volume=/home/user/docker/kn-vpn-client/wg0.conf:/gluetun/wireguard/wg0.conf:z
LogDriver=journald

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900

[Install]
WantedBy=kiwi-stack.target
