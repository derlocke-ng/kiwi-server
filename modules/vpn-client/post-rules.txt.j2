# gluetun post-rules for {{ hostname }} — applied inside the VPN client after the tunnel is up.
# Generated by kiwi-server; the fleet file is the place to change it.
{% if mss_clamp %}
# MTU: no TCP segment bigger than the tunnel carries — its MTU less 40 bytes of IPv4
# and TCP headers, on every SYN both ways. Not --clamp-mss-to-pmtu: it reads only the
# interface a SYN leaves by, and the way back can be narrower. --set-mss never raises
# a smaller MSS.
iptables -t mangle -A FORWARD -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss {{ wg_mtu | int - 40 }}
{% endif %}
{% set mesh_ssh_on = mesh_ssh and node_type != 'master' %}
{% set dnat = enable_vpn_dnat or extra_dnat_rules or module_rules or mesh_ssh_on %}
# forwarding (gluetun's policy is DROP): no hairpin on eth0; replies to what went out;
# what the DNAT rules below redirect; the docker network out through the tunnel.
iptables -A FORWARD -i eth0 -o eth0 -j REJECT
iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
{% if dnat %}
iptables -A FORWARD -i tun0 -m conntrack --ctstate DNAT -j ACCEPT
{% endif %}
iptables -A FORWARD -s {{ docker_subnet }} -o tun0 -j ACCEPT
{% if has_gateway %}
# LAN clients the gateway module routes through this container
iptables -A FORWARD -i eth0 -o tun0 -j ACCEPT
{% endif %}
{% if enable_vpn_dnat %}
# mesh access: traffic for this node's mesh address on 80/443 goes to the reverse proxy
iptables -t nat -A PREROUTING -d {{ vpn_ip }} -p tcp --dport 443 -j DNAT --to-destination {{ proxy_ip }}:443
iptables -t nat -A PREROUTING -d {{ vpn_ip }} -p tcp --dport 80 -j DNAT --to-destination {{ proxy_ip }}:80
{% endif %}
{% if mesh_ssh_on %}
# mesh SSH: port 22 of the mesh address to the machine's sshd (the docker gateway is the host)
iptables -t nat -A PREROUTING -d {{ vpn_ip }} -p tcp --dport 22 -j DNAT --to-destination {{ docker_gateway }}:{{ ssh_port }}
{% endif %}
{% for r in extra_dnat_rules %}
{% set portproto = r.split(':')[0] %}{% set dest = r.split(':', 1)[1] %}
{# a range A-B is --dport A:B; a destination without a port keeps the port #}
iptables -t nat -A PREROUTING -d {{ vpn_ip }} -p {{ portproto.split('/')[1] if '/' in portproto else 'tcp' }} --dport {{ portproto.split('/')[0] | replace('-', ':') }} -j DNAT --to-destination {{ dest }}
{% endfor %}
{% for rule in module_rules %}
iptables {{ rule }}
{% endfor %}
{# a block tag at the end of a comment line swallows the newline (trim_blocks), and the
   rule after it became part of the comment: no NAT at all, found on the first master #}
{% if mesh_via %}
# NAT: everything leaving through the tunnel
{% else %}
# NAT: everything leaving through the tunnel; DNAT'd flows too, since the
# host has no route back into the mesh for the replies
iptables -t nat -A POSTROUTING -m conntrack --ctstate DNAT -j MASQUERADE
{% endif %}
iptables -t nat -A POSTROUTING -o tun0 -j MASQUERADE
# replies to what we sent out
iptables -A INPUT -i tun0 -m state --state RELATED,ESTABLISHED -j ACCEPT
