# kiwi-server stack — generated; the fleet file is the place to change it
[Unit]
Description=kiwi stack: nextcloud-aio-apache
After=nextcloud-aio-nextcloud.service
Wants=nextcloud-aio-nextcloud.service
After=nextcloud-aio-notify-push.service
Wants=nextcloud-aio-notify-push.service
After=nextcloud-aio-collabora.service
Wants=nextcloud-aio-collabora.service
After=nextcloud-aio-talk.service
Wants=nextcloud-aio-talk.service
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/nextcloud-releases/aio-apache:latest
ContainerName=nextcloud-aio-apache
Network=knet-node.network
IP=172.128.0.6
AutoUpdate=registry
RunInit=true
ReadOnly=true
User=33
DropCapability=NET_RAW
Tmpfs=/run
Tmpfs=/usr/local/apache2/logs
Tmpfs=/tmp
Tmpfs=/home/www-data
Environment=NC_DOMAIN=cloud.sh3.home
Environment=NEXTCLOUD_HOST=nextcloud-aio-nextcloud
Environment=APACHE_HOST=nextcloud-aio-apache
Environment=COLLABORA_HOST=nextcloud-aio-collabora
Environment=TALK_HOST=nextcloud-aio-talk
Environment=APACHE_PORT=11000
Environment=AIO_LOG_LEVEL=warn
Environment=ONLYOFFICE_HOST=nextcloud-aio-onlyoffice
Environment=EUROOFFICE_HOST=nextcloud-aio-eurooffice
Environment=TZ=Europe/Berlin
Environment=APACHE_MAX_SIZE=1073741824
Environment=APACHE_MAX_TIME=360000
Environment=NOTIFY_PUSH_HOST=nextcloud-aio-notify-push
Environment=WHITEBOARD_HOST=nextcloud-aio-whiteboard
Environment=HARP_HOST=nextcloud-aio-harp
AddHost=sh3.home:172.128.0.5
AddHost=cloud.sh3.home:172.128.0.5
AddHost=vault.sh3.home:172.128.0.5
AddHost=portainer.sh3.home:172.128.0.5
Volume=nextcloud_aio_nextcloud:/var/www/html:ro
Volume=nextcloud_aio_apache:/mnt/data:rw
HealthCmd=/healthcheck.sh
HealthInterval=30s
HealthTimeout=30s
HealthStartPeriod=0s
HealthRetries=3
LogDriver=journald

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900

[Install]
WantedBy=kiwi-stack.target
