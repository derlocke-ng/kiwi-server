def to_text(ftype, value):
    if value is None:
        return ""
    if ftype in ("list",):
        return " ".join(str(v) for v in value) if isinstance(value, list) else str(value)
    if ftype == "lines":
        return "\n".join(str(v) for v in value) if isinstance(value, list) else str(value)
    if ftype == "map":
        return "\n".join("%s=%s" % (k, v) for k, v in value.items()) if isinstance(value, dict) else str(value)
    if ftype == "object":
        return yaml.safe_dump(value, sort_keys=False, default_flow_style=False).rstrip("\n") if value else ""
    return str(value)


def from_text(ftype, text):
    text = text.strip() if ftype != "text" else text.rstrip()
    if text == "":
        return None
    if ftype == "list":
        return text.split()
    if ftype == "lines":
        return [ln.strip() for ln in text.splitlines() if ln.strip()]
    if ftype == "map":
        out = {}
        for ln in text.splitlines():
            if "=" in ln:
                k, v = ln.split("=", 1)
                out[k.strip()] = v.strip()
        return out or None
    if ftype == "int":
        try:
            return int(text)
        except ValueError:
            return None
    if ftype == "object":
        try:
            v = yaml.safe_load(text)
        except yaml.YAMLError:
            return None   # kept as typed until it parses; validate reports it
        return v if isinstance(v, (dict, list)) and v else None
    return text


class Form:
    """Builds rows for one scope and writes changes back into the doc."""

    def __init__(self, win, doc, scope, roles, targets):
        self.win, self.doc, self.scope, self.roles, self.targets = win, doc, scope, roles, targets
        self.loading = False
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, hexpand=True)
        self.side = Gtk.ListBox(css_classes=["navigation-sidebar"])
        self.side.connect("row-selected", self.on_section)
        side = Gtk.ScrolledWindow(child=self.side, hscrollbar_policy=Gtk.PolicyType.NEVER, width_request=180)
        self.page = Gtk.Box()               # what the window shows: the sections beside their pages
        self.page.append(side)
        self.page.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        self.page.append(self.stack)
        self.role_parts = []
        self.build()

    # ---- sections ----
    def section(self, name, label, groups, at=None):
        """A page of its own with a row in the sidebar; `at` inserts the row there."""
        page = Adw.PreferencesPage()
        for g in groups:
            page.add(g)
        self.stack.add_named(page, name)
        row = Gtk.ListBoxRow(child=Gtk.Label(label=label, xalign=0, ellipsize=3))
        row.ks_name = name
        self.side.insert(row, -1 if at is None else at)
        return row, page

    def heading(self, text, at=None):
        lbl = Gtk.Label(label=text, xalign=0, margin_top=12, css_classes=["dim-label", "caption-heading"])
        row = Gtk.ListBoxRow(child=lbl, selectable=False, activatable=False)
        self.side.insert(row, -1 if at is None else at)
        return row

    def on_section(self, _box, row):
        if row is not None and getattr(row, "ks_name", None):
            self.stack.set_visible_child_name(row.ks_name)
            self.win.settings_section = row.ks_name      # the same section on the next host

    def select(self, name):
        rows, row = [], self.side.get_first_child()
        while row is not None:
            if getattr(row, "ks_name", None):
                rows.append(row)
            row = row.get_next_sibling()
        pick = next((r for r in rows if r.ks_name == name), rows[0] if rows else None)
        if pick is not None:
            self.side.select_row(pick)

    def effective_target(self):
        return self.doc.get(self.scope, ("target",)) or self.doc.get("defaults", ("target",)) or "coreos"

    # ---- helpers ----
    def inherited(self, field):
        """What the value is when this scope does not set it."""
        if self.scope != "defaults":
            v = self.doc.get("defaults", field["path"])
            if v is not None:
                return v
        return field.get("default")

    def current(self, field):
        return self.doc.get(self.scope, field["path"])

    def write(self, field, value):
        if self.loading:
            return
        self.doc.set(self.scope, field["path"], value)
        self.win.mark_dirty()
        if field["path"] == ("target",):
            GLib.idle_add(self.rebuild)
        elif field["path"] == ("role",) or (len(field["path"]) == 2 and field["path"][1] in ("modules", "preset")):
            self.rebuild_role_group()

    def role_name(self):
        r = self.doc.get(self.scope, ("role",))
        if r is None and self.scope != "defaults":
            r = self.doc.get("defaults", ("role",))
        return r or "bare"

    def visible(self, field):
        sc = field.get("scope", "all")
        return sc == "all" or (sc == "defaults") == (self.scope == "defaults")

    # ---- rows ----
    def row_for(self, field):
        t = field["type"]
        if field["path"][-2:] == ("vpn-server", "groups"):
            row = self.groups_row(field)
        elif t in ("text", "lines", "map", "object"):
            row = self.text_row(field)
        elif t == "bool":
            row = self.bool_row(field)
        elif t == "enum":
            row = self.enum_row(field)
        else:
            row = self.entry_row(field)
        if field.get("help"):
            btn = help_button(field["help"], DOCS + field.get("doc", "README.md#the-fleet-file"))
            if isinstance(row, Adw.ExpanderRow):
                row.add_suffix(btn)
            elif hasattr(row, "ks_switch"):         # the (?) before the switch, not after it
                row.remove(row.ks_switch)
                row.add_suffix(btn)
                row.add_suffix(row.ks_switch)
            else:
                row.add_suffix(btn)
        return row

    def entry_row(self, field):
        cls = Adw.PasswordEntryRow if field["type"] == "secret" else Adw.EntryRow
        row = cls(title=field["label"])
        inh = to_text(field["type"], self.inherited(field))
        cur = self.current(field)
        if cur is not None:
            row.set_text(to_text(field["type"], cur))
        sub = []
        if field.get("help"):
            sub.append(field["help"])
        if self.scope != "defaults" and inh:
            sub.append("inherited: %s" % ("••••" if field["type"] == "secret" else inh))
        elif field.get("placeholder"):
            sub.append("e.g. %s" % field["placeholder"])
        if sub:
            row.set_tooltip_text(" — ".join(sub))
            # EntryRow has no subtitle; a dim hint label as suffix keeps it visible
            shown = sub[-1] if (self.scope != "defaults" and inh) or field.get("placeholder") else ""
            if shown:
                hint = Gtk.Label(label=shown, ellipsize=3, max_width_chars=28, valign=Gtk.Align.CENTER)
                hint.add_css_class("dim-label")
                hint.add_css_class("caption")
                row.add_suffix(hint)
        if field["type"] == "file":
            btn = Gtk.Button(icon_name="document-open-symbolic", valign=Gtk.Align.CENTER,
                             tooltip_text="Choose a file")
            btn.add_css_class("flat")
            btn.connect("clicked", lambda *_: self.pick_file(row))
            row.add_suffix(btn)
        if field.get("apply"):
            # writing this field rebuilds the form (the module list): commit on Enter
            # or the apply button, not on every keystroke
            row.set_show_apply_button(True)
            row.connect("apply", lambda r: self.write(field, from_text(field["type"], r.get_text())))
        else:
            row.connect("changed", lambda r: self.write(field, from_text(field["type"], r.get_text())))
        return row

    def pick_file(self, row):
        dlg = Gtk.FileDialog(title="Choose a file")
        if self.doc.path:
            dlg.set_initial_folder(Gio.File.new_for_path(self.doc.dir))

        def done(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            p = f.get_path()
            rel = os.path.relpath(p, self.doc.dir)
            row.set_text(rel if not rel.startswith("..") else p)
        dlg.open(self.win, None, done)

    # ---- the VPN's client groups: a list to edit, not YAML ----
    def groups_row(self, field):
        exp = Adw.ExpanderRow(title=field["label"])
        cur = self.current(field)
        groups = dict(cur if isinstance(cur, dict) else (self.inherited(field) or {}))

        def save():
            self.write(field, {n: {k: v for k, v in g.items() if v is not None} for n, g in groups.items()})
            redraw()
        rows = []

        def redraw():
            for r in rows:
                exp.remove(r)
            rows.clear()
            inherited = self.current(field) is None and self.scope != "defaults"
            exp.set_subtitle("%d groups%s" % (len(groups), ", inherited" if inherited else ""))
            for name in sorted(groups):
                g = groups[name] or {}
                reach = g.get("reach", ["all"])
                bits = [g.get("subnet", "?"), "reaches " + (" ".join(reach) or "only the server")]
                bits += [w for k, w in (("peers", "no peers"), ("internet", "no internet")) if g.get(k) is False]
                if g.get("admin"):
                    bits.append("admin")
                row = plain_row(name, " · ".join(bits))
                edit = Gtk.Button(icon_name="document-edit-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"],
                                  tooltip_text="Edit")
                edit.connect("clicked", lambda _b, n=name: self.group_dialog(groups, n, save))
                rm = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"],
                                tooltip_text="Remove")
