    def action_button(self, label, args, msg, ask=None):
        """A button that runs the CLI with its output in the log, after `ask` (heading, body, verb)."""
        b = Gtk.Button(label=label, valign=Gtk.Align.CENTER, css_classes=["flat"])

        def go(*_):
            if not ask:
                return self.spawn(args, msg)
            dlg = Adw.AlertDialog(heading=ask[0], body=ask[1])
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("go", ask[2])
            dlg.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_close_response("cancel")
            dlg.connect("response", lambda _d, r: r == "go" and self.spawn(args, msg))
            dlg.present(self)
        b.connect("clicked", go)
