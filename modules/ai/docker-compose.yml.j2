{% if engine == 'llama' %}
# ai: llama.cpp's server alone, its API (OpenAI's) and its chat page on port 8000 of the stack network
services:
  {{ container_prefix }}-ai:
    image: {{ ai_image }}
    container_name: {{ container_prefix }}-ai
    # Its models are named in models.ini: the first is loaded at the start, another with the request
    # that names it, one in memory at a time. Its tools, its agent mode, its MCP proxy and its
    # tunnel (--connect) stay off: nothing here asks for them, and nothing ever should.
    command:
      - --host
      - 0.0.0.0
      - --port
      - "8000"
      - --models-preset
      - /etc/llama/models.ini
      - --models-max
      - "1"
{% if idle_minutes %}
      - --sleep-idle-seconds
      - "{{ idle_minutes * 60 }}"
{% endif %}
    environment:
      - TZ={{ timezone }}
      # the folder Studio keeps its models in too (Hugging Face's layout): what one downloaded, the other finds
      - LLAMA_CACHE=/models/hub
      - LLAMA_API_KEY={{ api_key }}
{% if gpu != 'none' %}
    devices:
{% if gpu == 'nvidia' %}
      - nvidia.com/gpu=all
{% else %}
      - /dev/dri
{% endif %}
{% endif %}
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ models_path }}:/models:z
      - {{ docker_dir }}/{{ container_prefix }}-ai/models.ini:/etc/llama/models.ini:ro,z
{% else %}
# ai: Unsloth Studio, its page and its OpenAI-compatible API on port 8000 of the stack network
services:
  {{ container_prefix }}-ai:
    image: {{ ai_image }}
    container_name: {{ container_prefix }}-ai
    # Studio alone, not the image's launcher: that one starts JupyterLab too (code as root in
    # the container) and cannot switch Studio's tools off. No Cloudflare tunnel, ever, not even
    # when its page's "Remote access" asks. The initial password only while none is stored:
    # Studio refuses to start when handed one later.
    command:
      - sh
      - -c
      - "if unsloth-studio-run --stored; then unset UNSLOTH_STUDIO_PASSWORD; fi; exec /opt/unsloth-studio/bin/unsloth studio -H 0.0.0.0 -p 8000 --no-cloudflare{{ '' if tools else ' --disable-tools' }}"
    environment:
      - TZ={{ timezone }}
      - UNSLOTH_STUDIO_PORT=8000
      - UNSLOTH_STUDIO_PASSWORD={{ studio_password }}
    devices:
{% if gpu == 'amd' %}
      - /dev/kfd
      - /dev/dri
{% else %}
      - nvidia.com/gpu=all
{% endif %}
    ipc: host
    ulimits:
      memlock: -1
      stack: 67108864
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ models_path }}:/workspace/.cache/huggingface:z
      - unsloth_studio:/opt/unsloth-studio
volumes:
  unsloth_studio:
    name: unsloth_studio
{% endif %}
