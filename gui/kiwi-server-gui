def to_text(ftype, value):
    if value is None:
        return ""
    if ftype in ("list",):
        return " ".join(str(v) for v in value) if isinstance(value, list) else str(value)
    if ftype == "lines":
        return "\n".join(str(v) for v in value) if isinstance(value, list) else str(value)
    if ftype == "map":
        return "\n".join("%s=%s" % (k, v) for k, v in value.items()) if isinstance(value, dict) else str(value)
    if ftype == "object":
        return yaml.safe_dump(value, sort_keys=False, default_flow_style=False).rstrip("\n") if value else ""
    return str(value)


def from_text(ftype, text):
    text = text.strip() if ftype != "text" else text.rstrip()
    if text == "":
        return None
    if ftype == "list":
        return text.split()
    if ftype == "lines":
        return [ln.strip() for ln in text.splitlines() if ln.strip()]
    if ftype == "map":
        out = {}
        for ln in text.splitlines():
            if "=" in ln:
                k, v = ln.split("=", 1)
                out[k.strip()] = v.strip()
        return out or None
    if ftype == "int":
        try:
            return int(text)
        except ValueError:
            return None
    if ftype == "object":
        try:
            v = yaml.safe_load(text)
        except yaml.YAMLError:
            return None   # kept as typed until it parses; validate reports it
        return v if isinstance(v, (dict, list)) and v else None
    return text


class Form:
    """Builds rows for one scope and writes changes back into the doc."""

    def __init__(self, win, doc, scope, roles, targets):
        self.win, self.doc, self.scope, self.roles, self.targets = win, doc, scope, roles, targets
        self.loading = False
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, hexpand=True)
        self.side = Gtk.ListBox(css_classes=["navigation-sidebar"])
        self.side.connect("row-selected", self.on_section)
        side = Gtk.ScrolledWindow(child=self.side, hscrollbar_policy=Gtk.PolicyType.NEVER, width_request=180)
        self.page = Gtk.Box()               # what the window shows: the sections beside their pages
        self.page.append(side)
        self.page.append(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL))
        self.page.append(self.stack)
        self.role_parts = []
        self.build()

    # ---- sections ----
    def section(self, name, label, groups, at=None):
        """A page of its own with a row in the sidebar; `at` inserts the row there."""
        page = Adw.PreferencesPage()
        for g in groups:
            page.add(g)
        self.stack.add_named(page, name)
        row = Gtk.ListBoxRow(child=Gtk.Label(label=label, xalign=0, ellipsize=3))
        row.ks_name = name
        self.side.insert(row, -1 if at is None else at)
        return row, page

    def heading(self, text, at=None):
        lbl = Gtk.Label(label=text, xalign=0, margin_top=12, css_classes=["dim-label", "caption-heading"])
        row = Gtk.ListBoxRow(child=lbl, selectable=False, activatable=False)
        self.side.insert(row, -1 if at is None else at)
        return row

    def on_section(self, _box, row):
        if row is not None and getattr(row, "ks_name", None):
            self.stack.set_visible_child_name(row.ks_name)
            self.win.settings_section = row.ks_name      # the same section on the next host

    def select(self, name):
        rows, row = [], self.side.get_first_child()
        while row is not None:
            if getattr(row, "ks_name", None):
                rows.append(row)
            row = row.get_next_sibling()
        pick = next((r for r in rows if r.ks_name == name), rows[0] if rows else None)
        if pick is not None:
            self.side.select_row(pick)

    def effective_target(self):
        return self.doc.get(self.scope, ("target",)) or self.doc.get("defaults", ("target",)) or "coreos"

    # ---- helpers ----
    def inherited(self, field):
        """What the value is when this scope does not set it."""
        if self.scope != "defaults":
            v = self.doc.get("defaults", field["path"])
            if v is not None:
                return v
        return field.get("default")

    def current(self, field):
        return self.doc.get(self.scope, field["path"])

    def forget_kept(self, field):
        """A kept password out of the secret store again (`secrets forget`)."""
        path = tuple(field["path"])
        host, setting = ("defaults", ".".join(path)) if self.scope in (None, "defaults") else (self.scope, ".".join(path[1:]))
        dlg = Adw.AlertDialog(heading="Forget %s?" % field["label"].strip("…"),
                              body="With its next apply the machine gets a generated password instead. A password that "
                                   "a database or an account keeps then no longer fits it: change it there too.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("forget", "Forget")
        dlg.set_response_appearance("forget", Adw.ResponseAppearance.DESTRUCTIVE)
        doc_path = self.doc.path

        def answer(_d, r):
            if r != "forget":
                return
            rc, out, err = run_cli(self.win.cli, ["secrets", "forget", doc_path, host, setting])
            if rc != 0:
                self.win.alert("Not forgotten", ((err or out).strip().replace("error: ", "").splitlines() or ["?"])[-1])
                return
            self.win.toast("%s %s: out of the secret store" % (host, setting))
            if self.win.current_scope is not None:
                self.win.show_scope(self.win.current_scope)
        dlg.connect("response", answer)
        dlg.present(self.win)

    def kept(self, field):
        """Is this module password kept in the secret store (`secrets keep`, its pins)?"""
        path = tuple(field["path"])
        if len(path) != 3 or not self.doc.path:
            return False
        if self.scope in (None, "defaults"):
            if path[0] != "notify":         # the messages' mail password, ntfy's token
                return False
            key = "notify/%s/%s" % (path[1], path[2])
        else:
            domain = self.doc.get(self.scope, ("domain",)) or self.doc.get("defaults", ("domain",))
            hostname = self.doc.get(self.scope, ("hostname",)) or (self.scope + ("." + domain if domain else ""))
            key = "%s/%s/%s" % (hostname, path[1], path[2])
        try:
            with open(os.path.join(os.path.dirname(self.doc.path), "secrets", "pins.json"), encoding="utf-8") as fh:
                return bool(json.load(fh).get(key))
        except (OSError, ValueError, AttributeError):
            return False

    def write(self, field, value):
        if self.loading:
            return
        if field["path"] == ("admin", "password") and value:
            # the console password: only its hash goes into the fleet file (no secret in the clear on a disk)
            import secrets as pysecrets
            r = subprocess.run(["openssl", "passwd", "-6", "-salt", pysecrets.token_hex(8), "-stdin"], input=str(value) + "\n",
                               capture_output=True, text=True)
            if r.returncode != 0 or not r.stdout.startswith("$6$"):
                self.win.toast("Not saved: openssl hashes the password, and it did not work here")
                return
            self.doc.set(self.scope, ("admin", "password_hash"), r.stdout.strip())
            self.doc.set(self.scope, ("admin", "password"), None)
            self.win.mark_dirty()
            return
        self.doc.set(self.scope, field["path"], value)
        self.win.mark_dirty()
        if field["path"] == ("target",):
            GLib.idle_add(self.rebuild)
        elif field["path"] == ("role",) or (len(field["path"]) == 2 and field["path"][1] in ("modules", "preset")):
            self.rebuild_role_group()

    def role_name(self):
        r = self.doc.get(self.scope, ("role",))
        if r is None and self.scope != "defaults":
            r = self.doc.get("defaults", ("role",))
        return r or "bare"

    def visible(self, field):
        sc = field.get("scope", "all")
        return sc == "all" or (sc == "defaults") == (self.scope == "defaults")

    # ---- rows ----
    def row_for(self, field):
        t = field["type"]
        if field["path"][-2:] == ("vpn-server", "groups"):
            row = self.groups_row(field)
        elif t in ("text", "lines", "map", "object"):
            row = self.text_row(field)
        elif t == "bool":
            row = self.bool_row(field)
        elif t == "enum":
            row = self.enum_row(field)
        else:
            row = self.entry_row(field)
        if field.get("help"):
            btn = help_button(field["help"], DOCS + field.get("doc", "README.md#the-fleet-file"))
            if isinstance(row, Adw.ExpanderRow):
                row.add_suffix(btn)
            elif hasattr(row, "ks_switch"):         # the (?) before the switch, not after it
                row.remove(row.ks_switch)
                row.add_suffix(btn)
                row.add_suffix(row.ks_switch)
            else:
                row.add_suffix(btn)
        return row

    def entry_row(self, field):
        cls = Adw.PasswordEntryRow if field["type"] == "secret" else Adw.EntryRow
        row = cls(title=field["label"])
        inh = to_text(field["type"], self.inherited(field))
        cur = self.current(field)
        if cur is not None:
            row.set_text(to_text(field["type"], cur))
        sub = []
        if field.get("help"):
            sub.append(field["help"])
        if field["type"] == "secret" and cur is None and self.kept(field):
            sub.append("kept in the secret store: type a new one to replace it")
        elif self.scope != "defaults" and inh:
            sub.append("inherited: %s" % ("••••" if field["type"] == "secret" else inh))
        elif field.get("placeholder"):
            sub.append("e.g. %s" % field["placeholder"])
        if sub:
            row.set_tooltip_text(" — ".join(sub))
            # EntryRow has no subtitle; a dim hint label as suffix keeps it visible
            shown = sub[-1] if (self.scope != "defaults" and inh) or field.get("placeholder") or sub[-1].startswith("kept in") else ""
            if shown:
                hint = Gtk.Label(label=shown, ellipsize=3, max_width_chars=28, valign=Gtk.Align.CENTER)
                hint.add_css_class("dim-label")
                hint.add_css_class("caption")
                row.add_suffix(hint)
        if field["type"] == "secret" and cur is None and self.kept(field):
            forget = Gtk.Button(label="Forget", valign=Gtk.Align.CENTER, css_classes=["flat"],
                                tooltip_text="Take it out of the secret store: the next apply gives the machine a generated one")
            forget.connect("clicked", lambda *_: self.forget_kept(field))
            row.add_suffix(forget)
        if field["type"] == "file":
            btn = Gtk.Button(icon_name="document-open-symbolic", valign=Gtk.Align.CENTER,
                             tooltip_text="Choose a file")
            btn.add_css_class("flat")
            btn.connect("clicked", lambda *_: self.pick_file(row))
            row.add_suffix(btn)
        if field.get("apply"):
            # writing this field rebuilds the form (the module list): commit on Enter
            # or the apply button, not on every keystroke
            row.set_show_apply_button(True)
            row.connect("apply", lambda r: self.write(field, from_text(field["type"], r.get_text())))
        else:
            row.connect("changed", lambda r: self.write(field, from_text(field["type"], r.get_text())))
        return row

    def pick_file(self, row):
        dlg = Gtk.FileDialog(title="Choose a file")
        if self.doc.path:
            dlg.set_initial_folder(Gio.File.new_for_path(self.doc.dir))

        def done(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            p = f.get_path()
            rel = os.path.relpath(p, self.doc.dir)
            row.set_text(rel if not rel.startswith("..") else p)
        dlg.open(self.win, None, done)

    # ---- the VPN's client groups: a list to edit, not YAML ----
    def groups_row(self, field):
        exp = Adw.ExpanderRow(title=field["label"])
        cur = self.current(field)
        groups = dict(cur if isinstance(cur, dict) else (self.inherited(field) or {}))

        def save():
            self.write(field, {n: {k: v for k, v in g.items() if v is not None} for n, g in groups.items()})
            redraw()
        rows = []

        def redraw():
            for r in rows:
                exp.remove(r)
            rows.clear()
            inherited = self.current(field) is None and self.scope != "defaults"
            exp.set_subtitle("%d groups%s" % (len(groups), ", inherited" if inherited else ""))
            for name in sorted(groups):
                g = groups[name] or {}
                reach = g.get("reach", ["all"])
                bits = [g.get("subnet", "?"), "reaches " + (" ".join(reach) or "only the server")]
                bits += [w for k, w in (("peers", "no peers"), ("internet", "no internet")) if g.get(k) is False]
                if g.get("admin"):
                    bits.append("admin")
                row = plain_row(name, " · ".join(bits))
                edit = Gtk.Button(icon_name="document-edit-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"],
                                  tooltip_text="Edit")
                edit.connect("clicked", lambda _b, n=name: self.group_dialog(groups, n, save))
                rm = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"],
                                tooltip_text="Remove")
                rm.connect("clicked", lambda _b, n=name: (groups.pop(n, None), save()))
                row.add_suffix(edit)
                row.add_suffix(rm)
                exp.add_row(row)
                rows.append(row)
            add = Adw.ButtonRow(title="Add a group", start_icon_name="list-add-symbolic")
            add.connect("activated", lambda *_: self.group_dialog(groups, None, save))
            exp.add_row(add)
            rows.append(add)
        redraw()
        return exp

    def group_dialog(self, groups, name, save):
        g = dict(groups.get(name) or {})
        if name is None:            # the next free /24 after the groups there are
            used = {str(x.get("subnet", "")).split(".")[2] for x in groups.values() if str(x.get("subnet", "")).count(".") == 3}
            base = next((str(x["subnet"]) for x in groups.values() if x.get("subnet")), "10.8.0.0/24").split(".")
            third = next(n for n in range(1, 255) if str(n) not in used)
            g = {"subnet": "%s.%s.%d.0/24" % (base[0], base[1], third), "reach": ["nodes"], "peers": False}
        dlg = Adw.Dialog(title="Group" if name else "A new group", content_width=480)
        page = Adw.PreferencesPage()
        grp = Adw.PreferencesGroup()
        name_row = Adw.EntryRow(title="Name", text=name or "")
        subnet = Adw.EntryRow(title="Addresses (a /24 of the VPN)", text=str(g.get("subnet", "")))
        reach = Adw.EntryRow(title="May reach", text=" ".join(g.get("reach", ["all"])))
        reach.add_suffix(help_button("all, nodes (every node), host names of the fleet, addresses or subnets, "
                                     "separated by spaces. Empty: only the server (its DNS)."))
        switches = {}
        for key, title, default in (("peers", "Reach other VPN clients", True), ("internet", "Use the internet exit", True),
                                    ("admin", "Open the admin pages", False)):
            sw = Adw.SwitchRow(title=title, active=bool(g.get(key, default)))
            switches[key] = (sw, default)
        for r in [name_row, subnet, reach] + [sw for sw, _d in switches.values()]:
            grp.add(r)
        page.add(grp)
        b = Gtk.Button(label="Save", css_classes=["suggested-action"], halign=Gtk.Align.END, margin_top=12)
        bg = Adw.PreferencesGroup()
        bg.add(b)
        page.add(bg)

        def done(*_):
            new = name_row.get_text().strip()
            if not re.match(r"^[a-z][a-z0-9-]*$", new):
                self.win.toast("A group name: lowercase letters, digits and dashes")
                return
            if new != name and new in groups:
                self.win.toast("There is already a group called %s" % new)
                return
            out = {"subnet": subnet.get_text().strip(), "reach": reach.get_text().split()}
            for key, (sw, default) in switches.items():
                if sw.get_active() != default:
                    out[key] = sw.get_active()
            if name and name != new:
                groups.pop(name, None)
            groups[new] = out
            dlg.close()
            save()
        b.connect("clicked", done)
        tb = Adw.ToolbarView(content=page)
        tb.add_top_bar(Adw.HeaderBar())
        dlg.set_child(tb)
        dlg.present(self.win)

    def text_row(self, field):
        exp = Adw.ExpanderRow(title=field["label"])
        tv = Gtk.TextView(monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=6,
                          bottom_margin=6, left_margin=8, right_margin=8)
        tv.add_css_class("ks-textbox")
        tv.set_size_request(-1, 110)
        cur = self.current(field)
        tv.get_buffer().set_text(to_text(field["type"], cur) if cur is not None else "")
        inh = self.inherited(field)
        if self.scope != "defaults" and inh:
            exp.set_subtitle(esc("inherited: %s" % to_text(field["type"], inh).replace("\n", " · ")[:80], -1))
        if cur is not None:
            exp.set_expanded(True)

        def changed(buf):
            s = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), True)
            self.write(field, from_text(field["type"], s))
        tv.get_buffer().connect("changed", changed)
        box = Gtk.Box(margin_top=6, margin_bottom=6, margin_start=6, margin_end=6)
        box.append(tv)
        tv.set_hexpand(True)
        exp.add_row(box)
        return exp

    def bool_row(self, field):
        inh = self.inherited(field)
        cur = self.current(field)
        if self.scope == "defaults":
            row = Adw.ActionRow(title=field["label"])
            sw = Gtk.Switch(valign=Gtk.Align.CENTER, active=bool(cur if cur is not None else inh))
            sw.connect("notify::active", lambda w, _p: self.write(field, bool(w.get_active())))
            row.add_suffix(sw)
            row.set_activatable_widget(sw)
            row.ks_switch = sw
            return row
        row = Adw.ComboRow(title=field["label"])
        row.set_model(Gtk.StringList.new(["Inherit (%s)" % ("on" if inh else "off"), "On", "Off"]))
        row.set_selected(0 if cur is None else (1 if cur else 2))
        row.connect("notify::selected",
                    lambda r, _p: self.write(field, {0: None, 1: True, 2: False}[r.get_selected()]))
        return row

    def enum_row(self, field):
        opts = list(field.get("options") or [])
        if field["path"] == ("target",):
            opts = list(self.targets)
        elif field["path"] == ("role",):
            opts = [r["name"] for r in self.roles]
        inh = self.inherited(field)
        cur = self.current(field)
        labels = list(opts)
        if self.scope != "defaults":
            labels = ["Inherit (%s)" % inh] + labels
        row = Adw.ComboRow(title=field["label"])
        row.set_model(Gtk.StringList.new(labels))
        if cur in opts:
            row.set_selected(opts.index(cur) + (0 if self.scope == "defaults" else 1))
        elif self.scope == "defaults" and inh in opts:
            row.set_selected(opts.index(inh))
        else:
            row.set_selected(0)

        def changed(r, _p):
            i = r.get_selected()
            if self.scope != "defaults":
                self.write(field, None if i == 0 else opts[i - 1])
            else:
                self.write(field, opts[i])
        row.connect("notify::selected", changed)
        return row

    # ---- assembly ----
    def build(self):
        self.loading = True
        target = self.effective_target()
        system, advanced = False, []
        for title, fields in BASE_GROUPS:
            if self.scope != "defaults" and target not in SECTION_TARGETS.get(title, (target,)):
                continue
            shown = [f for f in fields if self.visible(f)]
            if not shown:
                continue
            g = Adw.PreferencesGroup(title=SECTION_LABELS.get(title, title) if title in ADVANCED_SECTIONS else title)
            later = [f for f in shown if title == "Machine" and tuple(f["path"]) in INSTALL_FIELDS]
            for f in shown:
                if f not in later:
                    g.add(self.row_for(f))
            if later:
                g.add(self.folded("For its next install", "Target, disks, keyboard and language", later))
            if title == "Messages when something is wrong" and self.scope == "defaults":
                test = Adw.ButtonRow(title="Send a test message", start_icon_name="mail-send-symbolic")
                test.connect("activated", lambda *_: self.test_message())
                g.add(test)
                control = self.win.control_host()
                if control:     # what everyone on the network sees without a login, as the page says there
                    host = (self.win.status.get(control) or {}).get("hostname") or control
                    status = Adw.ButtonRow(title="Open the status page", end_icon_name="adw-external-link-symbolic")
                    status.connect("activated", lambda *_, h=host: Gtk.UriLauncher.new(
                        "https://control.%s/status" % h).launch(self.win, None, None))
                    g.add(status)
                    play = (getattr(self.win, "fleet_info", None) or {}).get("play") or {}
                    if play.get("site"):    # where the people of its group start and stop the game servers
                        games = Adw.ButtonRow(title="Open the game page", end_icon_name="adw-external-link-symbolic")
                        games.connect("activated", lambda *_, site=play["site"]: Gtk.UriLauncher.new(
                            "https://%s/play/" % site).launch(self.win, None, None))
                        g.add(games)
            if title in ADVANCED_SECTIONS:
                advanced.append(g)
                continue
            if title != "Machine" and not system:
                self.heading("System")
                system = True
            self.section("base:" + title, SECTION_LABELS.get(title, title), [g])
        if advanced:
            if not system:
                self.heading("System")
            self.section("base:Advanced", "Advanced", advanced)
        self.rebuild_role_group()
        self.loading = False
        self.select(getattr(self.win, "settings_section", None))

    def test_message(self):
        """One message on every channel that is set, as the control page's button does (saved first:
        the command reads the fleet file)."""
        win = self.win
        if win.doc.dirty and not win.save():
            return
        win.toast("Sending a test message…")

        def work():
            rc, out, err = run_cli(win.cli, ["notify", win.doc.path, "--test"], timeout=120)
            said = ((err or out).strip().splitlines() or [""])[-1].replace("error: ", "")
            GLib.idle_add(lambda: win.toast("Test message sent: look on your phone or in your mail" if rc == 0
                                            else "Not sent: %s" % (said or "no channel is set")) and False)
        threading.Thread(target=work, daemon=True).start()

    def folded(self, title, subtitle, fields, settings=False):
        """Rows that are rarely changed, folded away under one row that opens them."""
        exp = Adw.ExpanderRow(title=title, subtitle=subtitle)
        for f in fields:
            exp.add_row(f if settings else self.row_for(f))
        return exp

    def rebuild(self):
        """Everything again, e.g. after the target changed which sections there are."""
        while (row := self.side.get_first_child()) is not None:
            self.side.remove(row)
        while (page := self.stack.get_first_child()) is not None:
            self.stack.remove(page)
        self.role_parts = []
        self.build()
        return False

    def effective_modules(self, role):
        """The preset's modules, or the fleet's override, with dependencies."""
        v = self.doc.get(self.scope, (role["name"], "modules"))
        if v is None and self.scope != "defaults":
            v = self.doc.get("defaults", (role["name"], "modules"))
        if isinstance(v, list):
            wanted = [str(x) for x in v]
        elif isinstance(v, str) and v.strip():
            wanted = v.split()
        elif role.get("presets"):
            pr = self.doc.get(self.scope, (role["name"], "preset"))
            if pr is None and self.scope != "defaults":
                pr = self.doc.get("defaults", (role["name"], "preset"))
            presets = role["presets"]
            pr = pr if pr in presets else next(iter(presets))
            wanted = list(presets[pr].get("modules") or [])
        else:
            wanted = list(role.get("modules") or [])
        out = []

        def visit(m, seen):
            if m in out or m in seen:
                return
            seen.add(m)
            for d in (self.win.module_schemas.get(m) or {}).get("requires", []):
                visit(d, seen)
            out.append(m)
        for m in wanted:
            visit(m, set())
        return out

    def open_group(self, role, name, m, schema):
        """Open to: per web site of the module on a node, Tor (a hidden service of the machine's onion
        part) and a public name (its DNS record at the master, the node's proxy open through it). The
        VPN always; an admin page is offered neither. As the page has it."""
        sites = [x for x in schema.get("sites") or [] if not x.get("admin")]
        if self.scope == "defaults" or (role.get("node_type") or "node") != "node" or not sites:
            return None
        domain = str(self.doc.get(self.scope, ("domain",)) or self.doc.get("defaults", ("domain",)) or "home")
        g = Adw.PreferencesGroup(title="Open to", description="On the VPN always. Over Tor: a hidden service. From the "
                                 "Internet: a public name whose DNS record points at the master; Apply the master, then this machine.")
        services = self.doc.get(self.scope, (name, "onion", "services")) or {}

        def tor_changed(row, _p, key):
            if self.loading:
                return
            if row.get_active():
                self.doc.set(self.scope, (name, "onion", "services", key), {})
                if "onion" not in self.effective_modules(role):     # the machine's onion part comes along
                    v = self.doc.get(self.scope, (name, "modules"))
                    wanted = [str(x) for x in v] if isinstance(v, list) else self.preset_modules(role)
                    self.write({"path": (name, "modules")}, wanted + ["onion"])
                    return
            else:
                self.doc.set(self.scope, (name, "onion", "services", key), None)
            self.win.mark_dirty()

        def public_applied(row, site):
            text = row.get_text().strip().lower().split("://")[-1].strip("/")
            if text and not re.fullmatch(r"[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+", text):
                self.win.toast("A name like %s.example.org" % site["key"])
                return
            self.doc.set(self.scope, (name, m, site["setting"]), ("https://" + text if site.get("url") else text) if text else None)
            if text:        # the node's proxy takes it in through the master
                self.doc.set(self.scope, (name, "reverse-proxy", "public"), True)
            self.win.mark_dirty()
            self.win.toast("%s: %s" % (site["key"], ("open as %s once applied" % text) if text else "on the VPN only, once applied"))
        for site in sites:
            key = site["key"]
            label = "%s.%s" % (key, self.scope)
            if site.get("tor"):
                row = Adw.SwitchRow(title="%s over Tor" % label, use_markup=False, active=key in services,
                                    subtitle="A hidden service: opened in Tor Browser, without the VPN")
                row.connect("notify::active", tor_changed, key)
                g.add(row)
            if site.get("setting"):
                now = str(self.doc.get(self.scope, (name, m, site["setting"])) or "").split("://")[-1].strip("/")
                public = now if now and not (now + ".").endswith("." + domain + ".") else ""
                row = Adw.EntryRow(title="%s from the Internet, as" % label,
                                   use_markup=False, show_apply_button=True, text=public)
                row.connect("apply", public_applied, site)
                g.add(row)
        return g

    def preset_modules(self, role):
        """The modules the role's preset (or the role) starts from, as the fleet chooses it here."""
        if role.get("presets"):
            pr = self.doc.get(self.scope, (role["name"], "preset"))
            if pr is None and self.scope != "defaults":
                pr = self.doc.get("defaults", (role["name"], "preset"))
            presets = role["presets"]
            pr = pr if pr in presets else next(iter(presets))
            return list(presets[pr].get("modules") or [])
        return list(role.get("modules") or [])

    def parts_group(self, role, name):
        """Its parts: a switch for every module the role can run (as the page has them), with what it
        is for, what it needs, and the module source it comes from. A part another one needs comes along."""
        g = Adw.PreferencesGroup(title="Its parts", description="What runs on it. A part that another one needs comes along by itself.")
        schemas = self.win.module_schemas
        on = self.effective_modules(role)
        v = self.doc.get(self.scope, (name, "modules"))
        if v is None and self.scope != "defaults":
            v = self.doc.get("defaults", (name, "modules"))
        wanted = [str(x) for x in v] if isinstance(v, list) else (v.split() if isinstance(v, str) and v.strip() else self.preset_modules(role))
        kind = role.get("node_type") or "node"
        offered = [m for m, sch in schemas.items() if kind in (sch.get("node_types") or [kind]) or m in on]
        needed_by = {}
        for m in on:
            for d in (schemas.get(m) or {}).get("requires", []):
                needed_by.setdefault(d, []).append(m)

        def resolve(names):
            out = []

            def visit(m, seen):
                if m in out or m in seen:
                    return
                seen.add(m)
                for d in (schemas.get(m) or {}).get("requires", []):
                    visit(d, seen)
                out.append(m)
            for m in names:
                visit(m, set())
            return out

        def toggled(row, _p, m):
            if self.loading:
                return
            new = [x for x in wanted if x != m] + ([m] if row.get_active() and m not in wanted else [])
            same = set(resolve(new)) == set(resolve(self.preset_modules(role)))
            self.write({"path": (name, "modules")}, None if same else new)
        for m in sorted(offered, key=lambda x: (schemas[x].get("source") or "", (schemas[x].get("title") or x).lower())):
            sch = schemas[m]
            bits = [sch.get("description") or ""]
            if sch.get("requires"):
                bits.append("needs " + ", ".join(sch["requires"]))
            if needed_by.get(m) and m not in wanted:
                bits.append("comes along for " + ", ".join(needed_by[m]))
            if sch.get("source"):
                bits.append("from the module source " + sch["source"])
            row = Adw.SwitchRow(title=sch.get("title") or m, subtitle=" · ".join(b for b in bits if b), active=m in on, use_markup=False,
                                subtitle_lines=3, tooltip_text=m)
            row.connect("notify::active", toggled, m)
            g.add(row)
        return g

    def _field(self, path, s, default):
        doc = "modules/%s/module.yaml" % path[1] if len(path) == 3 else "roles/%s/role.yaml" % path[0]
        f = dict(path=path, type=s["type"], label=s["label"] + (" *" if s.get("required") else ""),
                 help=s.get("help", ""), options=s.get("options") or [], default=default,
                 placeholder=s.get("placeholder", ""), doc=doc)
        if s.get("targets"):
            f["help"] = (f["help"] + " (%s only)" % "/".join(s["targets"])).strip()
        return f

    def rebuild_role_group(self):
        """The role's page and one page per module, after Machine in the sidebar."""
        current = self.stack.get_visible_child_name()
        for row, page in self.role_parts:
            self.side.remove(row)
            if page is not None:
                self.stack.remove(page)
        self.role_parts = []
        name = self.role_name()
        role = next((r for r in self.roles if r["name"] == name), None)
        if not role:
            return
        was = self.loading
        self.loading = True
        at = [1]                            # right after Machine

        def add(*part):
            row = part[0] if len(part) == 1 else self.section(*part, at=at[0])[0]
            self.role_parts.append((row, self.stack.get_child_by_name(part[0]) if len(part) > 1 else None))
            at[0] += 1
        stack = bool(role.get("stack"))
        groups = []
        if stack:
            groups.append(self.parts_group(role, name))
        by_group = {}
        for st in role["settings"]:
            if st.get("group") == "Generated":         # kiwi-server fills these in: nothing to type
                continue
            by_group.setdefault(st.get("group") or "Settings", []).append(st)
        for gname, items in by_group.items():
            g = Adw.PreferencesGroup(title=gname if groups else role["title"])
            for st in items:
                g.add(self.row_for(self._field((name, st["key"]), st, st.get("default"))))
            groups.append(g)
        if groups:
            groups[0].set_header_suffix(info_button(role["description"] + (
                "" if role.get("status") == "stable" else " [%s]" % role.get("status")), DOCS + "roles/%s/role.yaml" % name))
            add("role", role["title"], groups)
        if stack:
            mdefaults = dict(role.get("module_defaults") or {})
            if role.get("presets"):
                pr = self.doc.get(self.scope, (role["name"], "preset")) or self.doc.get("defaults", (role["name"], "preset"))
                pr = pr if pr in role["presets"] else next(iter(role["presets"]))
                for m, d in (role["presets"][pr].get("module_defaults") or {}).items():
                    mdefaults[m] = {**(mdefaults.get(m) or {}), **d}
            mods = [m for m in self.effective_modules(role) if self.win.module_schemas.get(m)]
            if mods:
                add(self.heading("Modules", at=at[0]))
            for m in mods:
                schema = self.win.module_schemas[m]
                g = Adw.PreferencesGroup(title=schema["title"])
                if schema.get("description"):
                    g.set_header_suffix(info_button(schema["description"], DOCS + "modules/%s/module.yaml" % m))
                # what kiwi-server fills in is not shown; what is seldom changed is folded away under "More"
                shown = [st for st in schema["settings"] if st.get("group") != "Generated"]
                more = []
                for st in shown:
                    default = (mdefaults.get(m) or {}).get(st["key"], st.get("default"))
                    row = self.row_for(self._field((name, m, st["key"]), st, default))
                    if st.get("group") == "Advanced":
                        more.append(row)
                    else:
                        g.add(row)
                if more:
                    g.add(self.folded("More", "Images, versions and what is seldom changed", more, settings=True))
                if not shown:
                    g.add(Adw.ActionRow(title="No settings", subtitle="On or off, nothing else."))
                groups_here = [g]
                opened = self.open_group(role, name, m, schema)
                if opened is not None:
                    groups_here.append(opened)
                add("mod:" + m, schema["title"], groups_here)
        self.loading = was
        if current and self.stack.get_child_by_name(current):
            self.select(current)


