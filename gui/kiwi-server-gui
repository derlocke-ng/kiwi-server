    # ---- schema from the CLI ----
    def load_schema(self):
        rc, out, err = run_cli(self.cli, ["roles", "--porcelain"])
        if rc == 0:
            data = json.loads(out)
            self.roles = data["roles"]
            self.module_schemas = {m["name"]: m for m in data.get("modules", [])}
        else:
            self.append_log("roles: %s\n" % err)
        rc, out, err = run_cli(self.cli, ["targets", "--porcelain"])
        if rc == 0:
            self.targets = json.loads(out)["targets"]

    # ---- fleet files ----
    def open_dialog(self):
        if not self.confirm_discard(self.open_dialog):
            return
        dlg = Gtk.FileDialog(title="Open a fleet file")
        flt = Gtk.FileFilter()
        flt.set_name("YAML files")
        flt.add_pattern("*.yaml")
        flt.add_pattern("*.yml")
        fl = Gio.ListStore(item_type=Gtk.FileFilter)
        fl.append(flt)
        dlg.set_filters(fl)

        def done(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            self.open_path(f.get_path())
        dlg.open(self, None, done)

    def open_recent(self, path):
        if self.confirm_discard(lambda: self.open_path(path)):
            self.open_path(path)

    def rebuild_recent(self, paths):
        self.recent_menu.remove_all()
        for p in paths[:8]:
            item = Gio.MenuItem.new(tilde(p), None)
            item.set_action_and_target_value("win.open-recent", GLib.Variant.new_string(p))
            self.recent_menu.append_item(item)

    def open_path(self, path):
        try:
            self.doc = FleetDoc(path)
        except Exception as e:  # noqa: BLE001
            self.alert("Cannot open %s" % os.path.basename(path), str(e))
            return
        path = os.path.abspath(path)
        self.generation += 1
        self.polling = False
        self.status, self.fleet_info, self.live, self.last_seen, self.store = {}, {}, {}, {}, {}
        self.checked = None
        self.current_scope = None
        recent = [path] + [p for p in load_recent() if p != path]
        save_recent(recent)
        self.rebuild_recent(recent)
        self.title.set_subtitle(tilde(path))
        self.rebuild_sidebar(FLEET)
        self.mark_dirty()
        self.set_actions_sensitive()
        self.poll()

    def new_dialog(self):
        if not self.confirm_discard(self.new_dialog):
            return
        dlg = Gtk.FileDialog(title="Where to put the new fleet.yaml", initial_name="fleet.yaml")

        def done(d, res):
            try:
                f = d.save_finish(res)
            except GLib.Error:
                return
            path = f.get_path()
            if os.path.exists(path):
                os.unlink(path)          # the file dialog asked about replacing it already
            rc, out, err = run_cli(self.cli, ["init", "--questions"])
            if rc != 0:
                self.alert("kiwi-server init --questions failed", err or out)
                return
            SetupWizard(self, path, json.loads(out)).present(self)
        dlg.save(self, None, done)

    def ask_domain(self, then):
        dlg = Adw.AlertDialog(
            heading="The fleet's domain",
            body="Hosts are named <name>.<domain>, services <service>.<name>.<domain>: sh3.home, cloud.sh3.home.\n\n"
                 ".home can never become a public top-level domain; .internal, .corp and .mail are the other "
                 "safe choices. Not .local (that is mDNS) and not a public one like .dev or .kiwi, which anyone "
                 "can register names under.")
        entry = Gtk.Entry(text="home", placeholder_text="home")
        dlg.set_extra_child(entry)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("create", "Create")
        dlg.set_response_appearance("create", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("create")
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "create" and then(entry.get_text().strip() or "home"))
        dlg.present(self)

    def create_fleet(self, path, domain):
        if os.path.exists(path):
            os.unlink(path)
        rc, out, err = run_cli(self.cli, ["init", path, "--domain", domain])
        if rc != 0:
            self.alert("Could not create the fleet", err or out)
            return
        if err.strip():
            self.append_log(err)
        self.open_path(path)
        self.toast("Example fleet written — edit the hosts and their secrets")

    def save(self):
        if not self.doc.path:
            return False
        try:
            self.doc.save()
        except OSError as e:
            self.alert("Save failed", str(e))
            return False
        self.mark_dirty()
        self.poll()
        self.toast("Saved %s" % os.path.basename(self.doc.path))
        return True

    def mark_dirty(self):
        self.title.set_title("Kiwi Server" + (" •" if self.doc.dirty else ""))
        self.b_save.set_visible(bool(self.doc.path) and self.doc.dirty)
        self.update_rows()

    def confirm_discard(self, then):
        if not self.doc.dirty:
            return True
        dlg = Adw.AlertDialog(heading="Unsaved changes", body="Save the fleet file first?")
        dlg.add_response("discard", "Discard")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("save", "Save")
        dlg.set_response_appearance("discard", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("save")
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r == "save" and not self.save():
                return
            if r in ("save", "discard"):
                self.doc.dirty = False
                then()
        dlg.connect("response", resp)
        dlg.present(self)
        return False

    def on_close(self, *_):
        if self.busy:
            self.toast("A build is running — wait for it to finish")
            return True
        if self.doc.dirty:
            self.confirm_discard(self.destroy)
            return True
        return False

    # ---- what is known about a host ----
    def value_of(self, name, key, default):
        return self.doc.get(name, (key,)) or self.doc.get("defaults", (key,)) or default

    def group_of(self, name):
        role = self.value_of(name, "role", "bare")
        return dict(ROLE_GROUPS).get(role, role.capitalize())

    def locked(self):
        return bool(self.store.get("store")) and not self.store.get("open")

    def phase_of(self, name):
        st = self.status.get(name) or {}
        return st.get("phase") or ("invalid" if st.get("errors") else "")

    def is_new(self, name):
        """Not installed yet: never applied from this fleet folder and not answering. What
        comes next is a step, not a problem."""
        live = self.live.get(name)
        return self.phase_of(name) in NEW_PHASES and not (live and live["ok"]) and not self.last_seen.get(name)

    def state_of(self, name):
        if self.phase_of(name) == "invalid":
            return "bad"
        if self.is_new(name):
            return "new"
        live = self.live.get(name)
        return live["state"] if live else "unknown"

    def problems_of(self, name):
        st = self.status.get(name) or {}
        found = [("bad", e) for e in st.get("errors") or []] if self.phase_of(name) == "invalid" else []
        live = self.live.get(name)
        if not live or self.is_new(name):
            return found
        return found + [(p["level"], p["text"]) for p in live["problems"]]

    def next_of(self, name):
        return (self.status.get(name) or {}).get("next") or ""

    def machine_line(self, name):
        if self.locked():
            return "secret store locked"
        live = self.live.get(name)
        if self.is_new(name):
            return "not installed yet"
        if not live:
            return "checking…" if self.polling else "no answer yet"
        if not live["ok"]:
            seen = self.last_seen.get(name)
            return "unreachable" + (", seen %s ago" % duration(time.time() - seen) if seen else "")
        f = live["facts"]
        bits = ["up %s" % duration(f["uptime"])]
        if f["expected"]:
            bits.append("%d/%d running" % (f["running"], f["expected"]))
        return " · ".join(bits)

    def numbers(self):
        hosts = [h for h in self.doc.hosts() if not self.is_new(h)]
        answers = [self.live[h] for h in hosts if h in self.live]
        good = [a for a in answers if a["ok"]]
        return {"hosts": len(hosts), "answers": len(answers), "online": len(good),
                "running": sum(a["facts"]["running"] for a in good),
                "expected": sum(a["facts"]["expected"] for a in good),
                "attention": [(h, level, text) for h in hosts for level, text in self.problems_of(h)]}

    def fleet_line(self):
        n = self.numbers()
        if not n["hosts"]:
            fresh = [h for h in self.doc.hosts() if self.is_new(h)]
            return "%d to install" % len(fresh) if fresh else "no hosts yet"
        if self.locked():
            return "secret store locked"
        if not n["answers"]:
            return "checking…" if self.polling else "%d hosts" % n["hosts"]
        line = "%d of %d online" % (n["online"], n["hosts"])
        return line + (" · %d to look at" % len(n["attention"]) if n["attention"] else " · all good")

    # ---- sidebar ----
    def section_header(self, row, before):
        title = getattr(row, "group", None)
        if title and title != getattr(before, "group", None):
            row.set_header(Gtk.Label(label=title, xalign=0, css_classes=["ks-section"]))
        else:
            row.set_header(None)

    def rebuild_sidebar(self, select=None):
        want = select or self.current_scope
        while True:
            row = self.listbox.get_row_at_index(0)
            if row is None:
                break
            self.listbox.remove(row)
        order = {title: i for i, (_r, title) in enumerate(ROLE_GROUPS)}
        self.listbox.append(OverviewRow(self))
        for name in sorted(self.doc.hosts(), key=lambda h: order.get(self.group_of(h), len(order))):
            self.listbox.append(HostRow(self, name))
        self.listbox.append(DefaultsRow())
        self.select_scope(want)

    def rows(self):
        i = 0
        while True:
            row = self.listbox.get_row_at_index(i)
            if row is None:
                return
            yield row
            i += 1

    def select_scope(self, scope):
        for row in self.rows():
            if row.scope == scope:
                self.listbox.select_row(row)
                return
        self.listbox.select_row(self.listbox.get_row_at_index(0))

    def update_rows(self):
        """New facts into the rows as they stand; a host that changed role moves."""
        for row in self.rows():
            if isinstance(row, HostRow) and row.group != self.group_of(row.scope):
                self.rebuild_sidebar()
                return
            row.update()

    def on_select(self, _lb, row):
        if row is None:
            return
        if row.scope != self.current_scope:
            self.show_scope(row.scope)
        if self.split.get_collapsed():
            self.split.set_show_content(True)

    # ---- pages ----
    def show_scope(self, scope):
        self.current_scope = scope
        self.form_scope = None
        if scope is None or not self.doc.path:
            self.pages.set_visible_child_name("empty")
        elif scope == FLEET:
            self.render_fleet()
            self.pages.set_visible_child_name("fleet")
        elif scope == "defaults":
            self.defaults_bin.set_child(Form(self, self.doc, scope, self.roles, self.targets).page)
            self.pages.set_visible_child_name("defaults")
        else:
            self.pages.set_visible_child_name("host")
            self.on_host_tab()
        self.update_header()
        self.set_actions_sensitive()

    def is_host(self):
        return self.current_scope not in (None, FLEET, "defaults")

    def on_host_tab(self):
        if not self.is_host():
            return
        if self.host_stack.get_visible_child_name() == "settings":
            if self.form_scope != self.current_scope:     # built once per visit: a refresh must not eat what is being typed
                self.form_scope = self.current_scope
                self.settings_bin.set_child(Form(self, self.doc, self.current_scope, self.roles, self.targets).page)
            self.update_banner()
        else:
            self.render_host(self.current_scope)

    def update_banner(self):
        st = self.status.get(self.current_scope) or {}
        text = (st.get("errors") or st.get("warnings") or [None])[0]
        if text:
            self.banner.set_title(text)
        self.banner.set_revealed(bool(text))

    def set_compact(self, compact):
        self.compact = compact
        self.update_header()

    def update_header(self):
        scope, is_host = self.current_scope, self.is_host()
        self.b_apply.set_visible(is_host)
        self.b_more.set_visible(is_host)
        self.b_refresh.set_visible(bool(self.doc.path))
        self.switcher_bar.set_reveal(is_host and self.compact)
        self.content_hb.set_title_widget(self.switcher if is_host and not self.compact else self.content_title)
        if scope == FLEET:
            self.content_title.set_title("Overview")
            self.content_title.set_subtitle(self.checked_line())
        elif scope == "defaults":
            self.content_title.set_title("Defaults")
            self.content_title.set_subtitle("inherited by every host")
        elif is_host:
            self.content_title.set_title(scope)
            self.content_title.set_subtitle((self.status.get(scope) or {}).get("hostname") or "")
        else:
            self.content_title.set_title("")
            self.content_title.set_subtitle("")
        self.content_page.set_title(scope if is_host else "Overview")

    def checked_line(self):
        if self.polling and not self.checked:
            return "asking the machines…"
        return "checked %s" % time.strftime("%H:%M:%S", time.localtime(self.checked)) if self.checked else ""

    def render_current(self):
        self.update_header()
        if self.current_scope == FLEET:
            self.render_fleet()
        elif self.is_host():
            if self.host_stack.get_visible_child_name() == "settings":
                self.update_banner()
            else:
                self.render_host(self.current_scope)

    def attention_group(self, items, with_host):
        g = Adw.PreferencesGroup(title="Needs attention")
        for host, level, text in items:
            row = plain_row(host if with_host else text, text if with_host else "")
            row.add_prefix(dot(level))
            if with_host:
                row.set_activatable(True)
                row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                row.connect("activated", lambda _r, h=host: self.select_scope(h))
            g.add(row)
        return g

    def machine_card(self, name):
        st = self.status.get(name) or {}
        f = (self.live.get(name) or {}).get("facts") or {}
        state = self.state_of(name)
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=12, margin_bottom=12,
                       margin_start=14, margin_end=14)
        head = Gtk.Box(spacing=8)
        head.append(dot(state))
        head.append(Gtk.Label(label=name, xalign=0, hexpand=True, ellipsize=3, css_classes=["heading"]))
        head.append(pill(self.value_of(name, "role", "bare"), "dim"))
        body.append(head)
        body.append(caption(st.get("hostname") or ""))
        grid = Gtk.Grid(column_spacing=8, row_spacing=4)

        def line(row, label, fraction, text):
            grid.attach(caption(label), 0, row, 1, 1)
            grid.attach(meter(fraction, hexpand=True), 1, row, 1, 1)
            value = caption(text)
            value.set_xalign(1)
            grid.attach(value, 2, row, 1, 1)
        if f:
            m = f.get("memory") or {}
            if m.get("total"):
                used = 1 - m["available"] / m["total"]
                line(0, "Memory", used, "%d %%" % (used * 100))
            for i, d in enumerate(f.get("disks") or []):
                used = d["used"] / d["size"] if d["size"] else 0
                line(i + 1, "Disk %s" % d["mount"] if len(f["disks"]) > 1 else "Disk", used, "%d %%" % (used * 100))
            body.append(grid)
        body.append(caption(self.machine_line(name)))
        btn = Gtk.Button(child=body, css_classes=["card"], tooltip_text=WORDS[state])
        btn.connect("clicked", lambda *_: self.select_scope(name))
        return btn

    def render_fleet(self):
        n = self.numbers()
        parts = []
        if not self.store:
            store = ("–", "secrets", None)
        elif not self.store.get("store"):
            store = ("plain files", "secrets on disk", "warn")
        else:
            store = ("locked", "secrets", "warn") if self.locked() else ("open", self.store_detail() or "secrets", None)
        parts.append(flow([
            tile("%d/%d" % (n["online"], n["hosts"]) if n["answers"] else "–", "machines online",
                 "bad" if n["answers"] and n["online"] < n["hosts"] else None),
            tile("%d/%d" % (n["running"], n["expected"]) if n["answers"] else "–", "services running",
                 "bad" if n["running"] < n["expected"] else None),
            tile(str(len(n["attention"])) if n["answers"] else "–", "to look at",
                 "warn" if n["attention"] else "ok" if n["answers"] else None),
            tile(store[0], store[1], store[2]),
        ], 4))
        if n["attention"]:
            parts.append(self.attention_group(n["attention"], True))
        fresh = [h for h in self.doc.hosts() if self.is_new(h)]
        if fresh:
            g = Adw.PreferencesGroup(title="Next steps",
                                     description="Machines not installed yet, in the order to do them: the master first.")
            order = {title: i for i, (_r, title) in enumerate(ROLE_GROUPS)}
            for h in sorted(fresh, key=lambda x: order.get(self.group_of(x), len(order))):
                row = plain_row(h, self.next_of(h))
                row.add_prefix(dot("new"))
                row.set_activatable(True)
                row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
                row.connect("activated", lambda _r, x=h: self.select_scope(x))
                g.add(row)
            parts.append(g)
        machines = Adw.PreferencesGroup(title="Machines")
        order = {title: i for i, (_r, title) in enumerate(ROLE_GROUPS)}
        names = sorted(self.doc.hosts(), key=lambda h: order.get(self.group_of(h), len(order)))
        machines.add(flow([self.machine_card(h) for h in names], 3))
        parts.append(machines)
        net = Adw.PreferencesGroup(title="Network")
        info = self.fleet_info
        if info.get("domain"):
            net.add(info_row("Domain", "." + info["domain"], copy=True))
        if info.get("mesh"):
            net.add(info_row("Mesh", info["mesh"], copy=True))
        master = next((h for h, st in self.status.items() if st.get("vpn_ip") and st["vpn_ip"] == info.get("master_ip")), None)
        if master:
            net.add(info_row("Master", "%s, %s" % (master, info["master_ip"]), copy=True))
            peers = ((self.live.get(master) or {}).get("facts") or {}).get("peers")
            if peers:
                net.add(info_row("Tunnels", "%d of %d connected" % (peers["recent"], peers["total"])))
        if info.get("domain") or info.get("mesh") or master:
            parts.append(net)
        self.fleet_column.show(parts)

    def render_host(self, name):
        st = self.status.get(name) or {}
        live = self.live.get(name)
        f = (live or {}).get("facts") or {}
        state = self.state_of(name)
        problems = self.problems_of(name)
        hero = Gtk.Box(spacing=14)
        big = dot(state)
        big.add_css_class("ks-big")
        hero.append(big)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        col.append(Gtk.Label(label=name, xalign=0, css_classes=["title-1"]))
        word = "Secret store locked" if self.locked() else WORDS[state]
        col.append(caption(" · ".join(x for x in (word, st.get("hostname"), self.checked_line()) if x)))
        hero.append(col)
        parts = [hero]
        if state == "new" and self.next_of(name):
            g = Adw.PreferencesGroup(title="Next step")
            row = plain_row(self.next_of(name))
            row.set_title_selectable(True)
            g.add(row)
            parts.append(g)
        if problems:
            parts.append(self.attention_group([(name, lv, t) for lv, t in problems], False))
        if live and not live["ok"] and "resolve" in live["output"]:
            g = Adw.PreferencesGroup(title="How to reach it")
            row = plain_row("Its name does not resolve from here, and no other address of it is on record",
                            "Apply it once with an address and the app remembers: kiwi-server apply %s %s --ssh %s@<address>"
                            % (tilde(self.doc.path), name, self.admin_user(name)))
            g.add(row)
            parts.append(g)
        notes = [t for t in (live or {}).get("notes") or []
                 if not t.startswith(("backups here", "last backup"))]    # the Backups group says it
        if notes:
            g = Adw.PreferencesGroup(title="Good to know")
            for text in notes:
                g.add(plain_row(text))
            parts.append(g)
        if live and live.get("locked"):
            parts.append(self.locked_group(name))
        backups = self.backup_group(name, f)
        if backups:
            parts.append(backups)
        if f:
            parts.append(self.machine_group(f))
            parts.append(self.services_group(f))
        parts.append(self.network_group(name, st, live, f))
        web = self.web_group(st)
        if web:
            parts.append(web)
        parts.append(self.deploy_group(name, st, f))
        self.host_column.show(parts)

    def action_button(self, label, args, msg, ask=None):
        """A button that runs the CLI with its output in the log, after `ask` (heading, body, verb)."""
        b = Gtk.Button(label=label, valign=Gtk.Align.CENTER, css_classes=["flat"])

        def go(*_):
            if not ask:
                return self.spawn(args, msg)
            dlg = Adw.AlertDialog(heading=ask[0], body=ask[1])
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("go", ask[2])
            dlg.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_close_response("cancel")
            dlg.connect("response", lambda _d, r: r == "go" and self.spawn(args, msg))
            dlg.present(self)
        b.connect("clicked", go)
        return b

    def locked_group(self, name):
        g = Adw.PreferencesGroup(title="Disk")
        row = plain_row("Locked", "Waiting at boot for its key")
        row.add_suffix(self.action_button("Unlock", ["unlock", self.doc.path, name], "Unlocking %s…" % name))
        g.add(row)
        return g

    def backup_group(self, name, f):
        b, store = f.get("backup"), f.get("backup_store")
        if not b and not store:
            return None
        g = Adw.PreferencesGroup(title="Backups")
        g.set_header_suffix(help_button("Every night each module goes to the backup servers. "
                                        "Snapshots lists them; Restore brings a module back as it was then.",
                                        DOCS + "modules/backup/module.yaml"))
        if b:
            last = "%s ago" % duration(b["age"]) if b.get("last") and b.get("age") is not None else "never"
            copies = ", ".join("%s %s ago" % (c["server"].split(".")[1] if c["server"].startswith("backup.") else c["server"],
                                              duration(c["age"])) for c in b.get("copies") or [] if c.get("age") is not None)
            row = plain_row("Last backup: %s" % last, copies)
            row.add_suffix(self.action_button("Back up now", ["backups", self.doc.path, name, "--now"],
                                              "Backing up %s…" % name))
            snaps = Gtk.Button(label="Snapshots", valign=Gtk.Align.CENTER, css_classes=["flat"])
            snaps.connect("clicked", lambda *_: SnapshotsDialog(self, name).present(self))
            row.add_suffix(snaps)
            g.add(row)
            if b.get("held"):
                row = plain_row("Rebuilt: waiting", b["held"])
                row.add_suffix(self.action_button(
                    "Restore all", ["backups", self.doc.path, name, "--restore"], "Restoring %s…" % name,
                    ("Restore everything?", "Every module of %s comes back from its newest snapshot." % name, "Restore")))
                row.add_suffix(self.action_button(
                    "Start new", ["backups", self.doc.path, name, "--new"], "Backing up %s…" % name,
                    ("Start a new history?", "%s keeps what it has now and backs that up; the old snapshots stay "
                     "until pruned." % name, "Start new")))
                g.add(row)
        if store:
            repos = store.get("repos") or []
            row = plain_row("Stored here", "%s free on %s · %d machines" % (
                size_kib(store.get("free_kib") or 0), store.get("mount", ""), len(repos)))
            row.add_suffix(self.action_button("Prune now", ["prune", self.doc.path, name], "Pruning %s…" % name))
            g.add(row)
        return g

    def admin_user(self, name):
        return self.doc.get(name, ("admin", "user")) or self.doc.get("defaults", ("admin", "user")) or "core"

    def machine_group(self, f):
        g = Adw.PreferencesGroup(title="Machine")
        g.add(info_row("System", f["os"]))
        g.add(info_row("Kernel", f["kernel"]))
        g.add(info_row("Up", duration(f["uptime"])))
        if f["load"] and f["cpus"]:
            g.add(meter_row("Load", f["load"][0] / f["cpus"], "%.2f on %d CPUs" % (f["load"][0], f["cpus"])))
        m = f.get("memory") or {}
        if m.get("total"):
            used = m["total"] - m["available"]
            g.add(meter_row("Memory", used / m["total"], "%s of %s in use" % (size(used), size(m["total"]))))
        for d in f["disks"]:
            g.add(meter_row("Disk %s" % d["mount"], d["used"] / d["size"] if d["size"] else 0,
                            "%s of %s in use" % (size(d["used"]), size(d["size"]))))
        g.add(info_row("Clock", "synchronised" if f["clock_synced"] else "not synchronised"))
        return g

    def services_group(self, f):
        g = Adw.PreferencesGroup(title="Services")
        if f["expected"]:
            g.set_description("%d of %d running, on %s" % (f["running"], f["expected"], f["runtime"]))
        else:
            g.set_description("No stack on this machine")
        for s in f["services"]:
            kind = "bad" if not s["running"] else {"unhealthy": "warn", "starting": "warn"}.get(s["health"], "ok")
            word = "stopped" if not s["running"] else s["health"] or "running"
            row = plain_row(s["name"], s["status"] or s["state"], tooltip_text=s["image"] or None)
            row.add_prefix(dot(kind))
            row.add_suffix(pill(word, kind if kind != "ok" else "dim"))
            g.add(row)
        return g

    def network_group(self, name, st, live, f):
        g = Adw.PreferencesGroup(title="Network")
        if live:
            g.add(info_row("Reached at", live["target"], copy=True))
        g.add(info_row("Name", st.get("hostname") or name, copy=True))
        if st.get("vpn_ip"):
            g.add(info_row("Mesh address", st["vpn_ip"], copy=True))
        if st.get("address"):
            g.add(info_row("LAN address", "by DHCP" if st["address"] == "dhcp" else st["address"], copy=True))
        t = f.get("tunnel")
        if t:
            g.add(info_row("VPN client", "not running" if not t["running"] else "no tunnel" if not t["mtu"] else
                           "up, MTU %d, %s" % (t["mtu"], "forwarding" if t["forward"] else "NOT forwarding")))
        p = f.get("peers")
        if p:
            g.add(info_row("Tunnels here", "%d of %d connected" % (p["recent"], p["total"])))
        return g

    def web_group(self, st):
        if not st.get("sites"):
            return None
        g = Adw.PreferencesGroup(title="Web interfaces", description="Open from a device on the mesh")
        for site in st["sites"]:
            row = plain_row(site, activatable=True)
            row.add_suffix(Gtk.Image(icon_name="adw-external-link-symbolic"))
            row.connect("activated", lambda _r, s=site: Gtk.UriLauncher.new("https://" + s).launch(self, None, None))
            g.add(row)
        return g

    def deploy_group(self, name, st, f):
        g = Adw.PreferencesGroup(title="Deployment")
        if f:
            g.add(info_row("Role applied", when(f.get("applied"))))
        g.add(info_row("System and role", "%s, %s" % (self.value_of(name, "target", "ucore"), self.value_of(name, "role", "bare"))))
        if st.get("modules"):
            g.add(info_row("Modules", ", ".join(st["modules"])))
        if st.get("disk"):
            g.add(info_row("Install disk", str(st["disk"])))
        built = st.get("status") or {}
        g.add(info_row("Install media", "ISO built" if built.get("iso") else "scripts rendered" if built.get("script") else "nothing built yet"))
        up = st.get("updates") or {}
        if up:
            g.add(info_row("Automatic updates", "off" if not up.get("enabled", True) else
                           "on, reboots %s at %s" % ("/".join(up.get("days") or []) or "any day", up.get("time", "?"))))
        return g

    # ---- the secret store ----
    def store_detail(self):
        at = self.store.get("locks_at")
        return "locks itself in %s" % duration(max(at - time.time(), 0)) if at else ""

    def update_store(self):
        s = self.store
        known = bool(self.doc.path and s)
        self.store_banner.set_revealed(known and self.locked())
        self.store_icon.set_visible(known)
        self.store_button.set_visible(known and bool(s.get("store")))
        if not known:
            self.store_label.set_label("")
        elif not s.get("store"):
            self.store_icon.set_from_icon_name("dialog-warning-symbolic")
            self.store_label.set_label("Secrets are plain files")
            self.store_label.set_tooltip_text("kiwi-server secrets init %s" % self.doc.path)
        elif self.locked():
            self.store_icon.set_from_icon_name("changes-prevent-symbolic")
            self.store_label.set_label("Secrets locked")
            self.store_button.set_label("Unlock")
        else:
            self.store_icon.set_from_icon_name("changes-allow-symbolic")
            detail = self.store_detail()
            self.store_label.set_label("Secrets open")
            self.store_label.set_tooltip_text("%sOpens with: %s" % (detail.capitalize() + ". " if detail else "",
                                                                    ", ".join(s.get("opens_with") or [])))
            self.store_button.set_label("Lock")
        self.store_button.set_sensitive(not self.busy)

    def toggle_store(self):
        action = "unlock" if self.locked() else "lock"
        path, gen = self.doc.path, self.generation

        def worker():
            rc, out, err = run_cli(self.cli, ["secrets", action, path])
            GLib.idle_add(done, rc, err or out)

        def done(rc, text):
            if gen != self.generation:
                return False
            if rc != 0:
                self.alert("The store did not %s" % action,
                           "%s\n\nIn a terminal it can ask for the recovery key:\n  kiwi-server secrets unlock %s" % (text.strip(), path))
            self.poll()
            return False
        threading.Thread(target=worker, daemon=True).start()

    # ---- what the CLI says ----
    def tick(self):
        if self.is_active():
            self.poll()
        return True

    def on_focus(self):
        if self.is_active() and self.doc.path and (not self.checked or time.time() - self.checked > POLL_SECONDS):
            self.poll()

    def poll(self):
        """Ask again: the store, the fleet (quick), then the machines. Reads only."""
        if not self.doc.path or self.polling or self.busy:
            return
        self.polling = True
        self.b_refresh.set_sensitive(False)
        self.update_rows()
        path, gen = self.doc.path, self.generation

        def ask(args, timeout=120):
            rc, out, err = run_cli(self.cli, args, timeout)
            if rc != 0:
                return None, (err or out).strip()
            try:
                return json.loads(out), ""
            except ValueError:
                return None, "%s: no answer the app can read" % args[0]

        def worker():
            store, _err = ask(["secrets", "status", path, "--porcelain"])
            store = store or {}
            if store.get("store") and not store.get("open"):
                GLib.idle_add(self.answer_fleet, gen, store, None, "")
                GLib.idle_add(self.answer_machines, gen, None)
                return
            listing, err = ask(["list", path, "--porcelain"])
            GLib.idle_add(self.answer_fleet, gen, store, listing, err)
            live, _err = ask(["status", path, "--porcelain"], 90)
            GLib.idle_add(self.answer_machines, gen, live)
        threading.Thread(target=worker, daemon=True).start()

    def answer_fleet(self, gen, store, listing, err):
        if gen != self.generation:
            return False
        self.store = store
        if listing:
            self.status = {h["name"]: h for h in listing["hosts"]}
            self.fleet_info = {k: listing.get(k) or "" for k in ("domain", "mesh", "master_ip")}
        if err:
            self.append_log(err + "\n")
            self.toast(err.splitlines()[-1])
        self.update_store()
        self.set_actions_sensitive()
        self.update_rows()
        self.render_current()
        return False

    def answer_machines(self, gen, live):
        if gen != self.generation:
            return False
        self.polling = False
        self.b_refresh.set_sensitive(True)
        if self.locked():
            self.live = {}
        elif live:
            now = time.time()
            self.live = {h["host"]: h for h in live["hosts"]}
            self.last_seen.update({h: now for h, a in self.live.items() if a["ok"]})
            self.checked = now
        self.update_rows()
        self.render_current()
        return False

    # ---- hosts ----
    def add_host_dialog(self):
        if not self.doc.path:
            self.toast("Open or create a fleet first")
            return
        dlg = Adw.AlertDialog(heading="Add a host", body="Masters are named after fruit dishes, everything else after "
                              "fruits; any short name works: letters, digits, dashes. It becomes <name>.<domain>.")
        rc, out, _err = run_cli(self.cli, ["names"])
        pools = json.loads(out) if rc == 0 else {}
        taken = set(self.doc.hosts())               # with hosts added here and not saved yet
        names = {k: next((x for x in pools.get(k + "s", []) if x not in taken), "") for k in ("master", "node")}
        roles = [("node", "A node: a machine at home"), ("master", "A master: the machine everything connects to"),
                 ("bare", "Bare: only the system, a role later")]
        role = Gtk.DropDown.new_from_strings([label for _r, label in roles])
        entry = Gtk.Entry(text=names.get("node", ""), placeholder_text=names.get("node", "papaya"))
        suggested = [entry.get_text()]

        def role_changed(*_):
            key = "master" if roles[role.get_selected()][0] == "master" else "node"
            if entry.get_text() in suggested:          # not typed over: follow the role
                entry.set_text(names.get(key, ""))
                suggested.append(entry.get_text())
        role.connect("notify::selected", role_changed)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.append(role)
        box.append(entry)
        dlg.set_extra_child(box)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("add", "Add")
        dlg.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("add")
        dlg.set_close_response("cancel")

        def resp(_d, r):
            name = entry.get_text().strip()
            if r != "add" or not name:
                return
            if not re.match(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$", name, re.I):
                self.toast("A host name is a DNS label: letters, digits and dashes, 63 at most")
                return
            if name in self.doc.hosts() or name == "defaults":
                self.toast("There is already a host called %s" % name)
                return
            self.doc.add_host(name)
            kind = roles[role.get_selected()][0]
            self.doc.set(name, ("role",), kind)
            if kind == "master":            # what `kiwi-server add` writes; wg_host is the user's to fill in
                self.doc.set(name, ("target",), "debian")
                self.doc.set(name, ("master", "modules"), ["vpn-server", "dns", "tor", "reverse-proxy"])
            elif kind == "node":
                domain = self.doc.get("defaults", ("domain",)) or "home"
                self.doc.set(name, ("node", "preset"), "minimal")
                self.doc.set(name, ("node", "vpn-client", "wireguard_config"), "secrets/%s.%s.conf" % (name, domain))
            self.mark_dirty()
            self.rebuild_sidebar(name)
            self.host_stack.set_visible_child_name("settings")
        dlg.connect("response", resp)
        dlg.present(self)

    def remove_host_dialog(self):
        name = self.current_scope
        dlg = Adw.AlertDialog(heading="Remove %s?" % name,
                              body="Only from the fleet file. Generated files in the output directory stay.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("remove", "Remove")
        dlg.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r == "remove":
                self.doc.remove_host(name)
                self.mark_dirty()
                self.rebuild_sidebar(FLEET)
        dlg.connect("response", resp)
        dlg.present(self)

    # ---- actions ----
    def set_actions_sensitive(self):
        ok = bool(self.doc.path) and not self.busy and not self.locked()
        host = self.is_host()
        for name in ("render-all", "build-all"):
            self.lookup_action(name).set_enabled(ok)
        for name in ("render-host", "build-host", "status-host", "script-host", "stack-host", "folder-host"):
            self.lookup_action(name).set_enabled(ok and host)
        self.lookup_action("remove-host").set_enabled(host and not self.busy)
        self.lookup_action("refresh").set_enabled(bool(self.doc.path))
        self.b_apply.set_sensitive(ok and host)

    def ensure_saved(self):
        if not self.doc.path:
            self.toast("Open or create a fleet first")
            return False
        if self.doc.dirty and not self.save():
            return False
        return True

    def render(self, host):
        if not self.ensure_saved():
            return
        args = ["render", self.doc.path] + ([host] if host else [])
        self.spawn(args, "Rendering %s…" % (host or "every host"))

    def confirm_build(self, host):
        if not self.ensure_saved():
            return
        names = [host] if host else self.doc.hosts()
        lines = []
        for n in names:
            disk = self.doc.get(n, ("disk",)) or self.doc.get("defaults", ("disk",))
            lines.append("%s  →  %s" % (n, disk or "(no disk set — the build will refuse)"))
        dlg = Adw.AlertDialog(
            heading="Build unattended ISO%s?" % ("" if len(names) == 1 else "s"),
            body="Each ISO installs WITHOUT ASKING and wipes the disk it is told to:\n\n%s\n\n"
                 "Base images are downloaded once into the cache. The ISO carries the base "
                 "system only; Apply brings the host's role and its secrets afterwards." % "\n".join(lines))
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("build", "Build")
        dlg.set_response_appearance("build", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "build" and
                    self.spawn(["build", self.doc.path] + ([host] if host else []),
                               "Building %s…" % (host or "every host")))
        dlg.present(self)

    def confirm_apply(self, host):
        if not self.ensure_saved():
            return
        where = (self.live.get(host) or {}).get("target") or "%s@%s" % (
            self.admin_user(host), (self.status.get(host) or {}).get("hostname") or host)
        dlg = Adw.AlertDialog(
            heading="Apply %s?" % host,
            body="The role script is re-rendered, sent to %s over SSH (your key or agent must open the "
                 "connection; nothing asks for a password) and run as root with --force: the stack is rewritten "
                 "and restarted. Secrets and modules that changed take effect; the disk is not touched." % where)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("apply", "Apply")
        dlg.set_response_appearance("apply", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "apply" and
                    self.spawn(["apply", self.doc.path, host], "Applying %s…" % host))
        dlg.present(self)

    def show_status(self):
        if not self.ensure_saved():
            return
        scope = self.current_scope
        self.set_busy(True, "Asking %s…" % scope)

        def worker():
            rc, out, err = run_cli(self.cli, ["status", self.doc.path, scope])
            GLib.idle_add(done, rc, out, err)

        def done(rc, out, err):
            self.set_busy(False, "")
            if rc != 0 and not out.strip():
                self.alert("Cannot reach %s" % scope, err or out)
            else:
                TextDialog("%s — status" % scope, out + (("\n" + err) if err.strip() else "")).present(self)
            return False
        threading.Thread(target=worker, daemon=True).start()

    def show_script(self):
        if not self.ensure_saved():
            return
        scope = self.current_scope
        self.set_busy(True, "Rendering the role script…")

        def worker():
            rc, out, err = run_cli(self.cli, ["script", self.doc.path, scope, "--offline"])
            GLib.idle_add(done, rc, out, err)

        def done(rc, out, err):
            self.set_busy(False, "")
            if rc != 0:
                self.alert("Cannot render the script", err or out)
            else:
                TextDialog("%s — role script" % scope, out).present(self)
            return False
        threading.Thread(target=worker, daemon=True).start()

    def show_stack(self):
        st = self.status.get(self.current_scope) or {}
        p = os.path.join(st.get("dir") or "", "%s.stack" % self.current_scope, "docker-compose.yml")
        if not st.get("dir") or not os.path.isfile(p):
            self.toast("Render this host first — the stack is written next to its script")
            return
        with open(p, encoding="utf-8") as f:
            TextDialog("%s — docker-compose.yml" % self.current_scope, f.read()).present(self)

    def open_folder(self):
        st = self.status.get(self.current_scope) or {}
        d = st.get("dir")
        if not d or not os.path.isdir(d):
            self.toast("Nothing rendered for this host yet")
            return
        Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(d).get_uri(), None)

    def spawn(self, args, msg):
        if self.busy:
            return
        self.set_busy(True, msg)
        self.b_log.set_active(True)
        cmd = [self.cli] + list(args)

        def worker():
            GLib.idle_add(self.append_log, "\n$ %s\n" % " ".join(shlex.quote(c) for c in cmd))
            rc = 1
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                        text=True, stdin=subprocess.DEVNULL)
                for line in proc.stdout:
                    GLib.idle_add(self.append_log, line)
                rc = proc.wait()
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self.append_log, "%s\n" % e)
            GLib.idle_add(self.after_spawn, rc)
        threading.Thread(target=worker, daemon=True).start()

    def after_spawn(self, rc):
        self.set_busy(False, "")
        self.toast("Done" if rc == 0 else "Failed — see the output")
        self.poll()
        return False

    def set_busy(self, busy, msg):
        self.busy = busy
        self.progress.set_visible(busy)
        if busy and self._pulse is None:
            self._pulse = GLib.timeout_add(120, self._do_pulse)
        elif not busy and self._pulse is not None:
            GLib.source_remove(self._pulse)
            self._pulse = None
        self.set_actions_sensitive()
        self.store_button.set_sensitive(not busy)
        self.title.set_subtitle(msg if msg else (tilde(self.doc.path) if self.doc.path else "no fleet open"))

    def _do_pulse(self):
        self.progress.pulse()
        if not self.busy:
            self._pulse = None
            return False
        return True

    def append_log(self, text):
        self.logbuf.insert(self.logbuf.get_end_iter(), text)
        mark = self.logbuf.create_mark(None, self.logbuf.get_end_iter(), False)
        self.logview.scroll_mark_onscreen(mark)
        self.logbuf.delete_mark(mark)
        return False

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast.new(text))

    def alert(self, heading, body):
        dlg = Adw.AlertDialog(heading=heading, body=body)
        dlg.add_response("close", "Close")
        dlg.present(self)


class Application(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.path = None
        for name, cb in (("about", self.show_about), ("doctor", self.show_doctor)):
            act = Gio.SimpleAction(name=name)
            act.connect("activate", lambda _a, _p, cb=cb: cb())
            self.add_action(act)

    def show_doctor(self):
        win = self.get_active_window()
        if win:
            DoctorDialog(win).present(win)

    def show_about(self):
        win = self.get_active_window()
        cli = getattr(win, "cli", None) or find_cli()
        version = "?"
        if cli:
            rc, out, _err = run_cli(cli, ["version"])
            if rc == 0 and out.split():
                version = out.split()[-1]
        kw = dict(application_name="Kiwi Server", application_icon=APP_ID, developer_name="derlocke-ng",
                  version=version, website="https://github.com/derlocke-ng/kiwi-server",
                  issue_url="https://github.com/derlocke-ng/kiwi-server/issues",
                  license_type=Gtk.License.GPL_3_0,
                  comments="Create and manage a kiwi-network: unattended install ISOs and first-boot scripts "
                           "for kiwi-master and kiwi-node machines, applied and enrolled over SSH. "
                           "Part of the Kiwi Network.")
        dlg = Adw.AboutDialog(**kw) if hasattr(Adw, "AboutDialog") else Adw.AboutWindow(transient_for=win, **kw)
        dlg.add_credit_section("Icon", ["kiwi-icons https://github.com/derlocke-ng/kiwi-icons"])
        dlg.add_link("Kiwi Network", "https://github.com/derlocke-ng/kiwi-network")
        if hasattr(Adw, "AboutDialog"):
            dlg.present(win)
        else:
            dlg.present()

    def do_startup(self):
        Adw.Application.do_startup(self)
        # run from a checkout, before install.sh put the icon into hicolor: the
        # data/icons directory next to this script holds it under the app id
        icons = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "data", "icons")
        if os.path.isfile(os.path.join(icons, APP_ID + ".svg")):
            Gtk.IconTheme.get_for_display(Gdk.Display.get_default()).add_search_path(os.path.realpath(icons))
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_open(self, files, _n, _hint):
        self.path = files[0].get_path()
        self.do_activate()

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            cli = find_cli()
            if not cli:
                dlg = Adw.AlertDialog(heading="kiwi-server not found",
                                      body="The CLI must be installed next to this GUI:\n  kiwi install kiwi-server")
                dlg.add_response("close", "Close")
                tmp = Adw.ApplicationWindow(application=self, title="Kiwi Server", icon_name=APP_ID,
                                            default_width=420, default_height=200)
                tmp.present()
                dlg.connect("response", lambda *_: self.quit())
                dlg.present(tmp)
                return
            win = Window(self, cli)
            recent = load_recent()
            if self.path or recent:
                win.open_path(self.path or recent[0])
        win.present()


if __name__ == "__main__":
    import signal
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    sys.exit(Application().run(sys.argv))
