# kiwi-server stack — generated; the fleet file is the place to change it
[Unit]
Description=kiwi stack: nextcloud-aio-nextcloud
After=nextcloud-aio-database.service
Wants=nextcloud-aio-database.service
After=nextcloud-aio-redis.service
Wants=nextcloud-aio-redis.service
After=nextcloud-aio-imaginary.service
Wants=nextcloud-aio-imaginary.service
StartLimitIntervalSec=0

[Container]
Image=ghcr.io/nextcloud-releases/aio-nextcloud:latest
ContainerName=nextcloud-aio-nextcloud
Network=knet-node.network
AutoUpdate=registry
RunInit=true
DropCapability=NET_RAW
ShmSize=134217728
StopTimeout=600
Environment=NEXTCLOUD_HOST=nextcloud-aio-nextcloud
Environment=POSTGRES_HOST=nextcloud-aio-database
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_DB=nextcloud_database
Environment=POSTGRES_USER=nextcloud
Environment=REDIS_HOST=nextcloud-aio-redis
Environment=REDIS_PORT=6379
Environment=APACHE_HOST=nextcloud-aio-apache
Environment=APACHE_PORT=11000
Environment=NC_DOMAIN=cloud.sh3.home
Environment=ADMIN_USER=admin
Environment=NEXTCLOUD_DATA_DIR=/mnt/ncdata
Environment=OVERWRITEHOST=cloud.sh3.home
Environment=OVERWRITEPROTOCOL=https
Environment=EUROOFFICE_SECRET=
Environment=AIO_LOG_LEVEL=warn
Environment=NEXTCLOUD_MOUNT=
Environment=CLAMAV_ENABLED=no
Environment=CLAMAV_HOST=nextcloud-aio-clamav
Environment=ONLYOFFICE_ENABLED=no
Environment=EUROOFFICE_ENABLED=no
Environment=COLLABORA_ENABLED=yes
Environment=COLLABORA_HOST=nextcloud-aio-collabora
Environment=TALK_ENABLED=yes
Environment=ONLYOFFICE_HOST=nextcloud-aio-onlyoffice
Environment=EUROOFFICE_HOST=nextcloud-aio-eurooffice
Environment=UPDATE_NEXTCLOUD_APPS=no
Environment=TZ=Europe/Berlin
Environment=TALK_PORT=3478
Environment=IMAGINARY_ENABLED=yes
Environment=IMAGINARY_HOST=nextcloud-aio-imaginary
Environment=PHP_UPLOAD_LIMIT=50G
Environment=PHP_MEMORY_LIMIT=4096M
Environment=FULLTEXTSEARCH_ENABLED=no
Environment=FULLTEXTSEARCH_HOST=nextcloud-aio-fulltextsearch
Environment=FULLTEXTSEARCH_PROTOCOL=http
Environment=FULLTEXTSEARCH_PORT=9200
Environment=FULLTEXTSEARCH_USER=elastic
Environment=FULLTEXTSEARCH_INDEX=nextcloud-aio
Environment=PHP_MAX_TIME=360000
Environment=TRUSTED_CACERTS_DIR=/usr/local/share/ca-certificates
Environment="STARTUP_APPS=deck twofactor_totp tasks calendar contacts notes"
Environment=ADDITIONAL_APKS=imagemagick
Environment=ADDITIONAL_PHP_EXTENSIONS=imagick
Environment=INSTALL_LATEST_MAJOR=no
Environment=TALK_RECORDING_ENABLED=no
Environment=TALK_RECORDING_HOST=nextcloud-aio-talk-recording
Environment=REMOVE_DISABLED_APPS=yes
Environment=WHITEBOARD_ENABLED=no
Environment=HARP_ENABLED=no
Environment=HP_SHARED_KEY=
EnvironmentFile=/home/user/docker/kiwi/env/nextcloud-aio-nextcloud.env
AddHost=sh3.home:172.128.0.5
AddHost=cloud.sh3.home:172.128.0.5
AddHost=vault.sh3.home:172.128.0.5
AddHost=portainer.sh3.home:172.128.0.5
Volume=nextcloud_aio_nextcloud:/var/www/html:rw
Volume=/home/user/docker/knnc-data:/mnt/ncdata:rw,z
Volume=/home/user/docker/kiwi/ca:/usr/local/share/ca-certificates:ro,z
HealthCmd=/healthcheck.sh
HealthInterval=30s
HealthTimeout=30s
HealthStartPeriod=0s
HealthRetries=3
LogDriver=journald

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900

[Install]
WantedBy=kiwi-stack.target
