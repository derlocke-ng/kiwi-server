[Unit]
Description=Kiwi Network: Pi-hole's blocklist is there ({{ hostname }})
Documentation=https://github.com/derlocke-ng/kiwi-server
After=kiwi-stack.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=15min
ExecStart=/usr/bin/bash {{ docker_dir }}/kiwi/pihole-blocklist.sh

# no [Install]: {{ container_prefix }}-pihole-blocklist.timer starts it
