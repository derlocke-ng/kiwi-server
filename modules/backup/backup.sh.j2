#!/usr/bin/bash
{% set targets = (([server] if server else []) + (servers or [])) | unique | list %}
# {{ hostname }}'s data with restic, which runs in a container, to each of: {{ targets | join(', ') }}.
# Each server gets a full copy of its own. What is kept is what each module declares in the
# backup: block of its module.yaml.
#   kiwi-stack backup [--new]       one run now (kn-backup.timer does it at {{ at }}); --new: a
#                                   rebuilt machine starts a history of its own instead of restoring
#   kiwi-stack snapshots [MODULE...]           what is stored, server by server
#   kiwi-stack restore [--at TIME] MODULE...    put the freshest copy back, from whichever server
#                                   has it, or the freshest made at or before TIME ("2026-11-10
#                                   09:00", "yesterday 18:00", "3 days ago"), this machine's time
#                                   unless it says ("09:00 UTC"; the snapshots list shows UTC);
#                                   those modules stop around it
set -uo pipefail

DIR={{ docker_dir }}/kiwi/backup
HOST={{ hostname }}
IMAGE={{ image }}
TARGETS=({{ targets | join(' ') }})
TARGET=${TARGETS[0]}
AUTO_RESTORE={{ 'yes' if (restore or 'auto') == 'auto' else 'no' }}

MODULES=({{ backup_sources | map(attribute='name') | join(' ') }})
declare -A FREEZE FROZEN BULK EXCLUDE SERVICES NO_RESTORE
{% for s in backup_sources %}
FREEZE[{{ s.name }}]="{{ s.freeze | join(' ') }}"
FROZEN[{{ s.name }}]="{{ s.frozen | join(' ') }}"
BULK[{{ s.name }}]="{{ s.bulk | join(' ') }}"
EXCLUDE[{{ s.name }}]="{{ s.exclude | join(' ') }}"
SERVICES[{{ s.name }}]="{{ s.services | join(' ') }}"
NO_RESTORE[{{ s.name }}]="{{ s.no_restore }}"
{% endfor %}

# A server that hangs instead of refusing keeps restic waiting for as long as it hangs. LIMIT
# bounds that: a database frozen meanwhile is down, and a run that never ends blocks the next.
# A first upload that needs longer than BULK_LIMIT goes on from where it was at the next run.
FREEZE_LIMIT=10m
ASK_LIMIT=3m
BULK_LIMIT=20h

restic() { # MOUNT... -- ARGUMENT...      against $TARGET
    local mounts=()
    while [[ $1 != -- ]]; do mounts+=(-v "$1"); shift; done
    shift
    ${LIMIT:+timeout -k 60 "$LIMIT"} {{ runtime }} run --rm --network host --security-opt label=disable --env-file "$DIR/restic.env" \
        -v {{ docker_dir }}/kiwi/ca:/kiwi-ca:ro -v kiwi_restic_cache:/cache "${mounts[@]}" \
        "$IMAGE" --cacert /kiwi-ca/kiwiCA.crt --cache-dir /cache -r "rest:$TARGET/$HOST/" "$@"
}

name() { # TARGET: its host name, for files and messages
    local n=${1#https://}
    echo "${n%%[:/]*}"
}

excludes() { # MODULE: sets the array EXCLUDES
    local list e
    EXCLUDES=()
    read -ra list <<<"${EXCLUDE[$1]}"
    for e in "${list[@]}"; do EXCLUDES+=(--exclude "$e"); done
}

store() { # MODULE KIND MOUNTS
    local module=$1 kind=$2 m list mounts=() paths=()
    read -ra list <<<"$3"
    for m in "${list[@]}"; do
        if [[ ${m:0:1} == / && ! -e ${m%%:*} ]]; then
            echo "backup: ${m%%:*} is missing, left out" >&2
            continue
        fi
        mounts+=("$m:ro")
        paths+=("${m##*:}")
    done
    [[ -n ${paths[*]:-} ]] || return 0
    excludes "$module"
    restic "${mounts[@]}" -- backup --host "$HOST" --tag "$module,$kind" "${EXCLUDES[@]}" "${paths[@]}"
    local rc=$?
    # 3: stored, without a file or two that went away while the machine was running
    (( rc == 3 )) || return "$rc"
    echo "backup: $module: some files could not be read, the rest is stored" >&2
}

# A database must not change while restic reads it. Frozen, its files are what a power cut
# would leave, which is what it recovers from at its next start. It stays frozen for its own
# files only; the big ones are read with everything running.
FROZEN_NOW=()
thaw() {
    local c
    for c in "${FROZEN_NOW[@]}"; do
        {{ runtime }} unpause "$c" >/dev/null || echo "backup: $c could not be unpaused" >&2
    done
    FROZEN_NOW=()
}
trap thaw EXIT
trap 'exit 143' TERM INT

# A run killed outright thaws nothing, and a paused container looks like a running one:
# kn-backup.service does this after every run.
thaw_left() {
    local m c list
    for m in "${MODULES[@]}"; do
        read -ra list <<<"${FREEZE[$m]}"
        for c in "${list[@]}"; do
            [[ $({{ runtime }} inspect --format '{% raw %}{{.State.Status}}{% endraw %}' "$c" 2>/dev/null) == paused ]] || continue
            echo "backup: $c was left frozen" >&2
            {{ runtime }} unpause "$c" >/dev/null || echo "backup: $c could not be unpaused" >&2
        done
    done
}

backup_to() { # every module to $TARGET
    local m c list ok frozen_failed=0 failed=() at
    at=$(name "$TARGET")
    LIMIT=$ASK_LIMIT restic -- --no-lock cat config >/dev/null 2>&1 || LIMIT=$ASK_LIMIT restic -- init || return 1
    # a restic killed half way leaves its lock, and one from a prune stops every backup after
    # it. This removes only those: a lock in use is refreshed and is never old enough.
    LIMIT=$ASK_LIMIT restic -- unlock >/dev/null 2>&1 || true
    for m in "${MODULES[@]}"; do
        # the server gone, each module would sit frozen through restic's retries in its turn
        if [[ -n ${failed[*]:-} ]] && ! LIMIT=$ASK_LIMIT restic -- --no-lock cat config >/dev/null 2>&1; then
            echo "backup: $at no longer answers, stopping here" >&2
            failed+=("$m and those after it")
            break
        fi
        ok=1
        read -ra list <<<"${FREEZE[$m]}"
        for c in "${list[@]}"; do
            # not running: its files are not changing either
            if {{ runtime }} pause "$c" >/dev/null 2>&1; then FROZEN_NOW+=("$c"); fi
        done
        LIMIT=$FREEZE_LIMIT store "$m" frozen "${FROZEN[$m]}" || { ok=0; frozen_failed=1; }
        thaw
        LIMIT=$BULK_LIMIT store "$m" bulk "${BULK[$m]}" || ok=0
        (( ok )) || failed+=("$m")
        # A repository that could not take this database (a full disk still answers) will not
        # take the next one either, and each would sit frozen until its limit in its turn.
        if (( frozen_failed )); then
            echo "backup: $at took nothing from a frozen $m, stopping here" >&2
            failed+=("those after it")
            break
        fi
    done
    if [[ -n ${failed[*]:-} ]]; then
        echo "backup: $at: failed: ${failed[*]}" >&2
        return 1
    fi
    date -u +%FT%TZ > "$DIR/last-success.$at"
    echo "backup: ${MODULES[*]} stored at $at"
}

backup() { # to each server in turn: one that fails costs only its own copy
    local t rc=0
    for t in "${TARGETS[@]}"; do
        TARGET=$t
        backup_to || rc=1
    done
    (( rc == 0 )) && date -u +%FT%TZ > "$DIR/last-success"
    return "$rc"
}

# The freshest snapshot of one part of a module made at or before a moment (in nanoseconds), on
# $TARGET, as "NANOSECONDS SHORT-ID", or nothing: restic picks only the newest by itself, so its
# list is read here, the snapshots' time and short id and nothing else.
snapshot_at() { # MODULE KIND EPOCH
    local json t id e best='' best_e=0
    json=$(LIMIT=$ASK_LIMIT restic -- --no-lock snapshots --host "$HOST" --tag "$1,$2" --json) || return 1
    while read -r t id; do
        e=$(date -d "$t" +%s%N 2>/dev/null) || continue
        if (( e <= $3 && e > best_e )); then best=$id; best_e=$e; fi
    done < <(grep -o '"time": *"[^"]*"\|"short_id": *"[^"]*"' <<<"$json" | sed 's/^"[a-z_]*": *"//; s/"$//' | paste - -)
    [[ -n $best ]] && echo "$best_e $best"
}

freshest() { # MODULE KIND EPOCH: "TARGET SHORT-ID" of the freshest copy on any server, or nothing
    local t found best='' best_e=0
    for t in "${TARGETS[@]}"; do
        TARGET=$t
        found=$(snapshot_at "$1" "$2" "$3") || continue
        if (( ${found%% *} > best_e )); then best_e=${found%% *}; best="$t ${found#* }"; fi
    done
    [[ -n $best ]] && echo "$best"
}

put_back() { # MODULE KIND MOUNTS TARGET SNAPSHOT
    local module=$1 kind=$2 m list mounts=()
    read -ra list <<<"$3"
    [[ -n ${list[*]:-} ]] || return 0
    for m in "${list[@]}"; do
        [[ ${m:0:1} != / ]] || mkdir -p "${m%%:*}"
        mounts+=("${m%%:*}:/restore${m##*:}")
    done
    excludes "$module"
    TARGET=$4
    # --delete empties the target of what the snapshot does not hold: it must hold nothing but these
    restic "${mounts[@]}" -- restore "$5" --target /restore --delete "${EXCLUDES[@]}"
}

service() { # stop|start SERVICE...
    local verb=$1 s
    shift
    for s; do
{% if runtime == 'podman' %}
        systemctl "$verb" "$s.service"
{% else %}
        docker "$verb" "$s" >/dev/null
{% endif %}
    done
}

# Everything of the stack up again, a container in another's network included. Not `kiwi-stack
# start`: that restarts the host units too, kn-backup.service among them, and an automatic
# restore, which runs in it, was killed half way and began again, over and over.
stack_up() {
{% if runtime == 'podman' %}
    systemctl start kiwi-stack.target
{% else %}
    docker compose --file {{ docker_dir }}/docker-compose.yml up --detach >/dev/null
{% endif %}
}

restore() { # [--at TIME] MODULE...
    local m list kind at when rc=0 exact=''
    declare -A SNAP=()
    if [[ ${1:-} == --at ]]; then
        [[ -n ${2:-} ]] || { echo "usage: kiwi-stack restore [--at TIME] MODULE..." >&2; return 1; }
        at=$(date -d "$2" +%s%N 2>/dev/null) || { echo "backup: $2 is not a time date(1) understands" >&2; return 1; }
        exact=1
        shift 2
    else
        at=$(date +%s%N)
    fi
    when=$(date -d "@$(( at / 1000000000 ))" '+%F %T %Z')
    (( $# )) || { echo "usage: kiwi-stack restore [--at TIME] MODULE...   (${MODULES[*]})" >&2; return 1; }
    for m; do
        [[ -v "BULK[$m]" ]] || { echo "backup: no module $m here (${MODULES[*]})" >&2; return 1; }
        [[ -z ${NO_RESTORE[$m]} ]] || { echo "backup: $m is not restored from here: ${NO_RESTORE[$m]}" >&2; return 1; }
    done
    # every snapshot is found before anything stops: a time with nothing to restore changes nothing
    for m; do
        for kind in frozen bulk; do
            [[ $kind == frozen ]] && list=${FROZEN[$m]} || list=${BULK[$m]}
            [[ -n $list ]] || continue
            if ! SNAP[$m,$kind]=$(freshest "$m" "$kind" "$at"); then
                if [[ -n $exact ]]; then
                    echo "backup: no snapshot of $m ($kind) from $when or before: kiwi-stack snapshots $m" >&2
                    return 1
                fi
                echo "backup: $m ($kind): nothing stored yet, left as it is"
                unset "SNAP[$m,$kind]"
                continue
            fi
            echo "backup: $m ($kind): snapshot ${SNAP[$m,$kind]#* } from $(name "${SNAP[$m,$kind]%% *}"), the freshest from $when or before"
        done
    done
    for m; do
        [[ -v "SNAP[$m,frozen]" || -v "SNAP[$m,bulk]" ]] || continue
        read -ra list <<<"${SERVICES[$m]}"
        service stop "${list[@]}"
        if [[ -v "SNAP[$m,frozen]" ]]; then
            put_back "$m" frozen "${FROZEN[$m]}" ${SNAP[$m,frozen]} || { echo "backup: $m: its frozen part did not come back" >&2; rc=1; }
        fi
        if [[ -v "SNAP[$m,bulk]" ]]; then
            put_back "$m" bulk "${BULK[$m]}" ${SNAP[$m,bulk]} || { echo "backup: $m: its files did not come back" >&2; rc=1; }
        fi
        service start "${list[@]}"
    done
    stack_up || rc=1
    if (( rc == 0 )); then
        rm -f "$DIR/held"
        touch "$DIR/restored"       # what it backs up from now on continues what was restored
    fi
    return "$rc"
}

restore_all() { # every module this machine may restore
    local m list=()
    for m in "${MODULES[@]}"; do [[ -n ${NO_RESTORE[$m]} ]] || list+=("$m"); done
    restore "${list[@]}"
}

# A rebuilt machine finds snapshots of itself that it never made. Backed up now, its fresh and
# empty state would be the freshest snapshot, the one `restore` takes, and the next prune keeps
# only that one of the day. So it restores first (restore: auto) or waits (restore: hold).
held() { # true while this machine must not back up; says why on stderr
    [[ -f $DIR/last-success || -f $DIR/restored || -f $DIR/new-history ]] && return 1
    if [[ -f $DIR/held ]]; then cat "$DIR/held" >&2; return 0; fi
    local t list
    for t in "${TARGETS[@]}"; do
        TARGET=$t
        # no repository yet, or no server: a new machine, or a run that fails on its own anyway
        LIMIT=$ASK_LIMIT restic -- --no-lock cat config >/dev/null 2>&1 || continue
        if ! list=$(LIMIT=$ASK_LIMIT restic -- --no-lock snapshots --host "$HOST" --json 2>/dev/null); then
            echo "backup: $(name "$t") did not say what it holds of $HOST: trying again at the next run" >&2
            return 0
        fi
        [[ $list == *'"short_id"'* ]] || continue
        echo "backup: $(name "$t") holds snapshots of $HOST and this machine made none of them: rebuilt? Restore first (kiwi-stack restore MODULE...), or start a new history (kiwi-stack backup --new)" | tee "$DIR/held" >&2
        return 0
    done
    return 1
}

# a re-apply and a stack start restart host units: this keeps that from being a backup
due() {
    if [[ -f $DIR/last-success ]] && (( $(date +%s) - $(stat -c %Y "$DIR/last-success") <= 20 * 3600 )); then
        return 1
    fi
    if held 2>/dev/null; then [[ $AUTO_RESTORE == yes ]]; return; fi
    return 0
}

snapshots() { # [--json] MODULE...      --json: a line "server<TAB>restic's JSON" per server
    local t m json='' tags=()
    if [[ ${1:-} == --json ]]; then json=1; shift; fi
    for m; do tags+=(--tag "$m"); done
    for t in "${TARGETS[@]}"; do
        TARGET=$t
        if [[ -n $json ]]; then
            printf '%s\t%s\n' "$(name "$t")" "$(restic -- --no-lock --json snapshots --host "$HOST" "${tags[@]}" 2>/dev/null || echo null)"
        else
            echo "== $(name "$t")"
            restic -- --no-lock snapshots --host "$HOST" "${tags[@]}"
        fi
    done
}

exec 9>"$DIR/lock"
case "${1:-}" in
    due)        due ;;
    thaw)       flock -w 120 9 || exit 0; thaw_left ;;
    backup)     flock -n 9 || { echo "backup: one is running already" >&2; exit 1; }
                if [[ ${2:-} == --new ]]; then rm -f "$DIR/held"; touch "$DIR/new-history"; fi
                if held; then
                    [[ $AUTO_RESTORE == yes ]] || exit 1
                    echo "backup: this machine was rebuilt: restoring every module before its first backup"
                    restore_all || { echo "backup: the restore did not finish: nothing is backed up until it has" >&2; exit 1; }
                fi
                backup ;;
    snapshots)  shift; snapshots "$@" ;;
    restore)    shift; flock -n 9 || { echo "backup: one is running already" >&2; exit 1; }; restore "$@" ;;
    *)          echo "usage: kiwi-stack backup [--new] | snapshots [--json] [MODULE...] | restore [--at TIME] MODULE..." >&2; exit 1 ;;
esac
