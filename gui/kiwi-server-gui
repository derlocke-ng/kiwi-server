            for i, d in enumerate(f.get("disks") or []):
                used = d["used"] / d["size"] if d["size"] else 0
                line(i + 1, "Disk %s" % d["mount"] if len(f["disks"]) > 1 else "Disk", used, "%d %%" % (used * 100))
            body.append(grid)
