class SnapshotsDialog(Adw.Dialog):
    """What the backup servers keep of one machine, a module per group, each time with Restore."""

    def __init__(self, win, host):
        super().__init__(title="Snapshots of %s" % host, content_width=620, content_height=640)
        self.win, self.host = win, host
        self.page = Adw.PreferencesPage()
        self.status = Adw.StatusPage(title="Asking the backup servers…", child=Adw.Spinner())
        self.stack = Gtk.Stack()
        self.stack.add_named(self.status, "wait")
        self.stack.add_named(self.page, "list")
        tb = Adw.ToolbarView(content=self.stack)
        tb.add_top_bar(Adw.HeaderBar())
        self.set_child(tb)
        threading.Thread(target=self.load, daemon=True).start()

    def load(self):
        rc, out, err = run_cli(self.win.cli, ["backups", self.win.doc.path, self.host, "--porcelain"], timeout=180)
        GLib.idle_add(self.show_list, json.loads(out) if rc == 0 else None, err.strip())

    def show_list(self, data, err):
        if data is None:
            self.status.set_title("No answer")
            self.status.set_description(err.splitlines()[-1] if err else "")
            self.status.set_child(None)
            return False
        times = {}          # module -> minute -> (newest time, servers)
        for sv in data["servers"]:
            for sn in sv["snapshots"]:
                key = sn["time"][:16]
                at, servers = times.setdefault(sn["module"], {}).get(key, ("", set()))
                servers.add(sv["server"].removeprefix("backup.").split(".")[0])
                times[sn["module"]][key] = (max(at, sn["time"]), servers)
        missed = [sv["server"] for sv in data["servers"] if not sv["ok"]]
        if missed:
            g = Adw.PreferencesGroup()
            g.add(plain_row("Nothing found on %s" % ", ".join(missed), "Not reached, or it keeps no repository of this machine"))
            self.page.add(g)
        for module in sorted(times):
            g = Adw.PreferencesGroup(title=module)
            for key in sorted(times[module], reverse=True)[:30]:
                at, servers = times[module][key]
                row = plain_row(local_time(at), " · ".join(sorted(servers)))
                b = Gtk.Button(label="Restore", valign=Gtk.Align.CENTER, css_classes=["flat"])
                b.connect("clicked", self.ask, module, at)
                row.add_suffix(b)
                g.add(row)
            self.page.add(g)
        if not times:
            self.status.set_title("No snapshots yet")
            self.status.set_child(None)
            return False
        self.stack.set_visible_child_name("list")
        return False

    def ask(self, _b, module, at):
        dlg = Adw.AlertDialog(heading="Restore %s?" % module,
                              body="%s on %s goes back to %s. What it has now is replaced." % (module, self.host, local_time(at)))
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("go", "Restore")
        dlg.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r == "go":
                self.close()
                self.win.spawn(["backups", self.win.doc.path, self.host, module, "--restore", "--at", at],
                               "Restoring %s on %s…" % (module, self.host))
        dlg.connect("response", resp)
        dlg.present(self)


