def size_kib(kib):
    for unit in ("KiB", "MiB", "GiB", "TiB"):
        if kib < 1024 or unit == "TiB":
            return "%.0f %s" % (kib, unit) if unit == "KiB" else "%.1f %s" % (kib, unit)
        kib /= 1024


def local_time(iso):
    """restic's time (nanoseconds, an offset) as local 'Tue 10 Nov 19:01'."""
    try:
        import datetime
        t = datetime.datetime.fromisoformat(re.sub(r"(\.\d+)", "", iso).replace("Z", "+00:00"))
        return t.astimezone().strftime("%a %d %b %H:%M")
    except ValueError:
        return iso[:16]


def duration(seconds):
    s = int(seconds)
    if s < 90:
        return "%d s" % s
    if s < 3600:
        return "%d min" % (s / 60)
    if s < 86400:
        return "%d h %d min" % (s / 3600, s % 3600 / 60)
    return "%d d %d h" % (s / 86400, s % 86400 / 3600)


def size(kib):
    gib = kib / 1048576
    if gib >= 1024:
        return "%.1f TiB" % (gib / 1024)
    return "%.1f GiB" % gib if gib >= 1 else "%d MiB" % (kib / 1024)


def when(iso):
    """2026-11-09T06:32:25Z as `09 Nov 07:32, 1 h 3 min ago`."""
    dt = GLib.DateTime.new_from_iso8601(iso, None) if iso else None
    if dt is None:
        return iso or "never"
    ago = GLib.DateTime.new_now_utc().difference(dt) / 1000000
    return "%s, %s ago" % (dt.to_local().format("%d %b %H:%M"), duration(max(ago, 0)))


def load_recent():
    try:
        with open(RECENT, encoding="utf-8") as f:
