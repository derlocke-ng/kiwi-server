#!/usr/bin/env bash
# LAN gateway routing for {{ hostname }} — generated by kiwi-server, run by kn-gateway.service.
#
# LAN clients that point their default gateway at this machine are routed through
# the VPN client container (table 128). They may reach the mesh ({{ vpn_subnet }})
# and the internet through the tunnel, not the docker network itself.
set -u

PUB_IFACE="{{ pub_iface }}"
CONTAINER_IP="{{ vpn_client_ip }}"
DOCKER_SUBNET="{{ docker_subnet }}"
VPN_SUBNET="{{ vpn_subnet or mesh_subnet }}"
BRIDGE="{{ network_name }}"
OWN_MESH_IP="{{ vpn_ip }}"
PROXY_IP="{{ proxy_ip }}"
# docker names the bridge after the network; podman does not — the route to the
# stack's subnet names the interface either way
if ! ip link show "$BRIDGE" >/dev/null 2>&1; then
    BRIDGE=$(ip -o route show "$DOCKER_SUBNET" 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1)
fi
[[ -n $BRIDGE ]] || { echo "[kiwi-gw] no bridge for $DOCKER_SUBNET yet"; exit 1; }

if [[ -z $PUB_IFACE ]]; then
    PUB_IFACE=$(ip -o route get 8.8.8.8 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p')
fi
[[ -n $PUB_IFACE ]] || { echo "[kiwi-gw] no LAN interface found"; exit 1; }

rules_del() {
    iptables -D FORWARD -i "$PUB_IFACE" -d "$DOCKER_SUBNET" -m conntrack --ctstate NEW -m conntrack ! --ctstate DNAT -j DROP 2>/dev/null || true
    iptables -D FORWARD -i "$PUB_IFACE" -d "$DOCKER_SUBNET" -j DROP 2>/dev/null || true   # the rule of earlier versions
    iptables -D FORWARD -i "$PUB_IFACE" -o "$PUB_IFACE" -j DROP 2>/dev/null || true
    iptables -D FORWARD -i "$PUB_IFACE" -d "$VPN_SUBNET" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -i "$PUB_IFACE" -o "$BRIDGE" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -i "$BRIDGE" -o "$PUB_IFACE" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
    iptables -D INPUT -i "$BRIDGE" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
    if [[ -n $OWN_MESH_IP && -n $PROXY_IP ]]; then
        iptables -t nat -D PREROUTING -i "$PUB_IFACE" -d "$OWN_MESH_IP" -p tcp -m multiport --dports 80,443 -j DNAT --to-destination "$PROXY_IP" 2>/dev/null || true
    fi
    iptables -t nat -D POSTROUTING -o "$BRIDGE" -j KIWI_GW_NAT 2>/dev/null || true
    iptables -t nat -F KIWI_GW_NAT 2>/dev/null || true
    iptables -t nat -X KIWI_GW_NAT 2>/dev/null || true
    iptables -t nat -D POSTROUTING -o "$BRIDGE" -j MASQUERADE 2>/dev/null || true   # the rule of earlier versions
    ip route flush table 128 2>/dev/null || true
    while ip rule del iif "$PUB_IFACE" table 128 2>/dev/null; do :; done
}

case "${1:-start}" in
    stop)
        rules_del
        echo "[kiwi-gw] routing removed"
        exit 0 ;;
    start) ;;
    watch)
        # The rule and the routes below are not this script's alone: a network manager that
        # sets the card up anew (systemd-networkd after a new address, a link that came back)
        # may drop them, and the gateway then routed nothing, or around the VPN, until
        # someone restarted it. Looked at twice a minute and put back.
        while sleep 30; do
            if ! ip rule show | grep -q "iif $PUB_IFACE lookup 128"; then
                ip rule add iif "$PUB_IFACE" table 128 && echo "[kiwi-gw] the rule for the LAN was gone: put back"
            fi
            if ! ip route show table 128 2>/dev/null | grep -q "^default via $CONTAINER_IP "; then
                ip route replace table 128 default via "$CONTAINER_IP" && echo "[kiwi-gw] the route through the VPN client was gone: put back"
            fi
            ip route show table 128 2>/dev/null | grep -q "^throw $DOCKER_SUBNET" || ip route add table 128 throw "$DOCKER_SUBNET" 2>/dev/null || true
            if ! iptables -C FORWARD -i "$PUB_IFACE" -o "$PUB_IFACE" -j DROP 2>/dev/null; then
                iptables -I FORWARD -i "$PUB_IFACE" -o "$PUB_IFACE" -j DROP && echo "[kiwi-gw] the rule that keeps LAN clients inside the VPN was gone: put back"
            fi
        done
        exit 0 ;;
    *) echo "usage: gw.sh start|stop|watch" >&2; exit 1 ;;
esac

# the VPN client must be up: wait for it rather than fail the boot
for _ in $(seq 60); do
    ping -c 1 -W 2 "$CONTAINER_IP" >/dev/null 2>&1 && break
    sleep 2
done
if ! ping -c 1 -W 2 "$CONTAINER_IP" >/dev/null 2>&1; then
    echo "[kiwi-gw] VPN client at $CONTAINER_IP is not reachable"
    exit 1
fi

rules_del
if systemctl is-active -q firewalld 2>/dev/null; then
    # netavark marks the stack's network as trusted only at runtime, and a reload forgets
    # that: containers could no longer reach each other. Made permanent before any reload.
    firewall-cmd -q --permanent --zone=trusted --query-source="$DOCKER_SUBNET" || firewall-cmd -q --permanent --zone=trusted --add-source="$DOCKER_SUBNET"
    firewall-cmd -q --zone=trusted --query-source="$DOCKER_SUBNET" || firewall-cmd -q --zone=trusted --add-source="$DOCKER_SUBNET"
    # firewalld judges forwarded packets itself, whatever the rules below say, and refuses
    # LAN clients unless a policy lets them through. Made once: it takes a reload.
    if ! firewall-cmd -q --permanent --info-policy=kiwi-lan-gateway >/dev/null 2>&1; then
        zone=$(firewall-cmd --get-zone-of-interface="$PUB_IFACE" 2>/dev/null) || zone=$(firewall-cmd --get-default-zone)
        firewall-cmd -q --permanent --new-policy=kiwi-lan-gateway
        firewall-cmd -q --permanent --policy=kiwi-lan-gateway --add-ingress-zone="$zone"
        firewall-cmd -q --permanent --policy=kiwi-lan-gateway --add-egress-zone=ANY
        firewall-cmd -q --permanent --policy=kiwi-lan-gateway --set-target=ACCEPT
        firewall-cmd -q --reload
    fi
fi
# policy routing: what comes in on the LAN interface leaves via the VPN client
ip rule add iif "$PUB_IFACE" table 128
ip route add table 128 default via "$CONTAINER_IP"
ip route add table 128 throw "$DOCKER_SUBNET"
# LAN clients: no access to the docker network, mesh allowed, internet through the tunnel.
# -I puts a rule on top, so the last one inserted is checked first: the DROP goes last.
iptables -I INPUT -i "$BRIDGE" -m state --state RELATED,ESTABLISHED -j ACCEPT
iptables -I FORWARD -i "$BRIDGE" -o "$PUB_IFACE" -m state --state RELATED,ESTABLISHED -j ACCEPT
iptables -I FORWARD -i "$PUB_IFACE" -o "$BRIDGE" -j ACCEPT
iptables -I FORWARD -i "$PUB_IFACE" -d "$VPN_SUBNET" -j ACCEPT
# LAN clients must not reach the containers' own addresses — but this rule sits above
# everything else, so it must spare the replies to what the containers themselves
# started (the VPN client's WireGuard handshake came in on the LAN side and died here)
# and the connections netavark DNATs to published ports (Pi-hole, nginx from the LAN)
iptables -I FORWARD -i "$PUB_IFACE" -d "$DOCKER_SUBNET" -m conntrack --ctstate NEW -m conntrack ! --ctstate DNAT -j DROP
# The kill switch. What a LAN client sends leaves through the VPN client or not at all:
# never back out of the card it came in on, which is the way around the VPN. Without
# this, a lost rule above (table 128) turned the gateway into a plain router and every
# client's traffic left by the home's own connection, with nothing to see.
iptables -I FORWARD -i "$PUB_IFACE" -o "$PUB_IFACE" -j DROP
# This node's own names resolve to its mesh address, which lives inside the VPN client
# and only takes connections from the tunnel: a LAN client goes straight to the proxy.
if [[ -n $OWN_MESH_IP && -n $PROXY_IP ]]; then
    iptables -t nat -I PREROUTING -i "$PUB_IFACE" -d "$OWN_MESH_IP" -p tcp -m multiport --dports 80,443 -j DNAT --to-destination "$PROXY_IP"
fi
# LAN clients appear to the VPN client as the host; the containers' own traffic and
# the mesh's keep their addresses — with bridged traffic tracked by the host (lib.sh,
# problem 57) a bare "-o bridge" masquerade caught those too, and nginx logged every
# mesh client as 172.128.0.1
# (a chain, because iptables takes only one -s per rule)
iptables -t nat -N KIWI_GW_NAT
iptables -t nat -A KIWI_GW_NAT -s "$DOCKER_SUBNET" -j RETURN
iptables -t nat -A KIWI_GW_NAT -s "$VPN_SUBNET" -j RETURN
# a connection to a published port (nginx from the LAN) keeps its address: it is not going through the VPN client
iptables -t nat -A KIWI_GW_NAT -m conntrack --ctstate DNAT -j RETURN
iptables -t nat -A KIWI_GW_NAT -j MASQUERADE
iptables -t nat -I POSTROUTING -o "$BRIDGE" -j KIWI_GW_NAT
echo "[kiwi-gw] LAN ($PUB_IFACE) -> $CONTAINER_IP (VPN client); mesh $VPN_SUBNET allowed"
