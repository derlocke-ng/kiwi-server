def help_button(text, link=None, info=False):
    """A "?" beside a field or term: what it means, the documentation one click away. With
    `info`, an (i) instead: the whole of a text too long for where it stands."""
    if info:
        b = Gtk.MenuButton(icon_name="help-about-symbolic", valign=Gtk.Align.CENTER, tooltip_text="More",
                           css_classes=["flat", "circular", "ks-help"])
    else:   # a plain "?", as in the other kiwi apps: Adwaita's question icon is a diamond that reads as a warning
        b = Gtk.MenuButton(child=Gtk.Label(label="?", css_classes=["heading"]), valign=Gtk.Align.CENTER,
                           tooltip_text="What is this?", css_classes=["flat", "circular", "ks-help"])
    b.update_property([Gtk.AccessibleProperty.LABEL], ["More about this"])
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=10, margin_bottom=10,
                  margin_start=12, margin_end=12)
    box.append(Gtk.Label(label=text, wrap=True, max_width_chars=56, xalign=0, selectable=info))
    if link:
        box.append(Gtk.LinkButton(uri=link, label="More in the docs", halign=Gtk.Align.START, css_classes=["flat"]))
    b.set_popover(Gtk.Popover(child=box))
    return b


def info_button(text, link=None):
    return help_button(text, link, info=True)


class SetupWizard(Adw.Dialog):
    """A new fleet, step by step. The questions are `kiwi-server init --questions` and the
    answers go back to `kiwi-server init --answers`: the terminal and the app ask the same."""

    def __init__(self, win, path, data):
        super().__init__(title="A new network", content_width=660, content_height=700)
        self.win, self.path = win, path
        self.suggest = data.get("suggestions") or {}
        self.get, self.rows, self.machines, self.entries = {}, {}, [], {}
        self.steps = []
        for st in data["steps"]:            # a question with one possible answer is not a question
            asked = []
            for q in st["questions"]:
                opts = q.get("options") or []
                if q.get("type") == "choice" and len(opts) == 1:
                    self.get[q["id"]] = lambda v=opts[0]["value"]: v
                else:
                    asked.append(q)
            self.steps.append(dict(st, questions=asked))    # (a step without a question still says something)
        self.problem = {}
        self.nav = Adw.NavigationView()
        self.pages = [self.step_page(i, st) for i, st in enumerate(self.steps)]
        self.nav.add(self.pages[0])
        self.set_child(self.nav)
        self.update_when()

    # ---- the pages ----
    def step_page(self, i, step):
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(title=step["step"], description=step.get("intro", ""))
        for note in step.get("notes") or []:
            g.add(Adw.ActionRow(use_markup=False, title=note, title_lines=0))
        page.add(g)
        advanced = [q for q in step["questions"] if q.get("advanced")]
        for q in step["questions"]:
            if q.get("type") == "machines":
                page.add(self.machines_group(q))
            elif not q.get("advanced"):         # one question, and under it the sentence that explains it
                one = Adw.PreferencesGroup(description=q.get("help", ""))
                one.add(self.row_for(q, plain=True))
                self.rows[q["id"]] = (one, q.get("when"))       # hidden with its explanation, not only the row
                page.add(one)
        if advanced:
            more = Adw.PreferencesGroup()
            exp = Adw.ExpanderRow(title="More settings", subtitle="These have answers that work. Change them only if you know why.")
            for q in advanced:
                exp.add_row(self.row_for(q))
            more.add(exp)
            page.add(more)
        last = i == len(self.steps) - 1
        go = Gtk.Button(label="Create my network" if last else "Next", css_classes=["suggested-action", "pill"],
                        halign=Gtk.Align.CENTER, margin_top=6, margin_bottom=12)
        go.connect("clicked", lambda *_: self.go_on(i))
        self.problem[i] = Gtk.Label(wrap=True, xalign=0.5, justify=Gtk.Justification.CENTER, visible=False,
                                    css_classes=["error"], margin_start=18, margin_end=18, margin_top=6)
        foot = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        foot.append(self.problem[i])
        foot.append(go)
        tv = Adw.ToolbarView(content=page)
        tv.add_top_bar(Adw.HeaderBar())
        tv.add_bottom_bar(foot)
        return Adw.NavigationPage(title="%d of %d · %s" % (i + 1, len(self.steps), step["step"]), child=tv)

    def go_on(self, i):
        """Next: only when what this page asked is in order. The check is the terminal's
        (`init --check`), so both say the same about the same answer."""
        step = self.steps[i]
        ids = {q["id"] for q in step["questions"]}
        machines = any(q.get("type") == "machines" for q in step["questions"])
        a = self.answers()
        tmp = os.path.join(GLib.get_user_runtime_dir(), "kiwi-check-%d.json" % os.getpid())
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(a, f)
        try:
            rc, out, _err = run_cli(self.win.cli, ["init", "--check", tmp], timeout=60)
        finally:
            os.remove(tmp)
        try:
            bad = json.loads(out) if rc == 0 else {}
        except ValueError:
            bad = {}
        mine = []
        for key, msg in bad.items():
            if key in ids:
                mine.append(msg)
            elif machines and key.startswith("nodes."):
                n = int(key.split(".")[1])
                mine.append("%s: %s" % (a["nodes"][n].get("name") or "machine %d" % (n + 1), msg))
        self.problem[i].set_label(mine[0] if mine else "")
        self.problem[i].set_visible(bool(mine))
        if mine:
            return
        if i == len(self.steps) - 1:
            self.create()
        else:
            self.nav.push(self.pages[i + 1])

    def row_for(self, q, into=None, plain=False):
        """A row for one question; its value is read through self.get (or into, for a machine).
        `plain`: its help stands above it already, so no "?" button."""
        kind, get = q.get("type", "string"), None
        if kind == "choice":
            opts = q["options"]
            # (the subtitle shows the choice only when the row is told how to read an item's text)
            row = Adw.ComboRow(title=q["label"], model=Gtk.StringList.new([o["label"] for o in opts]), use_subtitle=True,
                               expression=Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
            row.set_selected(next((n for n, o in enumerate(opts) if o["value"] == q.get("default")), 0))
            row.connect("notify::selected", lambda *_: self.update_when())
            get = lambda r=row, o=opts: o[r.get_selected()]["value"]
        elif kind == "bool":
            row = Adw.SwitchRow(title=q["label"], active=bool(q.get("default")))
            get = row.get_active
        elif kind == "lookup":
            row, get = self.lookup_row(q)
        else:
            row = (Adw.PasswordEntryRow if q.get("secret") else Adw.EntryRow)(title=q["label"])
            row.set_text(str(q.get("default") or ""))
            get = lambda r=row: r.get_text().strip()
            self.entries[q["id"]] = row
        if q.get("help") and not plain:
            row.add_suffix(help_button(q["help"], DOCS + "README.md"))
        (into if into is not None else self.get)[q["id"]] = get
        if into is None:
            self.rows[q["id"]] = (row, q.get("when"))
        return row

    def lookup_row(self, q):
        """Looked up, not typed: sign in at the hoster in the browser, pick the server from its
        list. The address then stands in the address row; the login becomes the network's.
        Which hoster is another question's answer (q["lookup"]); netcup is the first."""
        row = Adw.ActionRow(use_markup=False, title=q["label"], subtitle="Not chosen. You can also type the address below.")
        btn = Gtk.Button(label="Sign in and pick it…", valign=Gtk.Align.CENTER)
        row.add_suffix(btn)
        picked = {"id": "", "token": ""}

        def failed(why):
            row.set_subtitle("That did not work: %s. Type the address below instead." % why)
            btn.set_sensitive(True)
            return False

        def opened(url, name):
            row.set_subtitle("Sign in to %s on the page that opened in your browser. This goes on by itself." % name)
            Gtk.UriLauncher.new(url).launch(self.win, None, None)
            return False

        def listed(rows, token, name):
            if not rows:
                return failed("%s lists no server for this account" % name)
            names = Gtk.DropDown.new_from_strings([r["label"] for r in rows])
            names.set_valign(Gtk.Align.CENTER)

            def take(*_):
                r = rows[names.get_selected()]
                picked.update(id=r["id"], token=token)
                if "master_address" in self.entries:
                    self.entries["master_address"].set_text(r["address"])
                row.set_subtitle("Its address is %s" % r["address"])
            names.connect("notify::selected", take)
            row.remove(btn)
            row.add_suffix(names)
            take()
            return False

        def work(provider, name):
            token = os.path.join(GLib.get_user_runtime_dir(), "kiwi-%s-%d.token" % (provider, os.getpid()))
            try:
                proc = subprocess.Popen([self.win.cli, "init", "--provider", provider, "--provider-login", token],
                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, stdin=subprocess.DEVNULL)
                for line in proc.stdout:
                    if line.startswith("http"):
                        GLib.idle_add(opened, line.strip(), name)
                err = proc.stderr.read()
                if proc.wait() != 0:
                    return GLib.idle_add(failed, (err.strip().replace("error: ", "").splitlines() or ["no answer"])[-1][:140])
            except OSError as e:
                return GLib.idle_add(failed, str(e))
            rc, out, err = run_cli(self.win.cli, ["init", "--provider", provider, "--provider-servers", token], timeout=120)
            try:
                rows = json.loads(out) if rc == 0 else None
            except ValueError:
                rows = None
            if rows is None:
                return GLib.idle_add(failed, (err.strip().replace("error: ", "").splitlines() or ["no answer"])[-1][:140])
            GLib.idle_add(listed, rows, token, name)

        def clicked(*_):
            provider = self.get[q["lookup"]]()
            name = (q.get("names") or {}).get(provider, provider)
            btn.set_sensitive(False)
            row.set_subtitle("Asking %s…" % name)
            threading.Thread(target=work, args=(provider, name), daemon=True).start()
        btn.connect("clicked", clicked)
        self.get["provider_token"] = lambda: picked["token"]
        return row, lambda: picked["id"]

    def machines_group(self, q):
        self.machine_q = q
        g = Adw.PreferencesGroup(title=q["label"])
        self.none_note = Adw.ActionRow(use_markup=False, title=q.get("none", ""), title_lines=0, visible=bool(q.get("none")))
        g.add(self.none_note)
        add = Gtk.Button(label=q.get("add", "Add a machine"), css_classes=["pill"], halign=Gtk.Align.CENTER, margin_top=12)
        add.connect("clicked", lambda *_: self.add_machine(g))
        g.add(add)
        self.machine_group = g
        return g

    def add_machine(self, g):
        n = len(self.machines)
        taken = {m["name"]() for m in self.machines} | ({self.get["master_name"]()} if "master_name" in self.get else set())
        name = next((x for x in self.suggest.get("nodes", []) if x not in taken), "node%d" % (n + 1))
        used = {m["fields"]["address"]() for m in self.machines if "address" in m["fields"]}
        free = [x for x in self.suggest.get("addresses") or [] if x not in used]
        exp = Adw.ExpanderRow(title=name, subtitle="a machine at home", expanded=True)
        more = Adw.ExpanderRow(title="More settings", subtitle="Its name, its system, its disk")
        fields = {}
        for f in self.machine_q.get("fields") or []:
            f = dict(f)
            if f.get("default_from") == "fruits":
                f["default"] = name
            elif f.get("default_from") == "suggest":
                f["default"] = free[0] if free else ""
            row = self.row_for(f, into=fields)
            (more if f.get("advanced") else exp).add_row(row)
            fields["_row_" + f["id"]] = (row, f.get("when"))
        exp.add_row(more)
        rm = Gtk.Button(icon_name="user-trash-symbolic", tooltip_text="Remove it", css_classes=["flat"],
                        valign=Gtk.Align.CENTER)
        exp.add_suffix(rm)
        entry = {"exp": exp, "fields": fields, "name": fields["name"]}
        name_row = fields["_row_name"][0]
        name_row.connect("changed", lambda r: exp.set_title(r.get_text().strip() or "a machine"))

        def remove(*_):
            g.remove(exp)
            self.machines.remove(entry)
            self.none_note.set_visible(not self.machines and bool(self.machine_q.get("none")))
        rm.connect("clicked", remove)
        self.machines.append(entry)
        self.none_note.set_visible(False)
        g.add(exp)
        self.update_when()

    def update_when(self):
        """Show a question only while its `when` holds (key == 'value')."""
        def holds(cond, values):
            if not cond:
                return True
            if " in " in cond:                  # key in a,b,c
                key, _sep, vals = cond.partition(" in ")
                return key in values and str(values[key]()) in vals.split(",")
            key, _sep, val = cond.partition(" == ")
            return key in values and str(values[key]()) == val.strip("'")
        for row, cond in self.rows.values():
            row.set_visible(holds(cond, self.get))
        for m in self.machines:
            for k, v in m["fields"].items():
                if k.startswith("_row_"):
                    v[0].set_visible(holds(v[1], {x: g for x, g in m["fields"].items() if not x.startswith("_row_")}))

    # ---- the end ----
    def answers(self):
        # (a question that was not asked, having one answer, has no row)
        a = {k: g() for k, g in self.get.items() if k not in self.rows or self.rows[k][0].get_visible()}
        a["nodes"] = [{k: g() for k, g in m["fields"].items() if not k.startswith("_row_") and m["fields"]["_row_" + k][0].get_visible()}
                      for m in self.machines]
        return a

    def create(self):
        a = self.answers()
        # the answers may hold a Mullvad key: they pass through memory, not the disk
        tmp = os.path.join(GLib.get_user_runtime_dir(), "kiwi-init-%d.json" % os.getpid())
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(a, f)
        spinner = Adw.StatusPage(title="Making your network", description="its keys and its settings")
        self.nav.push(Adw.NavigationPage(title="Making your network", child=spinner, can_pop=False))

        def work():
            try:
                rc, out, err = run_cli(self.win.cli, ["init", self.path, "--answers", tmp], timeout=300)
            finally:
                os.remove(tmp)
            GLib.idle_add(self.done, rc, out, err)
        threading.Thread(target=work, daemon=True).start()

    def done(self, rc, out, err):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18,
                      margin_start=18, margin_end=18)
        ok = rc == 0
        box.append(Gtk.Label(label="Your network is ready" if ok else "It was not made", xalign=0,
                             css_classes=["title-2"]))
        key = re.search(r"AGE-SECRET-KEY-1[0-9A-Z]+", out) if ok else None
        if key:
            box.append(Gtk.Label(label="Write this recovery key down now, on paper or in a password manager. It is "
                                       "shown only once. If this computer is lost, it is the only way back to your "
                                       "network's keys.", wrap=True, xalign=0, css_classes=["warning"]))
            shown = Gtk.Label(label=key.group(0), selectable=True, wrap=True, wrap_mode=2, xalign=0,
                              css_classes=["monospace", "card"], margin_top=4, margin_bottom=4)
            shown.set_margin_start(2)
            box.append(shown)
            copy = Gtk.Button(label="Copy the key", halign=Gtk.Align.START)
            copy.connect("clicked", lambda b: (Gdk.Display.get_default().get_clipboard().set(key.group(0)),
                                               b.set_label("Copied")))
            box.append(copy)
        if ok:
            box.append(Gtk.Label(label="Next, the app lists your machines, the master first, with one step and one "
                                       "button each.", wrap=True, xalign=0))
        tv = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR, vexpand=True)
        text = (out + ("\n" + err if err.strip() else "")).strip()
        tv.get_buffer().set_text(text.replace(key.group(0), "(the key above)") if key else text)
        details = Gtk.Expander(label="Details" if ok else "What went wrong", expanded=not ok)
        details.set_child(Gtk.ScrolledWindow(child=tv, vexpand=True, min_content_height=220))
        box.append(details)
        b = Gtk.Button(label="Go to the first step" if ok else "Back", css_classes=["suggested-action", "pill"],
                       halign=Gtk.Align.CENTER)
        b.connect("clicked", lambda *_: (self.close(), ok and self.win.open_path(self.path)))
        box.append(b)
        self.nav.push(Adw.NavigationPage(title="Done" if ok else "Not made", child=box, can_pop=not ok))
        return False


def with_passphrase(cli, args, passphrase, timeout=600):
    """Run a command that takes --passphrase-file: the passphrase goes through a file in RAM
    that is gone afterwards. Returns (rc, output)."""
    tmp = os.path.join(GLib.get_user_runtime_dir(), "kiwi-pass-%d-%d" % (os.getpid(), threading.get_ident()))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(passphrase + "\n")
    try:
        rc, out, err = run_cli(cli, list(args) + ["--passphrase-file", tmp], timeout=timeout)
    finally:
        os.remove(tmp)
    return rc, (out + err)


