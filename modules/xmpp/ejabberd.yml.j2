{# one template, two files: `output` says which. config: the service in the WireGuard server's
   network. config_public: the separate public instance (two) #}
{% set public = output == 'config_public' %}
{% set host = xmpp_domain if public else main_host %}
{% set onion_host = (onion or {}).get('xmpp' if public else 'jabber', '') %}
{% set federates = public or one_public %}
{# a node's public name: the master hands the connections on, each with its visitor's address in front #}
{% set handed = forwarded and federates %}
# ejabberd for {{ host }} on {{ hostname }}: generated by kiwi-server; the fleet file is the place to change it
hosts:
  - {{ host }}
{% if onion_host %}
  # accounts for people who come through Tor and have no way to check a certificate
  - {{ onion_host }}
{% endif %}
loglevel: info
# no addresses of the people in the log
hide_sensitive_log_data: true
default_db: mnesia
certfiles:
  - /opt/ejabberd/conf/certs/*.pem
acme:
  auto: false
trusted_proxies:
  - 127.0.0.1
  - {{ docker_subnet }}

listen:
  - port: 5222
    ip: "::"
    module: ejabberd_c2s
    max_stanza_size: 262144
    shaper: c2s_shaper
    access: c2s
    starttls_required: true
  - port: 5223
    ip: "::"
    module: ejabberd_c2s
    max_stanza_size: 262144
    shaper: c2s_shaper
    access: c2s
    tls: true
{% if federates %}
  - port: 5269
    ip: "::"
    module: ejabberd_s2s_in
    max_stanza_size: 524288
    shaper: s2s_shaper
{% endif %}
{% if handed %}
  # the same doors for what the master hands on from the Internet: the visitor's address comes first
  - port: 15222
    ip: "::"
    module: ejabberd_c2s
    use_proxy_protocol: true
    max_stanza_size: 262144
    shaper: c2s_shaper
    access: c2s
    starttls_required: true
  - port: 15223
    ip: "::"
    module: ejabberd_c2s
    use_proxy_protocol: true
    max_stanza_size: 262144
    shaper: c2s_shaper
    access: c2s
    tls: true
  - port: 15269
    ip: "::"
    module: ejabberd_s2s_in
    use_proxy_protocol: true
    max_stanza_size: 524288
    shaper: s2s_shaper
{% endif %}
  # plain HTTP for the reverse proxy only; it speaks https to the people
  - port: 5280
    ip: "{{ '::' if public else '127.0.0.1' if local_http.startswith('127.') else '::' }}"
    module: ejabberd_http
    request_handlers:
      /register: mod_register_web
      /captcha: ejabberd_captcha
      /upload: mod_http_upload
      /websocket: ejabberd_http_ws
      /bosh: mod_bosh
      /admin: ejabberd_web_admin

{% if join_on %}
  # the network's sign-up page (/join) makes accounts here: two commands, from the stack network only
  - port: 5281
    ip: "::"
    module: ejabberd_http
    request_handlers:
      /api: mod_http_api
{% endif %}

s2s_use_starttls: required
{% if not federates %}
# a service for the VPN only: it asks no other server and none reaches it
s2s_access: none
{% endif %}

# a new account: after a captcha, and one per address in ten minutes
captcha_cmd: /usr/local/bin/captcha.sh
# (the pictures' address must be a whole one; for a visitor through Tor the proxy makes it relative)
captcha_url: https://{{ host }}/captcha
registration_timeout: 600

acl:
  local:
    user_regexp: ""
  loopback:
    ip:
      - 127.0.0.0/8
      - ::1/128
  admin:
    user:
      - {{ admin_user }}@{{ host }}

access_rules:
  local:
    allow: local
  c2s:
    deny: blocked
    allow: all
  register:
{% if registration %}
    allow: all
{% else %}
    deny: all
{% endif %}
  announce:
    allow: admin
  configure:
    allow: admin
  muc_create:
    allow: local
  pubsub_createnode:
    allow: local
  trusted_network:
    allow: loopback

api_permissions:
  "console commands":
    from: ejabberd_ctl
    who: all
    what: "*"
  "webadmin commands":
    from: ejabberd_web_admin
    who: admin
    what: "*"
  "adhoc commands":
    from: mod_adhoc_api
    who: admin
    what: "*"
{% if join_on %}
  "kiwi sign-up page":
    from: mod_http_api
    who:
      ip: {{ docker_subnet }}
    what:
      - register
      - check_account
{% endif %}

shaper:
  normal:
    rate: 3000
    burst_size: 20000
  fast: 100000

shaper_rules:
  max_user_sessions: 10
  max_user_offline_messages:
    5000: admin
    100: all
  c2s_shaper:
    none: admin
    normal: all
  s2s_shaper: fast

modules:
{% if join_on %}
  mod_http_api: {}
{% endif %}
  mod_adhoc: {}
  mod_adhoc_api: {}
  mod_admin_extra: {}
  mod_announce:
    access: announce
  mod_blocking: {}
  mod_bosh: {}
  mod_caps: {}
  mod_carboncopy: {}
  mod_client_state: {}
  mod_configure: {}
  mod_disco: {}
  # an address that keeps typing wrong passwords is shut out for an hour
  mod_fail2ban:
    c2s_auth_ban_lifetime: 3600
    c2s_max_auth_failures: 10
  mod_http_upload:
    put_url: https://@HOST@/upload
    docroot: /opt/ejabberd/upload
    max_size: {{ upload_mb * 1024 * 1024 }}
    custom_headers:
      "Access-Control-Allow-Origin": "https://@HOST@"
      "Access-Control-Allow-Methods": "GET,HEAD,PUT,OPTIONS"
      "Access-Control-Allow-Headers": "Content-Type"
  mod_last: {}
  mod_mam:
    assume_mam_usage: true
    default: always
  mod_muc:
    host: rooms.@HOST@
    access:
      - allow
    access_admin:
      - allow: admin
    access_create: muc_create
    access_persistent: muc_create
    access_mam:
      - allow
    default_room_options:
      mam: true
  mod_muc_admin: {}
  mod_offline:
    access_max_user_messages: max_user_offline_messages
  mod_ping: {}
  mod_privacy: {}
  mod_private: {}
  mod_pubsub:
    access_createnode: pubsub_createnode
    plugins:
      - flat
      - pep
    force_node_config:
      storage:bookmarks:
        access_model: whitelist
  mod_push: {}
  mod_push_keepalive: {}
  mod_register:
    access: register
    captcha_protected: true
    ip_access: all
    password_strength: 32
  mod_register_web: {}
  mod_roster:
    versioning: true
{% if federates %}
  mod_s2s_dialback: {}
{% endif %}
  mod_stream_mgmt:
    resend_on_timeout: if_offline
  mod_vcard: {}
  mod_vcard_xupdate: {}
  mod_version:
    show_os: false
