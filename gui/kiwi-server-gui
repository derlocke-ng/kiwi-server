    # ---- schema from the CLI ----
    def load_schema(self):
        rc, out, err = run_cli(self.cli, ["roles", "--porcelain"])
        if rc == 0:
            self.roles = json.loads(out)["roles"]
        else:
            self.append_log("roles: %s\n" % err)
        rc, out, err = run_cli(self.cli, ["targets", "--porcelain"])
        if rc == 0:
            self.targets = json.loads(out)["targets"]

    # ---- fleet files ----
    def open_dialog(self):
        if not self.confirm_discard(self.open_dialog):
            return
        dlg = Gtk.FileDialog(title="Open a fleet file")
        flt = Gtk.FileFilter()
        flt.set_name("YAML files")
        flt.add_pattern("*.yaml")
        flt.add_pattern("*.yml")
        fl = Gio.ListStore(item_type=Gtk.FileFilter)
        fl.append(flt)
        dlg.set_filters(fl)

        def done(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            self.open_path(f.get_path())
        dlg.open(self, None, done)

    def open_path(self, path):
        try:
            self.doc = FleetDoc(path)
        except Exception as e:  # noqa: BLE001
            self.alert("Cannot open %s" % os.path.basename(path), str(e))
            return
        self.title.set_subtitle(path)
        self.rebuild_sidebar()
        self.refresh_status()
        self.listbox.select_row(self.listbox.get_row_at_index(0))
        self.set_actions_sensitive()

    def new_dialog(self):
        if not self.confirm_discard(self.new_dialog):
            return
        dlg = Gtk.FileDialog(title="Where to put the new fleet.yaml", initial_name="fleet.yaml")

        def done(d, res):
            try:
                f = d.save_finish(res)
            except GLib.Error:
                return
            path = f.get_path()
            if os.path.exists(path):
                os.unlink(path)
            rc, out, err = run_cli(self.cli, ["init", path])
            if rc != 0:
                self.alert("Could not create the fleet", err or out)
                return
            self.open_path(path)
            self.toast("Example fleet written — edit the hosts and their secrets")
        dlg.save(self, None, done)

    def save(self):
        if not self.doc.path:
            return
        try:
            self.doc.save()
        except OSError as e:
            self.alert("Save failed", str(e))
            return
        self.mark_dirty()
        self.refresh_status()
        self.toast("Saved %s" % os.path.basename(self.doc.path))

    def mark_dirty(self):
        self.title.set_title("Kiwi Server" + (" •" if self.doc.dirty else ""))
        self.b_save.set_sensitive(bool(self.doc.path) and self.doc.dirty)

    def confirm_discard(self, then):
        if not self.doc.dirty:
            return True
        dlg = Adw.AlertDialog(heading="Unsaved changes", body="Save the fleet file first?")
        dlg.add_response("discard", "Discard")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("save", "Save")
        dlg.set_response_appearance("discard", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_response_appearance("save", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("save")
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r == "save":
                self.save()
            if r in ("save", "discard"):
                self.doc.dirty = False
                then()
        dlg.connect("response", resp)
        dlg.present(self)
        return False

    def on_close(self, *_):
        if self.busy:
            self.toast("A build is running — wait for it to finish")
            return True
        if self.doc.dirty:
            self.confirm_discard(self.destroy)
            return True
        return False

    # ---- sidebar ----
    def rebuild_sidebar(self):
        while True:
            row = self.listbox.get_row_at_index(0)
            if row is None:
                break
            self.listbox.remove(row)
        self.listbox.append(self.make_row("defaults"))
        for name in self.doc.hosts():
            self.listbox.append(self.make_row(name))

    def make_row(self, scope):
        row = Gtk.ListBoxRow()
        row.scope = scope
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=6, margin_bottom=6,
                      margin_start=4, margin_end=4)
        top = Gtk.Box(spacing=6)
        if scope == "defaults":
            lbl = Gtk.Label(label="Defaults", xalign=0, hexpand=True)
            lbl.add_css_class("heading")
            top.append(lbl)
            box.append(top)
            sub = Gtk.Label(label="applies to every host", xalign=0)
            sub.add_css_class("dim-label")
            sub.add_css_class("caption")
            box.append(sub)
        else:
            lbl = Gtk.Label(label=scope, xalign=0, hexpand=True, ellipsize=3)
            lbl.add_css_class("heading")
            top.append(lbl)
            st = self.status.get(scope) or {}
            if st.get("errors"):
                top.append(pill("INVALID", "bad", "\n".join(st["errors"])))
            elif st.get("status", {}).get("iso"):
                top.append(pill("ISO", "ok", "the ISO is built"))
            elif st.get("status", {}).get("script"):
                top.append(pill("rendered", "acc", "scripts and configs are rendered"))
            box.append(top)
            tgt = self.doc.get(scope, ("target",)) or self.doc.get("defaults", ("target",)) or "ucore"
            role = self.doc.get(scope, ("role",)) or self.doc.get("defaults", ("role",)) or "bare"
            pills = Gtk.Box(spacing=4)
            pills.append(pill(tgt, "dim"))
            pills.append(pill(role, "dim"))
            box.append(pills)
            hn = st.get("hostname") or self.doc.get(scope, ("hostname",)) or ""
            if hn:
                sub = Gtk.Label(label=hn, xalign=0, ellipsize=3)
                sub.add_css_class("dim-label")
                sub.add_css_class("caption")
                box.append(sub)
        row.set_child(box)
        return row

    def on_select(self, _lb, row):
        if row is None:
            return
        self.show_editor(row.scope)

    def refresh_rows(self):
        """Re-render the rows without losing the selection."""
        sel = self.current_scope
        self.rebuild_sidebar()
        i = 0
        while True:
            row = self.listbox.get_row_at_index(i)
            if row is None:
                break
            if row.scope == sel:
                self.listbox.select_row(row)
                break
            i += 1

    # ---- editor ----
    def show_editor(self, scope):
        self.current_scope = scope
        child = self.editor_holder.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self.editor_holder.remove(child)
            child = nxt
        is_host = scope not in (None, "defaults")
        for b in (self.b_host_render, self.b_host_build, self.b_host_script, self.b_host_folder, self.b_host_remove):
            b.set_visible(is_host)
        if scope is None or not self.doc.path:
            self.editor_holder.append(self.empty)
            self.content_title.set_title("")
            self.banner.set_revealed(False)
            return
        form = Form(self, self.doc, scope, self.roles, self.targets)
        sc = Gtk.ScrolledWindow(child=form.page, vexpand=True)
        self.editor_holder.append(sc)
        if scope == "defaults":
            self.content_title.set_title("Defaults")
            self.content_title.set_subtitle("inherited by every host")
            self.banner.set_revealed(False)
        else:
            st = self.status.get(scope) or {}
            self.content_title.set_title(scope)
            self.content_title.set_subtitle(st.get("hostname") or "")
            if st.get("errors"):
                self.banner.set_title(st["errors"][0])
                self.banner.set_revealed(True)
            elif st.get("warnings"):
                self.banner.set_title(st["warnings"][0])
                self.banner.set_revealed(True)
            else:
                self.banner.set_revealed(False)

    def add_host_dialog(self):
        if not self.doc.path:
            self.toast("Open or create a fleet first")
            return
        dlg = Adw.AlertDialog(heading="Add a host", body="A short name: letters, digits, dashes. "
                              "It becomes <name>.<domain> unless you set a hostname.")
        entry = Gtk.Entry(placeholder_text="sh5")
        dlg.set_extra_child(entry)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("add", "Add")
        dlg.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("add")
        dlg.set_close_response("cancel")

        def resp(_d, r):
            name = entry.get_text().strip()
            if r != "add" or not name:
                return
            if name in self.doc.hosts() or name == "defaults":
                self.toast("There is already a host called %s" % name)
                return
            self.doc.add_host(name)
            self.mark_dirty()
            self.current_scope = name
            self.refresh_rows()
        dlg.connect("response", resp)
        dlg.present(self)

    def remove_host_dialog(self):
        name = self.current_scope
        dlg = Adw.AlertDialog(heading="Remove %s?" % name,
                              body="Only from the fleet file. Generated files in the output directory stay.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("remove", "Remove")
        dlg.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r == "remove":
                self.doc.remove_host(name)
                self.mark_dirty()
                self.current_scope = "defaults"
                self.refresh_rows()
        dlg.connect("response", resp)
        dlg.present(self)

    # ---- status from the CLI ----
    def refresh_status(self):
        if not self.doc.path or self.doc.dirty:
            return

        def worker():
            rc, out, err = run_cli(self.cli, ["list", self.doc.path, "--porcelain"])
            data = {}
            if rc == 0:
                try:
                    data = {h["name"]: h for h in json.loads(out)["hosts"]}
                except (ValueError, KeyError):
                    data = {}
            else:
                GLib.idle_add(self.append_log, (err or out) + "\n")
            GLib.idle_add(self.apply_status, data)
        threading.Thread(target=worker, daemon=True).start()

    def apply_status(self, data):
        self.status = data
        self.refresh_rows()
        if self.current_scope not in (None, "defaults"):
            self.show_editor(self.current_scope)
        return False

    # ---- actions ----
    def set_actions_sensitive(self):
        ok = bool(self.doc.path) and not self.busy
        for b in (self.b_build, self.b_render, self.b_host_render, self.b_host_build, self.b_host_script):
            b.set_sensitive(ok)
        self.mark_dirty()

    def ensure_saved(self):
        if not self.doc.path:
            self.toast("Open or create a fleet first")
            return False
        if self.doc.dirty:
            self.save()
        return True

    def render(self, host):
        if not self.ensure_saved():
            return
        args = ["render", self.doc.path] + ([host] if host else [])
        self.spawn(args, "Rendering %s…" % (host or "every host"))

    def confirm_build(self, host):
        if not self.ensure_saved():
            return
        names = [host] if host else self.doc.hosts()
        lines = []
        for n in names:
            st = self.status.get(n) or {}
            lines.append("%s  →  %s" % (n, st.get("disk") or "(no disk set — the build will refuse)"))
        dlg = Adw.AlertDialog(
            heading="Build unattended ISO%s?" % ("" if len(names) == 1 else "s"),
            body="Each ISO installs WITHOUT ASKING and wipes the disk it is told to:\n\n%s\n\n"
                 "Base images are downloaded once into the cache." % "\n".join(lines))
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("build", "Build")
        dlg.set_response_appearance("build", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "build" and
                    self.spawn(["build", self.doc.path] + ([host] if host else []),
                               "Building %s…" % (host or "every host")))
        dlg.present(self)

    def show_script(self):
        if not self.ensure_saved():
            return
        rc, out, err = run_cli(self.cli, ["script", self.doc.path, self.current_scope])
        if rc != 0:
            self.alert("Cannot render the script", err or out)
            return
        TextDialog("%s — role script" % self.current_scope, out).present(self)

    def open_folder(self):
        st = self.status.get(self.current_scope) or {}
        d = st.get("dir")
        if not d or not os.path.isdir(d):
            self.toast("Nothing rendered for this host yet")
            return
        Gio.AppInfo.launch_default_for_uri("file://" + d, None)

    def spawn(self, args, msg):
        if self.busy:
            return
        self.set_busy(True, msg)
        self.b_log.set_active(True)
        cmd = [self.cli] + list(args)

        def worker():
            GLib.idle_add(self.append_log, "\n$ %s\n" % " ".join(shlex.quote(c) for c in cmd))
            rc = 1
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                        text=True, stdin=subprocess.DEVNULL)
                for line in proc.stdout:
                    GLib.idle_add(self.append_log, line)
                rc = proc.wait()
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self.append_log, "%s\n" % e)
            GLib.idle_add(self.after_spawn, rc)
        threading.Thread(target=worker, daemon=True).start()

    def after_spawn(self, rc):
        self.set_busy(False, "")
        self.toast("Done" if rc == 0 else "Failed — see the output")
        self.refresh_status()
        return False

    def set_busy(self, busy, msg):
        self.busy = busy
        self.progress.set_visible(busy)
        if busy and self._pulse is None:
            self._pulse = GLib.timeout_add(120, self._do_pulse)
        elif not busy and self._pulse is not None:
            GLib.source_remove(self._pulse)
            self._pulse = None
        self.set_actions_sensitive()
        self.title.set_subtitle(msg if msg else (self.doc.path or "no fleet open"))

    def _do_pulse(self):
        self.progress.pulse()
        if not self.busy:
            self._pulse = None
            return False
        return True

    def append_log(self, text):
        self.logbuf.insert(self.logbuf.get_end_iter(), text)
        mark = self.logbuf.create_mark(None, self.logbuf.get_end_iter(), False)
        self.logview.scroll_mark_onscreen(mark)
        self.logbuf.delete_mark(mark)
        return False

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast.new(text))

    def alert(self, heading, body):
        dlg = Adw.AlertDialog(heading=heading, body=body)
        dlg.add_response("close", "Close")
        dlg.present(self)


class Application(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.path = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def do_open(self, files, _n, _hint):
        self.path = files[0].get_path()
        self.do_activate()

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            cli = find_cli()
            if not cli:
                dlg = Adw.AlertDialog(heading="kiwi-server not found",
                                      body="The CLI must be installed next to this GUI:\n  kiwi install kiwi-server")
                dlg.add_response("close", "Close")
                tmp = Adw.ApplicationWindow(application=self)
                dlg.connect("response", lambda *_: self.quit())
                dlg.present(tmp)
                return
            win = Window(self, cli)
            if self.path:
                win.open_path(self.path)
        win.present()


if __name__ == "__main__":
    import signal
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    sys.exit(Application().run(sys.argv))
