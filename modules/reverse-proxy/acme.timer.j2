[Unit]
Description=Kiwi Network: renew the Let's Encrypt certificates of {{ hostname }} when they are due
Documentation=https://github.com/derlocke-ng/kiwi-server

[Timer]
OnBootSec=10min
OnUnitActiveSec=1d
RandomizedDelaySec=1h
Unit={{ container_prefix }}-acme.service

[Install]
WantedBy=timers.target
