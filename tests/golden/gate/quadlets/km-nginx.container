# kiwi-server stack — generated; the fleet file is the place to change it
[Unit]
Description=kiwi stack: km-nginx
Requires=km-vpn-server.service
After=km-vpn-server.service
StartLimitIntervalSec=0

[Container]
Image=docker.io/library/nginx:1
ContainerName=km-nginx
Network=container:km-vpn-server
AutoUpdate=registry
Volume=/home/user/docker/km-nginx/nginx.conf:/etc/nginx/nginx.conf:ro,z
Volume=/home/user/docker/km-nginx/fullchain.pem:/etc/nginx/fullchain.pem:ro,z
Volume=/home/user/docker/km-nginx/privkey.pem:/etc/nginx/privkey.pem:ro,z
LogDriver=journald

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900

[Install]
WantedBy=kiwi-stack.target
