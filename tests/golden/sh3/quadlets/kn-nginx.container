# kiwi-server stack — generated; the fleet file is the place to change it
[Unit]
Description=kiwi stack: kn-nginx
StartLimitIntervalSec=0

[Container]
Image=docker.io/library/nginx:1
ContainerName=kn-nginx
Network=knet-node.network
IP=172.128.0.5
AutoUpdate=registry
AddHost=sh3.home:172.128.0.5
AddHost=cloud.sh3.home:172.128.0.5
AddHost=vault.sh3.home:172.128.0.5
AddHost=portainer.sh3.home:172.128.0.5
Volume=/home/user/docker/kn-nginx/nginx.conf:/etc/nginx/nginx.conf:ro,z
Volume=/home/user/docker/kn-nginx/fullchain.pem:/etc/nginx/fullchain.pem:ro,z
Volume=/home/user/docker/kn-nginx/privkey.pem:/etc/nginx/privkey.pem:ro,z
PublishPort=80:80
PublishPort=443:443
LogDriver=journald

[Service]
Restart=always
RestartSec=15
TimeoutStartSec=900

[Install]
WantedBy=kiwi-stack.target
