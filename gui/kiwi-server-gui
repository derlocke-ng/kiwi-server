        win, name = self.win, self.scope
        st = win.status.get(name) or {}
        state = win.state_of(name)
        self.dot.set_css_classes(["ks-dot", state])
        self.dot.set_tooltip_text(WORDS[state])
        self.line.set_label(win.machine_line(name))
        self.line.set_tooltip_text(st.get("hostname") or "")
        problems = win.problems_of(name)
        if state == "new":
