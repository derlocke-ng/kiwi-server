    def joined(self):
        """Does this fleet belong to a control node (it joined one, or pushed to one)?"""
        return bool(self.doc.path) and os.path.isfile(os.path.join(os.path.dirname(self.doc.path), "control", "remote"))

    def sync(self, say=False, after_save=False):
        """Keep in step with the control node, in the background: fetch what is newer there
        (on opening), send what was saved here. A copy that changed on both sides is left
        alone and said."""
        if not self.joined():
            if say:
                self.toast("This fleet has no control node")
            return
        path, generation, dirty = self.doc.path, self.generation, self.doc.dirty

        def work():
            steps = ["push"] if after_save else (["pull"] if dirty else ["pull", "push"])
            rc, text = 0, ""
            for step in steps:
                rc, out, err = run_cli(self.cli, ["control", step, path], timeout=180)
                text = (err or out).strip().replace("error: ", "").replace(":: ", "")
                if rc != 0:
                    break
                if step == "pull" and "in step" not in text:
                    GLib.idle_add(came)
            GLib.idle_add(done, rc, text)

        def came():
            if generation == self.generation and not self.doc.dirty:
                self.open_path(path, sync=False)      # what came is what is shown
            return False

        def done(rc, text):
            if generation != self.generation and rc == 0:
                return False
            if rc != 0:
                self.toast("Not in step with the control node: %s" % (text.splitlines() or ["?"])[-1][:160])
            elif say:
                self.toast("In step with the control node")
            return False
        threading.Thread(target=work, daemon=True).start()

    def open_path(self, path, sync=True):
        try:
            self.doc = FleetDoc(path)
        except Exception as e:  # noqa: BLE001
            self.alert("Cannot open %s" % os.path.basename(path), str(e))
            return
        path = os.path.abspath(path)
        self.generation += 1
        self.polling = False
        self.status, self.fleet_info, self.live, self.last_seen, self.store = {}, {}, {}, {}, {}
        self.checked = None
        self.current_scope = None
        recent = [path] + [p for p in load_recent() if p != path]
        save_recent(recent)
        self.rebuild_recent(recent)
        self.title.set_subtitle(tilde(path))
        self.rebuild_sidebar(FLEET)
        self.mark_dirty()
        self.set_actions_sensitive()
        self.poll()
        if sync:
            self.sync()

    def new_dialog(self):
        """A new network: straight to the questions. It goes into ~/kiwi (or ~/kiwi-2, … when
        that holds one already); nobody is asked for a file name before they know what it is."""
        if not self.confirm_discard(self.new_dialog):
            return
        folder, n = os.path.expanduser("~/kiwi"), 2
        while os.path.exists(folder) and os.listdir(folder):
            folder, n = os.path.expanduser("~/kiwi-%d" % n), n + 1
        rc, out, err = run_cli(self.cli, ["init", "--questions"])
        if rc != 0:
            self.alert("The questions could not be loaded", err or out)
            return
        os.makedirs(folder, mode=0o700, exist_ok=True)
        SetupWizard(self, os.path.join(folder, "fleet.yaml"), json.loads(out)).present(self)

