        elif win.phase_of(name) == "invalid":
            self.badge.set_child(pill("SETTINGS", "bad", "\n".join(st.get("errors") or [])))
        elif problems and state != "down":
            self.badge.set_child(pill(str(len(problems)), state, "\n".join(t for _l, t in problems)))
