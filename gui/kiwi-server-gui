def help_button(text, link=None, info=False):
    """A "?" beside a field or term: what it means, the documentation one click away. With
    `info`, an (i) instead: the whole of a text too long for where it stands."""
    if info:
        b = Gtk.MenuButton(icon_name="help-about-symbolic", valign=Gtk.Align.CENTER, tooltip_text="More",
                           css_classes=["flat", "circular", "ks-help"])
