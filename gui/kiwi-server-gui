                g.add(row)
            page.add(g)
        head = Adw.HeaderBar()
        again = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Ask again")
        again.connect("clicked", lambda *_: self.load())
        head.pack_end(again)
        tb = Adw.ToolbarView(content=page)
        tb.add_top_bar(head)
        self.set_child(tb)

    def invite(self, extra, label):
        d = Adw.AlertDialog(heading="An invite code for %s" % label, body="It is shown once. Give it to the person; they enter it at /join.")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
