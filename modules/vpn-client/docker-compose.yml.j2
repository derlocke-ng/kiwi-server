# vpn-client (gluetun) — the network anchor of a node or the exit of a master
services:
  {{ container_prefix }}-vpn-client:
    image: {{ image }}
    container_name: {{ container_prefix }}-vpn-client
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - VPN_SERVICE_PROVIDER={{ vpn_provider }}
      - VPN_TYPE={{ vpn_type }}
{% if openvpn_config_present %}
      # another provider's OpenVPN config, as a file (its certificates inside)
      - OPENVPN_CUSTOM_CONFIG=/gluetun/custom.ovpn
{% elif not wireguard_config_present %}
      - WIREGUARD_PRIVATE_KEY={{ wireguard_private_key }}
{% if wireguard_addresses %}
      - WIREGUARD_ADDRESSES={{ wireguard_addresses }}
{% endif %}
{% if wireguard_preshared_key %}
      - WIREGUARD_PRESHARED_KEY={{ wireguard_preshared_key }}
{% endif %}
{% if vpn_provider == 'custom' %}
      # another provider's WireGuard config, by its lines
      - WIREGUARD_PUBLIC_KEY={{ wireguard_public_key }}
      - WIREGUARD_ENDPOINT_IP={{ wireguard_endpoint_ip }}
{% endif %}
{% endif %}
{% for key, value in [('SERVER_COUNTRIES', server_countries), ('SERVER_REGIONS', server_regions), ('SERVER_CITIES', server_cities), ('SERVER_HOSTNAMES', server_hostnames)] if value %}
      - {{ key }}={{ value }}
{% endfor %}
{% if vpn_endpoint_port %}
      - VPN_ENDPOINT_PORT={{ vpn_endpoint_port }}
      - WIREGUARD_ENDPOINT_PORT={{ vpn_endpoint_port }}
{% endif %}
      - TZ={{ timezone }}
      - WIREGUARD_MTU={{ wg_mtu }}
      - WIREGUARD_PERSISTENT_KEEPALIVE_INTERVAL={{ keepalive or (10 if vpn_provider == 'custom' else 25) }}s
      - DNS_UPSTREAM_RESOLVERS={{ dot_providers }}
      - BLOCK_MALICIOUS=off
{% if vpn_provider == 'custom' and 'HEALTH_RESTART_VPN' not in extra_env %}
      # one fixed server (a node's is its master): a tunnel set up anew reaches the same server
      # with the same keys, so nothing is gained, and everything that uses the tunnel is cut each
      # time. gluetun's own check asks names on the Internet through the tunnel, and a failed one
      # set the tunnel up anew every six seconds. When the provider renumbered a home's line (27
      # Nov 2026, 03:01) six machines did that 76 times each: the line was back at 03:09, the mesh
      # only at 03:14. The same when only the master's way out is away and the mesh itself is
      # fine. The tunnel now stays as it is; WireGuard finds its way again by itself
      - HEALTH_RESTART_VPN=off
{% endif %}
{% for k, v in extra_env.items() %}
      - {{ k }}={{ v }}
{% endfor %}
{% if vpn_provider != 'custom' %}
      - UPDATER_PERIOD=24h
{% endif %}
{% set inbound = [] %}
{% if enable_vpn_dnat %}{% set _ = inbound.extend(['80', '443']) %}{% endif %}
{% if mesh_ssh and node_type != 'master' %}{% set _ = inbound.append('22') %}{% endif %}
{% for r in extra_dnat_rules if '-' not in r.split(':')[0] %}{% set _ = inbound.append(r.split(':')[0].split('/')[0]) %}{% endfor %}
{% if vpn_input_ports %}{% set _ = inbound.append(vpn_input_ports) %}{% endif %}
{% if inbound %}
      - FIREWALL_VPN_INPUT_PORTS={{ inbound | join(',') }}
{% endif %}
{% if outbound_subnets %}
      - FIREWALL_OUTBOUND_SUBNETS={{ outbound_subnets }}
{% endif %}
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
{% if published_ports %}
    ports:
{% for p in published_ports %}
      - "{{ p }}"
{% endfor %}
{% endif %}
    sysctls:
{# never inherited: at boot this namespace is made before the host's forwarding is on #}
      - net.ipv4.ip_forward=1
      - net.ipv4.tcp_mtu_probing=1
      - net.ipv4.tcp_base_mss=1024
    restart: unless-stopped
{% if vpn_provider != 'custom' %}
    # gluetun restarts a failing tunnel to the same server, so a bad one keeps the exit down for
    # good. Unhealthy for five minutes, the container is killed, and its next start picks another.
    healthcheck:
      test: ["CMD", "/gluetun-entrypoint", "healthcheck"]
      interval: 60s
      timeout: 10s
      retries: 5
      start_period: 120s
    x-kiwi-health-on-failure: kill
{% endif %}
    logging:
      driver: json-file
      options:
        max-size: 10m
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-vpn-client/post-rules.txt:/iptables/post-rules.txt:z
{% if wireguard_config_present %}
      - {{ docker_dir }}/{{ container_prefix }}-vpn-client/wg0.conf:/gluetun/wireguard/wg0.conf:z
{% endif %}
{% if openvpn_config_present %}
      - {{ docker_dir }}/{{ container_prefix }}-vpn-client/custom.ovpn:/gluetun/custom.ovpn:ro,z
{% endif %}
