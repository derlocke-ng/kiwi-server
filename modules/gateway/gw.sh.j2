#!/usr/bin/env bash
# LAN gateway routing for {{ hostname }} — generated by kiwi-server, run by kn-gateway.service.
#
# LAN clients that point their default gateway at this machine are routed through
# the VPN client container (table 128). They may reach the mesh ({{ vpn_subnet }})
# and the internet through the tunnel, not the docker network itself.
set -u

PUB_IFACE="{{ pub_iface }}"
CONTAINER_IP="{{ vpn_client_ip }}"
DOCKER_SUBNET="{{ docker_subnet }}"
VPN_SUBNET="{{ vpn_subnet or mesh_subnet }}"
BRIDGE="{{ network_name }}"

if [[ -z $PUB_IFACE ]]; then
    PUB_IFACE=$(ip -o route get 8.8.8.8 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p')
fi
[[ -n $PUB_IFACE ]] || { echo "[kiwi-gw] no LAN interface found"; exit 1; }

rules_del() {
    iptables -D FORWARD -i "$PUB_IFACE" -d "$DOCKER_SUBNET" -j DROP 2>/dev/null || true
    iptables -D FORWARD -i "$PUB_IFACE" -d "$VPN_SUBNET" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -i "$PUB_IFACE" -o "$BRIDGE" -j ACCEPT 2>/dev/null || true
    iptables -D FORWARD -i "$BRIDGE" -o "$PUB_IFACE" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
    iptables -D INPUT -i "$BRIDGE" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
    iptables -t nat -D POSTROUTING -o "$BRIDGE" -j MASQUERADE 2>/dev/null || true
    ip route flush table 128 2>/dev/null || true
    while ip rule del iif "$PUB_IFACE" table 128 2>/dev/null; do :; done
}

case "${1:-start}" in
    stop)
        rules_del
        echo "[kiwi-gw] routing removed"
        exit 0 ;;
    start) ;;
    *) echo "usage: gw.sh start|stop" >&2; exit 1 ;;
esac

# the VPN client must be up: wait for it rather than fail the boot
for _ in $(seq 60); do
    ping -c 1 -W 2 "$CONTAINER_IP" >/dev/null 2>&1 && break
    sleep 2
done
if ! ping -c 1 -W 2 "$CONTAINER_IP" >/dev/null 2>&1; then
    echo "[kiwi-gw] VPN client at $CONTAINER_IP is not reachable"
    exit 1
fi

rules_del
# policy routing: what comes in on the LAN interface leaves via the VPN client
ip rule add iif "$PUB_IFACE" table 128
ip route add table 128 default via "$CONTAINER_IP"
ip route add table 128 throw "$DOCKER_SUBNET"
# LAN clients: no access to the docker network, mesh allowed, internet through the tunnel.
# -I puts a rule on top, so the last one inserted is checked first: the DROP goes last.
iptables -I INPUT -i "$BRIDGE" -m state --state RELATED,ESTABLISHED -j ACCEPT
iptables -I FORWARD -i "$BRIDGE" -o "$PUB_IFACE" -m state --state RELATED,ESTABLISHED -j ACCEPT
iptables -I FORWARD -i "$PUB_IFACE" -o "$BRIDGE" -j ACCEPT
iptables -I FORWARD -i "$PUB_IFACE" -d "$VPN_SUBNET" -j ACCEPT
iptables -I FORWARD -i "$PUB_IFACE" -d "$DOCKER_SUBNET" -j DROP
iptables -t nat -I POSTROUTING -o "$BRIDGE" -j MASQUERADE
echo "[kiwi-gw] LAN ($PUB_IFACE) -> $CONTAINER_IP (VPN client); mesh $VPN_SUBNET allowed"
