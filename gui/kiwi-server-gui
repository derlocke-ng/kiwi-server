        connectable = [(h["name"], m, label) for h in got.get("hosts") or [] for m, label in self.CONNECTABLE
                       if m in (h.get("modules") or [])]
        if people is not None and connectable:
            g = Adw.PreferencesGroup(title="Services that sign people in with these accounts",
                                     description="Connect one, then apply its machine: it offers \u201cSign in with accounts\u201d.")
            secrets_dir = os.path.join(self.win.doc.dir, "secrets", "accounts")
            for host, m, label in connectable:
                row = Adw.ActionRow(title=label, subtitle=host)
