[Unit]
Description=nginx on {{ hostname }}: read the list of banned addresses again
Documentation=https://github.com/derlocke-ng/kiwi-server
# many bans in a row must not hit systemd's start limit: that would stop the path unit watching
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=-{{ '/usr/bin/podman' if runtime == 'podman' else '/usr/bin/docker' }} exec {{ container_prefix }}-nginx nginx -s reload
