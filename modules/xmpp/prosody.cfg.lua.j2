-- Prosody for {{ xmpp_host }} on {{ hostname }}: generated by kiwi-server; the fleet file is the place to change it
admins = { "{{ admin_user }}@{{ xmpp_host }}" }

modules_enabled = {
    "roster"; "saslauth"; "tls"; "disco"; "carbons"; "pep"; "private"; "blocklist"; "vcard4"; "vcard_legacy";
    "version"; "uptime"; "time"; "ping"; "mam"; "csi_simple"; "smacks"; "bookmarks"; "limits";
    -- people come by invitation: the admin makes one in the app, the invited person makes the account
    "register"; "invites"; "invites_adhoc"; "invites_register"; "admin_adhoc"; "admin_shell";
    -- files and web apps come through the reverse proxy
    "http"; "websocket"; "bosh";
{% if xmpp_public %}
    "dialback";
{% endif %}
}
modules_disabled = {
{% if not xmpp_public %}
    "s2s";      -- a mesh name: no other server reaches it, and it asks none
{% endif %}
}

allow_registration = false
registration_invite_only = true
c2s_require_encryption = true
s2s_require_encryption = true
s2s_secure_auth = true
authentication = "internal_hashed"
storage = "internal"
default_archive_policy = true
archive_expires_after = "{{ history_days }}d"
limits = { c2s = { rate = "100kb/s" }; s2sin = { rate = "100kb/s" } }
log = { info = "*console" }

-- plain HTTP for the reverse proxy only; it speaks https to the people
http_ports = { 5280 }
http_interfaces = { "*" }
https_ports = { }
trusted_proxies = { "127.0.0.1", "{{ docker_subnet }}" }
http_external_url = "https://{{ xmpp_host }}/"
consider_websocket_secure = true
consider_bosh_secure = true

VirtualHost "{{ xmpp_host }}"
    ssl = { certificate = "/etc/prosody/certs/fullchain.pem"; key = "/etc/prosody/certs/privkey.pem" }

Component "rooms.{{ xmpp_host }}" "muc"
    name = "Rooms"
    restrict_room_creation = "local"
    modules_enabled = { "muc_mam" }

Component "upload.{{ xmpp_host }}" "http_file_share"
    http_host = "{{ xmpp_host }}"
    http_file_share_size_limit = {{ upload_mb }} * 1024 * 1024
    http_file_share_expires_after = 60 * 60 * 24 * 31
    http_file_share_access = { "{{ xmpp_host }}" }
